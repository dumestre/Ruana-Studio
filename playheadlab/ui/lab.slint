// PlayheadLab — laboratório de playhead/scrub.
//
// Réplica mínima da timeline: régua clicável/arrastável, track
// fake com blocos, playhead que segue o mouse em tempo real
// (parado e tocando), sem ímã e sem salto.
//
// O playhead é UMA ÚNICA linha vermelha que:
//  - segue o mouse 1:1 durante o scrub (binding direto, 0ms)
//  - segue o transporte quando não arrasta
//  - desce da régua até o fim da timeline
//
// Instrumentação pro HUD: taxa de seeks/s e moves/s.

import { Slider } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "PlayheadLab";
    preferred-width: 1200px;
    preferred-height: 420px;
    background: #14161a;

    // =====================================================
    // ESTADO
    // =====================================================

    // Zoom: pixels por segundo.
    in-out property <float> pps: 100.0;

    // Posição do transporte em segundos (fonte: clock simulado).
    in-out property <float> transport-secs: 0.0;

    // Playing?
    in-out property <bool> playing: false;

    // Scroll horizontal do viewport.
    in-out property <length> scroll-x: 0px;

    // Duração do projeto.
    in property <float> duration: 30.0;

    // =====================================================
    // UNIDADES
    // =====================================================

    property <length> px-per-sec:
        root.pps * 1px;

    // =====================================================
    // DERIVADOS
    // =====================================================

    // Posição do playhead em coordenadas de CONTEÚDO.
    // - Scrub: segue o mouse direto (binding puro, 0ms).
    // - Idle: segue o transporte.
    // Prioridade: SCRUB > transporte. Durante o arrasto o mouse
    // manda; ao soltar, o clock já foi re-ancorado no mesmo ponto
    // (seek throttled), então não há salto.
    // Anti-flash: ao soltar o mouse há 1 frame em que
    // `scrubbing` já é false mas `transport-secs` ainda não
    // propagou o seek final → a agulha piscaria na posição
    // antiga. Guardamos o último x do scrub e usamos como
    // fonte até o transporte alcançá-lo (tolerância de 2px).
    // O hold anti-flash só vale PARADO: tocando, o transporte se
    // afasta do ponto de scrub por design — a agulha deve seguir
    // o clock. (Era isso que congelava a agulha no play.)
    property <bool> use-scrub-pos:
        !root.playing
        && (root.scrubbing
            || (root.transport-secs - root.last-scrub-secs).abs()
               > 2.0 / root.pps);

    property <length> content-playhead-x:
        root.use-scrub-pos
            ? root.last-scrub-secs * root.px-per-sec
            : root.transport-secs * root.px-per-sec;

    // Viewport.
    property <length> view-w: timeline-area.width;
    property <length> project-span: root.duration * root.px-per-sec;
    property <length> max-scroll:
        max(0px, root.project-span - self.view-w);

    // Estado do scrub (setado pelo touch da régua).
    in-out property <bool> scrubbing: false;
    in-out property <float> last-scrub-secs: 0.0;

    // =====================================================
    // CALLBACKS (Rust)
    // =====================================================

    callback seek(float);           // segundos → clock visual
    callback toggle-play();
    in property <int> seeks-per-sec;
    in property <int> moves-per-sec;

    // =====================================================
    // LAYOUT
    // =====================================================

    VerticalLayout {
        padding: 10px;
        spacing: 4px;

        HorizontalLayout {
            height: 30px;
            spacing: 8px;

            Rectangle {
                width: 90px;
                height: 26px;
                border-radius: 4px;
                background: root.playing ? #2e5c3a : #3a3f47;
                TouchArea {
                    pointer-event(ev) => {
                        if ev.kind == PointerEventKind.down
                            && ev.button == PointerEventButton.left {
                            root.toggle-play();
                        }
                    }
                }
                Text {
                    text: root.playing ? "■ STOP" : "▶ PLAY";
                    color: white;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            Text { text: "Zoom:"; color: #cccccc; vertical-alignment: center; }
            Slider {
                width: 220px;
                minimum: 10.0;
                maximum: 2000.0;
                value <=> root.pps;
            }
            Rectangle {}
            Text {
                text: "pos: " + (root.transport-secs * 100).round() / 100 + "s";
                color: #9ecbff;
                vertical-alignment: center;
            }
        }

        // =================================================
        // ÁREA DA TIMELINE
        // =================================================
        timeline-area := Rectangle {
            clip: true;
            border-radius: 6px;
            background: #1c1f24;
            // Largura/altura derivam SÓ do layout (stretch), nunca
            // dos filhos — a régua/track têm largura enorme
            // (project-span) e sem isso a janela cresceria infinito.
            horizontal-stretch: 1;
            vertical-stretch: 1;

            // ---------- RÉGUA ----------
            Rectangle {
                x: -root.scroll-x;
                y: 0;
                width: root.project-span;
                height: 28px;
                background: #23262c;

                // Barras a cada segundo.
                for i in 30: Rectangle {
                    x: (i * root.pps) * 1px;
                    y: 0;
                    width: 1px;
                    height: parent.height;
                    background: #3a3f47;
                }

                // TouchArea da régua: SCRUB.
                ruler-touch := TouchArea {
                    pointer-event(ev) => {
                        if ev.button == PointerEventButton.left {
                            if ev.kind == PointerEventKind.down {
                                root.scrubbing = true;
                            }
                            if ev.kind == PointerEventKind.up
                                || ev.kind == PointerEventKind.cancel {
                                root.scrubbing = false;
                                // Seek FINAL imediato no release: garante
                                // que o transporte fique exatamente onde
                                // soltei (sem esperar o throttle).
                                root.seek((self.mouse-x + root.scroll-x) / root.px-per-sec);
                            }
                        }
                    }
                    moved => {
                        // Posição LOCAL ao mouse, atualizada TODO
                        // frame de movimento pelo renderer (0ms de
                        // roundtrip). O playhead lê isso diretamente.
                        root.last-scrub-secs = (self.mouse-x + root.scroll-x) / root.px-per-sec;

                        let secs =
                            (self.mouse-x) / root.pps;
                    }
                    // Release fora do down: garante o seek final.
                    clicked => {
                        let secs =
                            (self.mouse-x) / root.pps;
                    }
                }
            }

            // ---------- TRACK FAKE ----------
            Rectangle {
                x: -root.scroll-x;
                y: 28px;
                width: root.project-span;
                height: parent.height - 28px;
                background: #191c21;

                for b in [
                    {s: 1.0, len: 3.0},
                    {s: 5.5, len: 2.0},
                    {s: 9.0, len: 6.5},
                    {s: 17.0, len: 4.0},
                    {s: 23.0, len: 5.0},
                ]: Rectangle {
                    x: (b.s * root.pps) * 1px;
                    y: 6px;
                    width: (b.len * root.pps) * 1px;
                    height: parent.height - 12px;
                    border-radius: 4px;
                    background: #2b4a38;
                    border-width: 1px;
                    border-color: #3f6b50;
                }
            }

            // ---------- PLAYHEAD ----------
            // UMA ÚNICA linha vermelha, de cima pra baixo, que
            // segue o conteúdo. Durante scrub: gruda no mouse.
            Rectangle {
                x: root.content-playhead-x - 1px;
                y: 0;
                width: 2px;
                height: parent.height;
                background: #dc3545;
                z: 50;

                // Cabeça (bolinha) só na régua.
                Rectangle {
                    x: -4px; y: 8px;
                    width: 10px; height: 10px;
                    border-radius: 5px;
                    background: #dc3545;
                }
            }
        }

        // ---------- HUD ----------
        HorizontalLayout {
            height: 14px;
            spacing: 12px;
            Text {
                text: "seeks/s: " + root.seeks-per-sec
                    + "   moves/s: " + root.moves-per-sec;
                color: #666c77;
                font-size: 11px;
                vertical-alignment: center;
            }
            Rectangle {}
            Text {
                text: "arraste na régua — agulha segue o mouse";
                color: #444a54;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
    }
}
