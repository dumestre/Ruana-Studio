import { Button } from "components/button.slint";
import { Theme } from "theme.slint";

export component EditToolbar inherits Rectangle {
    in-out property <int> active-tool: 0;

    in-out property <bool> beat-open: false;
    in-out property <bool> explorer-visible: true;

    callback tool-changed(int);

    height: 32px;
    background: Theme.surface;

    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 3px;
        cross-axis-alignment: CrossAxisAlignment.center;

        HorizontalLayout {
            spacing: 0px;
            alignment: LayoutAlignment.center;
            cross-axis-alignment: CrossAxisAlignment.center;

        Button {
            width: 28px;
            height: 26px;
            icon: @image-url("icons/select.svg");
            filled-icon: @image-url("icons/select_filled.svg");
            icon-size: 17px;
            text: "";
            borderless: true;
            toggled: root.active-tool == 0;

            clicked => {
                root.active-tool = 0;
                root.tool-changed(0);
            }
        }

        Button {
            width: 28px;
            height: 26px;
            icon: @image-url("icons/slice.svg");
            filled-icon: @image-url("icons/slice_filled.svg");
            icon-size: 17px;
            text: "";
            borderless: true;
            toggled: root.active-tool == 1;

            clicked => {
                root.active-tool = 1;
                root.tool-changed(1);
            }
        }

        Button {
            width: 28px;
            height: 26px;
            icon: @image-url("icons/stretch.svg");
            filled-icon: @image-url("icons/stretch_filled.svg");
            icon-size: 17px;
            text: "";
            borderless: true;
            toggled: root.active-tool == 2;

            clicked => {
                root.active-tool = 2;
                root.tool-changed(2);
            }
        }

        Button {
            width: 28px;
            height: 26px;
            icon: @image-url("icons/draw.svg");
            filled-icon: @image-url("icons/draw_filled.svg");
            icon-size: 17px;
            text: "";
            borderless: true;
            toggled: root.active-tool == 3;

            clicked => {
                root.active-tool = 3;
                root.tool-changed(3);
            }
        }

        Button {
            width: 28px;
            height: 26px;
            icon: @image-url("icons/erase.svg");
            filled-icon: @image-url("icons/erase_filled.svg");
            icon-color: #9a9a9a;
            icon-size: 17px;
            text: "";
            borderless: true;
            toggled: root.active-tool == 4;

            clicked => {
                root.active-tool = 4;
                root.tool-changed(4);
            }
        }
    }


        

        Rectangle {
            width: 1px;
            height: 20px;
            background: Theme.border;
        }
        HorizontalLayout {
            alignment: LayoutAlignment.stretch;
            cross-axis-alignment: CrossAxisAlignment.center;

        

        Button {
            width: 28px;
            height: 26px;
            icon: @image-url("icons/drum.svg");
            icon-size: 17px;
            text: "";
            borderless: true;
            toggled: root.beat-open;
            subtle-toggled: true;
            toggled-icon-color: Theme.accent;

            clicked => {
                root.beat-open = !root.beat-open;
            }
        }

        Button {
            width: 28px;
            height: 26px;
            icon: @image-url("icons/folder.svg");
            icon-size: 17px;
            text: "";
            borderless: true;
            toggled: root.explorer-visible;
            subtle-toggled: true;
            toggled-icon-color: Theme.accent;

            clicked => {
                root.explorer-visible = !root.explorer-visible;
            }
        }
    }
    }
}