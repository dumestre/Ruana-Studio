import { Button } from "components/button.slint";
import { Theme } from "theme.slint";

export component EditToolbar inherits Rectangle {

    // ============================================================
    // ESTADO
    // ============================================================

    in-out property <int> active-tool: 0;

    in-out property <bool> clip-pool-open: false;
    in-out property <bool> beat-open: false;
    in-out property <bool> explorer-visible: true;
    in-out property <bool> panel-visible: true;

    callback tool-changed(int);


    // ============================================================
    // DIMENSÕES
    // ============================================================

    height: 32px;

    background:
        transparent;


    // ============================================================
    // BORDA INFERIOR
    // ============================================================

    Rectangle {

        x: 0px;
        y: parent.height - 1px;

        width: parent.width;
        height: 1px;

        background:
            Theme.border;
    }


    // ============================================================
    // TOOLBAR
    // ============================================================

    HorizontalLayout {

        x: 0px;
        y: 0px;

        width: parent.width;
        height: parent.height;

        padding-left:
            8px;

        padding-right:
            8px;

        spacing:
            3px;

        cross-axis-alignment:
            CrossAxisAlignment.center;


        // ========================================================
        // START
        // ========================================================

        HorizontalLayout {

            spacing:
                3px;

            alignment:
                LayoutAlignment.start;

            cross-axis-alignment:
                CrossAxisAlignment.center;


            // ====================================================
            // CLIP POOL
            // ====================================================

            Button {

                width:
                    18px;

                height:
                    18px;

                resting-bg:
                    Theme.surface-high;

                icon:
                    @image-url(
                        "icons/clippool.svg"
                    );

                icon-size:
                    16px;

                icon-color:
                    Theme.text-primary;

                text:
                    "";

                borderless:
                    true;
                corner-radius: 2px;

                toggled:
                    root.clip-pool-open;

                toggled-fg:
                    Colors.black;

                subtle-toggled:
                    true;

                toggled-icon-color:
                    Theme.accent;


                clicked => {

                    root.clip-pool-open =
                        !root.clip-pool-open;
                }
            }


            // ====================================================
            // SEPARADOR
            // ====================================================

            Rectangle {

                width:
                    1px;

                height:
                    20px;

                background:
                    Theme.border;
            }
        }


        // ========================================================
        // CENTER
        // ========================================================

        HorizontalLayout {

            horizontal-stretch:
                0;

            opacity:
                1;

            spacing:
                3px;

            alignment:
                LayoutAlignment.center;

            cross-axis-alignment:
                CrossAxisAlignment.center;


            // ====================================================
            // FERRAMENTAS
            // ====================================================

                HorizontalLayout {

                    spacing:
                        2px;

                    alignment:
                        LayoutAlignment.center;

                    cross-axis-alignment:
                        CrossAxisAlignment.center;

                    padding-left:
                        2px;

                    padding-right:
                        2px;


                    // ============================================
                    // SELECT - 0
                    // ============================================

                    Button {

                        width:
                            18px;

                        height:
                            18px;

                        resting-bg:
                            Theme.surface-high;

                        icon:
                            @image-url(
                                "icons/select.svg"
                            );

                        filled-icon:
                            @image-url(
                                "icons/select_filled.svg"
                            );

                        icon-size:
                            16px;

                        icon-color:
                            Theme.text-primary;

                        padding-x:
                            0px;

                        text:
                            "";

                        borderless:
                            true;
                        corner-radius: 2px;

                        toggled:
                            root.active-tool == 0;

                        toggled-fg:
                            Colors.black;

                        subtle-toggled:
                            true;


                        clicked => {

                            root.active-tool =
                                0;

                            root.tool-changed(
                                0
                            );
                        }
                    }


                    // ============================================
                    // SLICE - 1
                    // ============================================

                    Button {

                        width:
                            18px;

                        height:
                            18px;

                        resting-bg:
                            Theme.surface-high;

                        icon:
                            @image-url(
                                "icons/slice.svg"
                            );

                        filled-icon:
                            @image-url(
                                "icons/slice_filled.svg"
                            );

                        icon-size:
                            16px;

                        icon-color:
                            Theme.text-primary;

                        text:
                            "";

                        borderless:
                            true;
                        corner-radius: 2px;

                        toggled:
                            root.active-tool == 1;

                        toggled-fg:
                            Colors.black;

                        subtle-toggled:
                            true;


                        clicked => {

                            root.active-tool =
                                1;

                            root.tool-changed(
                                1
                            );
                        }
                    }


                 
                    // ============================================
                    // GLUE - 2
                    // ============================================

                    Button {

                        width:
                            18px;

                        height:
                            18px;

                        resting-bg:
                            Theme.surface-high;

                        icon:
                            @image-url(
                                "icons/glue.svg"
                            );

                        filled-icon:
                            @image-url(
                                "icons/glue_filled.svg"
                            );

                        icon-size:
                            16px;

                        icon-color:
                            Theme.text-primary;

                        text:
                            "";

                        borderless:
                            true;
                        corner-radius: 2px;

                        toggled:
                            root.active-tool == 2;

                        toggled-fg:
                            Colors.black;

                        subtle-toggled:
                            true;


                        clicked => {

                            root.active-tool =
                                2;

                            root.tool-changed(
                                2
                            );
                        }
                    }



                    // ============================================
                    // STRETCH - 3
                    // ============================================

                    Button {

                        width:
                            18px;

                        height:
                            18px;

                        resting-bg:
                            Theme.surface-high;

                        icon:
                            @image-url(
                                "icons/expand_diag.svg"
                            );

                        filled-icon:
                            @image-url(
                                "icons/stretch_filled.svg"
                            );

                        icon-size:
                            16px;

                        icon-color:
                            Theme.text-primary;

                        text:
                            "";

                        borderless:
                            true;
                        corner-radius: 2px;

                        toggled:
                            root.active-tool == 3;

                        toggled-fg:
                            Colors.black;

                        subtle-toggled:
                            true;


                        clicked => {

                            root.active-tool =
                                3;

                            root.tool-changed(
                                3
                            );
                        }
                    }


                    
                    // ============================================
                    // ERASE - 5
                    // ============================================

                    Button {

                        width:
                            18px;

                        height:
                            18px;

                        resting-bg:
                            Theme.surface-high;

                        icon:
                            @image-url(
                                "icons/erase.svg"
                            );

                        filled-icon:
                            @image-url(
                                "icons/erase_filled.svg"
                            );

                        icon-color:
                            Theme.text-primary;

                        icon-size:
                            16px;

                        text:
                            "";

                        borderless:
                            true;
                        corner-radius: 2px;

                        toggled:
                            root.active-tool == 5;

                        toggled-fg:
                            Colors.black;

                        subtle-toggled:
                            true;


                        clicked => {

                            root.active-tool =
                                5;

                            root.tool-changed(
                                5
                            );
                        }
                    }
                }
        }


        // ========================================================
        // END
        // ========================================================

        HorizontalLayout {

            spacing:
                3px;

            alignment:
                LayoutAlignment.end;

            cross-axis-alignment:
                CrossAxisAlignment.center;


            // ====================================================
            // SEPARADOR
            // ====================================================

            Rectangle {

                width:
                    1px;

                height:
                    20px;

                background:
                    Theme.border;
            }


            // ====================================================
            // DRUM / BEAT
            // ====================================================

            Button {

                width:
                    18px;

                height:
                    18px;

                resting-bg:
                    Theme.surface-high;

                icon:
                    @image-url(
                        "icons/drum.svg"
                    );

                icon-size:
                    16px;

                icon-color:
                    Theme.text-primary;

                text:
                    "";

                borderless:
                    true;
                corner-radius: 2px;

                toggled:
                    root.beat-open;

                toggled-fg:
                    Colors.black;

                subtle-toggled:
                    true;

                toggled-icon-color:
                    Theme.accent;


                clicked => {

                    root.beat-open =
                        !root.beat-open;
                }
            }


            // ====================================================
            // EXPLORER
            // ====================================================

            Button {

                width:
                    18px;

                height:
                    18px;

                resting-bg:
                    Theme.surface-high;

                icon:
                    @image-url(
                        "icons/folder.svg"
                    );

                icon-size:
                    16px;

                icon-color:
                    Theme.text-primary;

                text:
                    "";

                borderless:
                    true;
                corner-radius: 2px;

                toggled:
                    root.explorer-visible;

                toggled-fg:
                    Colors.black;

                subtle-toggled:
                    true;

                toggled-icon-color:
                    Theme.accent;


                clicked => {

                    root.explorer-visible =
                        !root.explorer-visible;
                }
            }


            // ====================================================
            // PANEL
            // ====================================================

            Button {

                width:
                    18px;

                height:
                    18px;

                resting-bg:
                    Theme.surface-high;

                icon:
                    @image-url(
                        "icons/restore.svg"
                    );

                icon-size:
                    16px;

                icon-color:
                    Theme.text-primary;

                text:
                    "";

                borderless:
                    true;
                corner-radius: 2px;

                toggled:
                    root.panel-visible;

                toggled-fg:
                    Colors.black;

                subtle-toggled:
                    true;

                toggled-icon-color:
                    Theme.accent;


                clicked => {

                    root.panel-visible =
                        !root.panel-visible;
                }
            }
        }
    }
}