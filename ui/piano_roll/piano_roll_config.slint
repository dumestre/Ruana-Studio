export component PianoRollConfig {
    in property <length> key-height: 20px;
    in property <length> keyboard-width: 58px;
    in property <length> beat-width: 80px;
    in property <length> ruler-height: 26px;
    in property <length> velocity-height: 90px;

    // Snap (alinhamento automático ao grid)
    in property <bool> snap-enabled: true;

    // Denominador do snap (1/n).
    // Valores comuns:
    //   1  = semínima (1 tempo = 1 beat)
    //   2  = mínima
    //   4  = seminima (1 beat)
    //   8  = colcheia (1/2 beat)
    //   16 = semicolcheia (1/4 beat) — padrão
    //   32 = fusa
    //   6  = tercina de semínima (1/3 beat)
    //   12 = tercina de colcheia
    //   24 = tercina de semicolcheia
    in property <int> snap-denominator: 16;

    out property <length> black-key-width: root.keyboard-width - 20px;
}
