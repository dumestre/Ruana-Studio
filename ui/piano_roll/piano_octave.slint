import { Theme } from "../theme.slint";
import { PianoKey } from "piano_key.slint";

export component PianoOctave inherits Rectangle {

    in property <int> octave: 4;

    in property <length> key-height: 20px;

    in property <length> keyboard-width: 58px;
    in property <length> black-key-width: 38px;
    in property <int> last-note: 127;

    callback note-pressed(int);

    width: root.keyboard-width;
    height: 12 * root.key-height;

    background: Theme.base;

    function is-black(semitone: int) -> bool {
        semitone == 1
            || semitone == 3
            || semitone == 6
            || semitone == 8
            || semitone == 10
    }

    // ============================================================
    // TECLAS BRANCAS
    // ============================================================

    for semitone in [0, 2, 4, 5, 7, 9, 11]: PianoKey {

        visible: root.octave * 12 + semitone <= root.last-note;

        note: root.octave * 12 + semitone;

        background: Colors.whitesmoke;
        black: false;

        label:
            semitone == 0
                ? "C" + root.octave
                : "";

        x: 0px;

        y:
            (11 - semitone)
            * root.key-height;

        width: root.keyboard-width;
        height: root.key-height;

        pressed => {
            root.note-pressed(self.note);
        }
    }

    // ============================================================
    // BORDAS INFERIORES DAS TECLAS BRANCAS
    // ============================================================

    for semitone in [0, 2, 4, 5, 7, 9, 11]: Rectangle {

        visible: root.octave * 12 + semitone <= root.last-note;

        x: 0px;

        y:
            (11 - semitone)
            * root.key-height
            + root.key-height
            - 1px;

        width: root.keyboard-width;
        height: 1px;

        background: Theme.border;

        z: 5;
    }

    // ============================================================
    // TECLAS PRETAS
    // ============================================================

    for semitone in [1, 3, 6, 8, 10]: PianoKey {

        visible: root.octave * 12 + semitone <= root.last-note;

        note: root.octave * 12 + semitone;

        background: #333333;
        black: true;

        label: "";

        x: 0px;

        y:
            (11 - semitone)
            * root.key-height;

        width: root.black-key-width;
        height: root.key-height;

        pressed => {
            root.note-pressed(self.note);
        }
    }

    // ============================================================
    // BORDAS DAS TECLAS PRETAS (3 lados: superior, inferior, direita)
    // ============================================================

    for semitone in [1, 3, 6, 8, 10]: Rectangle {

        visible: root.octave * 12 + semitone <= root.last-note;

        x: 0px;
        y:
            (11 - semitone)
            * root.key-height;

        width: root.black-key-width;
        height: root.key-height;

        background: transparent;
        border-width: 1px;
        border-color: Theme.border;

        z: 10;
    }

    // ============================================================
    // BORDA DIREITA DO TECLADO (separação teclado x grid)
    // ============================================================

    Rectangle {
        x: root.keyboard-width - 1px;
        y: 0px;

        width: 1px;
        height: root.height;

        background: Theme.border;

        z: 20;
    }
}
