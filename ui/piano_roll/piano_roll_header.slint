import { Button } from "../components/button.slint";
import { Theme } from "../theme.slint";

export component PianoRollHeader inherits Rectangle {

    in property <string> title: "Piano Roll";
    in-out property <bool> floating: false;

    callback float-toggle();

    height: 26px;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;

        alignment: LayoutAlignment.space-between;
        cross-axis-alignment: CrossAxisAlignment.center;

        Text {
            text: root.title;

            color: Theme.text-primary;

            font-size: 10px;
            font-weight: 600;

            vertical-alignment: center;
        }

        Button {
            width: 22px;
            height: 20px;

            icon: @image-url("../icons/expand_diag.svg");
            icon-size: 12px;

            text: "";

            borderless: true;

            icon-color: Theme.text-dim;

            toggled: root.floating;
            toggled-icon-color: Theme.accent;

            transform-rotation:
                root.floating
                    ? 180deg
                    : 0deg;

            clicked => {
                root.float-toggle();
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;

        width: 100%;
        height: 1px;

        background: Theme.border;
    }
}