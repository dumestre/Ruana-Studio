import { Button } from "../components/button.slint";
import { Theme } from "../theme.slint";

export component PianoRollHeader inherits Rectangle {

    in property <string> title: "Piano Roll";
    in-out property <bool> floating: false;

    callback float-toggle();
    callback scale-assistant();

    height: 26px;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;

        alignment: LayoutAlignment.space-between;
        cross-axis-alignment: CrossAxisAlignment.center;

        Text {
            text: root.title;

            color: Theme.text-primary;

            font-size: 10px;
            font-weight: 600;

            vertical-alignment: center;
        }

        HorizontalLayout {
            spacing: 2px;

            // ========================================================
            // ESCALA
            // ========================================================

            Rectangle {
                width: 72px;
                height: 20px;

                background: transparent;

                TouchArea {
                    clicked => {
                        root.scale-assistant();
                    }

                    mouse-cursor: pointer;
                }

                HorizontalLayout {
                    spacing: 4px;

                    padding-left: 5px;
                    padding-right: 5px;

                    alignment: LayoutAlignment.center;
                    cross-axis-alignment: CrossAxisAlignment.center;

                    Image {
                        source: @image-url("../icons/scale.svg");

                        width: 12px;
                        height: 12px;
                        
                    }

                    Text {
                        text: "Escala";

                        // TEXTO CLARO
                        color: Theme.text-primary;

                        font-size: 9px;
                        font-weight: 600;

                        vertical-alignment: center;
                    }
                }
            }

            // ========================================================
            // EXPANDIR / FLUTUAR
            // ========================================================

            Button {
                width: 22px;
                height: 20px;

                icon: @image-url("../icons/expand_diag.svg");
                icon-size: 12px;

                text: "";

                borderless: true;

                icon-color: Theme.text-dim;

                toggled: root.floating;
                toggled-icon-color: Theme.accent;

                transform-rotation:
                    root.floating
                        ? 180deg
                        : 0deg;

                clicked => {
                    root.float-toggle();
                }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;

        width: 100%;
        height: 1px;

        background: Theme.border;
    }
}