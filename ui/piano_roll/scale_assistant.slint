import { Theme } from "../theme.slint";
import { Button } from "../components/button.slint";
import { ComboBox } from "std-widgets.slint";
import { ScaleCheckBox } from "../components/checkbox.slint";

export component ScaleAssistant inherits Rectangle {

    callback close();
    callback apply();

    // ============================================================
    // ESTADO E DADOS
    // ============================================================

    in-out property <string> root-note: "C";
    in-out property <string> scale: "Maior (Jônio)";

    in-out property <bool> snap-to-scale: false;
    in-out property <bool> highlight-notes: true;
    in-out property <bool> fold-piano-roll: false;

    in property <[string]> root-notes: [
        "C", "C# / Db", "D", "D# / Eb", "E", "F",
        "F# / Gb", "G", "G# / Ab", "A", "A# / Bb", "B"
    ];

    in property <[string]> scales: [
        "Maior (Jônio)",
        "Menor Natural (Eólio)",
        "Dórico",
        "Frígio",
        "Lídio",
        "Mixolídio",
        "Lócrio",
        "Menor Harmônica",
        "Menor Melódica",
        "Pentatônica Maior",
        "Pentatônica Menor",
        "Escala de Blues",
        "Tons Inteiros",
        "Diminuta",
        "Cromática"
    ];

    // ============================================================
    // DIMENSÕES
    // ============================================================

    width: 260px;
    height: 400px;

    background: Theme.surface;

    border-width: 1px;
    border-color: Theme.border;

    border-radius: 4px;

    // ============================================================
    // CABEÇALHO
    // ============================================================

    Rectangle {
        x: 0px;
        y: 0px;

        width: parent.width;
        height: 34px;

        background: Theme.surface-high;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;

            spacing: 8px;

            cross-axis-alignment: CrossAxisAlignment.center;

            // Barrinha verde
            Rectangle {
                width: 4px;
                height: 24px;

                background: Theme.accent;

                border-radius: 2px;
            }

            // Título
            Text {
                text: "ASSISTENTE DE ESCALA";

                color: Theme.text-primary;

                font-size: 14px;
                font-weight: 700;

                vertical-alignment: center;
            }

            // Espaçador
            Rectangle {
                horizontal-stretch: 1;
            }

            // Fechar
            Button {
                width: 24px;
                height: 24px;

                border-radius: 12px;

                icon: @image-url("../icons/close.svg");
                icon-size: 14px;
                icon-color: Theme.text-primary;

                clicked => {
                    root.close();
                }
            }
        }
    }

    // ============================================================
    // CONTEÚDO
    // ============================================================

    VerticalLayout {
        x: 12px;
        y: 46px;

        width: parent.width - 24px;

        alignment: LayoutAlignment.start;

        spacing: 16px;

        // ========================================================
        // TÔNICA + ESCALA
        // ========================================================

        VerticalLayout {
            spacing: 12px;

            // ----------------------------------------------------
            // TÔNICA
            // ----------------------------------------------------

            VerticalLayout {
                spacing: 4px;

                Text {
                    text: "Tônica";

                    color: Theme.text-dim;

                    font-size: 9px;
                    font-weight: 600;
                }

                ComboBox {
                    height: 28px;
                    width: parent.width;

                    model: root.root-notes;

                    current-value: root.root-note;

                    selected(value) => {
                        root.root-note = value;
                    }
                }
            }

            // ----------------------------------------------------
            // ESCALA
            // ----------------------------------------------------

            VerticalLayout {
                spacing: 4px;

                Text {
                    text: "Escala / Modo";

                    color: Theme.text-dim;

                    font-size: 9px;
                    font-weight: 600;
                }

                ComboBox {
                    height: 28px;
                    width: parent.width;

                    model: root.scales;

                    current-value: root.scale;

                    selected(value) => {
                        root.scale = value;
                    }
                }
            }
        }

        // ========================================================
        // OPÇÕES DO PIANO ROLL
        // ========================================================

        VerticalLayout {
            spacing: 8px;

            Text {
                text: "Comportamento da Grade";

                color: Theme.text-dim;

                font-size: 9px;
                font-weight: 600;
            }

            // ----------------------------------------------------
            // DESTACAR ESCALA
            // ----------------------------------------------------

            ScaleCheckBox {
                text: "Destacar notas na escala";

                checked: root.highlight-notes;

                toggled(value) => {
                    root.highlight-notes = value;
                }
            }

            // ----------------------------------------------------
            // SNAP TO SCALE
            // ----------------------------------------------------

            ScaleCheckBox {
                text: "Snap to Scale (Ajustar notas)";

                checked: root.snap-to-scale;

                toggled(value) => {
                    root.snap-to-scale = value;
                }
            }

            // ----------------------------------------------------
            // FOLD
            // ----------------------------------------------------

            ScaleCheckBox {
                text: "Fold (Ocultar teclas fora da escala)";

                checked: root.fold-piano-roll;

                toggled(value) => {
                    root.fold-piano-roll = value;
                }
            }
        }
    }

    // ============================================================
    // BOTÕES
    // ============================================================

    HorizontalLayout {
        x: 12px;
        y: parent.height - 36px;

        width: parent.width - 24px;

        spacing: 6px;

        alignment: LayoutAlignment.end;

        cross-axis-alignment: CrossAxisAlignment.stretch;

        // --------------------------------------------------------
        // CANCELAR
        // --------------------------------------------------------

        Button {
            width: 70px;
            height: 24px;

            text: "Cancelar";

            borderless: true;

            clicked => {
                root.close();
            }
        }

        // --------------------------------------------------------
        // APLICAR
        // --------------------------------------------------------

        Button {
            width: 70px;
            height: 24px;

            text: "Aplicar";

            toggled: true;

            clicked => {
                root.apply();
            }
        }
    }
}