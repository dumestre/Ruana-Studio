import { Theme } from "../theme.slint";
import { Button } from "../components/button.slint";
import { PianoRollData, PianoRollActions } from "piano_roll_state.slint";
import { LineEdit } from "std-widgets.slint";

export component PianoNoteProperties inherits Rectangle {

    callback note-start-changed(int, float);
    callback note-length-changed(int, float);

    width: 240px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    // Estado raiz
    property <int> current-id: PianoRollData.selected-note;
    property <int> sel-count: PianoRollData.selected-notes.length;
    property <bool> multi-selected: root.sel-count > 1;

    function note-name-from-midi(midi: int) -> string {
        let names: [string] = [
            "C", "C#", "D", "D#", "E", "F",
            "F#", "G", "G#", "A", "A#", "B"
        ];
        let octave: int = Math.floor(midi / 12) - 1;
        let semitone: int = midi - (octave + 1) * 12;
        let safe: int = Math.max(0, Math.min(11, semitone));
        names[safe] + octave.to-fixed(0)
    }

    // ============================================================
    // CABEÇALHO
    // ============================================================

    Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: 30px;
        background: Theme.surface-high;

        Rectangle {
            x: 0; y: 0;
            width: 4px; height: parent.height;
            background: Theme.accent;
        }

        Text {
            x: 14px; y: 0;
            width: parent.width - 20px; height: parent.height;
            text: "PROPRIEDADES DA NOTA";
            color: Theme.text-primary;
            font-size: 10px; font-weight: 800;
            vertical-alignment: center;
        }

        Rectangle {
            x: 0; y: parent.height - 1px;
            width: parent.width; height: 1px;
            background: Theme.border;
        }
    }

    // ============================================================
    // CASO 1: Nenhuma nota selecionada
    // ============================================================

    if !root.multi-selected && root.current-id < 0: Rectangle {
        x: 12px; y: 54px;
        width: parent.width - 24px; height: 200px;
        background: Theme.surface;

        Text {
            x: 0; y: 0;
            width: parent.width; height: 32px;
            text: "Nenhuma nota selecionada.";
            color: Theme.text-dim;
            font-size: 10px; font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            x: 0; y: 36px;
            width: parent.width; height: 80px;
            text:
                "Clique em uma nota no grid para selecionar.\n"
                + "Shift + arrasto = selecionar várias notas.";
            color: Theme.text-dim;
            font-size: 9px; font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: top;
            wrap: word-wrap;
        }
    }

    // ============================================================
    // CASO 2: Múltiplas notas selecionadas
    // ============================================================

    if root.multi-selected: Rectangle {
        x: 12px; y: 54px;
        width: parent.width - 24px; height: 220px;
        background: Theme.surface;

        Rectangle {
            x: 0; y: 0;
            width: parent.width; height: 56px;
            background: Theme.surface-high;
            border-radius: 4px;

            Text {
                x: 14px; y: 0;
                width: 80px; height: parent.height;
                text: root.sel-count.to-fixed(0);
                color: Theme.accent;
                font-size: 24px; font-weight: 800;
                vertical-alignment: center;
                horizontal-alignment: left;
            }

            Text {
                x: 92px; y: 14px;
                width: parent.width - 104px; height: 28px;
                text: "notas selecionadas.";
                color: Theme.text-dim;
                font-size: 10px; font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: left;
            }
        }

        Button {
            x: 0; y: 76px;
            width: 100%; height: 30px;
            text: "Excluir " + root.sel-count.to-fixed(0) + " notas";

            clicked => {
                PianoRollActions.delete-selection-requested();
            }
        }
    }

    // ============================================================
    // CASO 3: Nota ÚNICA selecionada
    // Conteúdo renderiza DENTRO do for-loop (filtrado por id)
    // para ter acesso DIRETO aos campos n.note / n.start etc.
    // ============================================================

    for n in PianoRollData.notes: VerticalLayout {
        visible: n.id == root.current-id;
        x: 12px; y: 42px;
        width: parent.width - 24px;
        spacing: 14px;

        // --- Badge com o nome da nota ---
        Rectangle {
            height: 56px;
            background: Theme.surface-high;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;

            Text {
                x: 14px; y: 0;
                width: 90px; height: parent.height;
                text: root.note-name-from-midi(n.note);
                color: Theme.accent;
                font-size: 24px; font-weight: 800;
                vertical-alignment: center;
                horizontal-alignment: left;
            }

            VerticalLayout {
                x: 104px; y: 0;
                width: parent.width - 118px; height: parent.height;
                spacing: 0;

                Text {
                    height: 18px;
                    text: "MIDI " + n.note.to-fixed(0);
                    color: Theme.text-dim;
                    font-size: 9px; font-weight: 600;
                    vertical-alignment: bottom;
                }
                Text {
                    height: 22px;
                    text:
                        "Tecla "
                        + (PianoRollData.last-note - n.note + 1).to-fixed(0)
                        + " / "
                        + (PianoRollData.last-note - PianoRollData.first-note + 1).to-fixed(0);
                    color: Theme.text-primary;
                    font-size: 9px; font-weight: 600;
                    vertical-alignment: top;
                }
            }
        }

        // --- START ---
        VerticalLayout {
            spacing: 4px;
            Text {
                text: "Início (compasso.beat.sub)";
                color: Theme.text-dim;
                font-size: 9px; font-weight: 700;
            }
            Rectangle {
                height: 26px;
                background: Theme.base;
                border-width: 1px; border-color: Theme.border;
                border-radius: 3px;

                TextInput {
                    x: 6px; y: 0;
                    width: parent.width - 12px;
                    height: parent.height;
                    color: Theme.text-primary;
                    font-size: 10px;
                    text:
                        (1 + Math.floor(n.start / 4.0)).to-fixed(0)
                        + "."
                        + (1 + Math.floor(Math.mod(n.start, 4.0))).to-fixed(0)
                        + "."
                        + Math.round(Math.mod(n.start, 1.0) * 16.0).to-fixed(0);
                }
            }
        }

        // --- LENGTH ---
        VerticalLayout {
            spacing: 4px;
            Text {
                text: "Duração (beats)";
                color: Theme.text-dim;
                font-size: 9px; font-weight: 700;
            }
            Rectangle {
                height: 26px;
                background: Theme.base;
                border-width: 1px; border-color: Theme.border;
                border-radius: 3px;

                TextInput {
                    x: 6px; y: 0;
                    width: parent.width - 12px;
                    height: parent.height;
                    color: Theme.text-primary;
                    font-size: 10px;
                    text: n.length.to-fixed(3);
                }
            }
        }

        // --- VELOCIDADE ---
        VerticalLayout {
            spacing: 4px;

            HorizontalLayout {
                height: 14px;
                Text {
                    text: "Velocidade (0–127)";
                    color: Theme.text-dim;
                    font-size: 9px; font-weight: 700;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: n.velocity.to-fixed(0);
                    color: Theme.accent;
                    font-size: 10px; font-weight: 800;
                }
            }

            Rectangle {
                height: 26px;
                background: Theme.base;
                border-width: 1px; border-color: Theme.border;
                border-radius: 3px;

                Rectangle {
                    x: 2px; y: 2px;
                    width:
                        (n.velocity / 127.0) * (parent.width - 4px);
                    height: parent.height - 4px;
                    background:
                        n.velocity >= 96
                            ? Theme.ok.brighter(0.1)
                            : n.velocity >= 64
                                ? Theme.ok
                                : Theme.ok.darker(0.25);
                    border-radius: 2px;
                }

                TouchArea {
                    x: 0; y: 0;
                    width: parent.width; height: parent.height;
                    mouse-cursor: ew-resize;

                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down
                            && event.button == PointerEventButton.left {

                            self.editing = true;
                            let ratio: float =
                                Math.max(0px,
                                    Math.min(parent.width, self.mouse-x)
                                ) / parent.width;
                            PianoRollActions.note-velocity-changed(
                                root.current-id,
                                Math.max(0, Math.min(127,
                                    Math.round(ratio * 127.0)
                                ))
                            );

                        } else if event.kind == PointerEventKind.move
                            && self.editing {

                            let ratio: float =
                                Math.max(0px,
                                    Math.min(parent.width, self.mouse-x)
                                ) / parent.width;
                            PianoRollActions.note-velocity-changed(
                                root.current-id,
                                Math.max(0, Math.min(127,
                                    Math.round(ratio * 127.0)
                                ))
                            );

                        } else if event.kind == PointerEventKind.up {
                            self.editing = false;
                        }
                    }

                    private property <bool> editing: false;
                }
            }
        }

        // --- Ações ---
        HorizontalLayout {
            spacing: 6px;
            alignment: LayoutAlignment.end;

            Button {
                height: 26px; horizontal-stretch: 1;
                text: "Excluir";

                clicked => {
                    PianoRollActions.note-deleted(root.current-id);
                }
            }
        }
    }
}
