export struct PianoNote {
    id: int,
    note: int,
    start: float,
    length: float,
    velocity: int
}

export struct RulerTick {
    bar: int,
    pos: float,
    level: int
}

export global PianoRollData {
    in-out property <[PianoNote]> notes: [];
    in-out property <int> selected-note: -1;
    in-out property <[int]> selected-notes: [];
    in-out property <int> first-note: 0;
    in-out property <int> last-note: 127;
    in-out property <[int]> note-lines: [];
    in-out property <[int]> beat-lines: [];
    in-out property <[int]> octave-range: [];
    in-out property <[int]> bar-range: [];
    in-out property <[RulerTick]> ruler-ticks: [];

    // PPQ (pulses per quarter note) para cálculo do playhead.
    // 960 ppq = padrão da maioria das DAWs modernas.
    in-out property <int> ppq: 960;

    // Posição atual do playhead em pulses (PPQ).
    // 960 = 1 beat. 960 * 4 = 1 compasso (4/4).
    in-out property <int> position: 0;
}

export global PianoRollActions {
    callback note-added(int, float, float, int);
    callback note-moved(int, float);
    callback note-resized(int, float);
    callback note-deleted(int);
    callback note-selected(int);
    callback note-previewed(int);
    callback note-velocity-changed(int, int);
    callback notes-selection-changed([int]);
    callback quantize-requested(int);
    callback delete-selection-requested();
    callback lasso-selection-requested(float, float, float, float, float, float, int);
}
