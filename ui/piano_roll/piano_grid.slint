import { Theme } from "../theme.slint";
import { PianoRollData } from "piano_roll_state.slint";

export component PianoGrid inherits Rectangle {

    // ============================================================
    // MÉTRICAS
    // ============================================================

    in property <length> beat-width: 80px;

    in property <length> key-height: 20px;

    // ============================================================
    // DIMENSÕES DO GRID
    // ============================================================

    property <length> content-width:
        root.beat-width
        * PianoRollData.bar-range.length
        * 4;

    property <length> content-height:
        root.key-height
        * PianoRollData.note-lines.length;

    width: root.content-width;
    height: root.content-height;

    background: Theme.base;

    // ============================================================
    // LINHAS HORIZONTAIS — UMA POR NOTA (topo da célula)
    // ============================================================

    for note in PianoRollData.note-lines: Rectangle {

        y:
            (
                PianoRollData.last-note
                - note
            )
            * root.key-height;

        width: parent.width;

        height: 1px;

        background:
            Math.mod(
                PianoRollData.last-note - note,
                12
            ) == 0
                ? Theme.border
                : Theme.grid-line;

        z: 0;
    }

    // ============================================================
    // LINHA HORIZONTAL FINAL (base da última nota = mais grave)
    // ============================================================

    Rectangle {
        y: root.content-height - 1px;

        width: parent.width;
        height: 1px;

        background: Theme.border;

        z: 0;
    }

    // ============================================================
    // LINHAS VERTICAIS
    // ============================================================

    for beat in PianoRollData.beat-lines: Rectangle {

        x: beat * root.beat-width / 4;

        width: 1px;

        height: parent.height;

        background:
            Math.mod(beat, 16) == 0
                ? Theme.border
                : Math.mod(beat, 4) == 0
                    ? Theme.grid-line
                    : Theme.grid-sub;

        z: 1;
    }

    // ============================================================
    // LINHA VERTICAL FINAL (extrema direita do grid)
    // ============================================================

    Rectangle {
        x: root.content-width - 1px;

        width: 1px;
        height: parent.height;

        background: Theme.border;

        z: 1;
    }
}
