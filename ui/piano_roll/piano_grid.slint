import { Theme } from "../theme.slint";
import { PianoRollData } from "piano_roll_state.slint";

export component PianoGrid inherits Rectangle {

    // ============================================================
    // MÉTRICAS
    // ============================================================

    in property <length> beat-width: 80px;

    in property <length> key-height: 20px;
    in property <string> scale-root: "C";
    in property <string> scale-name: "Maior (Jônio)";
    in property <bool> highlight-scale: false;

    function root-pitch() -> int {
        root.scale-root == "C" ? 0
        : root.scale-root == "C# / Db" ? 1
        : root.scale-root == "D" ? 2
        : root.scale-root == "D# / Eb" ? 3
        : root.scale-root == "E" ? 4
        : root.scale-root == "F" ? 5
        : root.scale-root == "F# / Gb" ? 6
        : root.scale-root == "G" ? 7
        : root.scale-root == "G# / Ab" ? 8
        : root.scale-root == "A" ? 9
        : root.scale-root == "A# / Bb" ? 10 : 11;
    }

    function is-scale-note(note: int) -> bool {
        let p = Math.mod(note - root.root-pitch() + 120, 12);
        root.scale-name == "Cromática" ? true
        : root.scale-name == "Pentatônica Maior" ? (p == 0 || p == 2 || p == 4 || p == 7 || p == 9)
        : root.scale-name == "Pentatônica Menor" ? (p == 0 || p == 3 || p == 5 || p == 7 || p == 10)
        : root.scale-name == "Escala de Blues" ? (p == 0 || p == 3 || p == 5 || p == 6 || p == 7 || p == 10)
        : root.scale-name == "Menor Natural (Eólio)" ? (p == 0 || p == 2 || p == 3 || p == 5 || p == 7 || p == 8 || p == 10)
        : root.scale-name == "Dórico" ? (p == 0 || p == 2 || p == 3 || p == 5 || p == 7 || p == 9 || p == 10)
        : root.scale-name == "Frígio" ? (p == 0 || p == 1 || p == 3 || p == 5 || p == 7 || p == 8 || p == 10)
        : root.scale-name == "Lídio" ? (p == 0 || p == 2 || p == 4 || p == 6 || p == 7 || p == 9 || p == 11)
        : root.scale-name == "Mixolídio" ? (p == 0 || p == 2 || p == 4 || p == 5 || p == 7 || p == 9 || p == 10)
        : root.scale-name == "Lócrio" ? (p == 0 || p == 1 || p == 3 || p == 5 || p == 6 || p == 8 || p == 10)
        : root.scale-name == "Menor Harmônica" ? (p == 0 || p == 2 || p == 3 || p == 5 || p == 7 || p == 8 || p == 11)
        : root.scale-name == "Menor Melódica" ? (p == 0 || p == 2 || p == 3 || p == 5 || p == 7 || p == 9 || p == 11)
        : (p == 0 || p == 2 || p == 4 || p == 5 || p == 7 || p == 9 || p == 11);
    }

    // ============================================================
    // DIMENSÕES DO GRID
    // ============================================================

    property <length> content-width:
        root.beat-width
        * PianoRollData.bar-range.length
        * 4;

    property <length> content-height:
        root.key-height
        * PianoRollData.note-lines.length;

    width: root.content-width;
    height: root.content-height;

    background: Theme.base;

    // ============================================================
    // FUNDO (TECLAS PRETAS/BRANCAS) E LINHAS HORIZONTAIS
    // ============================================================

    for note in PianoRollData.note-lines: Rectangle {
        
        // Posiciona a linha inteira da nota
        y: (PianoRollData.last-note - note) * root.key-height;
        width: parent.width;
        height: root.key-height; 
        z: 0;

        // Lógica de piano: Descobre qual nota é na oitava (0 a 11)
        property <int> nota-na-oitava: Math.mod(note, 12);
        
        // 1(C#), 3(D#), 6(F#), 8(G#), 10(A#) são as teclas pretas do piano
        property <bool> is-tecla-preta: 
            nota-na-oitava == 1 || nota-na-oitava == 3 || 
            nota-na-oitava == 6 || nota-na-oitava == 8 || nota-na-oitava == 10;

        // Pinta o fundo da linha com surface se for tecla preta, transparente se for branca
        background: is-tecla-preta ? Theme.surface : Theme.base;
        opacity: root.highlight-scale && !root.is-scale-note(note) ? 0.42 : 1.0;

        // Borda superior da linha (aquela que antes era o retângulo principal)
        Rectangle {
            y: 0; 
            width: parent.width;
            height: 1px;
            
            background: Math.mod(PianoRollData.last-note - note, 12) == 0 
                        ? Theme.border 
                        : Theme.grid-line;
        }
    }

    // ============================================================
    // LINHA HORIZONTAL FINAL (base da última nota = mais grave)
    // ============================================================

    Rectangle {
        y: root.content-height - 1px;

        width: parent.width;
        height: 1px;

        background: Theme.border;

        z: 0;
    }

    // ============================================================
    // LINHAS VERTICAIS
    // ============================================================

    for beat in PianoRollData.beat-lines: Rectangle {

        x: beat * root.beat-width / 4;

        width: 1px;

        height: parent.height;

        background:
            Math.mod(beat, 16) == 0
                ? Theme.border
                : Math.mod(beat, 4) == 0
                    ? Theme.grid-line
                    : Theme.grid-sub;

        z: 1;
    }

    // ============================================================
    // LINHA VERTICAL FINAL (extrema direita do grid)
    // ============================================================

    Rectangle {
        x: root.content-width - 1px;

        width: 1px;
        height: parent.height;

        background: Theme.border;

        z: 1;
    }
}
