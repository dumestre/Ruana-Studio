import { Theme } from "../theme.slint";
import { PianoRollData } from "piano_roll_state.slint";

export component PianoGrid inherits Rectangle {

    in property <length> beat-width: 80px;
    in property <length> key-height: 20px;

    property <length> content-width:
        root.beat-width * PianoRollData.bar-range.length * 4;

    property <length> content-height:
        root.key-height * PianoRollData.note-lines.length;

    width: root.content-width;
    height: root.content-height;
    horizontal-stretch: 1;

    background: Theme.base;

    // Linhas horizontais (uma por nota, índices vindos do Rust).
    // Células de nota "C" mais fortes para orientação visual.
    for i in PianoRollData.note-lines: Rectangle {
        y: i * root.key-height;

        width: parent.width;
        height: 1px;

        background:
            Math.mod(PianoRollData.last-note - i, 12) == 0
                ? Theme.border
                : Theme.grid-line;
    }

    // Linhas verticais (uma por semicolcheia, vindas do Rust):
    // compasso forte, tempo médio, subdivisão fraca.
    for beat in PianoRollData.beat-lines: Rectangle {
        x: beat * root.beat-width / 4;

        width: 1px;
        height: parent.height;

        background:
            Math.mod(beat, 16) == 0
                ? Theme.border
                : Math.mod(beat, 4) == 0
                    ? Theme.grid-line
                    : Theme.grid-sub;
    }
}
