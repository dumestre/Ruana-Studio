import { Theme } from "../theme.slint";
import { PianoRollData } from "piano_roll_state.slint";

export component PianoGrid inherits Rectangle {

    // ============================================================
    // MÉTRICAS
    // ============================================================

    in property <length> beat-width: 80px;

    in property <length> key-height: 20px;

    // ============================================================
    // DIMENSÕES DO GRID
    // ============================================================

    property <length> content-width:
        root.beat-width
        * PianoRollData.bar-range.length
        * 4;

    property <length> content-height:
        root.key-height
        * PianoRollData.note-lines.length;

    width: root.content-width;
    height: root.content-height;

    background: Theme.base;

    // ============================================================
    // FUNDO (TECLAS PRETAS/BRANCAS) E LINHAS HORIZONTAIS
    // ============================================================

    for note in PianoRollData.note-lines: Rectangle {
        
        // Posiciona a linha inteira da nota
        y: (PianoRollData.last-note - note) * root.key-height;
        width: parent.width;
        height: root.key-height; 
        z: 0;

        // Lógica de piano: Descobre qual nota é na oitava (0 a 11)
        property <int> nota-na-oitava: Math.mod(note, 12);
        
        // 1(C#), 3(D#), 6(F#), 8(G#), 10(A#) são as teclas pretas do piano
        property <bool> is-tecla-preta: 
            nota-na-oitava == 1 || nota-na-oitava == 3 || 
            nota-na-oitava == 6 || nota-na-oitava == 8 || nota-na-oitava == 10;

        // Pinta o fundo da linha com surface se for tecla preta, transparente se for branca
        background: is-tecla-preta ? Theme.surface : transparent;

        // Borda superior da linha (aquela que antes era o retângulo principal)
        Rectangle {
            y: 0; 
            width: parent.width;
            height: 1px;
            
            background: Math.mod(PianoRollData.last-note - note, 12) == 0 
                        ? Theme.border 
                        : Theme.grid-line;
        }
    }

    // ============================================================
    // LINHA HORIZONTAL FINAL (base da última nota = mais grave)
    // ============================================================

    Rectangle {
        y: root.content-height - 1px;

        width: parent.width;
        height: 1px;

        background: Theme.border;

        z: 0;
    }

    // ============================================================
    // LINHAS VERTICAIS
    // ============================================================

    for beat in PianoRollData.beat-lines: Rectangle {

        x: beat * root.beat-width / 4;

        width: 1px;

        height: parent.height;

        background:
            Math.mod(beat, 16) == 0
                ? Theme.border
                : Math.mod(beat, 4) == 0
                    ? Theme.grid-line
                    : Theme.grid-sub;

        z: 1;
    }

    // ============================================================
    // LINHA VERTICAL FINAL (extrema direita do grid)
    // ============================================================

    Rectangle {
        x: root.content-width - 1px;

        width: 1px;
        height: parent.height;

        background: Theme.border;

        z: 1;
    }
}