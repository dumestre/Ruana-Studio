import { Theme } from "../theme.slint";
import { PianoRollHeader } from "piano_roll_header.slint";
import { PianoKeyboard } from "piano_keyboard.slint";
import { PianoRuler } from "piano_ruler.slint";
import { PianoGrid } from "piano_grid.slint";

export component PianoRollArea inherits Rectangle {

    // =====================================================
    // ESTADO
    // =====================================================

    in-out property <bool> floating: false;
    in property <bool> show-header: true;

    callback float-toggle();


    // =====================================================
    // MIDI
    // =====================================================

    property <int> first-note: 0;
    property <int> last-note: 127;


    // =====================================================
    // CONFIGURAÇÃO
    // =====================================================

    property <length> key-height: 20px;

    property <length> keyboard-width: 58px;

    property <length> beat-width: 80px;

    property <length> ruler-height: 26px;


    background: Theme.base;


    // =====================================================
    // LAYOUT PRINCIPAL
    // =====================================================

    VerticalLayout {

        spacing: 0;

        alignment: LayoutAlignment.stretch;
        cross-axis-alignment: CrossAxisAlignment.stretch;


        // =================================================
        // HEADER
        // =================================================

        if root.show-header: PianoRollHeader {

            title: "Piano Roll";

            floating <=> root.floating;

            float-toggle => {
                root.float-toggle();
            }
        }


        // =================================================
        // EDITOR
        // =================================================

        HorizontalLayout {

            spacing: 0;

            horizontal-stretch: 1;
            vertical-stretch: 1;


            // =============================================
            // COLUNA DO TECLADO
            // =============================================

            VerticalLayout {

                spacing: 0;

                width: root.keyboard-width;

                horizontal-stretch: 0;
                vertical-stretch: 1;


                // =========================================
                // ESPAÇO CORRESPONDENTE À RÉGUA
                // =========================================

                Rectangle {

                    width: root.keyboard-width;
                    height: root.ruler-height;

                    background: Theme.surface;

                    Rectangle {
                        y: parent.height - 1px;

                        width: parent.width;
                        height: 1px;

                        background: Theme.border;
                    }
                }


                // =========================================
                // TECLADO
                // =========================================

                PianoKeyboard {

                    width: root.keyboard-width;

                    first-note: root.first-note;
                    last-note: root.last-note;

                    key-height: root.key-height;

                    vertical-stretch: 1;
                }
            }


            // =============================================
            // ÁREA MUSICAL
            // =============================================

            VerticalLayout {

                spacing: 0;

                horizontal-stretch: 1;
                vertical-stretch: 1;


                // =========================================
                // RÉGUA
                // =========================================

                PianoRuler {

                    height: root.ruler-height;

                    px-per-bar:
                        root.beat-width * 4;
                }


                // =========================================
                // GRID
                // =========================================

                Rectangle {

                    clip: true;

                    horizontal-stretch: 1;
                    vertical-stretch: 1;


                    PianoGrid {

                        beat-width: root.beat-width;

                        key-height: root.key-height;

                        first-note: root.first-note;
                        last-note: root.last-note;
                    }
                }
            }
        }
    }
}