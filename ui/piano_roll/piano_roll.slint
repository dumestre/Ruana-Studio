import { Theme } from "../theme.slint";
import { PianoRollHeader } from "piano_roll_header.slint";
import { PianoKeyboard } from "piano_keyboard.slint";
import { PianoRuler } from "piano_ruler.slint";
import { PianoGrid } from "piano_grid.slint";
import { PianoNoteView } from "piano_note_view.slint";
import { PianoRollConfig } from "piano_roll_config.slint";
import { PianoRollData, PianoRollActions } from "piano_roll_state.slint";

export component PianoRollArea inherits Rectangle {

    in-out property <bool> floating: false;
    in property <bool> show-header: true;

    callback float-toggle();

    config := PianoRollConfig {}

    property <length> px-per-beat: config.beat-width;
    property <length> note-height: config.key-height;
    property <length> scroll-x: 0px;
    property <length> scroll-y: 0px;

    property <length> world-width:
        root.px-per-beat * 4 * PianoRollData.bar-range.length;
    property <length> world-height:
        root.note-height * (PianoRollData.last-note - PianoRollData.first-note + 1);

    background: Theme.base;

    VerticalLayout {
        spacing: 0;

        if root.show-header: PianoRollHeader {
            title: "Piano Roll";

            floating <=> root.floating;

            float-toggle => {
                root.float-toggle();
            }
        }

        HorizontalLayout {
            spacing: 0;

            // ========================================================
            // TECLADO
            // ========================================================

            VerticalLayout {
                width: config.keyboard-width;
                spacing: 0;

                // Espaço acima das teclas (alinhado com a régua)
                Rectangle {
                    width: config.keyboard-width;
                    height: config.ruler-height;

                    background: Theme.surface;

                    // Borda inferior — alinhada com a borda inferior da régua
                    Rectangle {
                        x: 0;
                        y: parent.height - 1px;

                        width: parent.width;
                        height: 1px;

                        background: Theme.border;

                        z: 10;
                    }

                    // Borda direita — alinhada com a borda vertical da régua e do grid
                    Rectangle {
                        x: parent.width - 1px;
                        y: 0;

                        width: 1px;
                        height: parent.height;

                        background: Theme.border;

                        z: 10;
                    }
                }

                PianoKeyboard {
                    width: config.keyboard-width;

                    key-height: root.note-height;
                    keyboard-width: config.keyboard-width;
                    black-key-width: config.black-key-width;

                    scroll-y: root.scroll-y;

                    vertical-stretch: 1;

                    note-pressed(note) => {
                        PianoRollActions.note-previewed(note);
                    }
                }
            }

            // ========================================================
            // ÁREA MUSICAL
            // ========================================================

            VerticalLayout {
                spacing: 0;
                horizontal-stretch: 1;
                vertical-stretch: 1;

                // ----------------------------------------------------
                // RÉGUA
                // ----------------------------------------------------

                PianoRuler {
                    height: config.ruler-height;

                    ruler-height: config.ruler-height;

                    px-per-bar: root.px-per-beat * 4;

                    scroll-x: root.scroll-x;
                }

                // ----------------------------------------------------
                // VIEWPORT
                // ----------------------------------------------------

                Rectangle {
                    clip: true;

                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    background: Theme.base;

                    // Borda superior (entre régua e viewport)
                    Rectangle {
                        x: 0;
                        y: 0;

                        width: parent.width;
                        height: 1px;

                        background: Theme.border;

                        z: 50;
                    }

                    // =================================================
                    // INTERAÇÃO
                    // =================================================

                    interaction := TouchArea {
                        x: 0;
                        y: 0;

                        width: parent.width;
                        height: parent.height;

                        mouse-cursor: crosshair;

                        pointer-event(event) => {

                            if event.kind == PointerEventKind.down
                                && event.button == PointerEventButton.left {

                                self.painting = true;

                                root.paint-note = -1;
                                root.paint-start = -1.0;

                                root.paint-add();

                            } else if event.kind == PointerEventKind.move
                                && self.painting {

                                root.paint-add();

                            } else if event.kind == PointerEventKind.up {

                                self.painting = false;
                            }
                        }

                        scroll-event(event) => {

                            if event.modifiers.control {

                                root.px-per-beat =
                                    Math.max(
                                        24px,
                                        Math.min(
                                            320px,
                                            root.px-per-beat *
                                            (event.delta-y > 0 ? 0.9 : 1.1)
                                        )
                                    );

                                root.note-height =
                                    Math.max(
                                        12px,
                                        Math.min(
                                            40px,
                                            root.note-height *
                                            (event.delta-y > 0 ? 0.9 : 1.1)
                                        )
                                    );

                            } else if event.modifiers.shift {

                                root.scroll-x =
                                    Math.max(
                                        0px,
                                        root.scroll-x + event.delta-x
                                    );

                            } else {

                                root.scroll-y =
                                    Math.max(
                                        0px,
                                        root.scroll-y + event.delta-y
                                    );
                            }

                            accept
                        }

                        private property <bool> painting: false;
                    }

                    // =================================================
                    // MUNDO (grid + notas) com dimensões explícitas
                    // =================================================

                    Rectangle {
                        x: -root.scroll-x;
                        y: -root.scroll-y;

                        width: root.world-width;
                        height: root.world-height;

                        PianoGrid {
                            beat-width: root.px-per-beat;
                            key-height: root.note-height;
                        }

                        for note in PianoRollData.notes: PianoNoteView {

                            note-id: note.id;
                            note: note.note;
                            start: note.start;
                            length: note.length;
                            velocity: note.velocity;

                            px-per-beat: root.px-per-beat;
                            key-height: root.note-height;

                            viewport-scroll(dx, dy) => {
                                root.scroll-x =
                                    Math.max(
                                        0px,
                                        root.scroll-x + dx
                                    );

                                root.scroll-y =
                                    Math.max(
                                        0px,
                                        root.scroll-y + dy
                                    );
                            }

                            viewport-zoom(f) => {

                                root.px-per-beat =
                                    Math.max(
                                        24px,
                                        Math.min(
                                            320px,
                                            root.px-per-beat * f
                                        )
                                    );

                                root.note-height =
                                    Math.max(
                                        12px,
                                        Math.min(
                                            40px,
                                            root.note-height * f
                                        )
                                    );
                            }
                        }
                    }
                }
            }
        }
    }

    // ================================================================
    // CRIAÇÃO DE NOTAS
    // ================================================================

    function paint-add() {

        let mx =
            interaction.mouse-x
            + root.scroll-x;

        let my =
            interaction.mouse-y
            + root.scroll-y;

        let note =
            Math.max(
                PianoRollData.first-note,
                Math.min(
                    PianoRollData.last-note,
                    PianoRollData.last-note
                        - Math.floor(
                            my / root.note-height
                        )
                )
            );

        let start =
            Math.max(
                0.0,
                Math.round(
                    (mx / root.px-per-beat) * 4.0
                ) / 4.0
            );

        if note != self.paint-note
            || start != self.paint-start {

            self.paint-note = note;
            self.paint-start = start;

            PianoRollActions.note-added(
                note,
                start,
                1.0,
                100
            );
        }
    }

    private property <int> paint-note: 0;
    private property <float> paint-start: 0.0;
}
