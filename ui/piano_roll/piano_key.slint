import { Theme } from "../theme.slint";

export component PianoKey inherits Rectangle {

    in property <int> note: 60;
    in property <bool> black: false;
    in property <string> label: "";

    callback pressed();

    private property <bool> hovered: touch.has-hover;
    private property <bool> down: touch.pressed;

    background:
        root.black
            ? Theme.base.darker(
                root.down ? 0.28 : root.hovered ? 0.12 : 0.0
            )
            : Theme.text-primary.brighter(
                root.down ? 0.15 : root.hovered ? 0.06 : 0.0
            );

    touch := TouchArea {
        mouse-cursor: pointer;

        clicked => {
            root.pressed();
        }
    }

    // Nome da nota — somente nas teclas C
    Text {
        visible: !root.black && root.label != "";

        x: 4px;
        y: 0px;

        width: parent.width - 4px;
        height: parent.height;

        text: root.label;

        color: Theme.text-dim;
        font-size: 8px;
        font-weight: 600;

        vertical-alignment: center;
        horizontal-alignment: left;
    }
}