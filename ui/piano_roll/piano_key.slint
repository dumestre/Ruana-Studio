import { Theme } from "../theme.slint";

export component PianoKey inherits Rectangle {

    in property <int> note: 60;
    in property <bool> black: false;
    in property <string> label: "";

    callback pressed();

    private property <bool> hovered: touch.has-hover;
    private property <bool> down: touch.pressed;

    background:
        root.black
            ? Theme.surface-high.darker(
                root.down ? 0.22 : root.hovered ? 0.08 : 0.0
            )
            : Theme.surface-high.brighter(
                root.down ? 0.10 : root.hovered ? 0.04 : 0.0
            );

    touch := TouchArea {
        mouse-cursor: pointer;

        clicked => {
            root.pressed();
        }
    }

    // Nome da nota — somente nas teclas C
    Text {
        visible: !root.black && root.label != "";

        x: 4px;
        y: 0px;

        width: parent.width - 4px;
        height: parent.height;

        text: root.label;

        color: Theme.text-dim;
        font-size: 8px;
        font-weight: 600;

        vertical-alignment: center;
        horizontal-alignment: left;
    }
}
