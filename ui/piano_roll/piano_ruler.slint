import { Theme } from "../theme.slint";
import { PianoRollData } from "piano_roll_state.slint";

export component PianoRuler inherits Rectangle {

    in property <length> px-per-bar: 160px;
    in property <length> ruler-height: 24px;
    in property <length> scroll-x: 0px;

    height: root.ruler-height;

    background: Theme.surface;

    Rectangle {
        width: parent.width;
        height: parent.height;

        clip: true;

        // Fundo alternado por compasso
        for i in PianoRollData.bar-range: Rectangle {
            x: i * root.px-per-bar - root.scroll-x;
            y: 0;

            width: root.px-per-bar;
            height: parent.height;

            background:
                Math.mod(i, 2) == 1
                    ? Theme.base
                    : Theme.surface;
        }

        // Borda inferior da régua (separação com a viewport abaixo)
        Rectangle {
            x: 0;
            y: parent.height - 1px;

            width: parent.width;
            height: 1px;

            background: Theme.is-paper ? Theme.base : Theme.border;

            z: 30;
        }

        // Linhas dos compassos
        for i in PianoRollData.bar-range: Rectangle {
            x: i * root.px-per-bar - root.scroll-x;
            y: 0;

            width: 1px;
            height: parent.height - 1px;

            background:
                Math.mod(i, 2) == 1
                    ? (Theme.is-paper ? Theme.base : Theme.border)
                    : (Theme.is-paper ? Theme.base : Theme.border).transparentize(0.45);
        }

        // Número dos compassos
        for i in PianoRollData.bar-range: Text {
            x: i * root.px-per-bar + 6px - root.scroll-x;
            y: 0;

            width: root.px-per-bar - 12px;
            height: parent.height;

            text: (i + 1).to-fixed(0);

            color: Theme.text-primary;

            font-size: 10px;
            font-weight: 700;

            vertical-alignment: center;
            horizontal-alignment: left;

            overflow: elide;
        }

        // Ticks de subdivisão (gerados no Rust): nível 0=compasso,
        // 1=tempo, 2=colcheia, 3=semicolcheia. Visibilidade por zoom.
        for tick in PianoRollData.ruler-ticks: Rectangle {
            visible: root.tick-visible(tick.level);

            x: (tick.bar + tick.pos) * root.px-per-bar - root.scroll-x;
            y:
                tick.level == 0 ? 0
                : tick.level == 1 ? 4px
                : tick.level == 2 ? parent.height - 8px
                : parent.height - 6px;

            width: 1px;
            height:
                tick.level == 0 ? parent.height - 1px
                : tick.level == 1 ? parent.height - 8px
                : tick.level == 2 ? 7px
                : 5px;

            background:
                Theme.is-paper ? Theme.base.transparentize(
                    tick.level >= 2 ? 0.25 : 0.6
                ) : Theme.border.transparentize(
                    tick.level >= 2 ? 0.25 : 0.6
                );

            z: 5;
        }
    }

    function tick-visible(level: int) -> bool {
        level == 0
            || (level == 1 && root.px-per-bar >= 40px)
            || (level == 2 && root.px-per-bar >= 120px)
            || (level == 3 && root.px-per-bar >= 240px)
    }
}
