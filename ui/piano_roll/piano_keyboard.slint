import { Theme } from "../theme.slint";
import { PianoOctave } from "piano_octave.slint";
import { PianoRollData } from "piano_roll_state.slint";

export component PianoKeyboard inherits Rectangle {

    in property <length> key-height: 20px;
    in property <length> keyboard-width: 58px;
    in property <length> black-key-width: 38px;
    in property <length> scroll-y: 0px;

    callback note-pressed(int);

    width: root.keyboard-width;

    background: Theme.base;

    Rectangle {
        width: root.keyboard-width;
        height: parent.height;

        clip: true;

        for oct in PianoRollData.octave-range: PianoOctave {

            octave: oct;

            key-height: root.key-height;

            keyboard-width: root.keyboard-width;

            black-key-width: root.black-key-width;

            last-note: PianoRollData.last-note;

            y:
                (
                    PianoRollData.last-note
                    - oct * 12
                    - 11
                )
                * root.key-height
                - root.scroll-y;

            note-pressed(note) => {
                root.note-pressed(note);
            }
        }
    }

    // Divisória vertical entre teclado e Piano Roll
    Rectangle {
        x: parent.width - 1px;

        width: 1px;
        height: parent.height;

        background: Theme.border;

        z: 100;
    }
}