import { Theme } from "../theme.slint";

export component PanControl inherits Rectangle {
    in-out property <float> value: 0.5;
    callback changed(float);
    private property <bool> dragging: false;

    width: 82px;
    height: 36px;
    background: Theme.base;
    border-radius: 3px;
    border-width: 1px;
    border-color: Theme.border;

    pan-recess := Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        background: transparent;
        border-radius: 2px;

        pan-graph := Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 18px;
            background: Theme.surface;
            border-radius: 4px;

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 3px;
                width: 1px;
                height: 14px;
                background: Theme.text-dim;
            }

            Rectangle {
                property <float> amount: Math.abs(root.value - 0.5) * 2.0;
                width: Math.max(3px, parent.width * 0.5 * self.amount);
                height: 4px + self.amount * 10px;
                x: root.value < 0.5 ? parent.width / 2 - self.width : parent.width / 2;
                y: (parent.height - self.height) / 2;
                background: Theme.accent;
                border-radius: 1px;
            }

            TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: ew-resize;

                pointer-event(event) => {
                    let cursor-x = self.absolute-position.x + self.mouse-x;
                    let graph-x = pan-graph.absolute-position.x;
                    if event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.left {
                        root.dragging = true;
                        root.value = Math.max(0.0, Math.min(1.0, (cursor-x - graph-x) / pan-graph.width));
                        root.changed(root.value);
                    } else if root.dragging
                        && event.kind == PointerEventKind.move {
                        root.value = Math.max(0.0, Math.min(1.0, (cursor-x - graph-x) / pan-graph.width));
                        root.changed(root.value);
                    } else if root.dragging
                        && event.kind == PointerEventKind.up {
                        root.dragging = false;
                    }
                }
            }
        }

        HorizontalLayout {
            x: 3px;
            y: 18px;
            width: parent.width - 6px;
            height: 14px;
            padding-left: 3px;
            padding-right: 3px;
            spacing: 2px;
            alignment: LayoutAlignment.center;
            cross-axis-alignment: CrossAxisAlignment.center;

            pan-value-input := TextInput {
                text: ((root.value - 0.5) * 200.0).to-fixed(0);
                input-type: decimal;
                horizontal-stretch: 1;
                height: 100%;
                color: Theme.text-primary;
                font-size: 9px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;

                accepted => {
                    let pan-percent = Math.max(-100.0, Math.min(100.0, self.text.to-float()));
                    root.value = 0.5 + pan-percent / 200.0;
                    root.changed(root.value);
                    self.clear-focus();
                }
            }

            Text {
                text: "%";
                width: 8px;
                height: 100%;
                color: Theme.text-dim;
                font-size: 8px;
                vertical-alignment: center;
            }
        }

        TouchArea {
            x: 0px;
            y: 24px;
            width: 100%;
            height: 14px;
            mouse-cursor: text;
            clicked => {
                pan-value-input.focus();
                pan-value-input.select-all();
            }
        }
    }
}