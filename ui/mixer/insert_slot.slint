import { Theme } from "../theme.slint";
import { Button } from "../components/button.slint";

// Slot de insert (efeito encadeado) de um canal do mixer.
// Mostra o número do slot, o nome do processador e botões de
// power (bypass) e remover.
export component InsertSlot inherits Rectangle {
    in property <int> slot-index: 0;
    in property <string> name: "";
    in property <bool> enabled: true;

    callback toggle();
    callback remove();

    height: 20px;
    background: Theme.base;
    border-radius: 3px;
    border-width: 1px;
    border-color: Theme.border;

    states [
        disabled when !root.enabled: {
            opacity: 0.55;
        }
    ]

    // Número do slot
    Text {
        x: 5px;
        width: 14px;
        height: 100%;
        color: Theme.text-dim;
        font-size: 8px;
        font-weight: 600;
        horizontal-alignment: left;
        vertical-alignment: center;
        text: (root.slot-index + 1);
    }

    // Nome do processador
    Text {
        x: 19px;
        width: parent.width - 51px;
        height: 100%;
        color: Theme.text-primary;
        font-size: 9px;
        horizontal-alignment: left;
        vertical-alignment: center;
        overflow: TextOverflow.elide;
        text: root.name;
    }

    // Power (bypass)
    Button {
        width: 14px;
        height: 14px;
        x: parent.width - 30px;
        y: (parent.height - self.height) / 2;
        icon: @image-url("../icons/power.svg");
        icon-size: 10px;
        borderless: true;
        icon-color: root.enabled ? Theme.ok : Theme.text-dim;
        keep-icon-color: true;
        clicked => { root.toggle(); }
    }

    // Remover
    Button {
        width: 12px;
        height: 14px;
        x: parent.width - 16px;
        y: (parent.height - self.height) / 2;
        icon: @image-url("../icons/close.svg");
        icon-size: 9px;
        borderless: true;
        icon-color: Theme.text-dim;
        clicked => { root.remove(); }
    }
}
