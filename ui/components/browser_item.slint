import { Theme } from "../theme.slint";

export component BrowserItem inherits Rectangle {
    in property <string> name: "";
    in property <string> type: "";
    in property <string> icon: "♫";
    in property <image> icon-image: @image-url("");
    in property <bool> selected: false;

    callback clicked();

    height: 28px;

    background: root.selected
        ? Theme.surface-high
        : transparent;

    border-radius: 3px;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 7px;
        spacing: 5px;
        alignment: LayoutAlignment.start;
        cross-axis-alignment: CrossAxisAlignment.center;

        // Indicador de seleção
        Rectangle {
            width: 2px;
            height: root.selected ? 18px : 0px;

            background: Theme.accent;
            border-radius: 1px;
        }

        // Ícone
        Text {
            text: root.icon;
            visible: root.icon-image.width == 0;

            width: 16px;

            color: root.selected
                ? Theme.accent
                : Theme.text-dim;

            font-size: 10px;

            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Image {
            source: root.icon-image;
            visible: root.icon-image.width > 0;
            width: 14px;
            height: 14px;
            colorize: root.selected
                ? Theme.accent
                : Theme.text-dim;
        }

        // Nome
        Text {
            text: root.name;

            color: root.selected
                ? Theme.text-primary
                : Theme.text-dim;

            font-size: 10px;

            vertical-alignment: center;

            horizontal-stretch: 1;
            overflow: elide;
        }

        // Tipo / informação
        Text {
            text: root.type;

            color: Theme.text-dim;

            font-size: 8px;

            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}