import { Theme } from "../theme.slint";

export component BrowserItem inherits Rectangle {
    in property <string> name: "";
    in property <string> type: "";
    in property <string> icon: "♫";
    in property <image> icon-image: @image-url("");
    in property <bool> selected: false;
    in property <bool> drag-enabled: false;

    callback clicked();
    callback drag-started();
    callback drag-moved(length, length);
    callback drag-finished();

    in-out property <bool> dragging: false;

    height: 28px;

    background: root.selected
        ? Theme.surface-high
        : transparent;

    border-radius: 3px;

    // Indicador de seleção (sobreposto na borda esquerda)
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 2px;
        height: 18px;
        visible: root.selected;

        background: Theme.accent;
        border-radius: 1px;
    }

    HorizontalLayout {
        padding-left: 3px;
        padding-right: 7px;
        spacing: 3px;
        alignment: LayoutAlignment.start;
        cross-axis-alignment: CrossAxisAlignment.center;

        // Nome
        Text {
            text: root.name;

            color: root.selected
                ? Theme.text-primary
                : Theme.text-dim;

            font-size: 10px;

            vertical-alignment: center;

            horizontal-stretch: 1;
            overflow: elide;
        }

        // Ícone (à direita, não empurra o texto)
        Text {
            text: root.icon;
            visible: root.icon-image.width == 0;

            color: root.selected
                ? Theme.accent
                : Theme.text-dim;

            font-size: 10px;

            vertical-alignment: center;
        }

        Image {
            source: root.icon-image;
            visible: root.icon-image.width > 0;

            width: 12px;
            height: 12px;

            colorize: root.selected
                ? Theme.accent
                : Theme.text-dim;
        }

        // Tipo / informação
        Text {
            text: root.type;

            color: Theme.text-dim;

            font-size: 8px;

            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }

    states [
        hovered when touch.has-hover && !root.selected: {
            background: Theme.surface-high;
        }
    ]

    touch := TouchArea {
        mouse-cursor: pointer;

        property <bool> is-down: false;
        property <length> press-x: 0px;
        property <length> press-y: 0px;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down
                && event.button == PointerEventButton.left
                && root.drag-enabled {
                self.is-down = true;
                self.press-x = self.mouse-x;
                self.press-y = self.mouse-y;
            } else if event.kind == PointerEventKind.up
                && self.is-down {
                self.is-down = false;
                if root.dragging {
                    root.dragging = false;
                    root.drag-finished();
                }
            } else if event.kind == PointerEventKind.move
                && self.is-down {
                if !root.dragging {
                    let dx = self.mouse-x - self.press-x;
                    let dy = self.mouse-y - self.press-y;
                    if (dx < 0px ? -dx : dx) > 6px
                        || (dy < 0px ? -dy : dy) > 6px {
                        root.dragging = true;
                        root.drag-started();
                    }
                }
                if root.dragging {
                    let win = self.absolute-position;
                    root.drag-moved(
                        self.mouse-x + win.x,
                        self.mouse-y + win.y
                    );
                }
            }
        }

        clicked => {
            if !root.dragging {
                root.clicked();
            }
        }
    }
}