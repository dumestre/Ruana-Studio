import { Theme } from "../theme.slint";

export component BrowserItem inherits Rectangle {
    in property <string> name: "";
    in property <string> type: "";
    in property <string> icon: "♫";
    in property <image> icon-image: @image-url("");
    in property <bool> selected: false;

    callback clicked();

    height: 28px;

    background: root.selected
        ? Theme.surface-high
        : transparent;

    border-radius: 3px;

    // Indicador de seleção (sobreposto na borda esquerda)
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 2px;
        height: 18px;
        visible: root.selected;

        background: Theme.accent;
        border-radius: 1px;
    }

    HorizontalLayout {
        padding-left: 3px;
        padding-right: 7px;
        spacing: 3px;
        alignment: LayoutAlignment.start;
        cross-axis-alignment: CrossAxisAlignment.center;

        // Nome
        Text {
            text: root.name;

            color: root.selected
                ? Theme.text-primary
                : Theme.text-dim;

            font-size: 10px;

            vertical-alignment: center;

            horizontal-stretch: 1;
            overflow: elide;
        }

        // Tipo / informação
        Text {
            text: root.type;

            color: Theme.text-dim;

            font-size: 8px;

            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }

    states [
        hovered when touch.has-hover && !root.selected: {
            background: Theme.surface-high;
        }
    ]

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}