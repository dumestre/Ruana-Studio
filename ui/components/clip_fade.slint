import { Theme } from "../theme.slint";
import { ClipDragState } from "../timeline/clip_drag/clip_drag_state.slint";

// ============================================================
// CLIP FADE — controle de fade-in/out do clip
//
// POSICIONADO SOBRE O ROOT DO CLIP (cobre o corpo + header). As
// duas BOLINHAS no topo (uma na borda do fade-in, outra do fade-out)
// arrastam horizontalmente, mudando a largura da região de fade e a
// CURVA BEZIER de atenuação. Gesto 100% local; release comita via
// `fade-committed`.
//
// Coordenadas relativas ao root do clip (mesmas do track_clip).
// ============================================================

export component ClipFade inherits Rectangle {

    in property <int> clip-id: 0;
    in property <float> fade-in: 0.0;
    in property <float> fade-out: 0.0;
    in property <float> len: 4.0;
    in property <length> px-per-beat: 40px;
    in property <length> row-height: 64px;
    in property <length> header-height: 30px;
    in property <length> bw: 1px;
    in property <bool> is-midi: false;
    in property <bool> interactive: true;
    in property <int> active-tool: 0;
    in property <bool> selected: false;
    in property <bool> multi-selected: false;
    in property <bool> hovered: false;
    in property <color> clip-color: Theme.accent;

    // Publicado: larguras de fade (px do root) p/ o waveform request.
    in-out property <length> fade-in-w:
        Math.min(root.px-per-beat * root.display-fade-in, root.body-w);

    in-out property <length> fade-out-w:
        Math.min(root.px-per-beat * root.display-fade-out, root.body-w);

    // Publicado: gesto ativo (usado p/ cursor/opacity pelo track_clip).
    in-out property <bool> fading: false;
    // Publicado: lado do gesto (-1 in, +1 out).
    in-out property <int> fade-side: 0;

    callback fade-committed(int, float, float);

    background: transparent;
    clip: true;

    private property <bool> show-fade-controls:
        !root.is-midi
        && root.active-tool == 0
        && (root.selected
            || root.multi-selected
            || root.hovered);

    private property <length> fade-grip-size: 10px;
    private property <length> fade-grip-half: root.fade-grip-size / 2;
    private property <length> fade-slot: 16px;

    private property <length> fade-grip-y:
        root.header-height + root.fade-slot / 2;

    private property <float> live-fade-in: 0.0;
    private property <float> live-fade-out: 0.0;
    private property <length> fade-start-abs-x: 0px;
    private property <float> fade-start-value: 0.0;

    private property <float> display-fade-in:
        root.fading && root.fade-side < 0 ? root.live-fade-in : root.fade-in;

    private property <float> display-fade-out:
        root.fading && root.fade-side > 0 ? root.live-fade-out : root.fade-out;

    // Corpo: largura útil dentro das bordas.
    private property <length> body-w: root.width - 2 * root.bw;
    private property <length> body-h: root.row-height - root.header-height - root.bw;

    private property <length> fade-grip-x-in: root.fade-in-w;
    private property <length> fade-grip-x-out: root.width - 2 * root.bw - root.fade-out-w;

    // =====================================================
    // GRADIENTE DE ATENUAÇÃO (a região do fade escurece a onda)
    // =====================================================

    if root.show-fade-controls && root.fade-in-w >= 1px:
        Rectangle {
            x: root.bw;
            y: root.header-height;
            width: root.fade-in-w;
            height: root.body-h;
            background: @linear-gradient(
                90deg,
                root.clip-color.darker(0.12).with-alpha(0.92) 0%,
                transparent 100%
            );
            z: 5;
        }

    if root.show-fade-controls && root.fade-out-w >= 1px:
        Rectangle {
            x: root.width - root.bw - root.fade-out-w;
            y: root.header-height;
            width: root.fade-out-w;
            height: root.body-h;
            background: @linear-gradient(
                90deg,
                transparent 0%,
                root.clip-color.darker(0.12).with-alpha(0.92) 100%
            );
            z: 5;
        }

    // =====================================================
    // CURVAS BEZIER do fade (linha branca sobre a onda)
    // =====================================================

    if root.show-fade-controls && root.fade-in-w >= 1px:
        Path {
            x: root.bw + root.fade-grip-x-in;
            y: root.header-height;
            width: root.fade-in-w;
            height: root.body-h;
            commands: "M 0,100 C 25,100 75,0 100,0";
            viewbox-width: 100;
            viewbox-height: 100;
            fit: fill;
            fill: transparent;
            stroke: #FFFFFF;
            stroke-width: 1px;
            opacity: root.fading && root.fade-side < 0 ? 0.95 : 0.55;
            z: 6;
        }

    if root.show-fade-controls && root.fade-out-w >= 1px:
        Path {
            x: root.bw + root.fade-grip-x-out;
            y: root.header-height;
            width: root.fade-out-w;
            height: root.body-h;
            commands: "M 0,0 C 25,0 75,100 100,100";
            viewbox-width: 100;
            viewbox-height: 100;
            fit: fill;
            fill: transparent;
            stroke: #FFFFFF;
            stroke-width: 1px;
            opacity: root.fading && root.fade-side > 0 ? 0.95 : 0.55;
            z: 6;
        }

    // =====================================================
    // BOLINHAS (pinos) — cada uma com sua TouchArea de gesto
    // =====================================================

    if root.show-fade-controls && (root.hovered || root.fading):
        TouchArea {
            x: root.bw + root.fade-grip-x-in - root.fade-grip-half;
            y: root.fade-grip-y - root.fade-grip-half;
            width: root.fade-grip-size;
            height: root.fade-grip-size;
            mouse-cursor: ew-resize;
            z: 7;

            Rectangle {
                x: 0px;
                y: 0px;
                width: root.fade-grip-size;
                height: root.fade-grip-size;
                border-radius: root.fade-grip-half;
                background: (root.fading && root.fade-side == -1)
                    ? Theme.accent : Theme.accent-hover;
                border-width: 1px;
                border-color: Theme.on-accent;
                opacity: root.fading && root.fade-side < 0 ? 1.0 : 0.85;
            }

            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.fade-side = -1;
                    root.fade-start-abs-x = self.absolute-position.x + self.mouse-x;
                    root.fade-start-value = root.fade-in;
                    root.live-fade-in = root.fade-in;
                    root.live-fade-out = root.fade-out;
                    root.fading = true;
                } else if event.kind == PointerEventKind.up && root.fading && root.fade-side == -1 {
                    root.commit-fade();
                }
            }

            moved => {
                if self.pressed && root.fading && root.fade-side == -1 {
                    root.apply-fade-move(self.absolute-position.x + self.mouse-x);
                }
            }
        }

    if root.show-fade-controls && (root.hovered || root.fading):
        TouchArea {
            x: root.bw + root.fade-grip-x-out - root.fade-grip-half;
            y: root.fade-grip-y - root.fade-grip-half;
            width: root.fade-grip-size;
            height: root.fade-grip-size;
            mouse-cursor: ew-resize;
            z: 7;

            Rectangle {
                x: 0px;
                y: 0px;
                width: root.fade-grip-size;
                height: root.fade-grip-size;
                border-radius: root.fade-grip-half;
                background: (root.fading && root.fade-side == 1)
                    ? Theme.accent : Theme.accent-hover;
                border-width: 1px;
                border-color: Theme.on-accent;
                opacity: root.fading && root.fade-side > 0 ? 1.0 : 0.85;
            }

            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.fade-side = 1;
                    root.fade-start-abs-x = self.absolute-position.x + self.mouse-x;
                    root.fade-start-value = root.fade-out;
                    root.live-fade-in = root.fade-in;
                    root.live-fade-out = root.fade-out;
                    root.fading = true;
                } else if event.kind == PointerEventKind.up && root.fading && root.fade-side == 1 {
                    root.commit-fade();
                }
            }

            moved => {
                if self.pressed && root.fading && root.fade-side == 1 {
                    root.apply-fade-move(self.absolute-position.x + self.mouse-x);
                }
            }
        }

    // =====================================================
    // LÓGICA COMPARTILHADA DO GESTO
    // =====================================================

    function apply-fade-move(cursor-abs-x: length) {
        let dfade-dx-px = (cursor-abs-x - root.fade-start-abs-x) / 1px;
        let dfade-ppb = root.px-per-beat / 1px;
        let dfade-delta-beats = dfade-dx-px / dfade-ppb;
        let dfade-snap = ClipDragState.snap-enabled ? Math.round(dfade-delta-beats) : dfade-delta-beats;
        let dfade-value = Math.max(0.0, Math.min(root.len * 0.5, root.fade-start-value + dfade-snap));
        if root.fade-side < 0 {
            root.live-fade-in = dfade-value;
        } else {
            root.live-fade-out = dfade-value;
        }
    }

    function commit-fade() {
        root.fading = false;
        let side = root.fade-side;
        let fi = side < 0 ? root.live-fade-in : root.fade-in;
        let fo = side > 0 ? root.live-fade-out : root.fade-out;
        root.fade-side = 0;
        root.fade-committed(root.clip-id, fi, fo);
    }
}
