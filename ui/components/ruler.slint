import { Theme } from "../theme.slint";


export component TimelineRuler inherits Rectangle {

    // Métrica musical — projetada do core pelo Rust.
    // Nenhum hardcode de 4/4: tudo deriva de beats-per-bar.
    in property <int> total-bars: 32;

    in property <int> beats-per-bar: 4;

    in property <length> px-per-bar: 160px;

    in property <length> ruler-height: 30px;

    in property <length> scroll-x: 0px;

    callback seek-to-beat(float);

    height:
        root.ruler-height;

    background:
        Theme.surface;

    // Largura de uma batida em pixels.
    property <length> px-per-beat:
        root.px-per-bar / root.beats-per-bar;


    // =====================================================
    // FUNDO ALTERNADO POR COMPASSO (igual ao beat sequencer)
    //
    // Math.mod(i, 2) == 1 -> tom mais escuro.
    // =====================================================

    for i in root.total-bars: Rectangle {

        x:
            i * root.px-per-bar;

        y: 0;

        width:
            root.px-per-bar;

        height:
            parent.height;

        background:
            Math.mod(i, 2) == 1
                ? Theme.base
                : Theme.surface;

        z: -1;
    }


    // =====================================================
    // LINHA INFERIOR
    // =====================================================

    Rectangle {

        x: 0;
        y:
            parent.height - 1px;

        width:
            parent.width;

        height: 1px;

        background:
            Theme.border;
    }


    // =====================================================
    // LINHAS DOS COMPASSOS
    // =====================================================

    for i in root.total-bars: Rectangle {

        x:
            i * root.px-per-bar;

        y: 0;

        width: 1px;

        height:
            parent.height - 1px;

        background:
            Math.mod(i, 2) == 1
                ? Theme.border
                : Theme.border.transparentize(0.45);
    }


    // =====================================================
    // NÚMEROS
    //
    // Alinhados exatamente na linha do compasso.
    // =====================================================

    for i in root.total-bars: Text {

        x:
            i * root.px-per-bar + 2px;

        y: 0;

        width:
            root.px-per-bar - 2px;

        height:
            parent.height;

        text:
            "" + (i + 1);

        color:
            Math.mod(i, 2) == 1
                ? Theme.text-primary
                : Theme.text-dim;

        font-size:
            Math.mod(i, 2) == 1
                ? 10px
                : 9px;

        font-weight:
            Math.mod(i, 2) == 1
                ? 700
                : 500;

        vertical-alignment:
            center;

        horizontal-alignment:
            left;

        overflow:
            elide;
    }


    // =====================================================
    // LINHAS DE BATIDA
    //
    // Uma por batida do compasso (k = 0 é a própria linha do
    // compasso, já desenhada). Mesma matemática/origem/zoom do
    // grid da Timeline: x = i * px-per-bar + k * px-per-beat.
    // Visíveis quando cabe.
    // =====================================================

    for i in root.total-bars: Rectangle {
        width: 0px;
        height: 0px;

        for k in root.beats-per-bar: Rectangle {

            visible:
                k > 0 && root.px-per-bar >= 40px;

            x:
                i * root.px-per-bar
                + k * root.px-per-beat;

            y: 0;

            width: 1px;

            height:
                root.ruler-height - 1px;

            background:
                Theme.border.transparentize(0.6);
        }
    }


    // =====================================================
    // SUBDIVISÃO 1/8 (meio da batida)
    //
    // Visível quando px-per-bar >= 120px (mesmo threshold da
    // Timeline).
    // =====================================================

    for i in root.total-bars: Rectangle {
        width: 0px;
        height: 0px;

        for k in root.beats-per-bar: Rectangle {

            visible:
                root.px-per-bar >= 120px;

            x:
                i * root.px-per-bar
                + k * root.px-per-beat
                + root.px-per-beat * 0.5;

            y:
                root.ruler-height - 8px;

            width: 1px;
            height: 7px;

            background:
                Theme.border.transparentize(0.25);
        }
    }


    // =====================================================
    // SUBDIVISÃO 1/16 (1/4 e 3/4 da batida)
    //
    // Visível quando px-per-bar >= 240px (mesmo threshold da
    // Timeline).
    // =====================================================

    for i in root.total-bars: Rectangle {
        width: 0px;
        height: 0px;

        for k in root.beats-per-bar: Rectangle {

            visible:
                root.px-per-bar >= 240px;

            x:
                i * root.px-per-bar
                + k * root.px-per-beat
                + root.px-per-beat * 0.25;

            y:
                root.ruler-height - 6px;

            width: 1px;
            height: 5px;

            background:
                Theme.border.transparentize(0.25);
        }

        for k in root.beats-per-bar: Rectangle {

            visible:
                root.px-per-bar >= 240px;

            x:
                i * root.px-per-bar
                + k * root.px-per-beat
                + root.px-per-beat * 0.75;

            y:
                root.ruler-height - 6px;

            width: 1px;
            height: 5px;

            background:
                Theme.border.transparentize(0.25);
        }
    }

    // =====================================================
    // CLICK-TO-SEEK
    //
    // Conversão pixel→batida genérica: compassos têm
    // beats-per-bar batidas.
    // =====================================================

    TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        clicked => {
            let beat = (self.mouse-x + root.scroll-x)
                / root.px-per-bar
                * root.beats-per-bar;
            root.seek-to-beat(max(0.0, beat));
        }

        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                let beat = (self.mouse-x + root.scroll-x)
                    / root.px-per-bar
                    * root.beats-per-bar;
                root.seek-to-beat(max(0.0, beat));
            }
        }
    }
}
