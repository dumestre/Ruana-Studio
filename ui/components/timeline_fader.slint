import { Theme } from "../theme.slint";

export component TimelineVolume inherits Rectangle {
    // ============================================================
    // ESTADO E PROPRIEDADES
    // ============================================================
    in-out property <float> value: 0.75;
    in-out property <string> db-text: "0.0";
    in property <string> caption: "";

    // Animação suave para o fader deslizar até a posição (estilo DAW motorizado)
    animate value { duration: 120ms; easing: ease-out; }

    callback changed(float);
    callback value-accepted(string);

    width: 180px;
    height: 48px;

    // ============================================================
    // FUNÇÕES PURAS DE CONVERSÃO DE ESCALA (-60dB a +6dB)
    // ============================================================
    pure function db-to-position(db: float) -> float {
        if db <= -60 { return 0; }
        if db <= 0 { return ((db + 60) / 60) * 0.75; }
        return 0.75 + (db / 6) * 0.25;
    }

    pure function position-to-db(v: float) -> float {
        if v <= 0 { return -60; }
        if v <= 0.75 { return -60 + ((v / 0.75) * 60); }
        return ((v - 0.75) / 0.25) * 6;
    }

    // ============================================================
    // HEADER: INPUT DE TEXTO E UNIDADE
    // ============================================================
    HorizontalLayout {
        y: 0px;
        x: 0px;
        width: parent.width;
        height: 16px;
        alignment: center;
        spacing: 4px;

        input := TextInput {
            text: root.db-text;
            color: Theme.text-primary;
            font-size: 10px;
            font-weight: 700;
            horizontal-alignment: TextHorizontalAlignment.center;
            vertical-alignment: center;
            width: 44px;

            // Ao pressionar Enter, converte o texto e move o fader imediatamente
            accepted => {
                let parsed-db = self.text.to-float();
                let clamped-db = max(-60.0, min(6.0, parsed-db));
                
                // Recalcula e desliza o fader diretamente pela interface
                root.value = root.db-to-position(clamped-db);
                
                // Notifica o backend em Rust
                root.changed(root.value);
                root.value-accepted(self.text);
                
                self.clear-focus();
            }
        }

        Text {
            text: "dB";
            color: Theme.text-dim;
            font-size: 9px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    // ============================================================
    // ÁREA DO FADER E MARCAÇÕES (TRILHO E HANDLE)
    // ============================================================
    track-area := Rectangle {
        y: 18px;
        x: 10px;
        width: parent.width - 20px;
        height: 16px;

        // TRILHO BASE
        track := Rectangle {
            y: (parent.height - self.height) / 2;
            height: 6px;
            width: parent.width;
            background: Theme.surface-high;
            border-radius: 3px;

            // PREENCHIMENTO NORMAL (-60dB até 0dB / 0% até 75%)
            Rectangle {
                x: 0;
                y: 0;
                height: parent.height;
                width: parent.width * min(root.value, 0.75);
                background: Theme.accent;
                opacity: 0.6;
                border-radius: 3px;
            }

            // PREENCHIMENTO HEADROOM (0dB até +6dB / 75% até 100%)
            Rectangle {
                x: parent.width * 0.75;
                y: 0;
                height: parent.height;
                width: max(0px, (root.value - 0.75) * parent.width);
                background: Theme.accent;
                opacity: 0.25;
                border-radius: 3px;
            }

            // MARCAÇÕES VISUAIS DA ESCALA
        
            // Marca 0 dB (Destaque Principal)
            Rectangle { x: parent.width * 0.75 - 1px; y: -6px; width: 2px; height: 18px; background: Theme.surface-high; border-radius: 1px; } 
            
            Rectangle { x: parent.width - 1px; y: -4px; width: 1px; height: 14px; background: Theme.text-dim; opacity: 0.65; } // +6 dB

            // TEXTOS DA ESCALA
            Text {
                x: parent.width * 0.75 - 15px;
                y: 13px;
                text: "0 dB";
                color: Theme.text-primary;
                font-size: 8px;
                font-weight: 700;
                horizontal-alignment: center;
                width: 30px;
            }
            Text {
                x: parent.width - 15px;
                y: 13px;
                text: "+6";
                color: Theme.text-dim;
                font-size: 7px;
                horizontal-alignment: center;
                width: 30px;
            }
        }

        // INTERAÇÃO DO MOUSE COM O FADER
        TouchArea {
            width: track.width;
            height: 24px;
            y: (parent.height - self.height) / 2;
            mouse-cursor: pointer;

            moved => {
                if (self.pressed) {
                    root.value = max(0.0, min(1.0, self.mouse-x / self.width));
                    root.changed(root.value);
                }
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.value = max(0.0, min(1.0, self.mouse-x / self.width));
                    root.changed(root.value);
                }
            }
        }

        // HANDLE (BOTÃO DO FADER CENTRALIZADO NO VALOR)
        Rectangle {
            width: 14px;
            height: 14px;
            x: (track.width * root.value) - (self.width / 2);
            y: (parent.height - self.height) / 2;
            
            border-radius: 7px;
            background: Theme.surface;
            border-width: 2px;
            border-color: Theme.accent;

            
        }
    }

    // ============================================================
    // CAPTION (LEGENDA OPCIONAL)
    // ============================================================
    if root.caption != "" : Text {
        x: 0;
        y: 38px;
        width: parent.width;
        text: root.caption;
        color: Theme.text-dim;
        font-size: 8px;
        horizontal-alignment: center;
    }
}