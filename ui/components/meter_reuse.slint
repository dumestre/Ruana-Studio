import { Theme } from "../theme.slint";

export component StereoMeter inherits Rectangle {
    in property <float> left-level: 0.0;
    in property <float> right-level: 0.0;
    in property <float> left-peak: 0.0;
    in property <float> right-peak: 0.0;
    in property <bool> left-clipped: false;
    in property <bool> right-clipped: false;

    in property <length> meter-width: 5px;
    in property <length> channel-gap: 2px;
    in property <color> meter-background: #111111;
    in property <color> meter-border: transparent;
    in property <bool> signal-fill-only: false;

    private property <length> meter-height: Math.max(1px, root.height);
    private property <length> channel-width: Math.max(2px, root.meter-width);
    private property <length> divider-width: 1px;

    width: root.channel-width * 2 + root.channel-gap + root.divider-width;
    background: transparent;
    border-radius: 15px;

    function level-clamped(value: float) -> float {
        if value != value { return 0.0; }
        return Math.max(0.0, Math.min(1.0, value));
    }

    HorizontalLayout {
        x: 0; y: 0; width: parent.width; height: parent.height;
        alignment: center;
        spacing: root.channel-gap / 2;

        // CANAL L
        Rectangle {
            width: root.channel-width; height: root.meter-height;
            background: root.meter-background;
            border-width: 1px; border-color: root.meter-border;
            border-radius: 6px; clip: true;

            Rectangle {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                background: @linear-gradient(180deg, #FF3B30 0%, #FF3B30 10%, #FFCC00 10%, #FFCC00 25%, #00C853 25%, #00C853 100%);
                clip: true;
                Rectangle {
                    x: 0px; y: 0px; width: parent.width;
                    height: parent.height * (1.0 - root.level-clamped(root.left-level));
                    background: root.meter-background;
                    visible: !root.signal-fill-only || root.left-level > 0.001;
                }
            }
            Rectangle {
                x: 0px; y: parent.height - (root.level-clamped(root.left-peak) * parent.height) - 1px;
                width: parent.width; height: 2px;
                background: root.left-clipped ? #FF3030 : #FFFFFF;
                visible: root.left-peak > 0.001 && (!root.signal-fill-only || root.left-level > 0.001);
            }
        }

        // DIVISOR
        Rectangle {
            width: root.divider-width; height: root.meter-height;
            background: Theme.is-paper ? Theme.base.transparentize(0.6) : Theme.border;
        }

        // CANAL R
        Rectangle {
            width: root.channel-width; height: root.meter-height;
            background: root.meter-background;
            border-width: 1px; border-color: root.meter-border;
            border-radius: 6px; clip: true;

            Rectangle {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                background: @linear-gradient(180deg, #FF3B30 0%, #FF3B30 10%, #FFCC00 10%, #FFCC00 25%, #00C853 25%, #00C853 100%);
                clip: true;
                Rectangle {
                    x: 0px; y: 0px; width: parent.width;
                    height: parent.height * (1.0 - root.level-clamped(root.right-level));
                    background: root.meter-background;
                    visible: !root.signal-fill-only || root.right-level > 0.001;
                }
            }
            Rectangle {
                x: 0px; y: parent.height - (root.level-clamped(root.right-peak) * parent.height) - 1px;
                width: parent.width; height: 2px;
                background: root.right-clipped ? #FF3030 : #FFFFFF;
                visible: root.right-peak > 0.001 && (!root.signal-fill-only || root.right-level > 0.001);
            }
        }
    }
}
