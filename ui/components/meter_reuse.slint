import { Theme } from "../theme.slint";

// ============================================================
// STEREO METER - alinhado no centro: [ L | div | R ]
// ============================================================

export component StereoMeter inherits Rectangle {
    // ========================================================
    // PROPRIEDADES
    // ========================================================

    in property <float> left-level: 0.0;
    in property <float> right-level: 0.0;
    in property <float> left-peak: 0.0;
    in property <float> right-peak: 0.0;
    in property <bool> left-clipped: false;
    in property <bool> right-clipped: false;

    in property <length> meter-width: 5px;
    in property <length> channel-gap: 2px;
    in property <color> meter-background: #111111;
    in property <color> meter-border: transparent;

    // Fader cap (play icon) properties
    in property <bool> show-fader-cap: true;
    in property <float> left-cap-position: 0.0;   // 0.0 = bottom, 1.0 = top
    in property <float> right-cap-position: 0.0;  // 0.0 = bottom, 1.0 = top

    // ========================================================
    // DIMENSÕES
    // ========================================================

    private property <length> meter-height: Math.max(1px, root.height);
    private property <length> channel-width: Math.max(2px, root.meter-width);
    private property <length> divider-width: 1px;

    // Largura total = L + gap/2 + div + gap/2 + R = 5+1+1+1+5 = 13px
    width: root.channel-width * 2 + root.channel-gap + root.divider-width;
    background: transparent;
    border-radius: 15px;

    pure function level-clamped(value: float) -> float {
        return Math.max(0.0, Math.min(1.0, value));
    }

    // ========================================================
    // LAYOUT CENTRALIZADO
    // ========================================================

    HorizontalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        alignment: center;
        spacing: root.channel-gap / 2;

        // ----------------------------------------------------
        // CANAL L
        // ----------------------------------------------------
        Rectangle {
            width: root.channel-width;
            height: root.meter-height;
            background: root.meter-background;
            border-bottom-left-radius: 0px;
            border-width: 1px;
            border-color: root.meter-border;
            border-radius: 6px;
            clip: true;

            // Máscara do Nível (Cresce de baixo para cima)
            Rectangle {
                x: 1px;
                y: parent.height - self.height - 1px;
                width: parent.width - 2px;
                height: root.level-clamped(root.left-level) * (parent.height - 2px);
                clip: true;

                // Barra de Cor Estática (Fixada no fundo)
                Rectangle {
                    x: 0px;
                    y: parent.height - (root.meter-height - 2px);
                    width: parent.width;
                    height: root.meter-height - 2px;
                    background: @linear-gradient(180deg, #FF3B30 0%, #FF3B30 10%, #FFCC00 10%, #FFCC00 25%, #00C853 25%, #00C853 100%);
                }
            }

            // Peak Indicator
            Rectangle {
                x: 1px;
                y: parent.height - (root.level-clamped(root.left-peak) * (parent.height - 2px)) - 1px;
                width: parent.width - 2px;
                height: 2px;
                background: root.left-clipped ? #FF3030 : #FFFFFF;
                visible: root.left-peak > 0.001;
            }

            // Fader Cap (Play Icon) - CANAL L
            if root.show-fader-cap : Image {
                width: 30px;
                height: 22px;
                x: (parent.width - self.width) / 2;
                y: (parent.height * (1.0 - root.left-cap-position)) - (self.height / 2);
                source: @image-url("../icons/fader.png");
                horizontal-tiling: ImageTiling.none;
                image-fit: ImageFit.contain;
                image-rendering: ImageRendering.smooth;
                z: 10;
            }
        }

        // ----------------------------------------------------
        // DIVISOR CENTRAL
        // ----------------------------------------------------
        Rectangle {
            width: root.divider-width;
            height: root.meter-height;
            background: Theme.is-paper ? Theme.base.transparentize(0.6) : Theme.border;
        }

        // ----------------------------------------------------
        // CANAL R
        // ----------------------------------------------------
        Rectangle {
            width: root.channel-width;
            height: root.meter-height;
            background: root.meter-background;
            border-width: 1px;
            border-bottom-right-radius: 0px;
            border-color: root.meter-border;
            border-radius: 6px;
            clip: true;

            // Máscara do Nível (Cresce de baixo para cima)
            Rectangle {
                x: 1px;
                y: parent.height - self.height - 1px;
                width: parent.width - 2px;
                height: root.level-clamped(root.right-level) * (parent.height - 2px);
                clip: true;

                // Barra de Cor Estática (Fixada no fundo)
                Rectangle {
                    x: 0px;
                    y: parent.height - (root.meter-height - 2px);
                    width: parent.width;
                    height: root.meter-height - 2px;
                    background: @linear-gradient(180deg, #FF3B30 0%, #FF3B30 10%, #FFCC00 10%, #FFCC00 25%, #00C853 25%, #00C853 100%);
                }
            }

            // Peak Indicator
            Rectangle {
                x: 1px;
                y: parent.height - (root.level-clamped(root.right-peak) * (parent.height - 2px)) - 1px;
                width: parent.width - 2px;
                height: 2px;
                background: root.right-clipped ? #FF3030 : #FFFFFF;
                visible: root.right-peak > 0.001;
            }

            // Fader Cap (Play Icon) - CANAL R
            if root.show-fader-cap : Image {
                width: 30px;
                height: 22px;
                x: (parent.width - self.width) / 2;
                y: (parent.height * (1.0 - root.right-cap-position)) - (self.height / 2);
                source: @image-url("../icons/fader.png");
                horizontal-tiling: ImageTiling.none;
                image-fit: ImageFit.contain;
                image-rendering: ImageRendering.smooth;
                z: 10;
            }
        }
    }
}
