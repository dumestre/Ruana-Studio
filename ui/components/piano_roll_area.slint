import { Button } from "../components/button.slint";
import { Theme } from "../theme.slint";

component PanelHeader inherits Rectangle {
    in property <string> title: "";
    in-out property <bool> floating: false;
    callback float-toggle();

    height: 26px;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: LayoutAlignment.space-between;
        cross-axis-alignment: CrossAxisAlignment.center;
        height: 100%;

        Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: 10px;
            font-weight: 600;
        }

        Button {
            width: 22px;
            height: 20px;
            icon: @image-url("../icons/maximize.svg");
            icon-size: 12px;
            borderless: true;
            icon-color: Theme.text-dim;
            toggled: root.floating;
            toggled-icon-color: Theme.accent;
            clicked => { root.float-toggle(); }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }
}

export component PianoRollArea inherits Rectangle {
    in-out property <bool> floating: false;
    callback float-toggle();

    background: Theme.base;

    VerticalLayout {
        spacing: 0;
        alignment: LayoutAlignment.stretch;
        cross-axis-alignment: CrossAxisAlignment.stretch;

        PanelHeader {
            title: "Piano Roll";
            floating <=> root.floating;
            float-toggle => { root.float-toggle(); }
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.base;
            vertical-stretch: 1;
        }
    }
}