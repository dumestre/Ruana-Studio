import { Theme } from "../theme.slint";

export component SearchBar inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder: "Search...";

    height: 28px;

    background: Theme.base;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 3px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 6px;
        alignment: center;
        cross-axis-alignment: CrossAxisAlignment.center;

        Rectangle {
            width: 24px;
            height: 24px;
            
        

        Image {
            width: 16px;
            colorize: Theme.text-dim;
            height: 16px;
            source: @image-url("../icons/search.svg");
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    
        Rectangle {horizontal-stretch: 1;
            preferred-height: 20px;
            preferred-width: 200px;
            vertical-stretch: 1;
            background: Theme.text-dim.transparentize(0.89);
            border-radius: 6px;
            border-width: 1px;

        
        TextInput {
            text <=> root.text;
            color: Theme.text-primary;
            font-size: 12px;

            horizontal-stretch: 1;
            horizontal-alignment: TextHorizontalAlignment.center;
            vertical-alignment: center;

            Text {
                text: root.placeholder;
                visible: parent.text == "" && !parent.has-focus;
                color: Theme.text-dim;
                font-size: 12px;
                horizontal-alignment: TextHorizontalAlignment.center;
                vertical-alignment: center;
            }
        }
    }

        Text {
            text: root.text == "" ? "" : "×";
            width: 16px;

            color: Theme.text-dim;
            font-size: 20px;

            horizontal-alignment: center;
            vertical-alignment: center;

            TouchArea {
                clicked => {
                    root.text = "";
                }
            }
        }
    }
}