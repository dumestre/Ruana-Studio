import { Button } from "../components/button.slint";
import { Theme } from "../theme.slint";

component PanelHeader inherits Rectangle {
    in property <string> title: "";
    in-out property <bool> expanded: false;
    callback expand-toggle();

    height: 26px;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: LayoutAlignment.space-between;
        cross-axis-alignment: CrossAxisAlignment.center;
        height: 100%;

        Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: 10px;
            font-weight: 600;
        }

        Button {
            width: 22px;
            height: 20px;
            icon: @image-url("../icons/arrow_up.svg");
            icon-size: 12px;
            borderless: true;
            icon-color: Theme.text-dim;
            transform-rotation: root.expanded ? 180deg : 0deg;
            toggled: root.expanded;
            toggled-icon-color: Theme.accent;
            clicked => { root.expand-toggle(); }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }
}

export component SamplerArea inherits Rectangle {
    in-out property <bool> expanded: false;
    callback expand-toggle();

    background: Theme.base;

    VerticalLayout {
        spacing: 0;
        alignment: LayoutAlignment.stretch;
        cross-axis-alignment: CrossAxisAlignment.stretch;

        PanelHeader {
            title: "Sampler";
            expanded <=> root.expanded;
            expand-toggle => { root.expand-toggle(); }
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.base;
            vertical-stretch: 1;
        }
    }
}