import { Button } from "../components/button.slint";
import { Theme } from "../theme.slint";

export component BottomToolbar inherits Rectangle {
    in-out property <int> selected-tab: 0;

    height: 32px;
    in-out property <length> toolbar-height:
        self.height;
    background: Theme.base;

    Rectangle {
        width: 100%;
        height: 1px;
        background: Theme.border;
    }

    // Tab bar
    HorizontalLayout {
        spacing: 1px;
        alignment: LayoutAlignment.stretch;
        cross-axis-alignment: CrossAxisAlignment.stretch;
        height: 100%;

        // Tab: Mixer
        Button {
            text: "Mixer";
            width: 80px;
            height: 30px;
            toggled: root.selected-tab == 0;
            toggled-bg: Theme.accent;
            clicked => { root.selected-tab = 0; }
        }

        // Tab: Sampler
        Button {
            text: "Sampler";
            width: 80px;
            height: 30px;
            toggled: root.selected-tab == 1;
            toggled-bg: Theme.accent;
            clicked => { root.selected-tab = 1; }
        }

        // Tab: Piano Roll
        Button {
            text: "Piano Roll";
            width: 90px;
            height: 30px;
            toggled: root.selected-tab == 2;
            toggled-bg: Theme.accent;
            clicked => { root.selected-tab = 2; }
        }

        // Tab: Explorer
        Button {
            text: "Explorer";
            width: 80px;
            height: 30px;
            toggled: root.selected-tab == 3;
            toggled-bg: Theme.accent;
            clicked => { root.selected-tab = 3; }
        }
    }
}