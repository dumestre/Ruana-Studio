import { Button } from "../components/button.slint";
import { Theme } from "../theme.slint";

export component BottomToolbar inherits Rectangle {
    in-out property <int> selected-tab: 0;
    in-out property <bool> sampler-visible: true;
    in-out property <bool> piano-visible: false;
    in-out property <bool> explorer-visible: true;
    in-out property <bool> mixer-visible: true;

    height: 40px;
    in-out property <length> toolbar-height:
        self.height;
    background: Theme.surface;

    // Tab bar
    HorizontalLayout {
        spacing: 1px;
        alignment: LayoutAlignment.stretch;
        cross-axis-alignment: CrossAxisAlignment.stretch;

        // Tab: Sampler
        Button {
            text: "S";
            width: 40px;
            height: 38px;
            toggled: root.selected-tab == 0;
            toggled-bg: Theme.accent;
            clicked => {
                root.selected-tab = 0;
                root.sampler-visible = true;
                root.piano-visible = false;
            }
        }

        // Tab: Piano Roll
        Button {
            text: "P";
            width: 40px;
            height: 38px;
            toggled: root.selected-tab == 1;
            toggled-bg: Theme.accent;
            clicked => {
                root.selected-tab = 1;
                root.sampler-visible = false;
                root.piano-visible = true;
            }
        }

        // Tab: Explorer
        Button {
            text: "E";
            width: 40px;
            height: 38px;
            toggled: root.selected-tab == 2;
            toggled-bg: Theme.accent;
            clicked => {
                root.selected-tab = 2;
                // Explorer visibility handled separately
            }
        }

        // Tab: Mixer
        Button {
            text: "M";
            width: 40px;
            height: 38px;
            toggled: root.selected-tab == 3;
            toggled-bg: Theme.accent;
            clicked => {
                root.selected-tab = 3;
                root.mixer-visible = !root.mixer-visible;
            }
        }
    }

    // Sampler area - shows when selected-tab == 0
    Rectangle {
        visible: root.selected-tab == 0;
        width: 100%;
        height: root.toolbar-height;
        background: Theme.base;
    }

    // Piano Roll area - shows when selected-tab == 1
    Rectangle {
        visible: root.selected-tab == 1;
        width: 100%;
        height: root.toolbar-height;
        background: Theme.base;
    }

    // Timeline area - shows when selected-tab >= 2
    Rectangle {
        visible: root.selected-tab >= 2;
        width: 100%;
        height: root.toolbar-height;
        background: Theme.base;
    }
}