import { Theme } from "../theme.slint";

export component Fader inherits Rectangle {
    // ============================================================
    // ESTADO E PROPRIEDADES
    // ============================================================
    in-out property <float> value: 0.75;
    in-out property <string> db-text: "0.0";
    in property <string> caption: "";

    // Animação para deslizamento suave estilo fader motorizado
    animate value { duration: 120ms; easing: ease-out; }

    callback changed(float);
    callback value-accepted(string);

    width: 48px;
    height: 180px;

    // ============================================================
    // FUNÇÕES PURAS DE CONVERSÃO DE ESCALA (-60dB a +6dB)
    // ============================================================
    pure function db-to-position(db: float) -> float {
        if db <= -60 { return 0; }
        if db <= 0 { return ((db + 60) / 60) * 0.75; }
        return 0.75 + (db / 6) * 0.25;
    }

    pure function position-to-db(v: float) -> float {
        if v <= 0 { return -60; }
        if v <= 0.75 { return -60 + ((v / 0.75) * 60); }
        return ((v - 0.75) / 0.25) * 6;
    }

    // ============================================================
    // HEADER: INPUT NUMÉRICO DE DB (Aceita '-', '+' e '.')
    // ============================================================
    input-box := Rectangle {
        x: (parent.width - self.width) / 2;
        y: 0px;
        width: 42px;
        height: 18px;
        background: Theme.surface-high;
        border-radius: 3px;

        input := TextInput {
            width: 100%;
            height: 100%;
            text: root.db-text;
            color: Theme.text-primary;
            font-size: 10px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;

            accepted => {
                let parsed-db = self.text.to-float();
                let clamped-db = max(-60.0, min(6.0, parsed-db));
                
                root.value = root.db-to-position(clamped-db);
                root.changed(root.value);
                root.value-accepted(self.text);
                
                self.clear-focus();
            }
        }
    }

    // ============================================================
    // ÁREA DO FADER VERTICAL (TRILHO, MARCAÇÕES E CAP)
    // ============================================================
    fader-area := Rectangle {
        x: 0px;
        y: 22px;
        width: parent.width;
        height: parent.height - 38px; // Desconta Input e Caption

        // TRILHO BASE
        track := Rectangle {
            x: (parent.width - self.width) / 2;
            y: 0px;
            width: 4px;
            height: parent.height;
            background: Theme.surface-high;
            border-radius: 2px;

            // PREENCHIMENTO NORMAL (Base até 0 dB / 75%)
            Rectangle {
                x: 0px;
                y: parent.height * (1.0 - min(root.value, 0.75));
                width: parent.width;
                height: parent.height * min(root.value, 0.75);
                background: Theme.accent;
                opacity: 0.6;
                border-radius: 2px;
            }

            // PREENCHIMENTO HEADROOM (0 dB até +6 dB)
            Rectangle {
                x: 0px;
                y: parent.height * (1.0 - root.value);
                width: parent.width;
                height: max(0px, parent.height * (root.value - 0.75));
                background: Theme.accent;
                opacity: 0.25;
                border-radius: 2px;
            }

            // MARCAÇÕES VISUAIS DA ESCALA VERTICAL
            Rectangle { x: -6px; y: 0px; width: 5px; height: 1px; background: Theme.text-dim; opacity: 0.65; } // +6 dB
            Rectangle { x: -5px; y: parent.height * 0.125; width: 4px; height: 1px; background: Theme.text-dim; opacity: 0.5; } // +3 dB
            
            // Marca 0 dB (Destaque Principal)
            Rectangle { x: -8px; y: parent.height * 0.25 - 0.5px; width: 7px; height: 2px; background: Theme.text-primary; border-radius: 1px; } 
            
            Rectangle { x: -5px; y: parent.height * 0.325; width: 4px; height: 1px; background: Theme.text-dim; opacity: 0.5; } // -6 dB
            Rectangle { x: -5px; y: parent.height * 0.40; width: 4px; height: 1px; background: Theme.text-dim; opacity: 0.5; } // -12 dB
            Rectangle { x: -4px; y: parent.height * 0.55; width: 3px; height: 1px; background: Theme.text-dim; opacity: 0.35; } // -24 dB
            Rectangle { x: -6px; y: parent.height - 1px; width: 5px; height: 1px; background: Theme.text-dim; opacity: 0.65; } // -60 dB

            // RÓTULO DE ZERO DB
            Text {
                x: 8px;
                y: parent.height * 0.25 - 5px;
                text: "0";
                color: Theme.text-primary;
                font-size: 8px;
                font-weight: 700;
            }
        }

        // INTERAÇÃO DO MOUSE (Mapeamento vertical 0.0 na base e 1.0 no topo)
        touch := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: pointer;

            moved => {
                if (self.pressed) {
                    root.value = max(0.0, min(1.0, 1.0 - (self.mouse-y / self.height)));
                    root.changed(root.value);
                }
            }

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.value = max(0.0, min(1.0, 1.0 - (self.mouse-y / self.height)));
                    root.changed(root.value);
                }
            }
        }

        // BOTAO/CAP DO FADER (O centro do Cap coincide perfeitamente com o valor)
        fader-cap := Image {
            width: 30px;
            height: 22px;
            x: (parent.width - self.width) / 2;
            
            y: (parent.height * (1.0 - root.value)) - (self.height / 2);

            source: @image-url("../icons/fader.png");
            horizontal-tiling: ImageTiling.none;
            image-fit: ImageFit.contain;
            image-rendering: ImageRendering.smooth;
        }
    }

    // ============================================================
    // BOTTOM: CAPTION / RÓTULO
    // ============================================================
    if root.caption != "" : Text {
        x: 0px;
        y: parent.height - 12px;
        width: parent.width;
        height: 12px;
        text: root.caption;
        color: Theme.text-dim;
        font-size: 9px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}