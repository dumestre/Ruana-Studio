import { Theme } from "../theme.slint";

export component Meter {
    in property <float> level: 0.0;
    in property <bool> active: false;

    width: 8px;
    min-height: 40px;

    // ==========================================
    // CORES
    // ==========================================

    property <color> bar-color:
        root.level > 0.92
            ? Theme.danger
            : root.level > 0.75
                ? Theme.warn
                : Theme.ok;

    // ==========================================
    // SMOOTH LEVEL
    //
    // SEM animação Slint: o smoothing (attack instantâneo,
    // decay lento) é feito no Rust a cada tick do timer.
    // Animações aqui mantêm o renderer sob carga contínua
    // e travam o playhead durante o playback.
    // ==========================================

    property <float> smooth-level: root.level;

    // ==========================================
    // BACKGROUND
    // ==========================================

    Rectangle {
        width: 100%;
        height: 100%;

        background: Theme.surface-high;

        border-radius: 3px;
        border-width: 1px;
        border-color: Theme.border;
    }

    // ==========================================
    // LEVEL
    // ==========================================

    Rectangle {
        width: 100%;

        height: parent.height * root.smooth-level;

        y: parent.height - self.height;

        background: root.bar-color;

        border-radius: 3px;

        states [
            idle when !root.active: {
                opacity: 0.55;
            }
        ]
    }
}