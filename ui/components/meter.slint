import { Theme } from "../theme.slint";
import { StereoMeter } from "meter_reuse.slint";

export component Meter inherits Rectangle {
    in property <float> left-level: 0.0;
    in property <float> right-level: 0.0;
    in property <float> left-peak: 0.0;
    in property <float> right-peak: 0.0;
    in property <bool> left-clipped: false;
    in property <bool> right-clipped: false;
    in property <bool> active: false;

    // Fader cap position properties
    in property <bool> show-fader-cap: true;
    in property <float> left-cap-position: 0.0;
    in property <float> right-cap-position: 0.0;

    width: 13px;
    min-height: 40px;

    StereoMeter {
        width: 100%;
        height: 100%;

        left-level: root.left-level;
        right-level: root.right-level;
        left-peak: root.left-peak;
        right-peak: root.right-peak;
        left-clipped: root.left-clipped;
        right-clipped: root.right-clipped;

        meter-width: 5px;
        channel-gap: 2px;
        meter-background: Theme.surface-high;
        meter-border: Theme.border;

        show-fader-cap: root.show-fader-cap;
        left-cap-position: root.left-cap-position;
        right-cap-position: root.right-cap-position;
    }
}