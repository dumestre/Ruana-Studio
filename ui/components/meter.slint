import { Theme } from "../theme.slint";

export component Meter {
    in property <float> level: 0.0;
    in property <bool> active: false;
    in property <length> meter-height: 90px;

    width: 12px;
    height: root.meter-height;

    property <color> bar-color: self.level > 0.92 ? Theme.danger : self.level > 0.75 ? Theme.warn : Theme.ok;
    property <float> smooth-level: self.level;

    animate smooth-level {
        duration: 70ms;
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.surface-high;
        border-radius: 3px;
        border-width: 1px;
        border-color: Theme.border;
    }

    Rectangle {
        width: 100%;
        height: parent.height * root.smooth-level;
        y: parent.height - self.height;
        background: root.bar-color;
        border-radius: 3px;

        states [
            idle when !root.active: {
                opacity: 0.55;
            }
        ]
    }
}
