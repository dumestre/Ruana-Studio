import { Theme } from "../theme.slint";
import { StereoMeter } from "meter_reuse.slint";
import { AudioScale } from "audio_scale.slint";

// ============================================================
// METER — estilo Ableton Live
//
// Layout horizontal: triângulo (fader) à esquerda, meter no centro,
// e níveis de dB à direita. O triângulo é o indicador de volume,
// posicionado verticalmente conforme o volume. O meter mostra os
// níveis de áudio L/R.
// ============================================================

export component Meter inherits Rectangle {
    // ========================================================
    // MEDIÇÃO (normalizada em dB, ver `app/src/meters.rs`)
    // ========================================================

    in property <float> left-level: 0.0;
    in property <float> right-level: 0.0;
    in property <float> left-peak: 0.0;
    in property <float> right-peak: 0.0;
    in property <bool> left-clipped: false;
    in property <bool> right-clipped: false;

    in property <int> channel-index: 0;
    in property <color> fader-color: Theme.text-primary;

    // ========================================================
    // VOLUME
    // ========================================================

    in-out property <float> volume: 0.8;
    in property <bool> signal-fill-only: false;
    private property <bool> show-volume-control: !root.signal-fill-only;

    // ========================================================
    // CALLBACKS
    // ========================================================

    callback volume-changed(float);
    callback clip-cleared(int);

    // ========================================================
    // GEOMETRIA
    // ========================================================

    private property <length> triangle-width: 14px;
    private property <length> meter-width: 14px;
    private property <length> db-width: 24px;
    private property <length> tick-width: 3px;
    private property <length> tick-gap: 3px;
    private property <length> gap: 2px;
    private property <length> fader-gap: 5px;
    // Centraliza a barra no canal; os demais elementos são ancorados nela.
    private property <length> meter-x: (root.width - root.meter-width) / 2;
    private property <length> tick-x: root.meter-x - root.tick-gap - root.tick-width;
    private property <length> fader-x: root.tick-x - root.fader-gap - root.triangle-width;
    private property <[float]> scale-db: [6.0, 0.0, -6.0, -12.0, -18.0, -24.0, -30.0, -36.0, -42.0, -48.0, -54.0, -60.0];

    width: show-volume-control ? 90px : 8px;
    min-height: 40px;

    // ========================================================
    // TRIÂNGULO DE VOLUME (esquerda)
    // ========================================================

    if root.show-volume-control : Rectangle {
        x: root.fader-x;
        y: 0px;
        width: root.triangle-width;
        height: parent.height;

        background: transparent;

        border-radius: 3px;

        touch := TouchArea {
            width: 100%;
            height: 100%;

            moved => {
                root.volume = Math.max(0.0, Math.min(1.0,
                    (1.0 - (self.mouse-y / self.height))
                    * (AudioScale.db-ceiling - AudioScale.db-floor)
                    / (0.0 - AudioScale.db-floor)));
                root.volume-changed(root.volume);
            }

            clicked => {
                root.volume = Math.max(0.0, Math.min(1.0,
                    (1.0 - (self.mouse-y / self.height))
                    * (AudioScale.db-ceiling - AudioScale.db-floor)
                    / (0.0 - AudioScale.db-floor)));
                root.volume-changed(root.volume);
            }
        }

        Image {
            source: @image-url("../icons/play.svg");

            width: 16px;
            height: 16px;

            // Centralizado verticalmente na posição do volume
            x: (parent.width - self.width) / 2;
            y: Math.max(0px, Math.min(parent.height - self.height,
                parent.height * (1.0 - root.volume * (0.0 - AudioScale.db-floor)
                    / (AudioScale.db-ceiling - AudioScale.db-floor)) - self.height / 2));

            horizontal-tiling: ImageTiling.none;
            image-fit: ImageFit.contain;
            image-rendering: ImageRendering.smooth;

            colorize: root.fader-color;

            z: 10;
        }
    }

    // ========================================================
    // METER (centro)
    // ========================================================

    Rectangle {
        x: root.show-volume-control ? root.meter-x : 0px;
        y: 0px;
        width: root.meter-width;
        height: parent.height;

        StereoMeter {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;

            left-level: root.left-level;
            right-level: root.right-level;
            left-peak: root.left-peak;
            right-peak: root.right-peak;
            left-clipped: root.left-clipped;
            right-clipped: root.right-clipped;

            meter-width: 6.5px;
            channel-gap: 0px;
            meter-background: #B8B8B8;
            meter-border: transparent;
        }

        // ================================================
        // A barra permanece limpa no topo; o clip segue indicado pela
        // cor vermelha do pico e pode ser limpo clicando na barra.
        // ================================================

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.clip-cleared(root.channel-index); }
        }
    }

    // ========================================================
    // NÍVEIS DE dB (direita)
    // ========================================================

    if root.show-volume-control : Rectangle {
        x: root.meter-x + root.meter-width + root.gap;
        y: 0px;
        width: root.db-width;
        height: parent.height;

        for db in root.scale-db : Text {
            property <float> position: (db - AudioScale.db-floor) / (AudioScale.db-ceiling - AudioScale.db-floor);
            text: db.to-fixed(0);
            color: Theme.text-primary;
            font-size: 9px;
            horizontal-alignment: left;
            vertical-alignment: center;
            width: parent.width;
            height: 7px;
            y: Math.max(0px, Math.min(parent.height - self.height,
                parent.height * (1.0 - self.position) - self.height / 2));
        }
    }

    // Marcas da escala ficam entre o fader e a barra, alinhadas aos
    // números da direita na mesma posição vertical em dB.
    if root.show-volume-control: Rectangle {
        x: root.tick-x;
        width: root.tick-width;
        height: parent.height;
        background: transparent;

        for db in root.scale-db : Rectangle {
            property <float> position: (db - AudioScale.db-floor) / (AudioScale.db-ceiling - AudioScale.db-floor);
            x: 0px;
            y: Math.max(0px, Math.min(parent.height - self.height,
                parent.height * (1.0 - self.position) - self.height / 2));
            width: parent.width;
            height: 1px;
            background: Theme.text-primary;
        }
    }
}
