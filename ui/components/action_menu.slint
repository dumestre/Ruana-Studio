import { Theme } from "../theme.slint";

export struct ActionMenuItem {
    id: string,
    text: string,
    shortcut: string,
    enabled: bool,
    separator: bool,
    danger: bool,
}

export component ActionMenu inherits Rectangle {
    in property <[ActionMenuItem]> items;
    in property <length> menu-width: 220px;

    callback item-clicked(string);

    width: menu-width;

    background: Theme.surface;

    border-width: 1px;
    border-color: Theme.border;
    border-radius: 5px;

    clip: true;

    VerticalLayout {
        padding: 4px;
        spacing: 2px;

        for item in root.items : Rectangle {
            width: 100%;
            height: item.separator ? 7px : 30px;

            if item.separator : Rectangle {
                Rectangle {
                    x: 5px;
                    y: 3px;

                    width: parent.width - 10px;
                    height: 1px;

                    background: Theme.border;
                }
            }

            if !item.separator : Rectangle {
                border-radius: 3px;

                TouchArea {
                    enabled: item.enabled;

                    clicked => {
                        root.item-clicked(item.id);
                    }

                    Rectangle {
                        width: parent.width;
                        height: parent.height;

                        background: parent.has-hover
                            ? Theme.surface-high
                            : transparent;

                        border-radius: 3px;

                        HorizontalLayout {
                            padding-left: 9px;
                            padding-right: 9px;

                            Text {
                                text: item.text;

                                color: item.enabled
                                    ? (item.danger
                                        ? Theme.danger
                                        : Theme.text-primary)
                                    : Theme.text-dim;

                                font-size: 13px;

                                vertical-alignment: center;
                                horizontal-alignment: left;
                            }

                            Text {
                                text: item.shortcut;

                                color: Theme.text-dim;

                                font-size: 11px;

                                horizontal-alignment: right;
                                vertical-alignment: center;

                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }
        }
    }
}