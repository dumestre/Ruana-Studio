import { Theme } from "../theme.slint";
import { ScrollBarHorizontal } from "../components/scrollbar.slint";
import { ZoomBarHorizontal } from "../components/zoom_bar.slint";

export component HorizontalBarTool inherits Rectangle {

// =====================================================
// SCROLL HORIZONTAL
// =====================================================

in-out property <length> scroll-x: 0px;

in property <length> scroll-max-x: 0px;

in property <length> scroll-thumb-size-x: 100px;


// =====================================================
// ZOOM HORIZONTAL
// =====================================================

in-out property <float> zoom-x: 1.0;

in property <float> zoom-min-x: 0.5;

in property <float> zoom-max-x: 4.0;


// =====================================================
// TAMANHO
// =====================================================

in property <length> zoom-width: 220px;


background: Theme.surface;

border-radius: 3px;


VerticalLayout {

    width: parent.width;

    alignment: LayoutAlignment.stretch;
    cross-axis-alignment: CrossAxisAlignment.stretch;
    height: parent.height;

    spacing: 2px;


    // =================================================
    // SCROLL HORIZONTAL
    // =================================================

    ScrollBarHorizontal {


        height: 16px;
        horizontal-stretch: 1;

        value <=> root.scroll-x;

        max-value:
            root.scroll-max-x;

        thumb-size:
            root.scroll-thumb-size-x;
        width: 220px;
    }


    // =================================================
    // ZOOM HORIZONTAL
    // =================================================

    ZoomBarHorizontal {

        width: root.zoom-width;



        value <=> root.zoom-x;

        min-value:
            root.zoom-min-x;

        horizontal-stretch: 1;
        max-value:
            root.zoom-max-x;
    }
}
}