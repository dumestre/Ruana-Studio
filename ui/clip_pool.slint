// ============================================================
// ui/clip_pool.slint
// ============================================================

import { Theme } from "theme.slint";
import { ClipData } from "timeline/clip_data.slint";


// ============================================================
// CLIP ITEM VISUAL
// ============================================================

export component ClipItemVisual inherits Rectangle {

    // ========================================================
    // DADOS
    // ========================================================

    in property <string> name: "";

    in property <string> position: "";

    in property <string> duration: "";

    in property <color> clip-color:
        Theme.clip-midi;

    in property <bool> is-midi:
        true;


    // ========================================================
    // VISUAL
    // ========================================================

    height:
        38px;

    background:
        Theme.surface-high;

    border-radius:
        4px;

    border-width:
        1px;

    border-color:
        Theme.border;


    HorizontalLayout {

        cross-axis-alignment:
            CrossAxisAlignment.center;

        padding-left:
            0px;

        padding-right:
            6px;

        spacing:
            8px;


        // ====================================================
        // INDICADOR DE COR
        // ====================================================

        Rectangle {

            width:
                4px;

            height:
                90%;

            background:
                root.clip-color;

            border-radius:
                8px;
        }


        // ====================================================
        // INFORMAÇÕES
        // ====================================================

        VerticalLayout {

            spacing:
                2px;


            Text {

                text:
                    root.name;

                color:
                    Theme.text-primary;

                font-size:
                    11px;

                vertical-alignment:
                    center;

                overflow:
                    elide;
            }


            Text {

                visible:
                    root.position != ""
                    || root.duration != "";

                text:
                    "Pos "
                    + root.position
                    + "  ·  Len "
                    + root.duration;

                color:
                    Theme.text-dim;

                font-size:
                    9px;

                vertical-alignment:
                    center;

                overflow:
                    elide;
            }
        }
    }
}


// ============================================================
// CLIP ITEM
// ============================================================

component ClipItem inherits ClipItemVisual {

    // ========================================================
    // DRAG
    // ========================================================

    in-out property <bool> drag-active:
        false;

    callback drag-started(
        string,
        string,
        string,
        color,
        bool
    );

    callback drag-moved(
        length,
        length
    );

    callback drag-finished();


    // ========================================================
    // CLIQUE
    // ========================================================

    callback clicked();


    // ========================================================
    // VISUAL DRAG
    // ========================================================

    opacity:
        root.drag-active
            ? 0.35
            : 1.0;

    animate opacity {
        duration:
            120ms;
    }


    // ========================================================
    // TOUCH
    // ========================================================

    touch := TouchArea {

        x:
            0px;

        y:
            0px;

        width:
            parent.width;

        height:
            parent.height;

        mouse-cursor:
            grab;


        property <bool> is-down:
            false;

        property <length> press-x:
            0px;

        property <length> press-y:
            0px;

        property <bool> did-drag:
            false;


        // ====================================================
        // POINTER
        // ====================================================

        pointer-event(event) => {

            // =================================================
            // MOUSE DOWN
            // =================================================

            if event.kind
                == PointerEventKind.down
                && event.button
                == PointerEventButton.left {

                self.is-down =
                    true;

                self.did-drag =
                    false;

                self.press-x =
                    self.mouse-x;

                self.press-y =
                    self.mouse-y;
            }


            // =================================================
            // MOUSE UP
            // =================================================

            else if event.kind
                == PointerEventKind.up
                && self.is-down {

                self.is-down =
                    false;


                // ---------------------------------------------
                // CLIQUE PURO
                // ---------------------------------------------

                if !self.did-drag {

                    root.clicked();
                }


                // ---------------------------------------------
                // FINALIZA DRAG
                // ---------------------------------------------

                if root.drag-active {

                    root.drag-active =
                        false;

                    root.drag-finished();
                }
            }


            // =================================================
            // MOUSE MOVE
            // =================================================

            else if event.kind
                == PointerEventKind.move
                && self.is-down {

                if !root.drag-active {

                    let dx =
                        self.mouse-x
                        - self.press-x;

                    let dy =
                        self.mouse-y
                        - self.press-y;


                    if (dx < 0px ? -dx : dx) > 6px
                        || (dy < 0px ? -dy : dy) > 6px {

                        self.did-drag =
                            true;

                        root.drag-active =
                            true;

                        root.drag-started(
                            root.name,
                            root.position,
                            root.duration,
                            root.clip-color,
                            root.is-midi
                        );
                    }
                }


                if root.drag-active {

                    let win =
                        self.absolute-position;

                    root.drag-moved(
                        self.mouse-x + win.x,
                        self.mouse-y + win.y
                    );
                }
            }
        }
    }
}


// ============================================================
// CLIP POOL
// ============================================================

export component ClipPool inherits Rectangle {

    // ========================================================
    // DADOS
    // ========================================================

    in-out property <int> selected-track:
        0;

    in property <[string]> track-names:
        [
            "Drums",
            "Bass",
            "Vocal",
            "Synth"
        ];

    in property <[ClipData]> clips:
        [];


    // ========================================================
    // CALLBACKS
    // ========================================================

    callback track-selected(
        int
    );

    callback clip-clicked(
        int
    );

    callback clip-drag-started(
        string,
        string,
        string,
        color,
        bool
    );

    callback clip-drag-moved(
        length,
        length
    );

    callback clip-drag-finished();


    // ========================================================
    // PALETA
    // ========================================================

    private property <[color]> palette: [

        #6FA86B,
        #4F8AE0,
        #E0A94F,
        #E05E5E,
        #A060D8,
        #E05EAA,
        #3EC7B0,
        #C0C050
    ];

    private property <color> audio-default:
        #00C853;


    // ========================================================
    // DIMENSÕES
    // ========================================================

    preferred-width:
        230px;

    background:
        Theme.surface;


    // ========================================================
    // BORDA DIREITA
    // ========================================================

    Rectangle {

        x:
            parent.width - 1px;

        y:
            0px;

        width:
            1px;

        height:
            100%;

        background:
            Theme.border;
    }


    // ========================================================
    // CONTEÚDO
    // ========================================================

    VerticalLayout {

        alignment:
            LayoutAlignment.stretch;

        cross-axis-alignment:
            CrossAxisAlignment.stretch;

        padding:
            8px;

        spacing:
            8px;


        // ====================================================
        // CABEÇALHO
        // ====================================================

        Rectangle {

            width:
                100%;

            height:
                28px;

            background:
                Theme.surface-high;

            border-radius:
                4px;


            HorizontalLayout {

                alignment:
                    LayoutAlignment.stretch;

                cross-axis-alignment:
                    CrossAxisAlignment.center;

                spacing:
                    6px;


                Image {

                    source:
                        @image-url(
                            "icons/clippool.svg"
                        );

                    width:
                        22px;

                    height:
                        22px;
                }


                Text {

                    text:
                        "Clip Pool";

                    color:
                        Theme.accent;

                    font-size:
                        12px;

                    font-weight:
                        700;

                    horizontal-alignment:
                        center;

                    vertical-alignment:
                        center;

                    overflow:
                        elide;

                    horizontal-stretch:
                        1;
                }
            }
        }


        // ====================================================
        // LISTA
        // ====================================================

        clips-list := VerticalLayout {

            spacing:
                4px;


            for clip[i] in root.clips: ClipItem {

                visible:
                    clip.track-index
                    == root.selected-track;


                // ============================================
                // DADOS
                // ============================================

                name:
                    clip.name;

                position:
                    Math.round(
                        clip.beat * 10
                    ) / 10;

                duration:
                    Math.round(
                        clip.len * 10
                    ) / 10;


                // ============================================
                // COR
                // ============================================

                clip-color:
                    clip.color == 0
                        ? (
                            clip.is-midi
                                ? Theme.clip-midi
                                : root.audio-default
                        )
                        : root.palette[
                            Math.mod(
                                clip.color,
                                root.palette.length
                            )
                        ];


                // ============================================
                // TIPO
                // ============================================

                is-midi:
                    clip.is-midi;


                // ============================================
                // CLIQUE
                // ============================================

                clicked => {

                    root.clip-clicked(
                        clip.id
                    );
                }


                // ============================================
                // DRAG START
                // ============================================

                drag-started(
                    n,
                    p,
                    d,
                    c,
                    m
                ) => {

                    root.clip-drag-started(
                        n,
                        p,
                        d,
                        c,
                        m
                    );
                }


                // ============================================
                // DRAG MOVE
                // ============================================

                drag-moved(
                    x,
                    y
                ) => {

                    root.clip-drag-moved(
                        x,
                        y
                    );
                }


                // ============================================
                // DRAG FINISH
                // ============================================

                drag-finished => {

                    root.clip-drag-finished();
                }
            }
        }


        // ====================================================
        // ESPAÇADOR
        // ====================================================

        Rectangle {

            horizontal-stretch:
                1;

            background:
                transparent;
        }


        // ====================================================
        // STATUS
        // ====================================================

        Text {

            text:
                "Selection: "
                + (
                    root.selected-track + 1
                );

            color:
                Theme.text-dim;

            font-size:
                10px;

            horizontal-alignment:
                left;
        }
    }
}