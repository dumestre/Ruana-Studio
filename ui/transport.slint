import { Button } from "components/button.slint";
import { Theme } from "theme.slint";

export component Transport inherits Rectangle {
    in-out property <bool> playing: false;
    in-out property <bool> recording: false;
    in-out property <bool> loop-enabled: false;
    in-out property <bool> metronome-enabled: false;
    in-out property <int> position: 0;
    in property <int> bpm: 120;
    in property <int> beats-per-bar: 4;
    in property <int> ppq: 960;

    callback play-state-changed(bool);
    callback record-state-changed(bool);
    callback loop-state-changed(bool);
    callback metronome-state-changed(bool);

    // BPM novo (inteiro). O backend atualiza o Transport e
    // re-ancora o clock visual do playhead com a nova taxa.
    callback set-bpm(float);

    property <int> ticks-per-bar: self.ppq * self.beats-per-bar;
    property <int> bars: self.position / self.ticks-per-bar + 1;
    property <int> beat: Math.mod(self.position, self.ticks-per-bar) / self.ppq + 1;
    property <int> ticks: Math.mod(self.position, self.ppq);

    function pad2(v: int) -> string {
        return v < 10 ? "0" + v : "" + v;
    }

    
    height: 48px;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 6px;
        alignment: LayoutAlignment.center;
        cross-axis-alignment: CrossAxisAlignment.center;

        Button {
            icon: @image-url("icons/skip_back.svg");
            clicked => {
                root.position = 0;
            }
        }
        Button {
            icon: @image-url("icons/skip_fwd.svg");
            clicked => {
                root.position = root.ticks-per-bar * 15;
            }
        }
        Button {
            icon: root.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
            icon-color: Theme.accent;
            toggled: root.playing;
            toggled-bg: #f26a21;
            subtle-toggled: true;
            toggled-icon-color: Theme.accent;
            clicked => {
                root.playing = !root.playing;
                root.play-state-changed(root.playing);
            }
        }
        Button {
            icon: @image-url("icons/stop.svg");
            clicked => {
                root.playing = false;
                root.play-state-changed(false);
            }
        }
        Button {
            icon: @image-url("icons/rec.svg");
            icon-color: Theme.danger;
            toggled: root.recording;
            toggled-bg: Theme.danger;
            toggled-fg: #1E1E1E;
            clicked => {
                root.recording = !root.recording;
                root.record-state-changed(root.recording);
            }
        }
        Button {
            icon: @image-url("icons/loop.svg");
            toggled: root.loop-enabled;
            subtle-toggled: true;
            toggled-icon-color: Theme.accent;
            clicked => {
                root.loop-enabled = !root.loop-enabled;
                root.loop-state-changed(root.loop-enabled);
            }
        }

        Rectangle {
            width: 120px;
            height: 26px;
            background: Theme.base;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;

            

            Text {
                text: root.pad2(root.bars) + ":" + root.pad2(root.beat) + ":" + root.pad2(root.ticks);
                color: Theme.accent;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: LayoutAlignment.stretch;
            cross-axis-alignment: CrossAxisAlignment.center;

            Button {
                icon: @image-url("icons/metronome.svg");
                icon-size: 28px;
                borderless: true;
                keep-icon-color: true;
                toggled: root.metronome-enabled;
                preferred-width: 20px;
                subtle-toggled: true;
                toggled-icon-color: #0eec2c;
                clicked => {
                    root.metronome-enabled = !root.metronome-enabled;
                    root.metronome-state-changed(root.metronome-enabled);
                }
            }
             Rectangle {
            width: 1px;
            height: 20px;
            background: Theme.border;
        }

            Text {
                text: "" + root.bpm;
                color: Theme.accent;
                font-size: 12px;
                horizontal-alignment: TextHorizontalAlignment.center;
                vertical-alignment: center;
            }

            // BPM interativo: arrastar vertical (3px = ±1 BPM)
            // ou scroll do mouse. Limites 20–300.
            Rectangle {
                width: 34px;
                height: 20px;
                background: transparent;

                property <length> anchor-y: 0px;
                property <int> anchor-value: 120;

                Text {
                    text: "BPM";
                    color: Theme.text-primary;
                    font-size: 12px;
                    horizontal-alignment: TextHorizontalAlignment.center;
                    vertical-alignment: center;
                }

                TouchArea {
                    mouse-cursor: MouseCursor.ns_resize;

                    pointer-event(ev) => {
                        if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                            parent.anchor-y = self.mouse-y;
                            parent.anchor-value = root.bpm;
                        }
                    }

                    moved => {
                        let steps = Math.floor((parent.anchor-y - self.mouse-y) / 3px);
                        let target = max(20, min(300, parent.anchor-value + steps));
                        if (target != root.bpm) {
                            root.set-bpm(target);
                        }
                    }

                    scroll-event(e) => {
                        if (e.delta-y > 0) {
                            root.set-bpm(min(300, root.bpm + 1));
                        } else {
                            root.set-bpm(max(20, root.bpm - 1));
                        }
                        accept;
                    }
                }
            }
        }

        Rectangle {
            width: 1px;
            height: 20px;
            background: Theme.border;
        }

        Text {
            text: root.beats-per-bar + "/4";
            color: Theme.accent;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }
}
