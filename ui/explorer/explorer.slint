import { Theme } from "../theme.slint";
import { SearchBar } from "../components/search_bar.slint";
import { FileBrowser } from "file_browser.slint";
import { MediaBrowser } from "media_browser.slint";
import { PluginBrowser } from "plugin_browser.slint";
import { Preview } from "preview.slint";
import { ExplorerHeader } from "explorer_header.slint";
import { ExplorerTabs } from "explorer_tabs.slint";


export component Explorer inherits Rectangle {
    in-out property <int> browser-mode: 0;
    in-out property <string> search-text: "";

    preferred-width: 300px;
    width: 300px;
    

    background: Theme.surface;


    // =====================================================
    // BORDA DIREITA
    // =====================================================

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;

        background: Theme.border;
    }


    VerticalLayout {
        padding: 6px;
        spacing: 6px;


        // =====================================================
        // HEADER
        // =====================================================

        ExplorerHeader {
            menu-clicked => {
                // Menu do Explorer será implementado depois.
            }
        }


        // =====================================================
        // TABS
        // =====================================================

        ExplorerTabs {
            selected <=> root.browser-mode;

            tab-changed => {
                // browser-mode já está sincronizado.
            }
        }


        // =====================================================
        // SEARCH
        // =====================================================

        SearchBar {
            text <=> root.search-text;

            placeholder: root.browser-mode == 0
                ? "Search files..."
                : root.browser-mode == 1
                    ? "Search media..."
                    : "Search plugins...";
        }


        // =====================================================
        // BROWSER
        // =====================================================

        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            background: transparent;

            if root.browser-mode == 0 : FileBrowser {}

            if root.browser-mode == 1 : MediaBrowser {}

            if root.browser-mode == 2 : PluginBrowser {}
        }


        // =====================================================
        // PREVIEW SEPARATOR
        // =====================================================

        Rectangle {
            height: 1px;

            background: Theme.border;
        }


        // =====================================================
        // PREVIEW
        // =====================================================

        Preview {
            file-name: "No file selected";
            file-info: "Select an audio file";
            duration: "00:00";
            progress: 0.0;
            playing: false;

            play => {
                // Ligação com o engine virá depois.
            }

            stop => {
                // Ligação com o engine virá depois.
            }
        }
    }
}