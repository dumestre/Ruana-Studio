import { Theme } from "../theme.slint";
import { BrowserItem } from "../components/browser_item.slint";


export component FileBrowser inherits Rectangle {
    in-out property <string> current-path: "Project";

    background: transparent;

    VerticalLayout {
        alignment: LayoutAlignment.start;
        cross-axis-alignment: CrossAxisAlignment.stretch;
        spacing: 5px;


        // =====================================================
        // NAVEGAÇÃO
        // =====================================================

        Rectangle {
            height: 28px;

            background: Theme.base;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 3px;

            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 2px;
                alignment: LayoutAlignment.stretch;
                cross-axis-alignment: CrossAxisAlignment.center;

                Rectangle {
                    width: 24px;
                    height: 24px;
                    background: transparent;
                    border-radius: 3px;

                    Image {
                        source: @image-url("../icons/arrow_back.svg");

                        width: 14px;
                        height: 14px;

                        colorize: Theme.text-dim;
                    }
                }

                Rectangle {
                    width: 24px;
                    height: 24px;
                    background: transparent;
                    border-radius: 3px;

                    Image {
                        source: @image-url("../icons/arrow_fwd.svg");

                        width: 14px;
                        height: 14px;

                        colorize: Theme.text-dim;
                    }
                }

                Rectangle {
                    width: 24px;
                    height: 24px;
                    background: transparent;
                    border-radius: 3px;

                    Image {
                        source: @image-url("../icons/arrow_up.svg");

                        width: 14px;
                        height: 14px;

                        colorize: Theme.text-dim;
                    }
                }

                Rectangle {
                    width: 1px;
                    height: 16px;

                    background: Theme.border;
                }

                Text {
                    text: root.current-path;

                    color: Theme.text-primary;
                    font-size: 9px;

                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }


        // =====================================================
        // FAVORITES
        // =====================================================

        Rectangle {
            height: 20px;
            background: transparent;

            Text {
                text: "FAVORITES";

                color: Theme.text-dim;
                font-size: 8px;
                font-weight: 700;

                vertical-alignment: center;
            }
        }

        BrowserItem {
            name: "My Samples";
            type: "Folder";
            horizontal-stretch: 1;
            icon: "";
            icon-image: @image-url("../icons/folder.svg");
        }

        BrowserItem {
            name: "Vocals";
            type: "Folder";
            icon: "";
            icon-image: @image-url("../icons/folder.svg");
        }


        // =====================================================
        // PROJECT
        // =====================================================

        Rectangle {
            height: 20px;
            background: transparent;

            Text {
                text: "PROJECT";

                color: Theme.text-dim;
                font-size: 8px;
                font-weight: 700;

                vertical-alignment: center;
            }
        }

        BrowserItem {
            name: "Ferrum Studio";
            type: "Folder";
            icon: "";
            icon-image: @image-url("../icons/folder.svg");
            selected: true;
        }

        BrowserItem {
            name: "Audio";
            type: "Folder";
            icon: "";
            icon-image: @image-url("../icons/folder.svg");
        }

        BrowserItem {
            name: "Samples";
            type: "Folder";
            icon: "";
            icon-image: @image-url("../icons/folder.svg");
        }

        BrowserItem {
            name: "Presets";
            type: "Folder";
            icon: "";
            icon-image: @image-url("../icons/folder.svg");
        }


        // =====================================================
        // COMPUTER
        // =====================================================

        Rectangle {
            height: 20px;
            background: transparent;

            Text {
                text: "COMPUTER";

                color: Theme.text-dim;
                font-size: 8px;
                font-weight: 700;

                vertical-alignment: center;
            }
        }

        BrowserItem {
            name: "This PC";
            type: "Computer";
            icon: "";
            icon-image: @image-url("../icons/disk.svg");
        }

        BrowserItem {
            name: "C:";
            type: "Drive";
            icon: "";
            icon-image: @image-url("../icons/disk.svg");
        }

        BrowserItem {
            name: "D:";
            type: "Drive";
            icon: "";
            icon-image: @image-url("../icons/disk.svg");
        }
    }
}