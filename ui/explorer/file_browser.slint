import { Theme } from "../theme.slint";
import { BrowserItem } from "../components/browser_item.slint";

export struct FileEntry {
    name: string,
    type: string,
}

export component FileBrowser inherits Rectangle {
    in-out property <string> current-path: "Project";

    in property <[FileEntry]> favorites: [
        { name: "My Samples", type: "Folder" },
        { name: "Vocals", type: "Folder" },
    ];

    in property <[FileEntry]> project: [
        { name: "Ferrum Studio", type: "Folder" },
        { name: "Audio", type: "Folder" },
        { name: "Samples", type: "Folder" },
        { name: "Presets", type: "Folder" },
    ];

    in property <[FileEntry]> computer: [
        { name: "This PC", type: "Computer" },
        { name: "C:", type: "Drive" },
        { name: "D:", type: "Drive" },
    ];

    in-out property <int> selected-index: 2;

    callback file-selected(string, string);

    background: transparent;

    VerticalLayout {
        alignment: LayoutAlignment.start;
        cross-axis-alignment: CrossAxisAlignment.stretch;
        spacing: 5px;


        // =====================================================
        // NAVEGAÇÃO
        // =====================================================

        Rectangle {
            height: 28px;

            background: Theme.base;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 3px;

            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 2px;
                alignment: LayoutAlignment.stretch;
                cross-axis-alignment: CrossAxisAlignment.center;

                Rectangle {
                    width: 24px;
                    height: 24px;
                    background: transparent;
                    border-radius: 3px;
                    opacity: 0.45;

                    Image {
                        source: @image-url("../icons/arrow_back.svg");

                        width: 14px;
                        height: 14px;

                        colorize: Theme.text-dim;
                    }
                }

                Rectangle {
                    width: 24px;
                    height: 24px;
                    background: transparent;
                    border-radius: 3px;
                    opacity: 0.45;

                    Image {
                        source: @image-url("../icons/arrow_fwd.svg");

                        width: 14px;
                        height: 14px;

                        colorize: Theme.text-dim;
                    }
                }

                Rectangle {
                    width: 24px;
                    height: 24px;
                    background: transparent;
                    border-radius: 3px;
                    opacity: 0.45;

                    Image {
                        source: @image-url("../icons/arrow_up.svg");

                        width: 14px;
                        height: 14px;

                        colorize: Theme.text-dim;
                    }
                }

                Rectangle {
                    width: 1px;
                    height: 16px;

                    background: Theme.border;
                }

                Text {
                    text: root.current-path;

                    color: Theme.text-primary;
                    font-size: 9px;

                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }


        // =====================================================
        // FAVORITES
        // =====================================================

        Rectangle {
            height: 20px;
            background: transparent;

            Text {
                text: "FAVORITES";

                color: Theme.text-dim;
                font-size: 8px;
                font-weight: 700;

                vertical-alignment: center;
            }
        }

        for entry[index] in root.favorites : BrowserItem {
            name: entry.name;
            type: entry.type;
            selected: root.selected-index == index;
            icon: "";
            icon-image: @image-url("../icons/folder.svg");

            clicked => {
                root.selected-index = index;
                root.file-selected(entry.name, entry.type);
            }
        }


        // =====================================================
        // PROJECT
        // =====================================================

        Rectangle {
            height: 20px;
            background: transparent;

            Text {
                text: "PROJECT";

                color: Theme.text-dim;
                font-size: 8px;
                font-weight: 700;

                vertical-alignment: center;
            }
        }

        for entry[index] in root.project : BrowserItem {
            name: entry.name;
            type: entry.type;
            selected: root.selected-index == root.favorites.length + index;
            icon: "";
            icon-image: @image-url("../icons/folder.svg");

            clicked => {
                root.selected-index = root.favorites.length + index;
                root.file-selected(entry.name, entry.type);
            }
        }


        // =====================================================
        // COMPUTER
        // =====================================================

        Rectangle {
            height: 20px;
            background: transparent;

            Text {
                text: "COMPUTER";

                color: Theme.text-dim;
                font-size: 8px;
                font-weight: 700;

                vertical-alignment: center;
            }
        }

        for entry[index] in root.computer : BrowserItem {
            name: entry.name;
            type: entry.type;
            selected: root.selected-index == root.favorites.length + root.project.length + index;
            icon: "";
            icon-image: @image-url("../icons/disk.svg");

            clicked => {
                root.selected-index = root.favorites.length + root.project.length + index;
                root.file-selected(entry.name, entry.type);
            }
        }
    }
}
