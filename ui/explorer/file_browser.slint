import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { BrowserItem } from "../components/browser_item.slint";

export struct BrowserFileEntry {
    name: string,
    entry-type: string,
    path: string,
    is-directory: bool,
    size: int,
    modified: string,
    extension: string,
}

export component FileBrowser inherits Rectangle {
    in property <[BrowserFileEntry]> entries: [];
    in property <string> current-path: "";
    in property <[string]> path-history: [];
    in property <int> history-index: -1;
    in property <bool> can-go-up: false;

    in-out property <int> selected-index: -1;

    callback path-changed(string);
    callback file-selected(string, string, string); // name, type, path
    callback directory-entered(string); // path
    callback explorer-go-up();
    callback history-go(int);
    callback explorer-go-to-drives(); // Raiz: lista drives

    callback audio-drag-started(string, string, string, color, bool); // name, path, type, color, is-midi
    callback audio-drag-moved(length, length);
    callback audio-drag-finished();

    property <bool> can-back: root.history-index > 0;
    property <bool> can-forward: root.history-index < root.path-history.length - 1;

    background: transparent;

    VerticalLayout {
        alignment: LayoutAlignment.stretch;
        cross-axis-alignment: CrossAxisAlignment.stretch;
        spacing: 5px;

        // NAVEGAÇÃO
        Rectangle {
            height: 32px;
            vertical-stretch: 0;
            background: Theme.base;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 3px;

            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 2px;
                alignment: LayoutAlignment.stretch;
                cross-axis-alignment: CrossAxisAlignment.center;

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: back-touch.has-hover && root.can-back
                        ? Theme.surface-high
                        : transparent;
                    border-radius: 3px;
                    opacity: root.can-back ? 1.0 : 0.45;

                    Image {
                        source: @image-url("../icons/arrow_back.svg");
                        width: 16px;
                        height: 16px;
                        colorize: Theme.text-dim;
                    }

                    back-touch := TouchArea {
                        mouse-cursor: root.can-back
                            ? MouseCursor.pointer
                            : MouseCursor.default;

                        clicked => {
                            if root.can-back {
                                root.history-go(-1);
                            }
                        }
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: fwd-touch.has-hover && root.can-forward
                        ? Theme.surface-high
                        : transparent;
                    border-radius: 3px;
                    opacity: root.can-forward ? 1.0 : 0.45;

                    Image {
                        source: @image-url("../icons/arrow_fwd.svg");
                        width: 16px;
                        height: 16px;
                        colorize: Theme.text-dim;
                    }

                    fwd-touch := TouchArea {
                        mouse-cursor: root.can-forward
                            ? MouseCursor.pointer
                            : MouseCursor.default;

                        clicked => {
                            if root.can-forward {
                                root.history-go(1);
                            }
                        }
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: up-touch.has-hover && root.can-go-up
                        ? Theme.surface-high
                        : transparent;
                    border-radius: 3px;
                    opacity: root.can-go-up ? 1.0 : 0.45;

                    Image {
                        source: @image-url("../icons/arrow_up.svg");
                        width: 16px;
                        height: 16px;
                        colorize: Theme.text-dim;
                    }

                    up-touch := TouchArea {
                        mouse-cursor: root.can-go-up
                            ? MouseCursor.pointer
                            : MouseCursor.default;

                        clicked => {
                            if root.can-go-up {
                                root.explorer-go-up();
                            }
                        }
                    }
                }

                // Botão "Este Computador" (raiz drives)
                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: drives-touch.has-hover
                        ? Theme.surface-high
                        : transparent;
                    border-radius: 3px;
                    opacity: 1.0;

                    Image {
                        source: @image-url("../icons/computer.svg");
                        width: 16px;
                        height: 16px;
                        colorize: Theme.accent;
                    }

                    drives-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.explorer-go-to-drives();
                        }
                    }
                }

                Rectangle {
                    width: 1px;
                    height: 20px;
                    background: Theme.border;
                }

                Text {
                    text: root.current-path;
                    color: Theme.text-primary;
                    font-size: 9px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }

        // CABEÇALHO DA TABELA
        Rectangle {
            height: 24px;
            vertical-stretch: 0;
            background: Theme.base;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 3px;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                alignment: LayoutAlignment.space-around;
                cross-axis-alignment: CrossAxisAlignment.center;

                Text {
                    text: "Nome";
                    color: Theme.text-dim;
                    font-size: 8px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 4;
                    overflow: elide;
                }
                Text {
                    text: "Tipo";
                    color: Theme.text-dim;
                    font-size: 8px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    horizontal-alignment: right;
                    overflow: elide;
                }
                Text {
                    text: "Ext";
                    color: Theme.text-dim;
                    font-size: 8px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: "Tamanho";
                    color: Theme.text-dim;
                    font-size: 8px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1.5;
                    horizontal-alignment: right;
                    overflow: elide;
                }
                Text {
                    text: "Modificado";
                    color: Theme.text-dim;
                    font-size: 8px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 2;
                    horizontal-alignment: right;
                    overflow: elide;
                }
            }
        }

        // LISTA DE ARQUIVOS
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: transparent;
            clip: true;

            ScrollView {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    alignment: LayoutAlignment.stretch;
                    cross-axis-alignment: CrossAxisAlignment.center;
                    spacing: 1px;

                    for entry[index] in root.entries : BrowserItem {
                        name: entry.name;
                        type: entry.entry-type;
                        selected: root.selected-index == index;
                        icon: "";
                        icon-image:
                            entry.is-directory
                                ? @image-url("../icons/folder.svg")
                                : @image-url("../icons/audio.svg");
                        // Arrastável = decodificável. "File" é o que o
                        // Rust marca quando não sabe abrir.
                        drag-enabled:
                            !entry.is-directory
                            && entry.entry-type != "File";

                        // Propriedades extras para exibição em colunas
                        display-type: entry.entry-type;
                        display-ext: entry.extension;
                        display-size: entry.size;
                        display-modified: entry.modified;
                        is-drive: entry.entry-type == "Drive";

                        clicked => {
                            root.selected-index = index;
                            if entry.is-directory {
                                root.directory-entered(entry.path);
                            } else {
                                root.file-selected(entry.name, entry.entry-type, entry.path);
                            }
                        }

                        drag-started() => {
                            root.audio-drag-started(
                                entry.name,
                                entry.path,
                                entry.entry-type,
                                Theme.clip-audio,
                                false
                            );
                        }
                        drag-moved(x, y) => {
                            root.audio-drag-moved(x, y);
                        }
                        drag-finished() => {
                            root.audio-drag-finished();
                        }
                    }

                    // Pasta vazia (ou filtro sem resultado) precisa
                    // dizer isso — lista em branco parece bug.
                    if root.entries.length == 0: Rectangle {
                        height: 40px;

                        Text {
                            text: "Pasta vazia";
                            color: Theme.text-dim;
                            font-size: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}