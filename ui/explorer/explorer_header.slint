import { Theme } from "../theme.slint";

export component ExplorerHeader inherits Rectangle {
    callback menu-clicked();

    height: 28px;
    background: transparent;

    HorizontalLayout {
        spacing: 6px;
        alignment: center;
        cross-axis-alignment: CrossAxisAlignment.center;

        Text {
            text: "Explorer";

            color: Theme.text-primary;
            font-size: 12px;
            font-weight: 700;

            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Rectangle {
            width: 24px;
            height: 24px;

            background: transparent;
            border-radius: 3px;

            states [
                hovered when touch.has-hover: {
                    background: Theme.surface-high;
                }
            ]

            Image {
                source: @image-url("../icons/menu_dots.svg");

                width: 14px;
                height: 14px;

                colorize: Theme.text-dim;
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.menu-clicked();
                }
            }
        }
    }
}