import { Theme } from "../theme.slint";

export component ExplorerHeader inherits Rectangle {
    callback menu-clicked();

    height: 28px;
    background: transparent;

    HorizontalLayout {
        spacing: 6px;
        alignment: center;
        cross-axis-alignment: CrossAxisAlignment.center;

        Text {
            text: "Explorer";

            color: Theme.text-primary;
            font-size: 12px;
            font-weight: 700;

            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        
    }
}