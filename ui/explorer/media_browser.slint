import { Theme } from "../theme.slint";
import { BrowserItem } from "../components/browser_item.slint";

export struct MediaItem {
    name: string,
    type: string,
    category: string,
}

export component MediaBrowser inherits Rectangle {
    in property <[MediaItem]> media: [
        {
            name: "Kick_01.wav",
            type: "WAV",
            category: "One-Shot"
        },
        {
            name: "Kick_02.wav",
            type: "WAV",
            category: "One-Shot"
        },
        {
            name: "Snare_01.wav",
            type: "WAV",
            category: "One-Shot"
        },
        {
            name: "Hat_Closed.wav",
            type: "WAV",
            category: "One-Shot"
        },
        {
            name: "Bass_Loop_128.wav",
            type: "WAV",
            category: "Loops"
        },
        {
            name: "Vocal_Female.wav",
            type: "WAV",
            category: "Vocals"
        }
    ];

    in-out property <string> category-filter: "All";

    background: transparent;

    VerticalLayout {
        alignment: LayoutAlignment.start;
        cross-axis-alignment: CrossAxisAlignment.stretch;
        spacing: 5px;

        // Cabeçalho
        Rectangle {
            height: 26px;

            background: Theme.base;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 3px;

            HorizontalLayout {
                padding-left: 7px;
                padding-right: 7px;
                spacing: 6px;
                alignment: LayoutAlignment.center;
                cross-axis-alignment: CrossAxisAlignment.center;

                Text {
                    text: "♫";
                    width: 18px;

                    color: Theme.accent;
                    font-size: 11px;

                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Text {
                    text: "Media";

                    color: Theme.text-primary;
                    font-size: 9px;

                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }

        // Filtros
        Rectangle {
            height: 26px;
            background: transparent;

            HorizontalLayout {
                alignment: LayoutAlignment.space-between;
                cross-axis-alignment: CrossAxisAlignment.center;
                spacing: 3px;

                Rectangle {
                    width: 40px;
                    height: 23px;

                    background: root.category-filter == "All"
                        ? Theme.surface-high
                        : transparent;

                    border-radius: 3px;

                    Text {
                        text: "All";

                        color: root.category-filter == "All"
                            ? Theme.text-primary
                            : Theme.text-dim;

                        font-size: 8px;

                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => {
                            root.category-filter = "All";
                        }
                    }
                }

                Rectangle {
                    width: 52px;
                    height: 23px;

                    background: root.category-filter == "Loops"
                        ? Theme.surface-high
                        : transparent;

                    border-radius: 3px;

                    Text {
                        text: "Loops";

                        color: root.category-filter == "Loops"
                            ? Theme.accent
                            : Theme.text-dim;

                        font-size: 8px;

                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => {
                            root.category-filter = "Loops";
                        }
                    }
                }

                Rectangle {
                    width: 62px;
                    height: 23px;

                    background: root.category-filter == "One-Shot"
                        ? Theme.surface-high
                        : transparent;

                    border-radius: 3px;

                    Text {
                        text: "One-Shot";

                        color: root.category-filter == "One-Shot"
                            ? Theme.accent
                            : Theme.text-dim;

                        font-size: 8px;

                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => {
                            root.category-filter = "One-Shot";
                        }
                    }
                }

                Rectangle {
                    width: 48px;
                    height: 23px;

                    background: root.category-filter == "Vocals"
                        ? Theme.surface-high
                        : transparent;

                    border-radius: 3px;

                    Text {
                        text: "Vocals";

                        color: root.category-filter == "Vocals"
                            ? Theme.accent
                            : Theme.text-dim;

                        font-size: 8px;

                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => {
                            root.category-filter = "Vocals";
                        }
                    }
                }

                Rectangle {
                    width: 42px;
                    height: 23px;

                    background: root.category-filter == "MIDI"
                        ? Theme.surface-high
                        : transparent;

                    border-radius: 3px;

                    Text {
                        text: "MIDI";

                        color: root.category-filter == "MIDI"
                            ? Theme.accent
                            : Theme.text-dim;

                        font-size: 8px;

                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => {
                            root.category-filter = "MIDI";
                        }
                    }
                }
            }
        }

        // Lista
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            background: transparent;

            VerticalLayout {
                alignment: LayoutAlignment.stretch;
                cross-axis-alignment: CrossAxisAlignment.stretch;
                spacing: 1px;

                Text {
                    text: "MEDIA";

                    height: 20px;
                    horizontal-alignment: TextHorizontalAlignment.center;

                    color: Theme.text-dim;
                    font-size: 8px;
                    font-weight: 700;

                    vertical-alignment: center;
                }

                for item in root.media : BrowserItem {
                    visible: root.category-filter == "All"
                        || item.category == root.category-filter;

                    name: item.name;
                    type: item.type;

                    icon: item.category == "MIDI"
                        ? "♫"
                        : "●";
                }
            }
        }
    }
}