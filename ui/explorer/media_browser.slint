import { Theme } from "../theme.slint";

component MediaRow inherits Rectangle {
    in property <string> icon: "";
    in property <string> name: "";
    in property <string> info: "";
    in-out property <bool> selected: false;

    height: 26px;
    background: root.selected ? Theme.surface-high : transparent;
    border-radius: 2px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 7px;
        alignment: center;

        Text {
            text: root.icon;
            color: Theme.text-dim;
            font-size: 11px;
            width: 18px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        VerticalLayout {
            spacing: 0px;
            horizontal-stretch: 1;

            Text {
                text: root.name;
                color: Theme.text-primary;
                font-size: 10px;
                vertical-alignment: center;
            }

            Text {
                text: root.info;
                color: Theme.text-dim;
                font-size: 8px;
                vertical-alignment: center;
            }
        }
    }

    TouchArea {
        clicked => {
            root.selected = true;
        }
    }
}


export component MediaBrowser inherits Rectangle {
    background: transparent;

    VerticalLayout {
        spacing: 5px;

        // Caminho atual
        Rectangle {
            height: 26px;
            background: Theme.base;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 3px;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                alignment: center;

                Text {
                    text: "♫";
                    color: Theme.text-dim;
                    font-size: 12px;
                    width: 18px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Text {
                    text: "Samples";
                    color: Theme.text-primary;
                    font-size: 10px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }

        // Categorias
        Rectangle {
            height: 30px;
            background: transparent;

            HorizontalLayout {
                spacing: 4px;

                Rectangle {
                    width: 54px;
                    height: 24px;
                    background: Theme.surface-high;
                    border-radius: 3px;

                    Text {
                        text: "Samples";
                        color: Theme.text-primary;
                        font-size: 8px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 42px;
                    height: 24px;
                    background: transparent;
                    border-radius: 3px;

                    Text {
                        text: "Loops";
                        color: Theme.text-dim;
                        font-size: 8px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 55px;
                    height: 24px;
                    background: transparent;
                    border-radius: 3px;

                    Text {
                        text: "One-Shot";
                        color: Theme.text-dim;
                        font-size: 8px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 42px;
                    height: 24px;
                    background: transparent;
                    border-radius: 3px;

                    Text {
                        text: "MIDI";
                        color: Theme.text-dim;
                        font-size: 8px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Lista
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: transparent;

            VerticalLayout {
                spacing: 2px;

                Text {
                    text: "AUDIO FILES";
                    color: Theme.text-dim;
                    font-size: 8px;
                    font-weight: 700;
                    height: 20px;
                    vertical-alignment: center;
                }

                MediaRow {
                    icon: "♫";
                    name: "Kick_01.wav";
                    info: "Kick • 48 kHz • 24 bit";
                }

                MediaRow {
                    icon: "♫";
                    name: "Kick_02.wav";
                    info: "Kick • 48 kHz • 24 bit";
                }

                MediaRow {
                    icon: "♫";
                    name: "Snare_01.wav";
                    info: "Snare • 48 kHz • 24 bit";
                }

                MediaRow {
                    icon: "♫";
                    name: "Hat_Closed.wav";
                    info: "Hi-Hat • 48 kHz • 24 bit";
                }

                MediaRow {
                    icon: "♫";
                    name: "Vocal_Female.wav";
                    info: "Vocal • 44.1 kHz • 24 bit";
                }

                MediaRow {
                    icon: "♫";
                    name: "Bass_Loop_128.wav";
                    info: "Loop • 128 BPM • E min";
                }

                Rectangle {
                    height: 8px;
                    background: transparent;
                }

                Text {
                    text: "PRESETS";
                    color: Theme.text-dim;
                    font-size: 8px;
                    font-weight: 700;
                    height: 20px;
                    vertical-alignment: center;
                }

                MediaRow {
                    icon: "◆";
                    name: "Analog Bass";
