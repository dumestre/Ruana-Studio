import { Theme } from "../theme.slint";
import { BrowserItem } from "../components/browser_item.slint";

export component MediaBrowser inherits Rectangle {
    background: transparent;

    VerticalLayout {
        spacing: 5px;

        // Local atual
        Rectangle {
            height: 26px;

            background: Theme.base;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 3px;

            HorizontalLayout {
                padding-left: 7px;
                padding-right: 7px;
                spacing: 6px;
                alignment: center;

                Text {
                    text: "♫";
                    width: 18px;

                    color: Theme.accent;
                    font-size: 11px;

                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Text {
                    text: "Samples";

                    color: Theme.text-primary;
                    font-size: 9px;

                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "⋮";

                    width: 18px;

                    color: Theme.text-dim;
                    font-size: 13px;

                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Filtros
        Rectangle {
            height: 26px;
            background: transparent;

            HorizontalLayout {
                spacing: 3px;

                Rectangle {
                    width: 52px;
                    height: 23px;

                    background: Theme.surface-high;
                    border-radius: 3px;

                    Text {
                        text: "Audio";

                        color: Theme.text-primary;
                        font-size: 8px;

                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 45px;
                    height: 23px;

                    background: transparent;
                    border-radius: 3px;

                    Text {
                        text: "Loops";

                        color: Theme.text-dim;
                        font-size: 8px;

                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 55px;
                    height: 23px;

                    background: transparent;
                    border-radius: 3px;

                    Text {
                        text: "One-Shot";

                        color: Theme.text-dim;
                        font-size: 8px;

                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 42px;
                    height: 23px;

                    background: transparent;
                    border-radius: 3px;

                    Text {
                        text: "MIDI";

                        color: Theme.text-dim;
                        font-size: 8px;

                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Lista
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            background: transparent;

            VerticalLayout {
                spacing: 1px;

                Text {
                    text: "AUDIO FILES";

                    height: 20px;

                    color: Theme.text-dim;
                    font-size: 8px;
                    font-weight: 700;

                    vertical-alignment: center;
                }

                BrowserItem {
                    name: "Kick_01.wav";
                    type: "WAV";
                    icon: "♫";
                    selected: true;
                }

                BrowserItem {
                    name: "Kick_02.wav";
                    type: "WAV";
                    icon: "♫";
                }

                BrowserItem {
                    name: "Snare_01.wav";
                    type: "WAV";
                    icon: "♫";
                }

                BrowserItem {
                    name: "Hat_Closed.wav";
                    type: "WAV";
                    icon: "♫";
                }

                BrowserItem {
                    name: "Vocal_Female.wav";
                    type: "WAV";
                    icon: "♫";
                }

                BrowserItem {
                    name: "Bass_Loop_128.wav";
                    type: "WAV";
                    icon: "♫";
                }

                Rectangle {
                    height: 7px;
                    background: transparent;
                }

                Text {
                    text: "PRESETS";

                    height: 20px;

                    color: Theme.text-dim;
                    font-size: 8px;
                    font-weight: 700;

                    vertical-alignment: center;
                }

                BrowserItem {
                    name: "Analog Bass";
