import { Theme } from "../theme.slint";

component PluginRow inherits Rectangle {
    in property <string> icon: "";
    in property <string> name: "";
    in property <string> vendor: "";
    in-out property <bool> selected: false;

    height: 30px;
    background: root.selected ? Theme.surface-high : transparent;
    border-radius: 2px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        alignment: center;

        Rectangle {
            width: 20px;
            height: 20px;
            background: Theme.base;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 3px;

            Text {
                text: root.icon;
                color: Theme.text-dim;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            spacing: 0px;
            horizontal-stretch: 1;

            Text {
                text: root.name;
                color: Theme.text-primary;
                font-size: 10px;
                vertical-alignment: center;
            }

            Text {
                text: root.vendor;
                color: Theme.text-dim;
                font-size: 8px;
                vertical-alignment: center;
            }
        }
    }

    TouchArea {
        clicked => {
            root.selected = true;
        }
    }
}


export component PluginBrowser inherits Rectangle {
    background: transparent;

    VerticalLayout {
        spacing: 5px;

        // Busca
        Rectangle {
            height: 28px;
            background: Theme.base;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 3px;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                alignment: center;

                Text {
                    text: "⌕";
                    color: Theme.text-dim;
                    font-size: 13px;
                    width: 18px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Text {
                    text: "Search plugins...";
                    color: Theme.text-dim;
                    font-size: 9px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }

        // Formatos
        Rectangle {
            height: 28px;
            background: transparent;

            HorizontalLayout {
                spacing: 4px;

                Rectangle {
                    width: 48px;
                    height: 23px;
                    background: Theme.surface-high;
                    border-radius: 3px;

                    Text {
                        text: "All";
                        color: Theme.text-primary;
                        font-size: 8px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 48px;
                    height: 23px;
                    background: transparent;
                    border-radius: 3px;

                    Text {
                        text: "VST3";
                        color: Theme.text-dim;
                        font-size: 8px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 48px;
                    height: 23px;
                    background: transparent;
                    border-radius: 3px;

                    Text {
                        text: "CLAP";
                        color: Theme.text-dim;
                        font-size: 8px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Árvore de plugins
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: transparent;

            VerticalLayout {
                spacing: 2px;

                Text {
                    text: "INSTRUMENTS";
                    color: Theme.text-dim;
                    font-size: 8px;
                    font-weight: 700;
                    height: 20px;
                    vertical-alignment: center;
                }

                PluginRow {
                    icon: "♫";
                    name: "Ferrum Synth";
                    vendor: "Ferrum";
                }

                PluginRow {
                    icon: "♫";
                    name: "Piano";
                    vendor: "Instruments";
                }

                Rectangle {
                    height: 7px;
                    background: transparent;
                }

                Text {
                    text: "EFFECTS";
                    color: Theme.text-dim;
                    font-size: 8px;
                    font-weight: 700;
                    height: 20px;
                    vertical-alignment: center;
                }

                PluginRow {
                    icon: "◉";
                    name: "Ferrum EQ";
                    vendor: "Ferrum";
                }

                PluginRow {
                    icon: "◉";
                    name: "Ferrum Compressor";
                    vendor: "Ferrum";
                }

                PluginRow {
                    icon: "◉";
                    name: "PreVocal";
                    vendor: "Ferrum";
                }

                Rectangle {
                    height: 7px;
                    background: transparent;
                }

                Text {
                    text: "ANALYZERS";
                    color: Theme.text-dim;
                    font-size: 8px;
                    font-weight: 700;
                    height: 20px;
                    vertical-alignment: center;
                }

                PluginRow {
                    icon: "◌";
                    name: "Ferrum Spectrum";
                    vendor: "Ferrum";
                }
            }
        }
    }
}
