import { Button } from "components/button.slint";
import { Theme } from "theme.slint";
import { ProjectKey } from "components/project_key.slint";
import { ThemePicker } from "components/theme_picker.slint";
import { Transport } from "transport.slint";

export component Toolbar inherits Rectangle {
    in-out property <bool> snap-enabled: true;
    in-out property <bool> follow-enabled: true;
    in-out property <bool> grid-enabled: true;
    in-out property <bool> full-screen: false;
    in-out property <bool> jump-to-pattern: false;

    callback zoom-in;
    callback zoom-out;
    callback snap-toggled(bool);
    callback follow-toggled(bool);
    callback grid-toggled(bool);
    callback close;
    callback minimize;
    callback page-toggled(bool);
    callback theme-selected(int);

    // ---- Transport (integrado à toolbar) ----
    in-out property <bool> playing: false;
    in-out property <bool> loop-enabled: false;
    in-out property <bool> metronome-enabled: false;
    in-out property <int> metronome-sound: 0;
    in-out property <float> metronome-volume: 0.7;
    in-out property <int> transport-position: 0;
    in-out property <int> bpm: 120;
    in-out property <int> beats-per-bar: 4;
    in-out property <int> ppq: 960;

    callback play-state-changed(bool);
    callback loop-state-changed(bool);
    callback metronome-state-changed(bool);
    callback metronome-sound-changed(int);
    callback metronome-volume-changed(float);
    callback set-bpm(float);

    height: 34px;
    background: transparent;

    // Borda inferior
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }

    // Layout Principal da Toolbar
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        // Espaço geral entre os grandes blocos (Logo, Menus, Ferramentas)
        spacing: 16px; 
        alignment: LayoutAlignment.stretch;
        cross-axis-alignment: CrossAxisAlignment.center;

        // ==========================================
        // 1. LOGO & TÍTULO
        // ==========================================
        HorizontalLayout {
            spacing: 8px;
            alignment: LayoutAlignment.center;
            cross-axis-alignment: CrossAxisAlignment.center;

            Image {
                source: @image-url("../app/assets/RuanaStudio.svg");
                width: 26px;
                height: 26px;
            }

            Text {
                font-family: "poppins";
                font-size: 12px;
                horizontal-alignment: TextHorizontalAlignment.center;
                letter-spacing: 1px;
                text: "Ruana Studio";
            }
        }

        // ==========================================
        // 2. MENUS (FILE)
        // ==========================================
        HorizontalLayout {
            spacing: 2px;
            alignment: LayoutAlignment.stretch;
            cross-axis-alignment: CrossAxisAlignment.center;

            Button {
                text: "File"; height: 18px; padding-x: 3px; borderless: true; text-color: Theme.text-primary; letter-spacing: 1px; corner-radius: 2px; resting-bg: Theme.surface-high; clicked => {} 
            }
            Button {
                text: "Edit"; height: 18px; padding-x: 3px; borderless: true; text-color: Theme.text-primary; letter-spacing: 1px; corner-radius: 2px; resting-bg: Theme.surface-high; clicked => {} 
            }
            Button {
                text: "New"; height: 18px; padding-x: 3px; borderless: true; text-color: Theme.text-primary; letter-spacing: 1px; corner-radius: 2px; resting-bg: Theme.surface-high; clicked => {} 
            }
            Button {
                text: "Save"; height: 18px; padding-x: 3px; borderless: true; text-color: Theme.text-primary; letter-spacing: 1px; corner-radius: 2px; resting-bg: Theme.surface-high; clicked => {} 
            }
            Button {
                text: "Save As"; height: 18px; padding-x: 3px; borderless: true; text-color: Theme.text-primary; letter-spacing: 1px; corner-radius: 2px; resting-bg: Theme.surface-high; clicked => {} 
            }
            Button {
                text: "Settings"; height: 18px; padding-x: 3px; borderless: true; text-color: Theme.text-primary; letter-spacing: 1px; corner-radius: 2px; resting-bg: Theme.surface-high; clicked => {} 
            }
            Button {
                text: "Help"; height: 18px; padding-x: 3px; borderless: true; text-color: Theme.text-primary; letter-spacing: 1px; corner-radius: 2px; resting-bg: Theme.surface-high; clicked => {} 
            }
        }

        // ==========================================
        // 3. FERRAMENTAS DA DAW
        // ==========================================
        HorizontalLayout {
            spacing: 20px; // Espaço maior entre as seções
            alignment: LayoutAlignment.center;
            cross-axis-alignment: CrossAxisAlignment.center;

            HorizontalLayout {
                spacing: 2px;
                alignment: LayoutAlignment.center;
                cross-axis-alignment: CrossAxisAlignment.center;

                Button {
                    height: 18px; width: 18px; corner-radius: 2px; resting-bg: Theme.surface-high;
                    icon: @image-url("icons/undo.svg"); icon-size: 16px; icon-color: Theme.text-primary; borderless: true; clicked => {}
                }
                Button {
                    height: 18px; width: 18px; corner-radius: 2px; resting-bg: Theme.surface-high;
                    icon: @image-url("icons/redo.svg"); icon-size: 16px; icon-color: Theme.text-primary; borderless: true; clicked => {}
                }
            }
            HorizontalLayout {
                spacing: 2px;
                alignment: LayoutAlignment.center;
                cross-axis-alignment: CrossAxisAlignment.center;

                Button {
                    icon: @image-url("icons/follow.svg"); filled-icon: @image-url("icons/follow_filled.svg");
                icon-size: 16px; icon-color: Theme.text-primary; height: 18px; width: 18px; corner-radius: 2px; resting-bg: Theme.surface-high;
                toggled: root.follow-enabled; toggled-bg: Theme.toggle-active-bg; toggled-fg: Theme.text-primary; borderless: true; subtle-toggled: true;
                clicked => {
                    root.follow-enabled = !root.follow-enabled;
                    root.follow-toggled(root.follow-enabled);
                }
            }
            
            
            Button {
                icon: @image-url("icons/snap.svg"); filled-icon: @image-url("icons/snap_filled.svg");
                icon-size: 16px; icon-color: Theme.text-primary; height: 18px; width: 18px; corner-radius: 2px; resting-bg: Theme.surface-high;
                toggled: root.snap-enabled; toggled-bg: Theme.toggle-active-bg; toggled-fg: Theme.text-primary; borderless: true; subtle-toggled: true;
                clicked => {
                    root.snap-enabled = !root.snap-enabled;
                    root.snap-toggled(root.snap-enabled);
                }
            }
            }

        
            
            ProjectKey {
                border-radius: 2px; }
            ThemePicker {
                theme-selected(i) => {
                    root.theme-selected(i);
                }
            }
        }

        // ==========================================
        // TRANSPORT (integrado à toolbar)
        // ==========================================
        Transport {
            playing <=> root.playing;
            loop-enabled <=> root.loop-enabled;
            metronome-enabled <=> root.metronome-enabled;
            metronome-sound <=> root.metronome-sound;
            metronome-volume <=> root.metronome-volume;
            position <=> root.transport-position;
            bpm <=> root.bpm;
            beats-per-bar <=> root.beats-per-bar;
            ppq <=> root.ppq;

            play-state-changed(state) => { root.play-state-changed(state); }
            loop-state-changed(state) => { root.loop-state-changed(state); }
            metronome-state-changed(enabled) => { root.metronome-state-changed(enabled); }
            metronome-sound-changed(sound) => { root.metronome-sound-changed(sound); }
            metronome-volume-changed(value) => { root.metronome-volume-changed(value); }
            set-bpm(value) => { root.set-bpm(value); }
        }

        // ==========================================
        // 4. CONTROLES DA JANELA
        // ==========================================
        HorizontalLayout {
            spacing: 4px; // Substitui os Rectangles de 4px
            alignment: LayoutAlignment.stretch;
            cross-axis-alignment: CrossAxisAlignment.center;

            Button {
                height: 18px; icon: @image-url("icons/minimize.svg"); icon-size: 14px; preferred-height: 0px; preferred-width: 0px; text: ""; width: 18px; corner-radius: 9px; resting-bg: Theme.surface-high;
                clicked => { root.minimize(); }
            }
            Button {
                height: 18px; icon: root.full-screen ? @image-url("icons/restore.svg") : @image-url("icons/maximize.svg"); icon-size: 10px; text: ""; width: 18px; corner-radius: 9px; resting-bg: Theme.surface-high;
                clicked => { root.full-screen = !root.full-screen; }
            }
            Button {
                height: 18px; icon: @image-url("icons/close.svg"); icon-color: Colors.crimson; icon-size: 14px; text: ""; width: 18px; corner-radius: 9px; resting-bg: Theme.surface-high;
                clicked => { root.close(); }
            }
        }
    }
}