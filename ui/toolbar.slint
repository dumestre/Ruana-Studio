import { Button } from "components/button.slint";
import { Theme } from "theme.slint";
export component Toolbar inherits Rectangle {
    in-out property <bool> snap-enabled: true;
    in-out property <bool> grid-enabled: true;
    in-out property <bool> full-screen: false;
    
    

    callback zoom-in;
    callback zoom-out;
    callback snap-toggled(bool);
    callback grid-toggled(bool);
    callback close;
    callback minimize;

    height: 34px;
    background: Theme.surface;

    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        alignment: LayoutAlignment.stretch;
        cross-axis-alignment: CrossAxisAlignment.center;

        Image {
            source: @image-url("../app/assets/FerrumStudio.svg");
            width: 26px;
            height: 26px;
        }

        Rectangle {
            width: 8px;
            background: transparent;
        }

        Button { text: "New"; borderless: true;
            text-color: Colors.beige; clicked => {} }
        Button { text: "Open"; borderless: true;
            text-color: Colors.beige; clicked => {} }
        Button { text: "Save"; borderless: true;
            text-color: Colors.beige; clicked => {} }
        Button { text: "Save As"; borderless: true;
            text-color: Colors.beige; clicked => {} }

        Rectangle {
            width: 1px;
            background: Theme.border;
        }

        Button {
            height: 20px;
            width: 20px; 
            icon: @image-url("icons/undo.svg");
            icon-size: 16px;
            icon-color: #9a9a9a;
            borderless: true;
            clicked => {} 
        }
        Button { 
            height: 20px;
            width: 20px;
            icon: @image-url("icons/redo.svg");
            icon-size: 16px;
            icon-color: #9a9a9a;
            borderless: true;
            clicked => {} 
        }

        Rectangle {
            width: 1px;
            background: Theme.border;
        }
        
       
        Button {
            icon: @image-url("icons/snap.svg");
            icon-size: 16px;
            icon-color: Theme.text-dim;
            height: 22px;
            width: 22px;
            toggled: root.snap-enabled;
            toggled-bg: Theme.accent;
            toggled-fg: Theme.text-primary;
            toggled-icon-color: Theme.text-primary;
            borderless: true;
            clicked => {
                root.snap-enabled = !root.snap-enabled;
                root.snap-toggled(root.snap-enabled);
            }
        }
        Button {
            text: "GRID";
            height: 22px;
            toggled: root.grid-enabled;
            toggled-bg: Theme.accent;
            toggled-fg: Theme.base;
            subtle-toggled: true;
            clicked => {
                root.grid-enabled = !root.grid-enabled;
                root.grid-toggled(root.grid-enabled);
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;
        }

        HorizontalLayout {
            alignment: LayoutAlignment.end;
            cross-axis-alignment: CrossAxisAlignment.center;

        Button {
            
            height: 20px;
            icon: @image-url("icons/minimize.svg");
            icon-size: 14px;
            preferred-height: 0px;
            preferred-width: 0px;
            text: "";
            width: 20px;
            corner-radius: 13px;
            clicked => {
                root.minimize();
            }
        }
        Rectangle {
            width: 4px;
            background: transparent;
        }
        Button {
            height: 20px;
            icon: root.full-screen
                ? @image-url("icons/restore.svg")
                : @image-url("icons/maximize.svg");
            icon-size: 10px;
            text: "";
            width: 20px;
            corner-radius: 13px;
            clicked => {
                root.full-screen = !root.full-screen;
            }
        }
        Rectangle {
            width: 4px;
            background: transparent;
        }
        Button {
            height: 20px;
            icon: @image-url("icons/close.svg");
            icon-color: Colors.crimson;
            icon-size: 14px;
            text: "";
            width: 20px;
            corner-radius: 13px;
            clicked => {
                root.close();
            }
        }
    }
    }
}

