import { Button } from "components/button.slint";
import { Theme } from "theme.slint";

export component Toolbar inherits Rectangle {
    in-out property <bool> snap-enabled: true;
    in-out property <bool> grid-enabled: true;
    in-out property <bool> beat-open: false;

    callback zoom-in;
    callback zoom-out;
    callback snap-toggled(bool);
    callback grid-toggled(bool);
    callback beat-opened;
    callback close;
    callback maximize;
    callback minimize;

    
    height: 34px;
    background: Theme.surface;

    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        alignment: LayoutAlignment.start;
        cross-axis-alignment: CrossAxisAlignment.center;

        Image {
            source: @image-url("../app/assets/FerrumStudio.svg");
            width: 20px;
            height: 20px;
        }

        Rectangle {
            width: 8px;
            background: transparent;
        }

        Button { text: "New"; clicked => {} }
        Button { text: "Open"; clicked => {} }
        Button { text: "Save"; clicked => {} }
        Button { text: "Save As"; clicked => {} }

        Rectangle {
            width: 1px;
            background: Theme.border;
        }

        Button { text: "Undo"; clicked => {} }
        Button { text: "Redo"; clicked => {} }

        Rectangle {
            width: 1px;
            background: Theme.border;
        }

        Button {
            text: "Zoom -";
            clicked => {
                root.zoom-out();
            }
        }
        Button {
            text: "Zoom +";
            clicked => {
                root.zoom-in();
            }
        }

        Rectangle {
            width: 1px;
            background: Theme.border;
        }

        Button {
            text: "SNAP";
            toggled: root.snap-enabled;
            clicked => {
                root.snap-enabled = !root.snap-enabled;
                root.snap-toggled(root.snap-enabled);
            }
        }
        Button {
            text: "GRID";
            toggled: root.grid-enabled;
            clicked => {
                root.grid-enabled = !root.grid-enabled;
                root.grid-toggled(root.grid-enabled);
            }
        }

        Button {
            icon: @image-url("icons/drum.svg");
            icon-size: 30px;
            text: "";
            toggled: root.beat-open;
            subtle-toggled: true;
            toggled-icon-color: Theme.accent;
            clicked => {
                root.beat-opened();
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;
        }

        Text {
            text: "Mock Session";
            color: Theme.text-dim;
            font-size: 11px;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;
        }

        Button {
            icon: @image-url("icons/close.svg");
            icon-size: 14px;
            text: "";
            clicked => {
                root.close();
            }
        }
        Button {
            icon: @image-url("icons/maximize.svg");
            icon-size: 14px;
            text: "";
            clicked => {
                root.maximize();
            }
        }
        Button {
            icon: @image-url("icons/minimize.svg");
            icon-size: 14px;
            text: "";
            clicked => {
                root.minimize();
            }
        }
    }
}

