export global Theme {
    in property <color> base: #1E1E1E;
    in property <color> surface: #242424;
    in property <color> surface-high: #2E2E2E;
    in property <color> border: #3D3D3D;
    in property <color> accent: #F26A21;
    in property <color> accent-hover: #FF8A4D;
    in property <color> text-primary: #E8E8E8;
    in property <color> text-dim: #9A9A9A;
    in property <color> ok: #6FA86B;
    in property <color> warn: #F2B021;
    in property <color> danger: #E5484D;
    in property <color> playhead: #FFFFFF;
    in property <color> clip-audio: #F26A21;
    in property <color> clip-midi: #6FA86B;
    in property <color> activ: #10f100;
}
