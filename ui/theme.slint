// ============================================================
// THEME — paletas selecionáveis por índice (`active`).
//
// TODA a UI consome ONLY os tokens deste global. Trocar tema =
// setar `Theme.active` (do Rust ou do seletor do toolbar); as
// binds abaixo re-selecionam a paleta e o resto do app repinta.
//
// Índices: 0 Studio Dark · 1 Midnight Blue · 2 Violeta Ruana ·
//          3 Volt · 4 Sunset · 5 Ocean Teal · 6 Paper (claro).
// ============================================================

export global Theme {

    in-out property <int> active: 0;

    private property <[color]> base-list: [
        #1E1E1E, #161A21, #191722, #14160E, #211A12, #0F1E21, #F3F3F1
    ];
    private property <[color]> surface-list: [
        #242424, #1D242E, #221E2E, #1C1F15, #2A2117, #15262A, #FFFFFF
    ];
    private property <[color]> surface-high-list: [
        #2E2E2E, #26303D, #2D2740, #262A1D, #362A1B, #1E3035, #EBEBE8
    ];
    private property <[color]> border-list: [
        #3D3D3D, #33404F, #3C3350, #383F2C, #4A3A26, #2C4247, #D0D0CD
    ];
    private property <[color]> accent-list: [
        #00C853, #4FA8FF, #B85CFF, #A8FF00, #FF9F43, #2EC4B6, #00875A
    ];
    private property <[color]> accent-hover-list: [
        #09F664, #76BFFF, #CE8AFF, #C4FF4D, #FFB66D, #5AD9CC, #009F69
    ];
    private property <[color]> on-accent-list: [
        #333333, #161A21, #191722, #14160E, #211A12, #0F1E21, #FFFFFF
    ];
    private property <[color]> text-primary-list: [
        #E8E8E8, #E4ECF4, #EDE6F5, #F2F5E8, #F5EDE2, #E2F0EE, #1E1E1E
    ];
    private property <[color]> text-dim-list: [
        #9A9A9A, #8FA0B2, #9A8FB0, #9BA38A, #B0A090, #8FAAA6, #5F5F5F
    ];
    private property <[color]> ok-list: [
        #6FA86B, #6FA86B, #6FA86B, #8FC14F, #8FAA6B, #6FA86B, #2E7D32
    ];
    private property <[color]> warn-list: [
        #F2B021, #F2B021, #F2B021, #F2B021, #F2B021, #F2B021, #B26A00
    ];
    private property <[color]> danger-list: [
        #C80014, #C80014, #C80014, #C80014, #C80014, #C80014, #C62828
    ];
    private property <[color]> playhead-list: [
        #FFFFFF, #FFFFFF, #FFFFFF, #FFFFFF, #FFFFFF, #FFFFFF, #E53434
    ];
    private property <[color]> clip-audio-list: [
        #00C853, #4FA8FF, #B85CFF, #A8FF00, #FF9F43, #2EC4B6, #00875A
    ];
    private property <[color]> clip-midi-list: [
        #6FA86B, #6FA86B, #6FA86B, #8FC14F, #8FAA6B, #6FA86B, #2E7D32
    ];
    private property <[color]> activ-list: [
        #10f100, #4FA8FF, #B85CFF, #A8FF00, #FF9F43, #2EC4B6, #00875A
    ];
    private property <[color]> grid-line-list: [
        #353535, #2A3643, #332C44, #2E3422, #3B2F1F, #24383C, #DDDDDA
    ];
    private property <[color]> grid-sub-list: [
        #292929, #212B36, #292435, #24281A, #2F261A, #1D2C30, #E6E6E2
    ];

    private property <int> clamp: min(max(0, active), base-list.length - 1);

    in property <color> base: base-list[clamp];
    in property <color> surface: surface-list[clamp];
    in property <color> surface-high: surface-high-list[clamp];
    in property <color> border: border-list[clamp];
    in property <color> accent: accent-list[clamp];
    in property <color> accent-hover: accent-hover-list[clamp];
    in property <color> on-accent: on-accent-list[clamp];
    in property <color> text-primary: text-primary-list[clamp];
    in property <color> text-dim: text-dim-list[clamp];
    in property <color> ok: ok-list[clamp];
    in property <color> warn: warn-list[clamp];
    in property <color> danger: danger-list[clamp];
    in property <color> playhead: playhead-list[clamp];
    in property <color> clip-audio: clip-audio-list[clamp];
    in property <color> clip-midi: clip-midi-list[clamp];
    in property <color> activ: activ-list[clamp];
    in property <color> grid-line: grid-line-list[clamp];
    in property <color> grid-sub: grid-sub-list[clamp];
}