import { Theme } from "../theme.slint";
import { SamplerHeader } from "sampler_header.slint";
import { SamplerWaveform } from "sampler_waveform.slint";
import { SamplerTransport } from "sampler_transport.slint";
import { SamplerEnvelope } from "sampler_envelope.slint";
import { SamplerPitch } from "sampler_pitch.slint";
import { SamplerFilter } from "sampler_filter.slint";
import { SamplerAmp } from "sampler_amp.slint";
import { SamplerModulation } from "sampler_modulation.slint";

export component Sampler inherits Rectangle {

    // ============================================================
    // SAMPLE
    // ============================================================

    in-out property <string> sample-name: "No Sample";
    in-out property <bool> sample-loaded: false;

    in-out property <string> sample-format: "";
    in-out property <string> sample-duration: "";

    in-out property <[float]> peaks: [];

    // ============================================================
    // TRANSPORT
    // ============================================================

    in-out property <bool> playing: false;
    in-out property <bool> loop-enabled: false;
    in-out property <bool> reverse-enabled: false;
    in-out property <bool> one-shot: true;

    // ============================================================
    // ENVELOPE
    // ============================================================

    in-out property <float> attack: 0.01;
    in-out property <float> decay: 0.20;
    in-out property <float> sustain: 0.80;
    in-out property <float> release: 0.25;

    // ============================================================
    // PITCH
    // ============================================================

    in-out property <float> tune: 0.5;
    in-out property <float> fine: 0.5;
    in-out property <float> octave: 0.5;
    in-out property <float> glide: 0.0;
    in-out property <bool> glide-enabled: false;

    // ============================================================
    // FILTER
    // ============================================================

    in-out property <float> cutoff: 0.75;
    in-out property <float> resonance: 0.0;
    in-out property <float> filter-drive: 0.0;

    in-out property <string> filter-type: "LP";
    in-out property <bool> filter-enabled: false;

    // ============================================================
    // AMP
    // ============================================================

    in-out property <float> volume: 0.75;
    in-out property <float> pan: 0.5;
    in-out property <float> stereo-width: 1.0;
    in-out property <float> phase: 0.0;

    in-out property <bool> muted: false;
    in-out property <bool> solo: false;

    // ============================================================
    // LFO
    // ============================================================

    in-out property <float> lfo-rate: 0.35;
    in-out property <float> lfo-depth: 0.0;

    in-out property <string> lfo-waveform: "SINE";
    in-out property <string> lfo-destination: "PITCH";

    in-out property <bool> lfo-enabled: false;
    in-out property <bool> lfo-sync: false;

    // ============================================================
    // DIMENSÕES
    // ============================================================

    private property <length> content-padding: 10px;
    private property <length> section-gap: 8px;
    private property <length> header-height: 42px;
    private property <length> transport-height: 36px;

    background: Theme.base;

    // ============================================================
    // CONTAINER
    // ============================================================

    Rectangle {
        x: root.content-padding;
        y: root.content-padding;

        width:
            parent.width
            - root.content-padding * 2;

        height:
            parent.height
            - root.content-padding * 2;

        background: Theme.surface;

        border-width: 1px;
        border-color: Theme.border;
        border-radius: 4px;

        // ========================================================
        // HEADER
        // ========================================================

        SamplerHeader {
            x: 0;
            y: 0;

            width: parent.width;
            height: root.header-height;

            sample-name: root.sample-name;
            sample-loaded: root.sample-loaded;

            sample-format: root.sample-format;
            sample-duration: root.sample-duration;
        }

        // ========================================================
        // CONTEÚDO
        // ========================================================

        Rectangle {
            x: 0;
            y: root.header-height;

            width: parent.width;

            height:
                parent.height
                - root.header-height;

            background: Theme.surface;

            // ====================================================
            // WAVEFORM
            // ====================================================

            SamplerWaveform {
                x: root.section-gap;
                y: root.section-gap;

                width:
                    parent.width
                    - root.section-gap * 2;

                height: 150px;

                peaks: root.peaks;

                sample-loaded: root.sample-loaded;
                playing: root.playing;

                waveform-color: Theme.clip-audio;

                start-position: 0.0;
                end-position: 1.0;
                playhead-position: 0.0;
            }

            // ====================================================
            // TRANSPORT
            // ====================================================

            SamplerTransport {
                x: root.section-gap;
                y: 158px;

                width: 280px;
                height: root.transport-height;

                playing: root.playing;
                loop-enabled: root.loop-enabled;
                reverse-enabled: root.reverse-enabled;
                one-shot: root.one-shot;
            }

            // ====================================================
            // PITCH
            // ====================================================

            SamplerPitch {
                x: root.section-gap;
                y: 202px;

                width: 320px;
                height: 140px;

                tune: root.tune;
                fine: root.fine;
                octave: root.octave;
                glide: root.glide;
                glide-enabled: root.glide-enabled;

                tune-changed(value) => {
                    root.tune = value;
                }

                fine-changed(value) => {
                    root.fine = value;
                }

                octave-changed(value) => {
                    root.octave = value;
                }

                glide-changed(value) => {
                    root.glide = value;
                }

                glide-enabled-changed(value) => {
                    root.glide-enabled = value;
                }
            }

            // ====================================================
            // FILTER
            // ====================================================

            SamplerFilter {
                x: 336px;
                y: 202px;

                width: 320px;
                height: 150px;

                cutoff: root.cutoff;
                resonance: root.resonance;
                drive: root.filter-drive;

                filter-type: root.filter-type;
                enabled: root.filter-enabled;

                cutoff-changed(value) => {
                    root.cutoff = value;
                }

                resonance-changed(value) => {
                    root.resonance = value;
                }

                drive-changed(value) => {
                    root.filter-drive = value;
                }

                filter-type-changed(value) => {
                    root.filter-type = value;
                }

                enabled-changed(value) => {
                    root.filter-enabled = value;
                }
            }

            // ====================================================
            // AMP
            // ====================================================

            SamplerAmp {
                x: 672px;
                y: 202px;

                width: 320px;
                height: 140px;

                volume: root.volume;
                pan: root.pan;
                stereo-width: root.stereo-width;
                phase: root.phase;

                muted: root.muted;
                solo: root.solo;

                volume-changed(value) => {
                    root.volume = value;
                }

                pan-changed(value) => {
                    root.pan = value;
                }

                stereo-width-changed(value) => {
                    root.stereo-width = value;
                }

                phase-changed(value) => {
                    root.phase = value;
                }

                muted-changed(value) => {
                    root.muted = value;
                }

                solo-changed(value) => {
                    root.solo = value;
                }
            }

            // ====================================================
            // ENVELOPE
            // ====================================================

            SamplerEnvelope {
                x: root.section-gap;
                y: 350px;

                width: 320px;
                height: 180px;

                attack: root.attack;
                decay: root.decay;
                sustain: root.sustain;
                release: root.release;
            }

            // ====================================================
            // MODULATION / LFO
            // ====================================================

            SamplerModulation {
                x: 336px;
                y: 360px;

                width: 320px;
                height: 140px;

                rate: root.lfo-rate;
                depth: root.lfo-depth;

                waveform: root.lfo-waveform;
                destination: root.lfo-destination;

                enabled: root.lfo-enabled;
                sync: root.lfo-sync;

                rate-changed(value) => {
                    root.lfo-rate = value;
                }

                depth-changed(value) => {
                    root.lfo-depth = value;
                }

                waveform-changed(value) => {
                    root.lfo-waveform = value;
                }

                destination-changed(value) => {
                    root.lfo-destination = value;
                }

                enabled-changed(value) => {
                    root.lfo-enabled = value;
                }

                sync-changed(value) => {
                    root.lfo-sync = value;
                }
            }
        }
    }
}