import { Theme } from "../theme.slint";

export component Sampler inherits Rectangle {

    // ============================================================
    // ESTADO
    // ============================================================

    in-out property <string> sample-name: "No Sample";
    in-out property <bool> sample-loaded: false;
    in-out property <bool> playing: false;
    in-out property <bool> loop-enabled: false;

    // ============================================================
    // DIMENSÕES
    // ============================================================

    private property <length> header-height: 42px;
    private property <length> section-gap: 8px;
    private property <length> content-padding: 10px;

    // ============================================================
    // FUNDO
    // ============================================================

    background: Theme.base;

    // ============================================================
    // CONTAINER
    // ============================================================

    Rectangle {
        x: content-padding;
        y: content-padding;
        width: parent.width - content-padding * 2;
        height: parent.height - content-padding * 2;

        background: Theme.surface;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border;

        // ========================================================
        // HEADER
        // ========================================================

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: header-height;

            background: Theme.surface-high;

            // ----------------------------------------------------
            // NOME
            // ----------------------------------------------------

            Text {
                x: 12px;
                y: 0;
                width: parent.width - 220px;
                height: parent.height;

                text: sample-loaded ? sample-name : "Sampler";

                color: Theme.text-primary;

                vertical-alignment: center;

                font-size: 13px;
                font-weight: 600;
            }

            // ----------------------------------------------------
            // STATUS
            // ----------------------------------------------------

            Rectangle {
                x: parent.width - 190px;
                y: 11px;
                width: 8px;
                height: 8px;

                border-radius: 4px;

                background: sample-loaded
                    ? Theme.activ
                    : Theme.border;
            }

            Text {
                x: parent.width - 174px;
                y: 0;
                width: 80px;
                height: parent.height;

                text: sample-loaded ? "LOADED" : "EMPTY";

                color: sample-loaded
                    ? Theme.text-primary
                    : Theme.text-dim;

                vertical-alignment: center;

                font-size: 9px;
                font-weight: 600;
            }

            // ----------------------------------------------------
            // PRESET
            // ----------------------------------------------------

            Rectangle {
                x: parent.width - 88px;
                y: 7px;
                width: 76px;
                height: 28px;

                background: Theme.surface;

                border-width: 1px;
                border-color: Theme.border;
                border-radius: 3px;

                Text {
                    width: parent.width;
                    height: parent.height;

                    text: "PRESET";

                    color: Theme.text-dim;

                    horizontal-alignment: center;
                    vertical-alignment: center;

                    font-size: 9px;
                    font-weight: 600;
                }

                TouchArea {
                    clicked => {
                        // Futuro:
                        // abrir preset browser
                    }
                }
            }
        }

        // ========================================================
        // DIVISÓRIA DO HEADER
        // ========================================================

        Rectangle {
            x: 0;
            y: header-height;

            width: parent.width;
            height: 1px;

            background: Theme.border;
        }

        // ========================================================
        // ÁREA PRINCIPAL
        // ========================================================

        Rectangle {
            x: 0;
            y: header-height + 1px;

            width: parent.width;
            height: parent.height - header-height - 1px;

            background: Theme.surface;

            // ====================================================
            // WAVEFORM
            // ====================================================

            Rectangle {
                x: section-gap;
                y: section-gap;

                width: parent.width - section-gap * 2;
                height: parent.height * 0.45;

                background: Theme.base;

                border-width: 1px;
                border-color: Theme.border;
                border-radius: 3px;

                // ------------------------------------------------
                // GRID CENTRAL
                // ------------------------------------------------

                Rectangle {
                    x: 0;
                    y: parent.height / 2;

                    width: parent.width;
                    height: 1px;

                    background: Theme.grid-line;
                }

                // ------------------------------------------------
                // GRID SUPERIOR
                // ------------------------------------------------

                Rectangle {
                    x: 0;
                    y: parent.height * 0.25;

                    width: parent.width;
                    height: 1px;

                    background: Theme.grid-sub;
                }

                // ------------------------------------------------
                // GRID INFERIOR
                // ------------------------------------------------

                Rectangle {
                    x: 0;
                    y: parent.height * 0.75;

                    width: parent.width;
                    height: 1px;

                    background: Theme.grid-sub;
                }

                // ------------------------------------------------
                // ÁREA DA WAVEFORM
                // ------------------------------------------------

                Rectangle {
                    x: 8px;
                    y: 8px;

                    width: parent.width - 16px;
                    height: parent.height - 16px;

                    background: transparent;

                    if !sample-loaded : Text {
                        width: parent.width;
                        height: parent.height;

                        text: "DROP SAMPLE HERE";

                        color: Theme.text-dim;

                        horizontal-alignment: center;
                        vertical-alignment: center;

                        font-size: 11px;
                        font-weight: 600;
                    }

                    if sample-loaded : Rectangle {
                        x: 0;
                        y: parent.height * 0.48;

                        width: parent.width;
                        height: 2px;

                        background: Theme.clip-audio;
                        opacity: 0.75;
                    }
                }

                // ------------------------------------------------
                // START MARKER
                // ------------------------------------------------

                Rectangle {
                    x: 12px;
                    y: 0;

                    width: 1px;
                    height: parent.height;

                    background: Theme.accent;
                }

                // ------------------------------------------------
                // END MARKER
                // ------------------------------------------------

                Rectangle {
                    x: parent.width - 12px;
                    y: 0;

                    width: 1px;
                    height: parent.height;

                    background: Theme.accent;
                }
            }

            // ====================================================
            // CONTROLES INFERIORES
            // ====================================================

            Rectangle {
                x: section-gap;
                y: parent.height * 0.45 + section-gap * 2;

                width: parent.width - section-gap * 2;
                height: parent.height * 0.55 - section-gap * 3;

                background: transparent;

                // =================================================
                // TRANSPORT
                // =================================================

                Rectangle {
                    x: 0;
                    y: 0;

                    width: 120px;
                    height: 36px;

                    background: Theme.surface-high;

                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 3px;

                    // ---------------------------------------------
                    // PLAY
                    // ---------------------------------------------

                    Rectangle {
                        x: 4px;
                        y: 4px;

                        width: 52px;
                        height: 28px;

                        background: playing
                            ? Theme.accent
                            : Theme.surface;

                        border-radius: 3px;

                        Text {
                            width: parent.width;
                            height: parent.height;

                            text: playing ? "STOP" : "PLAY";

                            color: playing
                                ? Theme.on-accent
                                : Theme.text-primary;

                            horizontal-alignment: center;
                            vertical-alignment: center;

                            font-size: 9px;
                            font-weight: 600;
                        }

                        TouchArea {
                            clicked => {
                                playing = !playing;
                            }
                        }
                    }

                    // ---------------------------------------------
                    // LOOP
                    // ---------------------------------------------

                    Rectangle {
                        x: 60px;
                        y: 4px;

                        width: 52px;
                        height: 28px;

                        background: loop-enabled
                            ? Theme.accent
                            : Theme.surface;

                        border-radius: 3px;

                        Text {
                            width: parent.width;
                            height: parent.height;

                            text: "LOOP";

                            color: loop-enabled
                                ? Theme.on-accent
                                : Theme.text-primary;

                            horizontal-alignment: center;
                            vertical-alignment: center;

                            font-size: 9px;
                            font-weight: 600;
                        }

                        TouchArea {
                            clicked => {
                                loop-enabled = !loop-enabled;
                            }
                        }
                    }
                }

                // =================================================
                // PARÂMETROS
                // =================================================

                Rectangle {
                    x: 130px;
                    y: 0;

                    width: parent.width - 130px;
                    height: parent.height;

                    background: transparent;

                    // ---------------------------------------------
                    // AMP
                    // ---------------------------------------------

                    Rectangle {
                        x: 0;
                        y: 0;

                        width: parent.width / 3 - 6px;
                        height: parent.height;

                        background: Theme.surface-high;

                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 3px;

                        Text {
                            x: 8px;
                            y: 6px;

                            width: parent.width - 16px;
                            height: 18px;

                            text: "AMP";

                            color: Theme.text-dim;

                            font-size: 9px;
                            font-weight: 600;
                        }

                        Text {
                            x: 8px;
                            y: 24px;

                            width: parent.width - 16px;
                            height: 24px;

                            text: "0.0 dB";

                            color: Theme.text-primary;

                            font-size: 12px;
                            font-weight: 600;
                        }
                    }

                    // ---------------------------------------------
                    // PITCH
                    // ---------------------------------------------

                    Rectangle {
                        x: parent.width / 3;
                        y: 0;

                        width: parent.width / 3 - 6px;
                        height: parent.height;

                        background: Theme.surface-high;

                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 3px;

                        Text {
                            x: 8px;
                            y: 6px;

                            width: parent.width - 16px;
                            height: 18px;

                            text: "PITCH";

                            color: Theme.text-dim;

                            font-size: 9px;
                            font-weight: 600;
                        }

                        Text {
                            x: 8px;
                            y: 24px;

                            width: parent.width - 16px;
                            height: 24px;

                            text: "0 st";

                            color: Theme.text-primary;

                            font-size: 12px;
                            font-weight: 600;
                        }
                    }

                    // ---------------------------------------------
                    // PAN
                    // ---------------------------------------------

                    Rectangle {
                        x: parent.width * 2 / 3;
                        y: 0;

                        width: parent.width / 3;
                        height: parent.height;

                        background: Theme.surface-high;

                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 3px;

                        Text {
                            x: 8px;
                            y: 6px;

                            width: parent.width - 16px;
                            height: 18px;

                            text: "PAN";

                            color: Theme.text-dim;

                            font-size: 9px;
                            font-weight: 600;
                        }

                        Text {
                            x: 8px;
                            y: 24px;

                            width: parent.width - 16px;
                            height: 24px;

                            text: "C";

                            color: Theme.text-primary;

                            font-size: 12px;
                            font-weight: 600;
                        }
                    }
                }
            }
        }
    }
}