import { Theme } from "../theme.slint";
import { Knob } from "../components/knob.slint";
import { Button } from "../components/button.slint";

export component SamplerPitch inherits Rectangle {

    // ============================================================
    // PROPRIEDADES
    // ============================================================

    in-out property <float> tune: 0.5;
    in-out property <float> fine: 0.5;
    in-out property <float> octave: 0.5;
    in-out property <float> glide: 0.0;

    in-out property <bool> glide-enabled: false;

    callback tune-changed(float);
    callback fine-changed(float);
    callback octave-changed(float);
    callback glide-changed(float);
    callback glide-enabled-changed(bool);

    // ============================================================
    // FUNDO
    // ============================================================

    background: Theme.surface-high;

    border-width: 1px;
    border-color: Theme.border;
    border-radius: 3px;

    // ============================================================
    // TÍTULO
    // ============================================================

    Text {
        x: 8px;
        y: 5px;

        width: parent.width - 16px;
        height: 18px;

        text: "PITCH";

        color: Theme.text-dim;

        font-size: 9px;
        font-weight: 600;

        vertical-alignment: center;
    }

    // ============================================================
    // DIVISÓRIA
    // ============================================================

    Rectangle {
        x: 8px;
        y: 27px;

        width: parent.width - 16px;
        height: 1px;

        background: Theme.border;
    }

    // ============================================================
    // TUNE
    // ============================================================

    Knob {
        x: 8px;
        y: 36px;

        width: 54px;
        height: 68px;

        value: root.tune;

        centered: true;

        caption: "TUNE";

        display-value:
            root.tune == 0.5
                ? "0 st"
                : (
                    root.tune < 0.5
                        ? "-" + Math.round(
                            (0.5 - root.tune) * 48
                        ) + " st"
                        : "+" + Math.round(
                            (root.tune - 0.5) * 48
                        ) + " st"
                );

        show-display: true;
        show-text: true;

        changed(value) => {
            root.tune = value;
            root.tune-changed(value);
        }
    }

    // ============================================================
    // FINE
    // ============================================================

    Knob {
        x: 70px;
        y: 36px;

        width: 54px;
        height: 68px;

        value: root.fine;

        centered: true;

        caption: "FINE";

        display-value:
            root.fine == 0.5
                ? "0 ct"
                : (
                    root.fine < 0.5
                        ? "-" + Math.round(
                            (0.5 - root.fine) * 200
                        ) + " ct"
                        : "+" + Math.round(
                            (root.fine - 0.5) * 200
                        ) + " ct"
                );

        show-display: true;
        show-text: true;

        changed(value) => {
            root.fine = value;
            root.fine-changed(value);
        }
    }

    // ============================================================
    // OCTAVE
    // ============================================================

    Knob {
        x: 132px;
        y: 36px;

        width: 54px;
        height: 68px;

        value: root.octave;

        centered: true;

        caption: "OCTAVE";

        display-value:
            root.octave == 0.5
                ? "0"
                : (
                    root.octave < 0.5
                        ? "-" + Math.round(
                            (0.5 - root.octave) * 8
                        )
                        : "+" + Math.round(
                            (root.octave - 0.5) * 8
                        )
                );

        show-display: true;
        show-text: true;

        changed(value) => {
            root.octave = value;
            root.octave-changed(value);
        }
    }

    // ============================================================
    // GLIDE
    // ============================================================

    Knob {
        x: 194px;
        y: 36px;

        width: 54px;
        height: 68px;

        value: root.glide;

        caption: "GLIDE";

        display-value:
            Math.round(
                root.glide * 2000
            ) + " ms";

        show-display: true;
        show-text: true;

        changed(value) => {
            root.glide = value;
            root.glide-changed(value);
        }
    }

    // ============================================================
    // GLIDE ON/OFF
    // ============================================================

    Button {
        x: 256px;
        y: 48px;

        width: 48px;
        height: 26px;

        text: "GLD";

        toggled: root.glide-enabled;

        text-color: Theme.text-dim;

        toggled-bg: Theme.accent;
        toggled-fg: Theme.on-accent;

        clicked => {
            root.glide-enabled = !root.glide-enabled;
            root.glide-enabled-changed(
                root.glide-enabled
            );
        }
    }

    // ============================================================
    // RANGE
    // ============================================================

    Text {
        x: 8px;
        y: 110px;

        width: 240px;
        height: 18px;

        text: "±24 ST  •  ±200 CT  •  ±4 OCT";

        color: Theme.text-dim;

        font-size: 8px;

        vertical-alignment: center;
    }

    // ============================================================
    // STATUS
    // ============================================================

    Text {
        x: 256px;
        y: 80px;

        width: 48px;
        height: 18px;

        text: root.glide-enabled
            ? "ON"
            : "OFF";

        color: root.glide-enabled
            ? Theme.accent
            : Theme.text-dim;

        font-size: 7px;

        horizontal-alignment: center;
        vertical-alignment: center;
    }
}