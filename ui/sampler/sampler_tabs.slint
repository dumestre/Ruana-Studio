// ============================================================
// ABAS DO SAMPLER
// ============================================================
//
// A correção estrutural. O sampler antigo empilhava ~540px de
// cards em posição absoluta dentro de um host de 215px
// (ui/windows/workspace.slint:95), então envelope, filtro, amp e
// LFO simplesmente NUNCA apareciam.
//
// Em vez de tentar caber tudo de uma vez, o conteúdo vira páginas.
// Isso também dá endereço para os 4 módulos órfãos (keymap,
// mapping, velocity, playback) que estavam no repositório sem
// ninguém importar.
//
// O ponto verde na aba diz que existe algo LIGADO naquela página —
// sem isso, esconder conteúdo atrás de aba esconderia estado.
// ============================================================

import { SamplerStyle } from "sampler_style.slint";

export component SamplerTabs inherits Rectangle {
    in property <[string]> tabs: ["MAIN", "ZONE", "MAP", "MOD"];
    in property <int> current: 0;
    // Um bool por aba: página tem algo ativo. Curto ou vazio = sem ponto.
    in property <[bool]> active: [];
    in property <bool> compact: false;
    callback picked(int);

    height: SamplerStyle.tab-h(root.compact);
    background: SamplerStyle.panel;

    // Régua sob a fileira: amarra as abas ao conteúdo.
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: SamplerStyle.hairline;
    }

    HorizontalLayout {
        spacing: 0px;
        alignment: start;

        for t[i] in root.tabs: Rectangle {
            width: root.compact ? 52px : 64px;
            background: i == root.current ? SamplerStyle.card : transparent;

            HorizontalLayout {
                alignment: center;
                spacing: 3px;

                Text {
                    text: t;
                    font-size: SamplerStyle.title-size(root.compact);
                    font-weight: i == root.current ? 700 : 500;
                    letter-spacing: 0.8px;
                    color: i == root.current
                        ? SamplerStyle.text
                        : (tab-ta.has-hover ? SamplerStyle.text-mid : SamplerStyle.text-faint);
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }

                // Ponto de "tem coisa ligada aqui".
                if i < root.active.length && root.active[i]: Rectangle {
                    width: 3px;
                    height: 3px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 1.5px;
                    background: SamplerStyle.sec-amp;
                    horizontal-stretch: 0;
                }
            }

            // Indicador da aba atual: 2px no topo, como aba de DAW.
            if i == root.current: Rectangle {
                height: 2px;
                background: SamplerStyle.sec-sample;
            }

            // Tampa a régua de baixo na aba ativa, para a página
            // parecer contínua com a aba.
            if i == root.current: Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: SamplerStyle.card;
            }

            tab-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.picked(i);
                }
            }

            states [
                hovered when tab-ta.has-hover && i != root.current: {
                    background: SamplerStyle.card.with-alpha(0.5);
                }
            ]
        }

        // Espaço à direita para o que o chamador quiser encaixar.
        Rectangle {
            horizontal-stretch: 1;
            @children
        }
    }
}
