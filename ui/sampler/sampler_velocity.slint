import { Theme } from "../theme.slint";
import { Knob } from "../components/knob.slint";
import { Button } from "../components/button.slint";
import { SamplerCurves } from "sampler_curves.slint";

export component SamplerVelocity inherits Rectangle {

    // ============================================================
    // PROPRIEDADES
    // ============================================================

    in-out property <float> volume-amount: 1.0;
    in-out property <float> filter-amount: 0.0;
    in-out property <float> pitch-amount: 0.0;

    in-out property <string> curve: "LINEAR";

    callback volume-amount-changed(float);
    callback filter-amount-changed(float);
    callback pitch-amount-changed(float);
    callback curve-changed(string);

    // ============================================================
    // FUNDO
    // ============================================================

    background: Theme.surface-high;

    border-width: 1px;
    border-color: Theme.border;
    border-radius: 3px;

    // ============================================================
    // TÍTULO
    // ============================================================

    Text {
        x: 8px;
        y: 5px;

        width: parent.width - 16px;
        height: 18px;

        text: "VELOCITY";

        color: Theme.text-dim;

        font-size: 9px;
        font-weight: 600;

        vertical-alignment: center;
    }

    Rectangle {
        x: 8px;
        y: 27px;

        width: parent.width - 16px;
        height: 1px;

        background: Theme.border;
    }

    // ============================================================
    // CURVA
    // ============================================================

    Rectangle {
        x: 8px;
        y: 34px;

        width: 100px;
        height: 72px;

        background: Theme.base;

        border-width: 1px;
        border-color: Theme.border;
        border-radius: 2px;

        // --------------------------------------------------------
        // GRID
        // --------------------------------------------------------

        Rectangle {
            x: 0;
            y: parent.height / 2;

            width: parent.width;
            height: 1px;

            background: Theme.grid-sub;
        }

        Rectangle {
            x: parent.width / 2;
            y: 0;

            width: 1px;
            height: parent.height;

            background: Theme.grid-sub;
        }

        // Uma única curva Bézier substitui os 96 retângulos da versão
        // anterior. O viewbox normalizado é escalado pelo Path.
        Path {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            commands: SamplerCurves.velocity-curve(
                root.curve == "SOFT" ? "LOG" : root.curve == "HARD" ? "EXP" : "LINEAR",
                false
            );
            stroke: Theme.accent;
            stroke-width: 18;
            fill: transparent;
            viewbox-width: 1000;
            viewbox-height: 1000;
        }
    }

    // ============================================================
    // CURVE BUTTONS
    // ============================================================

    Button {
        x: 116px;
        y: 34px;

        width: 58px;
        height: 22px;

        text: "LINEAR";

        borderless: true;

        toggled: root.curve == "LINEAR";

        text-color: Theme.text-dim;

        toggled-bg: Theme.accent;
        toggled-fg: Theme.on-accent;

        clicked => {
            root.curve = "LINEAR";
            root.curve-changed("LINEAR");
        }
    }

    Button {
        x: 176px;
        y: 34px;

        width: 58px;
        height: 22px;

        text: "SOFT";

        borderless: true;

        toggled: root.curve == "SOFT";

        text-color: Theme.text-dim;

        toggled-bg: Theme.accent;
        toggled-fg: Theme.on-accent;

        clicked => {
            root.curve = "SOFT";
            root.curve-changed("SOFT");
        }
    }

    Button {
        x: 236px;
        y: 34px;

        width: 58px;
        height: 22px;

        text: "HARD";

        borderless: true;

        toggled: root.curve == "HARD";

        text-color: Theme.text-dim;

        toggled-bg: Theme.accent;
        toggled-fg: Theme.on-accent;

        clicked => {
            root.curve = "HARD";
            root.curve-changed("HARD");
        }
    }

    // ============================================================
    // VOLUME
    // ============================================================

    Knob {
        x: 116px;
        y: 62px;

        width: 48px;
        height: 64px;

        value: root.volume-amount;

        caption: "VOLUME";

        display-value:
            Math.round(root.volume-amount * 100) + "%";

        show-display: true;
        show-text: true;

        changed(value) => {
            root.volume-amount = value;
            root.volume-amount-changed(value);
        }
    }

    // ============================================================
    // FILTER
    // ============================================================

    Knob {
        x: 172px;
        y: 62px;

        width: 48px;
        height: 64px;

        value: root.filter-amount;

        caption: "FILTER";

        display-value:
            Math.round(root.filter-amount * 100) + "%";

        show-display: true;
        show-text: true;

        centered: true;

        changed(value) => {
            root.filter-amount = value;
            root.filter-amount-changed(value);
        }
    }

    // ============================================================
    // PITCH
    // ============================================================

    Knob {
        x: 228px;
        y: 62px;

        width: 48px;
        height: 64px;

        value: root.pitch-amount;

        caption: "PITCH";

        display-value:
            Math.round((root.pitch-amount - 0.5) * 24) + " st";

        show-display: true;
        show-text: true;

        centered: true;

        changed(value) => {
            root.pitch-amount = value;
            root.pitch-amount-changed(value);
        }
    }
}
