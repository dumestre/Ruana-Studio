import { Theme } from "../theme.slint";
import { Toolbar } from "../toolbar.slint";
import { Transport } from "../transport.slint";
import { EditToolbar } from "../edit_toolbar.slint";
import { ClipPool, ClipItemVisual } from "../clip_pool.slint";
import { Timeline } from "../timeline/timeline.slint";
import { ClipData } from "../timeline/clip_data.slint";
import { Explorer } from "../explorer/explorer.slint";
import { Mixer } from "../mixer.slint";
import { SamplerArea } from "../components/sampler_area.slint";
import { PianoRollArea } from "../components/piano_roll_area.slint";
import { SplitterVerticalGrowLeft, SplitterVerticalGrowRight, SplitterHorizontal } from "../components/splitter.slint";
import { ZoomBarHorizontal, ZoomBarVertical } from "../components/zoom_bar.slint";
import { ScrollBarHorizontal, ScrollBarVertical } from "../components/scrollbar.slint";
import { TrackPanel } from "../timeline/TrackPanel.slint";
import { BottomToolbar } from "../components/bottom_toolbar.slint";

export component Workspace inherits Rectangle {
    in-out property <bool> full-screen: false;
    in-out property <float> zoom-level: 1.0;
    in-out property <bool> playing: false;
    in-out property <int> transport-position: 0;
    in-out property <int> selected-track: 0;
    in-out property <int> active-tool: 0;
    in-out property <bool> beat-open: false;
    in-out property <bool> explorer-visible: true;
    in-out property <length> left-panel-width: 230px;
    in-out property <length> tracks-header-width: 200px;
    in-out property <length> explorer-width: 300px;
    in-out property <length> bottom-panel-height: 215px;
    in-out property <[string]> track-names: ["Drums", "Bass", "Vocal", "Synth"];
    in-out property <[ClipData]> clips: [];
    in-out property <float> zoom-y-level: 1.0;
    in-out property <bool> drag-active: false;
    in-out property <bool> drag-inited: false;

    in-out property <bool> drag-over-timeline: false;
    in-out property <float> drag-snap-beat: 0.0;
    in-out property <int> drag-drop-track: 0;

    in-out property <length> drag-x: 0px;
    in-out property <length> drag-y: 0px;
    in-out property <string> drag-name: "";
    in-out property <string> drag-position: "";
    in-out property <string> drag-duration: "";
    in-out property <color> drag-color: Theme.clip-midi;
    in-out property <bool> drag-is-midi: true;
    in-out property <angle> drag-tilt-display: 0deg;
    in-out property <[float]> mixer-meters: [0, 0, 0, 0, 0];
    in-out property <[bool]> mixer-mutes: [false, false, false, false, false];
    in-out property <[bool]> mixer-soloes: [false, false, false, false, false];
    in-out property <[bool]> mixer-arms: [false, false, false, false, false];
    in-out property <[float]> mixer-volumes: [0.8, 0.8, 0.8, 0.8, 0.8];
    in-out property <[float]> mixer-pans: [0.5, 0.5, 0.5, 0.5, 0.5];
    in-out property <string> explorer-current-path: "";
    in-out property <[string]> explorer-path-history: [];
    in-out property <int> explorer-history-index: -1;
    in-out property <[string]> explorer-entries: [];

    callback close();
    callback minimize();
    callback play-state-changed(bool);
    callback add-track-requested(string);
    callback clip-slice-requested(int, float);
    callback clip-move-started(int, float);
    callback clip-move-delta(int, float);
    callback clip-move-finished(int);
    callback mixer-param-changed(int, string, float);
    callback explorer-path-changed(string);
    callback explorer-directory-entered(string);
    callback explorer-go-up();
    callback drag-begin(string, string, string, color, bool);
    callback drag-move(length, length);
    callback drag-end();

    width: 100%;
    height: 100%;

    property <bool> bottom-panel-expanded: false;
    property <bool> bottom-panel-visible: true;
    property <length> expanded-panel-height: max(400px, root.height * 0.6);

    VerticalLayout {
        alignment: LayoutAlignment.stretch;
        cross-axis-alignment: CrossAxisAlignment.stretch;
        spacing: 0;

        // TOOLBAR
        Toolbar {
            full-screen <=> root.full-screen;

            zoom-in => {
                root.zoom-level = min(root.zoom-level + 0.25, 4.0);
            }
            zoom-out => {
                root.zoom-level = max(root.zoom-level - 0.25, 0.5);
            }
            close => { root.close(); }
            minimize => { root.minimize(); }
        }

        // TRANSPORT
        Transport {
            playing <=> root.playing;
            position <=> root.transport-position;
            play-state-changed(state) => { root.play-state-changed(state); }
        }

        // EDIT TOOLBAR
        EditToolbar {
            active-tool <=> root.active-tool;
            beat-open <=> root.beat-open;
            explorer-visible <=> root.explorer-visible;
            panel-visible <=> root.bottom-panel-visible;
        }

        // MAIN WORKSPACE AREA
        workspace := Rectangle {
            width: 100%;
            vertical-stretch: 1;

            // CLIP POOL (left)
            clip_pool := ClipPool {
                x: 0;
                y: 0;
                width: root.left-panel-width;
                height: 100%;
                selected-track <=> root.selected-track;
                track-names: root.track-names;

                clip-drag-started(name, position, duration, color, is-midi) => {
                    root.drag-begin(name, position, duration, color, is-midi);
                }
                clip-drag-moved(x, y) => { root.drag-move(x, y); }
                clip-drag-finished() => { root.drag-end(); }
            }

            // TRACK PANEL + TIMELINE (center)
            center-panel := Rectangle {
                x: root.left-panel-width;
                y: 0;
                width: parent.width - root.left-panel-width - (root.explorer-visible ? root.explorer-width + 5px : 0px);
                height: root.bottom-panel-visible
                    ? parent.height - root.bottom-panel-height - 5px
                    : parent.height;

                VerticalLayout {
                    spacing: 0;
                    alignment: LayoutAlignment.stretch;
                    cross-axis-alignment: CrossAxisAlignment.stretch;
                    height: 100%;

                    HorizontalLayout {
                        spacing: 0;
                        cross-axis-alignment: CrossAxisAlignment.stretch;
                        height: 100%;

                        // TRACK PANEL
                        TrackPanel {
                            width: root.tracks-header-width;
                            selected-track <=> root.selected-track;
                            track-names: root.track-names;
                            zoom-y: root.zoom-y-level;
                            track-clicked(index) => { root.selected-track = index; }
                            add-track-requested(type) => { root.add-track-requested(type); }
                        }

                        // TIMELINE
                        timeline := Timeline {
                            horizontal-stretch: 1;
                            selected-track <=> root.selected-track;
                            position: root.transport-position;
                            zoom <=> root.zoom-level;
                            zoom-y <=> root.zoom-y-level;
                            track-names: root.track-names;
                            active-tool: root.active-tool;
                            clips: root.clips;
                            drop-visible: root.drag-active && root.drag-inited && root.drag-over-timeline;
                            drop-x: root.drag-snap-beat * timeline.px-per-beat;
                            drop-track: root.drag-drop-track;
                            drop-len-beats: 4.0;
                            select-track(index) => { root.selected-track = index; }
                            clip-selected(index) => { root.selected-track = index; }
                            clip-slice-requested(id, position) => { root.clip-slice-requested(id, position); }
                            clip-move-started(id, beat) => { root.clip-move-started(id, beat); }
                            clip-move-delta(id, delta) => { root.clip-move-delta(id, delta); }
                            clip-move-finished(id) => { root.clip-move-finished(id); }
                            Rectangle { min-width: 16px; min-height: 16px; }
                        }
                    }
                }

                // SPLITTER TRACK PANEL
                SplitterVerticalGrowLeft {
                    x: root.tracks-header-width;
                    y: 0;
                    width: 5px;
                    height: 100%;
                    value <=> root.tracks-header-width;
                    min-value: 120px;
                    max-value: 420px;
                    z: 50;
                }

                // TIMELINE BARS
                ScrollBarHorizontal {
                    x: root.tracks-header-width;
                    y: parent.height - 14px;
                    width: parent.width - root.tracks-header-width - 32px;
                    height: 14px;
                    value <=> timeline.scroll-x;
                    max-value: timeline.max-scroll-x;
                    thumb-size: parent.width * parent.width / (parent.width + timeline.max-scroll-x);
                    z: 60;
                }

                ZoomBarHorizontal {
                    x: root.tracks-header-width;
                    y: parent.height - 14px - 16px;
                    width: parent.width - root.tracks-header-width - 32px;
                    height: 16px;
                    value: root.zoom-level;
                    min-value: 0.5;
                    max-value: 4.0;
                    zoom-requested(new-zoom) => {
                        let old-zoom = timeline.zoom;
                        root.zoom-level = new-zoom;
                        timeline.zoom = new-zoom;
                        timeline.scroll-x = max(0px, min(timeline.max-scroll-x,
                            ((timeline.width / 2 + timeline.scroll-x) / old-zoom) * new-zoom - timeline.width / 2
                        ));
                    }
                    z: 60;
                }

                ScrollBarVertical {
                    x: parent.width - 14px;
                    y: 0;
                    width: 14px;
                    height: parent.height - 30px;
                    value <=> timeline.scroll-y;
                    max-value: timeline.max-scroll-y;
                    thumb-size: parent.height * parent.height / (parent.height + timeline.max-scroll-y);
                    z: 60;
                }

                ZoomBarVertical {
                    x: parent.width - 30px;
                    y: 0;
                    width: 16px;
                    height: parent.height - 30px;
                    value <=> root.zoom-y-level;
                    min-value: 0.4;
                    max-value: 3.0;
                    z: 60;
                }
            }

            // SPLITTER BETWEEN UPPER AREA AND BOTTOM PANEL
            SplitterHorizontal {
                visible: root.bottom-panel-visible;
                x: root.left-panel-width;
                y: parent.height - root.bottom-panel-height - 5px;
                width: center-panel.width;
                height: 5px;
                value <=> root.bottom-panel-height;
                min-value: 120px;
                max-value: 600px;
                z: 30;
            }

            // BOTTOM PANEL: Dynamic content (Mixer / Sampler / Piano Roll)
            bottom-panel := Rectangle {
                visible: root.bottom-panel-visible;
                x: root.left-panel-width;
                y: parent.height - root.bottom-panel-height;
                width: center-panel.width;
                height: root.bottom-panel-height;
                background: Theme.surface;
                border-top-left-radius: 8px;
                border-top-right-radius: 8px;

                property <int> current-tab: bottom-toolbar.selected-tab;

                VerticalLayout {
                    spacing: 0;
                    alignment: LayoutAlignment.stretch;
                    cross-axis-alignment: CrossAxisAlignment.stretch;
                    height: 100%;

                    // Tab bar (top of panel)
                    bottom-toolbar := BottomToolbar {
                        toolbar-height <=> bottom-toolbar.height;
                    }

                    // Dynamic content based on selected tab
                    Rectangle {
                        width: 100%;
                        vertical-stretch: 1;
                        clip: true;

                        Mixer {
                            width: 100%;
                            height: 100%;
                            visible: bottom-panel.current-tab == 0;
                            expanded <=> root.bottom-panel-expanded;
                            expand-toggle => {
                                root.bottom-panel-expanded = !root.bottom-panel-expanded;
                                root.bottom-panel-height = root.bottom-panel-expanded ? root.expanded-panel-height : 215px;
                            }
                            meters <=> root.mixer-meters;
                            mutes <=> root.mixer-mutes;
                            soloes <=> root.mixer-soloes;
                            arms <=> root.mixer-arms;
                            volumes <=> root.mixer-volumes;
                            pans <=> root.mixer-pans;
                            channel-param-changed(idx, param, val) => { root.mixer-param-changed(idx, param, val); }
                        }

                        SamplerArea {
                            width: 100%;
                            height: 100%;
                            visible: bottom-panel.current-tab == 1;
                            expanded <=> root.bottom-panel-expanded;
                            expand-toggle => {
                                root.bottom-panel-expanded = !root.bottom-panel-expanded;
                                root.bottom-panel-height = root.bottom-panel-expanded ? root.expanded-panel-height : 215px;
                            }
                        }

                        PianoRollArea {
                            width: 100%;
                            height: 100%;
                            visible: bottom-panel.current-tab == 2;
                            expanded <=> root.bottom-panel-expanded;
                            expand-toggle => {
                                root.bottom-panel-expanded = !root.bottom-panel-expanded;
                                root.bottom-panel-height = root.bottom-panel-expanded ? root.expanded-panel-height : 215px;
                            }
                        }

                        Rectangle {
                            visible: bottom-panel.current-tab == 3;
                            width: 100%;
                            height: 100%;
                            background: Theme.base;
                        }
                    }
                }
            }

            // EXPLORER (right)
            Rectangle {
                x: parent.width - root.explorer-width;
                y: 0;
                width: root.explorer-width;
                height: 100%;
                visible: root.explorer-visible;

                SplitterVerticalGrowRight {
                    x: -5px;
                    y: 0;
                    width: 5px;
                    height: 100%;
                    value <=> root.explorer-width;
                    min-value: 220px;
                    max-value: 500px;
                    z: 40;
                }

                Explorer {
                    x: 0;
                    y: 0;
                    width: root.explorer-width;
                    height: 100%;
                    z: 40;
                    current-path <=> root.explorer-current-path;
                    path-history <=> root.explorer-path-history;
                    history-index <=> root.explorer-history-index;
                    entries <=> root.explorer-entries;
                    audio-drag-started(name, type, color, is-midi) => { root.drag-begin(name, "", "", color, is-midi); }
                    audio-drag-moved(x, y) => { root.drag-move(x, y); }
                    audio-drag-finished() => { root.drag-end(); }
                    explorer-path-changed(path) => { root.explorer-path-changed(path); }
                    explorer-directory-entered(path) => { root.explorer-directory-entered(path); }
                    explorer-go-up() => { root.explorer-go-up(); }
                }
            }

            // DRAG GHOST
            Rectangle {
                visible: root.drag-active && root.drag-inited;
                x: root.drag-over-timeline
                    ? timeline.absolute-position.x - root.absolute-position.x - timeline.scroll-x + root.drag-snap-beat * timeline.px-per-beat
                    : root.drag-x - root.absolute-position.x - (root.left-panel-width - 16px) / 2;
                y: root.drag-y - root.absolute-position.y - 19px;
                width: root.left-panel-width - 16px;
                height: 38px;
                transform-rotation: root.drag-tilt-display;
                transform-origin: { x: (root.left-panel-width - 16px) / 2, y: 19px };
                z: 200;

                Rectangle {
                    x: -3px;
                    y: -3px;
                    width: parent.width + 6px;
                    height: parent.height + 6px;
                    background: root.drag-color.transparentize(0.65);
                    border-radius: 7px;
                    z: -1;
                }

                ClipItemVisual {
                    width: 100%;
                    height: 100%;
                    name: root.drag-name;
                    position: root.drag-position;
                    duration: root.drag-duration;
                    clip-color: root.drag-color;
                    is-midi: root.drag-is-midi;
                }
            }
        }

        // STATUS DIVIDER
        Rectangle {
            width: 100%;
            height: 1px;
            background: Theme.border;
        }

        // STATUS BAR
        Rectangle {
            width: 100%;
            height: 22px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 16px;
                Text { text: "Ruana Studio 0.1.0"; color: Theme.text-dim; font-size: 10px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text { text: "120 BPM"; color: Theme.text-dim; font-size: 10px; vertical-alignment: center; }
                Text { text: "44.1 kHz"; color: Theme.text-dim; font-size: 10px; vertical-alignment: center; }
                Text { text: "24-bit"; color: Theme.text-dim; font-size: 10px; vertical-alignment: center; }
                Text { text: "FASE 1 - UI"; color: Theme.accent; font-size: 10px; vertical-alignment: center; }
            }
        }

        // Timer to update computed drag properties
        Timer {
            interval: 16ms;
            running: root.drag-active && root.drag-inited;
            triggered() => {
                root.drag-over-timeline = root.drag-x >= timeline.absolute-position.x
                    && root.drag-x <= timeline.absolute-position.x + timeline.width
                    && root.drag-y >= timeline.absolute-position.y + timeline.ruler-height;
                root.drag-snap-beat = max(0.0, round(((root.drag-x - timeline.absolute-position.x + timeline.scroll-x) / timeline.px-per-beat) * 2.0) / 2.0);
                root.drag-drop-track = max(0, min(floor((root.drag-y - timeline.absolute-position.y + timeline.scroll-y - timeline.ruler-height) / timeline.row-height), max(0, root.track-names.length - 1)));
            }
        }
    }
}