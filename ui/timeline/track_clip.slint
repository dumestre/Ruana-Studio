import { Theme } from "../theme.slint";
import { AudioWaveform } from "audio_waveform.slint";

export component TrackClip inherits Rectangle {

    // =====================================================
    // DADOS
    // =====================================================

    in property <string> name: "";

    in property <int> clip-id: 0;

    in property <float> beat: 0.0;

    in property <float> len: 4.0;

    in property <bool> is-midi: true;

    in property <int> color-index: 0;

    in property <length> px-per-beat: 40px;

    in property <length> row-height: 64px;

    in property <int> track-index: 0;

    in property <bool> selected: false;

    in property <int> active-tool: 0;

    in property <[float]> waveform-peaks: [];

    in property <int> drag-clip-id: -1;
    in property <int> drag-track-offset: 0;


    // =====================================================
    // PALETA DE CORES (8 opções, index 0 = padrão by-kind)
    // =====================================================

    private property <[color]> palette: [
        #6FA86B, // 0: padrão MIDI (verde original)
        #4F8AE0, // 1: azul
        #E0A94F, // 2: âmbar
        #E05E5E, // 3: vermelho
        #A060D8, // 4: roxo
        #E05EAA, // 5: rosa
        #3EC7B0, // 6: turquesa
        #C0C050, // 7: limão
    ];

    private property <color> audio-default: #00C853;

    private property <color> base-color:
        root.color-index == 0
            ? (root.is-midi ? Theme.clip-midi : root.audio-default)
            : root.palette[Math.mod(root.color-index, root.palette.length)];

    in property <color> clip-color: root.base-color;


    // =====================================================
    // CALLBACKS (PÚBLICOS)
    // =====================================================

    callback clicked(int);

    callback slice-requested(int, float);

    callback clip-move-started(int, float);       // id, start-beat
    callback clip-move-delta(int, float, int);     // id, delta-beats, delta-tracks
    callback clip-move-finished(int);              // id

    callback clip-resize-started(int, int);        // id, side (-1 left, 1 right)
    callback clip-resize-delta(int, int, float);   // id, side, delta-beats acumulado
    callback clip-resize-finished(int);            // id

    callback clip-delete-requested(int);           // id
    callback clip-rename-requested(int, string);   // id, new-name
    callback clip-color-cycle-requested(int);      // id → incrementa paleta


    // =====================================================
    // DIMENSÕES
    // =====================================================

    private property <length> edge-width: 7px;

    private property <length> header-height: 18px;


    // =====================================================
    // ESTADO DO MOUSE (hover + edges)
    // =====================================================

    private property <bool> hovered: touch.has-hover;

    private property <bool> on-left-edge:
        touch.has-hover
        && touch.mouse-x <= root.edge-width;

    private property <bool> on-right-edge:
        touch.has-hover
        && touch.mouse-x >= self.width - root.edge-width;

    private property <bool> on-edge:
        self.on-left-edge
        || self.on-right-edge;


    // =====================================================
    // SLICE
    // =====================================================

    property <length> slice-preview-x: -100px;

    private property <bool> slice-hover: touch.has-hover;


    // =====================================================
    // POSIÇÃO (usa FLOAT agora — NÃO trunca durante drag)
    // =====================================================

    x: root.beat * root.px-per-beat;

    y: 2px + (root.clip-id == root.drag-clip-id ? root.drag-track-offset * root.row-height : 0px);


    // =====================================================
    // TAMANHO
    // =====================================================

    width: root.len * root.px-per-beat;

    height: root.row-height - 4px;


    // =====================================================
    // RENAME MODE
    // =====================================================

    private property <bool> renaming: false;

    private property <string> rename-buffer: "";


    // =====================================================
    // COR BASE
    // =====================================================

    background: root.clip-color;


    // =====================================================
    // BORDA
    //
    // Seleção: borda CRIMSON — mesma cor da Playhead.
    // =====================================================

    border-radius: 4px;

    border-width:
        root.selected
            ? 3px
            : 1px;

    border-color:
        root.selected
            ? Colors.crimson
            : root.hovered
                ? root.clip-color.brighter(0.22)
                : root.clip-color.darker(0.18);


    // =====================================================
    // CORPO DO CLIP
    // =====================================================

    Rectangle {
        x: 1px;
        y: root.header-height;

        width: parent.width - 2px;

        height:
            parent.height
            - root.header-height
            - 1px;

        background:
            root.clip-color.darker(
                root.hovered
                    ? 0.08
                    : 0.15
            );

        opacity:
            root.hovered
                ? 1.0
                : 0.94;

        clip: true;

        // WAVEFORM para clips de áudio
        if !root.is-midi && root.waveform-peaks.length > 0: AudioWaveform {
            x: 2px;
            y: 0;
            width: parent.width - 4px;
            height: parent.height;
            waveform-color: root.clip-color.darker(1.5);
            hovered: root.hovered;
            peaks: root.waveform-peaks;
        }
    }


    // =====================================================
    // CABEÇALHO VIBRANTE
    // =====================================================

    Rectangle {
        x: 1px;
        y: 1px;

        width: parent.width - 2px;

        height: root.header-height;

        background:
            root.clip-color.brighter(
                root.hovered
                    ? 0.46
                    : 0.34
            );

        clip: true;


        // =================================================
        // BRILHO SUPERIOR
        // =================================================

        Rectangle {
            x: 0;
            y: 0;

            width: parent.width;
            height: 2px;

            background: root.clip-color.brighter(0.58);

            opacity: 0.75;
        }


        // =================================================
        // NOME (ou TextInput no modo rename)
        // =================================================

        if !root.renaming: Text {
            x: 6px;
            y: 2px;

            width: parent.width - 12px;
            height: parent.height - 2px;

            text: root.name;

            color: #171717;

            font-size: 9px;
            font-weight: 700;

            vertical-alignment: center;

            overflow: elide;
        }

        if root.renaming: Rectangle {
            x: 6px;
            y: 2px;

            width: parent.width - 12px;
            height: parent.height - 2px;

            background: #ffffff;
            border-radius: 2px;

            TextInput {
                x: 2px;
                y: 0;
                width: parent.width - 4px;
                height: parent.height;

                text <=> root.rename-buffer;

                color: #101010;

                font-size: 9px;
                font-weight: 700;

                vertical-alignment: center;
                horizontal-alignment: TextHorizontalAlignment.left;

                edited => {
                    if root.rename-buffer != "" {
                        root.clip-rename-requested(root.clip-id, root.rename-buffer);
                    }
                    root.renaming = false;
                }
            }
        }


    }


    // =====================================================
    // DIVISÓRIA DO HEADER
    // =====================================================

    Rectangle {
        x: 1px;
        y: root.header-height;
        width: parent.width - 2px;
        height: 1px;

        background: root.clip-color.brighter(0.30);

        opacity:
            root.hovered
                ? 0.85
                : 0.55;
    }


    // =====================================================
    // INDICADOR DE TIPO (águlha direita)
    // =====================================================

    Rectangle {
        x: parent.width - 8px;
        y: 5px;
        width: 3px;
        height: 8px;
        border-radius: 1px;
        background: Theme.text-primary;
        opacity: 0.45;
    }


    // =====================================================
    // HANDLE ESQUERDO
    // =====================================================

    if root.active-tool == 0
        && root.on-left-edge: Rectangle {

        x: 2px;
        y: 3px;
        width: 2px;
        height: parent.height - 6px;

        background: Theme.text-primary;
        opacity: 0.85;
        border-radius: 1px;
        z: 5;
    }


    // =====================================================
    // HANDLE DIREITO
    // =====================================================

    if root.active-tool == 0
        && root.on-right-edge: Rectangle {

        x: parent.width - 4px;
        y: 3px;
        width: 2px;
        height: parent.height - 6px;

        background: Theme.text-primary;
        opacity: 0.85;
        border-radius: 1px;
        z: 5;
    }


    // =====================================================
    // PREVIEW DO SLICE
    // =====================================================

    if root.active-tool == 1
        && root.slice-hover: Rectangle {

        x: root.slice-preview-x - 1px;
        y: 0px;
        width: 2px;
        height: parent.height;

        background: Theme.playhead;
        opacity: 0.95;
        z: 10;

        Rectangle {
            x: -2px;
            y: 0;
            width: 6px;
            height: 100%;
            background: Theme.playhead;
            opacity: 0.12;
        }
    }


    // =====================================================
    // TOUCH AREA PRINCIPAL — tudo é tratado aqui
    // =====================================================

    touch := TouchArea {

        x: 0;
        y: 0;

        width: parent.width;
        height: parent.height;

        // Renaming: libera o mouse para o TextInput do header.
        // NUNCA desabilitar durante o drag: o grab do ponteiro
        // morreria no meio do gesto e o clip "gruda".
        enabled: !root.renaming;

        mouse-cursor:
            root.active-tool == 1
                ? crosshair
                : root.active-tool == 0
                    && root.on-edge
                        ? ew-resize
                        : root.active-tool >= 3
                            ? none
                            : pointer;


        // =================================================
        // DOUBLE-CLICK NO HEADER → MODO RENAME
        // (o touch é o topo do clip: o rename vive aqui)
        // =================================================

        double-clicked => {
            if root.active-tool == 0
                && self.mouse-y <= root.header-height {
                root.rename-buffer = root.name;
                root.renaming = true;
            }
        }


        // =================================================
        // POINTER EVENT — unifica slice, move, resize, eraser, color
        //
        // SELEÇÃO NO PRESS (não no release): 1 clique seleciona
        // E já permite arrastar na mesma gesto.
        // =================================================

        pointer-event(event) => {

            // ----- RIGHT CLICK: COLOR CYCLE -----
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.clip-color-cycle-requested(root.clip-id);
            }

            // ----- FERRAMENTA ERASER (2) -----
            if root.active-tool == 2 {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.clip-delete-requested(root.clip-id);
                }
            }

            // ----- FERRAMENTA SLICE (1) -----
            if root.active-tool == 1 {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.slice-requested(
                        root.clip-id,
                        root.slice-preview-x / root.px-per-beat
                    );
                } else if event.kind == PointerEventKind.move {
                    root.slice-preview-x = self.mouse-x;
                }
            }

            // ----- FERRAMENTA SELECT (0) RESIZE NA BORDA -----
            if root.active-tool == 0 && root.on-edge {

                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {

                    let side =
                        root.on-left-edge
                            ? -1
                            : 1;

                    root.clicked(root.clip-id);

                    self.resize-side = side;
                    self.resize-start-abs-x = self.mouse-x + self.absolute-position.x;
                    self.resize-start-beat = root.beat;
                    self.resize-start-len = root.len;
                    self.resizing = true;

                    root.clip-resize-started(root.clip-id, side);

                } else if event.kind == PointerEventKind.move && self.resizing {

                    let dx = (self.mouse-x + self.absolute-position.x) - self.resize-start-abs-x;
                    let delta_beats = dx / root.px-per-beat;

                    root.clip-resize-delta(
                        root.clip-id,
                        self.resize-side,
                        delta_beats
                    );

                } else if event.kind == PointerEventKind.up && self.resizing {

                    self.resizing = false;
                    root.clip-resize-finished(root.clip-id);
                }
            }

            // ----- FERRAMENTA SELECT (0) MOVER (não edge) -----
            if root.active-tool == 0 && !root.on-edge && !root.renaming {

                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {

                    root.clicked(root.clip-id);

                    self.drag-start-abs-x = self.mouse-x + self.absolute-position.x;
                    self.drag-start-abs-y = self.mouse-y + self.absolute-position.y;
                    self.drag-start-beat = root.beat;
                    self.dragging = true;

                    root.clip-move-started(root.clip-id, root.beat);

                } else if event.kind == PointerEventKind.move && self.dragging {

                    let dx = (self.mouse-x + self.absolute-position.x) - self.drag-start-abs-x;
                    let dy = (self.mouse-y + self.absolute-position.y) - self.drag-start-abs-y;
                    let delta_beats = dx / root.px-per-beat;
                    let delta_tracks = Math.round(dy / root.row-height);

                    root.clip-move-delta(root.clip-id, delta_beats, delta_tracks);

                } else if event.kind == PointerEventKind.up && self.dragging {

                    self.dragging = false;
                    root.clip-move-finished(root.clip-id);
                }
            }
        }


        // ==================== ESTADOS PRIVADOS ====================

        // Move (absolute window coordinates to survive clip repositioning)
        private property <length> drag-start-abs-x: 0px;
        private property <length> drag-start-abs-y: 0px;
        private property <float> drag-start-beat: 0.0;
        private property <bool> dragging: false;

        // Resize
        private property <int> resize-side: 0;      // -1 left, 1 right
        private property <length> resize-start-abs-x: 0px;
        private property <float> resize-start-beat: 0.0;
        private property <float> resize-start-len: 0.0;
        private property <bool> resizing: false;
    }
}
