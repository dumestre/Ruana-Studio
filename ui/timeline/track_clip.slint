import { Theme } from "../theme.slint";
import { AudioWaveform } from "audio_waveform.slint";
import { ClipContextMenuState } from "../components/context_menu.slint";

export component TrackClip inherits Rectangle {

    // =====================================================
    // DADOS
    // =====================================================

    in property <string> name: "";

    in property <int> clip-id: 0;

    in property <float> beat: 0.0;

    in property <float> len: 4.0;

    in property <bool> is-midi: true;

    in property <int> color-index: 0;

    in property <length> px-per-beat: 40px;

    in property <length> row-height: 64px;

    in property <int> track-index: 0;

    in property <bool> selected: false;

    in property <int> active-tool: 0;

    in property <[float]> waveform-peaks: [];

    in property <int> drag-clip-id: -1;

    in property <int> drag-track-offset: 0;


    // =====================================================
    // PALETA
    // =====================================================

    private property <[color]> palette: [
        #6FA86B,
        #4F8AE0,
        #E0A94F,
        #E05E5E,
        #A060D8,
        #E05EAA,
        #3EC7B0,
        #C0C050
    ];

    private property <color> audio-default: #00C853;

    private property <color> base-color:
        root.color-index == 0
            ? (
                root.is-midi
                    ? Theme.clip-midi
                    : root.audio-default
            )
            : root.palette[
                Math.mod(
                    root.color-index,
                    root.palette.length
                )
            ];

    in property <color> clip-color:
        root.base-color;


    // =====================================================
    // CALLBACKS
    // =====================================================

    callback clicked(int);

    callback slice-requested(int, float);

    callback clip-move-started(int, float);

    callback clip-move-delta(int, float, int);

    callback clip-move-finished(int);

    callback clip-resize-started(int, int);

    callback clip-resize-delta(int, int, float);

    callback clip-resize-finished(int);

    callback clip-delete-requested(int);

    callback clip-rename-requested(int, string);

    callback clip-color-cycle-requested(int);

    callback clip-copy-requested(int);


    // =====================================================
    // DIMENSÕES
    // =====================================================

    private property <length> edge-width:
        7px;

    private property <length> header-height:
        18px;

    private property <length> minimum-clip-width:
        4px;

    private property <float> minimum-clip-length:
        0.0625;


    // =====================================================
    // ESTADO DO MOUSE
    // =====================================================

    private property <bool> hovered:
        touch.has-hover;

    private property <bool> on-left-edge:
        root.hovered
        && touch.mouse-x <= root.edge-width;

    private property <bool> on-right-edge:
        root.hovered
        && touch.mouse-x >= root.width - root.edge-width;

    private property <bool> on-edge:
        root.on-left-edge
        || root.on-right-edge;


    // =====================================================
    // ESTADO DO DRAG
    // =====================================================

    private property <bool> dragging:
        false;

    private property <bool> resizing:
        false;

    private property <int> resize-side:
        0;

    private property <length> drag-start-x:
        0px;

    private property <length> drag-start-y:
        0px;

    private property <float> drag-start-beat:
        0.0;

    private property <int> drag-start-track:
        0;

    private property <length> resize-start-x:
        0px;

    private property <float> resize-start-beat:
        0.0;

    private property <float> resize-start-len:
        0.0;


    // =====================================================
    // RENAME
    // =====================================================

    private property <bool> renaming:
        false;

    private property <string> rename-buffer:
        "";


    // =====================================================
    // SLICE
    // =====================================================

    property <length> slice-preview-x:
        -100px;

    private property <bool> slice-hover:
        root.active-tool == 1
        && touch.has-hover;


    // =====================================================
    // BORDA
    // =====================================================

    private property <length> bw:
        root.selected
            ? 2px
            : 1px;

    border-radius:
        4px;

    border-width:
        root.bw;

    border-color:
        root.selected
            ? #FFFFFF
            : root.hovered
                ? root.clip-color.brighter(0.22)
                : root.clip-color.darker(0.18);


    // =====================================================
    // POSIÇÃO
    // =====================================================

    x:
        root.beat * root.px-per-beat;

    y:
        2px
        + (
            root.clip-id == root.drag-clip-id
                ? root.drag-track-offset * root.row-height
                : 0px
        );


    // =====================================================
    // TAMANHO
    // =====================================================

    width:
        root.len * root.px-per-beat
            < root.minimum-clip-width
            ? root.minimum-clip-width
            : root.len * root.px-per-beat;

    height:
        root.row-height - 4px;


    // =====================================================
    // FUNDO DO ROOT
    //
    // IMPORTANTE:
    // O ROOT NÃO PINTA O FUNDO.
    //
    // Isso permite que o grid continue visível.
    // =====================================================

    background:
        #00000000;


    // =====================================================
    // CORPO DO CLIP
    // =====================================================

    Rectangle {

        x:
            root.bw;

        y:
            root.header-height;

        width:
            parent.width - 2 * root.bw;

        height:
            parent.height
            - root.header-height
            - root.bw;

        // =================================================
        // FUNDO TRANSLÚCIDO
        //
        // O alpha está AQUI.
        // Não usamos opacity no Rectangle.
        //
        // Assim a waveform continua opaca.
        // =================================================

        background:
            root.clip-color.darker(
                root.hovered
                    ? 0.08
                    : 0.15
            ).with-alpha(0.48);

        clip:
            true;


        // =================================================
        // WAVEFORM
        //
        // TOTALMENTE OPACA
        // =================================================

        if !root.is-midi
            && root.waveform-peaks.length > 0:

            AudioWaveform {

                x:
                    2px;

                y:
                    0px;

                width:
                    parent.width - 4px;

                height:
                    parent.height;

                waveform-color:
                    root.clip-color.brighter(
                        root.hovered
                            ? 0.46
                            : 0.34
                    );

                hovered:
                    root.hovered;

                peaks:
                    root.waveform-peaks;
            }
    }


    // =====================================================
    // HEADER
    // =====================================================

    Rectangle {

        x:
            root.bw;

        y:
            root.bw;

        width:
            parent.width - 2 * root.bw;

        height:
            root.header-height - root.bw;

        // HEADER CONTINUA OPACO
        background:
            root.clip-color.brighter(
                root.hovered
                    ? 0.46
                    : 0.34
            );

        clip:
            true;


        // =================================================
        // BRILHO SUPERIOR
        // =================================================

        Rectangle {

            x:
                0px;

            y:
                0px;

            width:
                parent.width;

            height:
                2px;

            background:
                root.clip-color.brighter(0.58);

            opacity:
                root.dragging || root.resizing
                    ? 1.0
                    : 0.75;
        }


        // =================================================
        // NOME
        // =================================================

        if !root.renaming:

            Text {

                x:
                    6px;

                y:
                    2px;

                width:
                    parent.width - 12px;

                height:
                    parent.height - 2px;

                text:
                    root.name;

                color:
                    #171717;

                font-size:
                    9px;

                font-weight:
                    700;

                vertical-alignment:
                    center;

                overflow:
                    elide;
            }


        // =================================================
        // RENAME
        // =================================================

        if root.renaming:

            Rectangle {

                x:
                    5px;

                y:
                    1px;

                width:
                    parent.width - 10px;

                height:
                    parent.height - 2px;

                background:
                    #FFFFFF;

                border-radius:
                    2px;


                TextInput {

                    x:
                        2px;

                    y:
                        0px;

                    width:
                        parent.width - 4px;

                    height:
                        parent.height;

                    text <=> root.rename-buffer;

                    color:
                        #101010;

                    font-size:
                        9px;

                    font-weight:
                        700;

                    vertical-alignment:
                        center;

                    horizontal-alignment:
                        TextHorizontalAlignment.left;


                    edited => {

                        if root.rename-buffer != "" {

                            root.clip-rename-requested(
                                root.clip-id,
                                root.rename-buffer
                            );
                        }

                        root.renaming =
                            false;
                    }
                }
            }
    }


    // =====================================================
    // DIVISÓRIA
    // =====================================================

    Rectangle {

        x:
            root.bw;

        y:
            root.header-height;

        width:
            parent.width - 2 * root.bw;

        height:
            1px;

        background:
            root.clip-color.brighter(0.30);

        opacity:
            root.dragging || root.resizing
                ? 1.0
                : root.hovered
                    ? 0.85
                    : 0.55;
    }


    // =====================================================
    // INDICADOR DIREITO
    // =====================================================

    Rectangle {

        x:
            parent.width - root.bw - 6px;

        y:
            5px;

        width:
            3px;

        height:
            8px;

        border-radius:
            1px;

        background:
            Theme.text-primary;

        opacity:
            root.dragging || root.resizing
                ? 0.9
                : 0.45;
    }


    // =====================================================
    // HANDLE ESQUERDO
    // =====================================================

    if root.active-tool == 0
        && root.on-left-edge:

        Rectangle {

            x:
                root.bw + 1px;

            y:
                3px;

            width:
                2px;

            height:
                parent.height - 6px;

            background:
                Theme.text-primary;

            opacity:
                root.resizing
                    ? 1.0
                    : 0.85;

            border-radius:
                1px;

            z:
                5;
        }


    // =====================================================
    // HANDLE DIREITO
    // =====================================================

    if root.active-tool == 0
        && root.on-right-edge:

        Rectangle {

            x:
                parent.width - root.bw - 3px;

            y:
                3px;

            width:
                2px;

            height:
                parent.height - 6px;

            background:
                Theme.text-primary;

            opacity:
                root.resizing
                    ? 1.0
                    : 0.85;

            border-radius:
                1px;

            z:
                5;
        }


    // =====================================================
    // INDICADOR DE DRAG
    // =====================================================

    if root.dragging:

        Rectangle {

            x:
                root.bw;

            y:
                root.bw;

            width:
                parent.width - 2 * root.bw;

            height:
                2px;

            background:
                Theme.accent-hover;

            opacity:
                0.9;

            z:
                20;
        }


    // =====================================================
    // INDICADOR DE RESIZE
    // =====================================================

    if root.resizing:

        Rectangle {

            x:
                root.resize-side < 0
                    ? root.bw
                    : parent.width - root.bw - 2px;

            y:
                root.bw;

            width:
                2px;

            height:
                parent.height - 2 * root.bw;

            background:
                Theme.accent-hover;

            opacity:
                0.95;

            z:
                20;
        }


    // =====================================================
    // SLICE PREVIEW
    // =====================================================

    if root.active-tool == 1
        && root.slice-hover:

        Rectangle {

            x:
                root.slice-preview-x - 1px;

            y:
                0px;

            width:
                2px;

            height:
                parent.height;

            background:
                Theme.playhead;

            opacity:
                0.95;

            z:
                10;


            Rectangle {

                x:
                    -2px;

                y:
                    0px;

                width:
                    6px;

                height:
                    parent.height;

                background:
                    Theme.playhead;

                opacity:
                    0.12;
            }
        }


    // =====================================================
    // TOUCH AREA
    // =====================================================

    touch := TouchArea {

        x:
            0px;

        y:
            0px;

        width:
            parent.width;

        height:
            parent.height;

        enabled:
            !root.renaming;


        // =================================================
        // CURSOR
        // =================================================

        mouse-cursor:

            root.active-tool == 1
                ? crosshair

            : root.resizing
                ? ew-resize

            : root.dragging
                ? pointer

            : root.active-tool == 0
                && root.on-edge
                    ? ew-resize

            : root.active-tool >= 3
                ? none

            : pointer;


        // =================================================
        // DOUBLE CLICK
        // =================================================

        double-clicked => {

            if root.active-tool == 0
                && self.mouse-y <= root.header-height {

                root.rename-buffer =
                    root.name;

                root.renaming =
                    true;
            }
        }


        // =================================================
        // POINTER
        // =================================================

        pointer-event(event) => {

            // =================================================
            // RIGHT CLICK
            // =================================================

            if event.kind
                    == PointerEventKind.down
                && event.button
                    == PointerEventButton.right {

                ClipContextMenuState.clip-id =
                    root.clip-id;

                ClipContextMenuState.x =
                    self.absolute-position.x
                    + self.mouse-x;

                ClipContextMenuState.y =
                    self.absolute-position.y
                    + self.mouse-y;

                ClipContextMenuState.open =
                    true;

                return;
            }


            // =================================================
            // ERASER
            // =================================================

            if root.active-tool == 2 {

                if event.kind
                        == PointerEventKind.down
                    && event.button
                        == PointerEventButton.left {

                    root.clip-delete-requested(
                        root.clip-id
                    );
                }

                return;
            }


            // =================================================
            // SLICE
            // =================================================

            if root.active-tool == 1 {

                if event.kind
                        == PointerEventKind.move {

                    root.slice-preview-x =
                        self.mouse-x;
                }

                if event.kind
                        == PointerEventKind.down
                    && event.button
                        == PointerEventButton.left {

                    let slice-x =
                        self.mouse-x;

                    let slice-px =
                        slice-x / 1px;

                    let ppb =
                        root.px-per-beat / 1px;

                    let slice-beat =
                        slice-px / ppb;

                    if slice-beat > 0.0
                        && slice-beat < root.len {

                        root.slice-requested(
                            root.clip-id,
                            slice-beat
                        );
                    }
                }

                return;
            }


            // =================================================
            // SELECT
            // =================================================

            if root.active-tool == 0
                && !root.renaming {


                // =============================================
                // DOWN
                // =============================================

                if event.kind
                        == PointerEventKind.down
                    && event.button
                        == PointerEventButton.left {


                    root.clicked(
                        root.clip-id
                    );


                    // =========================================
                    // RESIZE
                    // =========================================

                    if root.on-edge {

                        root.resize-side =
                            root.on-left-edge
                                ? -1
                                : 1;

                        root.resize-start-x =
                            self.mouse-x;

                        root.resize-start-beat =
                            root.beat;

                        root.resize-start-len =
                            root.len;

                        root.resizing =
                            true;

                        root.clip-resize-started(
                            root.clip-id,
                            root.resize-side
                        );
                    }


                    // =========================================
                    // DRAG
                    // =========================================

                    else {

                        root.drag-start-x =
                            self.mouse-x;

                        root.drag-start-y =
                            self.mouse-y;

                        root.drag-start-beat =
                            root.beat;

                        root.drag-start-track =
                            root.track-index;

                        root.dragging =
                            true;

                        root.clip-move-started(
                            root.clip-id,
                            root.beat
                        );
                    }
                }


                // =============================================
                // MOVE
                // =============================================

                else if event.kind
                            == PointerEventKind.move {


                    // =========================================
                    // RESIZE
                    // =========================================

                    if root.resizing {

                        let dx-px =
                            (
                                self.mouse-x
                                - root.resize-start-x
                            ) / 1px;

                        let ppb =
                            root.px-per-beat / 1px;

                        let delta-beats =
                            dx-px / ppb;


                        // =====================================
                        // DIREITA
                        // =====================================

                        if root.resize-side > 0 {

                            let new-len =
                                root.resize-start-len
                                + delta-beats;

                            let final-len =
                                new-len < root.minimum-clip-length
                                    ? root.minimum-clip-length
                                    : new-len;

                            let actual-delta =
                                final-len
                                - root.resize-start-len;

                            root.clip-resize-delta(
                                root.clip-id,
                                root.resize-side,
                                actual-delta
                            );
                        }


                        // =====================================
                        // ESQUERDA
                        // =====================================

                        else {

                            let max-negative =
                                root.resize-start-len
                                - root.minimum-clip-length;

                            let limited-delta =
                                delta-beats < -max-negative
                                    ? -max-negative
                                    : delta-beats;

                            root.clip-resize-delta(
                                root.clip-id,
                                root.resize-side,
                                limited-delta
                            );
                        }
                    }


                    // =========================================
                    // DRAG
                    // =========================================

                    else if root.dragging {

                        let dx-px =
                            (
                                self.mouse-x
                                - root.drag-start-x
                            ) / 1px;

                        let ppb =
                            root.px-per-beat / 1px;

                        let delta-beats =
                            dx-px / ppb;


                        let dy-px =
                            (
                                self.mouse-y
                                - root.drag-start-y
                            ) / 1px;

                        let row-height-px =
                            root.row-height / 1px;

                        let delta-tracks =
                            Math.round(
                                dy-px / row-height-px
                            );


                        root.clip-move-delta(
                            root.clip-id,
                            delta-beats,
                            delta-tracks
                        );
                    }
                }


                // =============================================
                // UP
                // =============================================

                else if event.kind
                            == PointerEventKind.up {


                    if root.resizing {

                        root.resizing =
                            false;

                        root.resize-side =
                            0;

                        root.clip-resize-finished(
                            root.clip-id
                        );
                    }


                    if root.dragging {

                        root.dragging =
                            false;

                        root.clip-move-finished(
                            root.clip-id
                        );
                    }
                }
            }
        }
    }
}