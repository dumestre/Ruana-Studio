import { Theme } from "../theme.slint";
import { ClipPalette } from "../clip_palette.slint";
import { AudioWaveform } from "audio_waveform.slint";
import { ClipContextMenuState } from "../components/context_menu.slint";
import { ClipDragState, TimelineMetrics } from "clip_drag/clip_drag_state.slint";
import { ClipFade } from "../components/clip_fade.slint";
import { ClipGain } from "../components/clip_gain.slint";

export component TrackClip inherits Rectangle {

    // =====================================================
    // DADOS
    // =====================================================

    in property <string> name: "";

    in property <int> clip-id: 0;

    in property <float> beat: 0.0;

    in property <float> len: 4.0;

    in property <bool> is-midi: true;

    in property <int> color-index: 0;

    in property <length> px-per-beat: 40px;

    in property <length> row-height: 64px;

    in property <length> ruler-height: 30px;

    in property <int> track-index: 0;

    in property <bool> selected: false;

    // Seleção múltipla via marquee (Ctrl+arrasto).
    in property <bool> multi-selected: false;

    in property <int> active-tool: 0;

    // Fades do clip (beats). Vêm do modelo; o drag local só
    // escreve nestes no commit do release.
    in property <float> fade-in: 0.0;

    in property <float> fade-out: 0.0;

    // Ganho do clip em dB (-24..+12). Vem do modelo; drag central
    // escreve via live-gain e comita no release (clip-gain-committed).
    in property <float> gain-db: 0.0;

    in property <[float]> waveform-peaks: [];

    // Waveform pré-renderizada (Rust). width 0 = sem imagem.
    in property <image> clip-waveform-image;

    // Janela rasterizada (px do corpo). src-w == 0 → a imagem
    // cobre o corpo inteiro; senão só o trecho [src-x, src-x+src-w]
    // foi rasterizado (zoom fundo = janela visível, pura e leve).
    in property <float> waveform-src-x: 0.0;
    in property <float> waveform-src-w: 0.0;

    // Viewport horizontal (origem e largura visíveis), no mesmo
    // sistema de conteúdo do clip. Scroll/zoom acordam o re-render
    // da janela da waveform.
    in property <length> viewport-x: 0px;
    in property <length> viewport-width: 1920px;

    // =====================================================
    // RE-RENDER POR JANELA
    //
    // Só o trecho do clip que cruza a viewport é pedido ao Rust:
    // (id, largura total do corpo em px, janela x0/x1 em px). O
    // raster na thread de fundo cobre APENAS essa janela — no zoom
    // fundo só os samples visíveis (poucas waves) são desenhados,
    // sample a sample: nítido e leve, sem varrer o arquivo inteiro.
    // handler: app/src/waveform.rs::wire_resolution_requests.
    // =====================================================

    private property <float> wave-area-origin:
        root.bw / 1px + 2.0;

    // Altura de EXIBIÇÃO do corpo do clip (px). O re-render rasteriza
    // a waveform nesta altura real — contornos e linhas ficam nítidos
    // 1:1 na tela (sem achatamento vertical).
    private property <float> wave-body-px:
        (root.row-height - root.header-height - root.bw) / 1px;

    // PROFISSIONAL: ancoragem da waveform durante o TRIM (resize).
    // Antes a waveform esticava com a largura do clip (escala),
    // encurtando visualmente. Agora a waveform mantém a escala
    // original (amostra-por-pixel) e o corpo apenas RECORTA (crop
    // ancorado no grid) — exatamente como FL Studio/Ableton.
    private property <length> waveform-anchor-w:
        root.resize-start-len * root.px-per-beat - 4px;
    private property <length> waveform-live-offset:
        root.resizing && root.resize-side < 0
            ? (root.resize-start-beat - root.live-beat) * root.px-per-beat
            : 0px;

    // Início da janela visível, em px do trecho da waveform
    // (0 = borda esquerda do corpo). Recorta [0, largura-px].
    private property <float> wave-w0:
        Math.clamp(
            (root.viewport-x / 1px)
                - root.beat * (root.px-per-beat / 1px)
                - root.wave-area-origin,
            0.0,
            (root.width / 1px) - 4.0
        );

    private property <float> wave-w1:
        Math.clamp(
            (root.viewport-x / 1px)
                + (root.viewport-width / 1px)
                - root.beat * (root.px-per-beat / 1px)
                - root.wave-area-origin,
            root.wave-w0,
            (root.width / 1px) - 4.0
        );

    changed width => {
        if !root.resizing
            && !root.is-midi
            && root.interactive
            && root.waveform-peaks.length > 0
            && root.width > 4px
            && root.wave-w1 > root.wave-w0 + 0.5 {

            TimelineMetrics.waveform-resolution-requested(
                root.clip-id,
                (root.width - 4px) / 1px,
                root.wave-w0,
                root.wave-w1,
                root.wave-body-px,
                root.gain-linear,
                fade_ctrl.fade-in-w / 1px,
                fade_ctrl.fade-out-w / 1px,
            );
        }
    }

    // Scroll horizontal / zoom: a janela muda sem a largura mudar
    // (wave-w1 depende de viewport-x, viewport-width e px-per-beat),
    // então este changed re-dispara o pedido com o novo recorte.
    changed wave-w1 => {
        if !root.resizing
            && !root.is-midi
            && root.interactive
            && root.waveform-peaks.length > 0
            && root.width > 4px
            && root.wave-w1 > root.wave-w0 + 0.5 {

            TimelineMetrics.waveform-resolution-requested(
                root.clip-id,
                (root.width - 4px) / 1px,
                root.wave-w0,
                root.wave-w1,
                root.wave-body-px,
                root.gain-linear,
                fade_ctrl.fade-in-w / 1px,
                fade_ctrl.fade-out-w / 1px,
            );
        }
    }

    // RESIZE: não existe RE-RENDER durante o gesto (guards acima).
    // No CÓRTE da borda, o Rust aparou o cache da waveform para o
    // trecho visível (crop ancorado, sem re-escalar) e este changed
    // resizing pede o raster do trecho novo assim que o gesto solta.
    changed resizing => {
        if !root.resizing
            && !root.is-midi
            && root.interactive
            && root.waveform-peaks.length > 0
            && root.width > 4px
            && root.wave-w1 > root.wave-w0 + 0.5 {

            TimelineMetrics.waveform-resolution-requested(
                root.clip-id,
                (root.width - 4px) / 1px,
                root.wave-w0,
                root.wave-w1,
                root.wave-body-px,
                root.gain-linear,
                fade_ctrl.fade-in-w / 1px,
                fade_ctrl.fade-out-w / 1px,
            );
        }
    }

    // Total de tracks do projeto (clamp vertical do arrasto).
    in property <int> track-count: 1;


    // =====================================================
    // MODO
    // =====================================================

    // Recebe eventos de mouse?
    //
    // O overlay de arrasto instancia um TrackClip só para
    // desenhar; ele NÃO pode ter TouchArea viva, senão fica
    // exatamente embaixo do cursor, acima das rows, roubando
    // hit-test e hover do clip que está sustentando o gesto.
    in property <bool> interactive: true;

    // Esta é a instância de ORIGEM de um arrasto em andamento?
    //
    // Ela continua na árvore, visível e interativa — é ela que
    // detém o grab do mouse e recebe os MOVE/UP do gesto. Só o
    // visual vira fantasma, como em qualquer DAW.
    //
    // (Antes a row usava `visible: false` aqui. Em Slint isso é
    // compilado para um `Clip` de tamanho ZERO em volta do
    // elemento, ou seja: apagava o dono do gesto no meio dele.)
    in property <bool> ghost: false;

    private property <float> ghost-opacity:
        root.ghost
            ? 0.22
            : 1.0;


    // =====================================================
    // PALETA
    // =====================================================

    private property <color> audio-default:
        #00C853;

    private property <color> base-color:
        root.color-index == 0
            ? (
                root.is-midi
                    ? Theme.clip-midi
                    : root.audio-default
            )
            : ClipPalette.colors[
                Math.mod(
                    root.color-index,
                    ClipPalette.colors.length
                )
            ];

    in property <color> clip-color:
        root.base-color;


    // =====================================================
    // CALLBACKS
    //
    // Commit único: o gesto inteiro acontece em puro Slint
    // (via ClipDragState / props locais) e o core recebe
    // UMA chamada no release. Zero roundtrips por frame.
    // =====================================================

    callback clicked(int);

    callback slice-requested(int, float);

    callback clip-move-committed(
        int,
        int,
        float
    );

    callback clip-resize-committed(
        int,
        int,
        float,
        float
    );

    callback clip-delete-requested(int);

    callback clip-rename-requested(int, string);

    callback clip-color-cycle-requested(int);

    callback clip-copy-requested(int);

    callback marquee-commit(
        float,
        float,
        float,
        float
    );

    callback clip-fade-committed(
        int,
        float,
        float
    );

    callback clip-gain-committed(
        int,
        float
    );


    // =====================================================
    // DIMENSÕES
    // =====================================================

    private property <length> edge-width:
        7px;

    private property <length> header-height:
        18px;

    private property <length> minimum-clip-width:
        4px;

    private property <float> minimum-clip-length:
        0.0625;


    // =====================================================
    // ESTADO DO MOUSE
    // =====================================================

    // Fantasma não reage a hover: o realce pertence à instância
    // que está seguindo o mouse no overlay.
    private property <bool> hovered:
        touch.has-hover
        && !root.ghost;

    // PROFISSIONAL: fade só bloqueia resize quando o cursor está
    // EXATAMENTE sobre o pino do fade (on-fade-grip), não em toda
    // a faixa superior. Antes `!in-fade-zone` desabilitava o resize
    // em 16px de altura inteira, atrapalhando manipular o clip.
    private property <bool> on-left-edge:
        root.hovered
        && touch.mouse-x <= root.edge-width;

    private property <bool> on-right-edge:
        root.hovered
        && touch.mouse-x >= root.width - root.edge-width;

    private property <bool> on-edge:
        root.on-left-edge
        || root.on-right-edge;


    // =====================================================
    // ESTADO DO DRAG
    //
    // O MOVE do arrasto vive no ClipDragState (global).
    // Aqui fica só o estado local do RESIZE, cujo feedback
    // é renderizado no próprio clip via live-len/live-beat.
    // =====================================================

    private property <bool> dragging:
        false;

    private property <bool> resizing:
        false;

    private property <int> resize-side:
        0;

    // Comprimento ao vivo durante o resize (borda esq. ou dir.).
    private property <float> live-len:
        0.0;

    // Beat ao vivo durante o resize pela borda ESQUERDA.
    private property <float> live-beat:
        0.0;

    private property <length> resize-start-abs-x:
        0px;

    private property <float> resize-start-beat:
        0.0;

    private property <float> resize-start-len:
        0.0;


    // =====================================================
    // ESTADO DO FADE / GAIN
    //
    // O gesto e o visual de fade/gain agora vivem nos componentes
    // separados ClipFade e ClipGain (instanciados no final do root,
    // acima da TouchArea `touch`). Aqui ficam SÓ as bindings que o
    // TrackClip ainda consome: mostrar/ocultar e o ganho linear para
    // escalar a waveform.
    // =====================================================

    private property <bool> show-fade-controls:
        !root.is-midi
        && root.active-tool == 0
        && (root.selected
            || root.multi-selected
            || root.hovered);

    private property <bool> show-gain-controls:
        !root.is-midi
        && root.active-tool == 0
        && (root.selected
            || root.multi-selected
            || root.hovered);

    // Ganho em linear aproximado para escala visual da waveform.
    // 10^(dB/20). Lê o valor ao vivo publicado pelo ClipGain.
    private property <float> gain-linear:
        Math.pow(10.0, gain_ctrl.display-gain-db / 20.0);

    // =====================================================
    // RENAME
    // =====================================================

    private property <bool> renaming:
        false;

    private property <string> rename-buffer:
        "";


    // =====================================================
    // SLICE
    // =====================================================

    property <length> slice-preview-x:
        -100px;

    private property <bool> slice-hover:
        root.active-tool == 1
        && touch.has-hover;


    // =====================================================
    // BORDA
    // =====================================================

    private property <length> bw:
        (root.selected || root.multi-selected)
            ? 2px
            : 1px;

    border-radius:
        1px;

    border-width:
        root.bw;

    border-color:
        root.ghost
            ? root.clip-color.transparentize(0.72)

        : root.selected
            ? #FFFFFF

        : root.multi-selected
            ? #FFFFFF

        : root.hovered
            ? root.clip-color

        : root.clip-color.darker(0.18);


    // =====================================================
    // POSIÇÃO
    //
    // Durante resize pela borda ESQUERDA, o clip desliza
    // localmente via live-beat (sem tocar no modelo).
    // =====================================================

    x:
        root.resizing
        && root.resize-side < 0
            ? root.live-beat * root.px-per-beat
            : root.beat * root.px-per-beat;

    y:
        0px;


    // =====================================================
    // TAMANHO
    //
    // Durante resize, a largura acompanha o mouse ao vivo.
    // =====================================================

    width:
        root.resizing
            ? (
                (
                    root.live-len * root.px-per-beat
                        < root.minimum-clip-width
                )
                    ? root.minimum-clip-width
                    : root.live-len * root.px-per-beat
            )
            : (
                (
                    root.len * root.px-per-beat
                        < root.minimum-clip-width
                )
                    ? root.minimum-clip-width
                    : root.len * root.px-per-beat
            );

    height:
        root.row-height;


    // =====================================================
    // ROOT
    // =====================================================

    background:
        #00000000;


    // =====================================================
    // CORPO DO CLIP
    //
    // SOMENTE O CORPO É TRANSLÚCIDO.
    //
    // Alpha baixo para permitir enxergar claramente
    // as linhas do grid por baixo do clip.
    // =====================================================

    Rectangle {
        border-color: root.hovered
                 ? crimson.with-alpha(0.45)
                 :crimson.with-alpha(0.22);
        border-width: 3px;

    Rectangle {

        x:
            root.bw;

        y:
            root.header-height;

        width:
            parent.width - 2 * root.bw;

        height:
            parent.height
            - root.header-height
            - root.bw;

        background:
            root.clip-color.darker(
                root.hovered
                    ? 0.05
                    : 0.12
            ).with-alpha(
                root.hovered
                    ? 0.30
                    : 0.50
            );

        // Brilho suave na borda da waveform: só o contorno do
        // perímetro brilha (borda fina translúcida branca), sem
        // afetar o interior — dá um realce sutil de "luz" evitando
        // o contorno nítido/duro de um border opaco.
        border-width:
            1px;


        border-color: root.hovered
                  ? crimson.with-alpha(0.45)
                  :crimson.with-alpha(0.22);
        border-radius:
            6px;

        opacity:
            root.ghost-opacity;

        clip:
            true;


        // =================================================
        // WAVEFORM
        //
        // Caminho rápido: imagem pré-renderizada no Rust (1
        // elemento). Fallback: retângulos por pico — usado pelo
        // fantasma do drag e quando não há imagem.
        // =================================================

        if !root.is-midi
            && (clip-waveform-image.width > 0
                || root.wave-w1 > 0.0):

            Image {
                // A imagem já vem rasterizada na resolução EXATA
                // da largura do corpo do clip pelo Rust.
                // image-fit: none evita qualquer stretch — a
                // waveform gruda no clip sem distorcer,
                // mesmo durante zoom/scroll. O crop do
                // conteúdo excedente fica por conta do
                // clip: true do Rectangle pai.
                x: root.resizing
                    ? 2px + root.waveform-live-offset + root.waveform-src-x * 1px
                    : 2px + root.waveform-src-x * 1px;
                y: 0px;
                width:
                    root.waveform-src-w > 0.0
                        ? root.waveform-src-w * 1px
                        : parent.width - 4px;
                height: parent.height;
                source: clip-waveform-image;
                image-rendering: pixelated;
            }

        if !root.is-midi
            && clip-waveform-image.width == 0
            && root.waveform-peaks.length > 0:

            AudioWaveform {

                x: root.resizing ? 2px + root.waveform-live-offset : 2px;

                y:
                    0px;

                width: root.resizing ? root.waveform-anchor-w : parent.width - 4px;

                height:
                    parent.height;

                waveform-color:
                    #0A0A0A;

                hovered:
                    root.hovered;

                peaks:
                    root.waveform-peaks;
            }
    }


    // =====================================================
    // HEADER
    //
    // TOTALMENTE OPACO.
    // =====================================================

    Rectangle {

        x:
            root.bw;

        y:
            root.bw;

        width:
            parent.width - 2 * root.bw;

        height:
            root.header-height - root.bw;

        background:
            root.clip-color;

        opacity:
            root.ghost-opacity;

        clip:
            true;


        // =================================================
        // NOME
        // =================================================

        if !root.renaming:

         Text {
    x: 6px;
    y: 0px;

    width: parent.width - 12px;
    height: parent.height - 2px;

    text: root.name;

    color: #171717;

    font-family: "Segoe UI";
    font-size: 10px;
    font-weight: 700;

    vertical-alignment: center;
    horizontal-alignment: left;

    overflow: elide;
}}


        // =================================================
        // RENAME
        // =================================================

        if root.renaming:

            Rectangle {

                x:
                    5px;

                y:
                    1px;

                width:
                    parent.width - 10px;

                height:
                    parent.height - 2px;

                background:
                    #FFFFFF;

                border-radius:
                    2px;


                TextInput {

                    x:
                        2px;

                    y:
                        0px;

                    width:
                        parent.width - 4px;

                    height:
                        parent.height;

                    text <=> root.rename-buffer;

                    color:
                        #101010;

                    font-size:
                        9px;

                    font-weight:
                        700;

                    vertical-alignment:
                        center;

                    horizontal-alignment:
                        TextHorizontalAlignment.left;


                    edited => {

                        if root.rename-buffer != "" {

                            root.clip-rename-requested(
                                root.clip-id,
                                root.rename-buffer
                            );
                        }

                        root.renaming =
                            false;
                    }
                }
            }
    }


    // =====================================================
    // DIVISÓRIA HEADER / CORPO
    // =====================================================

    Rectangle {

        x:
            root.bw;

        y:
            root.header-height;

        width:
            parent.width - 2 * root.bw;

        height:
            1px;

        background:
            root.clip-color.darker(0.18);

        opacity:
            (
                root.dragging || root.resizing
                    ? 1.0
                    : root.hovered
                        ? 0.85
                        : 0.55
            )
            * root.ghost-opacity;
    }


    // =====================================================
    // INDICADOR DIREITO
    // =====================================================

    Rectangle {

        x:
            parent.width - root.bw - 6px;

        y:
            5px;

        width:
            3px;

        height:
            8px;

        border-radius:
            1px;

        background:
            Theme.text-primary;

        opacity:
            (
                root.dragging || root.resizing
                    ? 0.9
                    : 0.45
            )
            * root.ghost-opacity;
    }


    // =====================================================
    // HANDLE ESQUERDO
    // =====================================================

    if root.active-tool == 0
        && root.on-left-edge:

        Rectangle {

            x:
                root.bw + 1px;

            y:
                3px;

            width:
                2px;

            height:
                parent.height - 6px;

            background:
                Theme.text-primary;

            opacity:
                root.resizing
                    ? 1.0
                    : 0.85;

            border-radius:
                1px;

            z:
                5;
        }


    // =====================================================
    // HANDLE DIREITO
    // =====================================================

    if root.active-tool == 0
        && root.on-right-edge:

        Rectangle {

            x:
                parent.width - root.bw - 3px;

            y:
                3px;

            width:
                2px;

            height:
                parent.height - 6px;

            background:
                Theme.text-primary;

            opacity:
                root.resizing
                    ? 1.0
                    : 0.85;

            border-radius:
                1px;

            z:
                5;
        }


    // =====================================================
    // INDICADOR DE DRAG
    //
    // Só na instância que está seguindo o mouse — o fantasma
    // fica limpo.
    // =====================================================

    if root.dragging
        && !root.ghost:

        Rectangle {

            x:
                root.bw;

            y:
                root.bw;

            width:
                parent.width - 2 * root.bw;

            height:
                2px;

            background:
                Theme.accent-hover;

            opacity:
                0.9;

            z:
                20;
        }


    // =====================================================
    // INDICADOR DE RESIZE
    // =====================================================

    if root.resizing:

        Rectangle {

            x:
                root.resize-side < 0
                    ? root.bw
                    : parent.width - root.bw - 2px;

            y:
                root.bw;

            width:
                2px;

            height:
                parent.height - 2 * root.bw;

            background:
                Theme.accent-hover;

            opacity:
                0.95;

            z:
                20;
        }


    // =====================================================
    // SLICE PREVIEW
    // =====================================================

    if root.active-tool == 1
        && root.slice-hover:

        Rectangle {

            x:
                root.slice-preview-x - 1px;

            y:
                0px;

            width:
                2px;

            height:
                parent.height;

            background:
                Theme.playhead;

            opacity:
                0.95;

            z:
                10;


            Rectangle {

                x:
                    -2px;

                y:
                    0px;

                width:
                    6px;

                height:
                    parent.height;

                background:
                    Theme.playhead;

                opacity:
                    0.12;
            }
        }


    // =====================================================
    // TOUCH AREA
    // =====================================================

    touch := TouchArea {

        x:
            0px;

        y:
            0px;

        width:
            parent.width;

        height:
            parent.height;

        enabled:
            root.interactive
            && !root.renaming;


        // =================================================
        // CURSOR
        // =================================================

        mouse-cursor:

            root.resizing
                ? ew-resize

            : root.on-edge
                ? ew-resize

            : root.active-tool == 1
                ? crosshair

            : root.active-tool == 0
                ? pointer

            : root.active-tool == 2
                ? pointer

            : root.active-tool == 3
                ? ew-resize

            : root.active-tool == 5
                ? pointer

            : none;


        // =================================================
        // DOUBLE CLICK
        // =================================================

        double-clicked => {

            if root.active-tool == 0
                && self.mouse-y <= root.header-height {

                root.rename-buffer =
                    root.name;

                root.renaming =
                    true;
            }
        }


        // =================================================
        // POINTER
        // =================================================

        pointer-event(event) => {

            // =============================================
            // CANCEL
            //
            // O grab foi perdido (janela perdeu o foco, item
            // desabilitado, gesto interrompido pelo sistema).
            //
            // Sem tratar isto o arrasto ficava preso para
            // sempre: `active` seguia true, o clip de origem
            // seguia fantasma e o overlay ficava colado no
            // cursor — exatamente o "clip fantasma que não
            // solta".
            // =============================================

            if event.kind
                    == PointerEventKind.cancel {

                ClipDragState.marquee-active =
                    false;

                if root.dragging {

                    root.dragging =
                        false;

                    ClipDragState.reset();
                }

                root.resizing =
                    false;

                root.resize-side =
                    0;

                return;
            }


            // =============================================
            // RIGHT CLICK
            // =============================================

            if event.kind
                    == PointerEventKind.down
                && event.button
                    == PointerEventButton.right {

                ClipContextMenuState.clip-id =
                    root.clip-id;

                ClipContextMenuState.x =
                    self.absolute-position.x
                    + self.mouse-x;

                ClipContextMenuState.y =
                    self.absolute-position.y
                    + self.mouse-y;

                ClipContextMenuState.open =
                    true;

                return;
            }


            // =============================================
            // ERASER
            // =============================================

            if root.active-tool == 2 {

                if event.kind
                        == PointerEventKind.down
                    && event.button
                        == PointerEventButton.left {

                    root.clip-delete-requested(
                        root.clip-id
                    );
                }

                return;
            }


            // =============================================
            // SLICE
            // =============================================

            if root.active-tool == 1 {

                if event.kind
                        == PointerEventKind.move {

                    root.slice-preview-x =
                        self.mouse-x;
                }

                if event.kind
                        == PointerEventKind.down
                    && event.button
                        == PointerEventButton.left {

                    let slice-x =
                        self.mouse-x;

                    let slice-px =
                        slice-x / 1px;

                    let ppb =
                        root.px-per-beat / 1px;

                    let slice-beat =
                        slice-px / ppb;

                    if slice-beat > 0.0
                        && slice-beat < root.len {

                        root.slice-requested(
                            root.clip-id,
                            slice-beat
                        );
                    }
                }

                return;
            }


            // =============================================
            // SELECT
            // =============================================

            if root.active-tool == 0
                && !root.renaming {


                // =========================================
                // DOWN
                // =========================================

                if event.kind
                        == PointerEventKind.down
                    && event.button
                        == PointerEventButton.left {


                    // Ctrl+DOWN sobre um clip → MARQUEE, não seleção.
                    // A TouchArea do clip captura este gesto (o
                    // zoom-pan-area da timeline nem vê), então é aqui
                    // que a caixa de seleção nasce. Os move/up chegam
                    // ao zoom-pan-area, que atualiza/finaliza.
                    if event.modifiers.control {
                        ClipDragState.marquee-active = true;
                        // Coordenadas de CONTEÚDO da timeline, via
                        // TimelineMetrics (mesma base usada pelo
                        // zoom-pan-area): posição absoluta do mouse
                        // menos a origem da timeline + scroll.
                        let abs-x =
                            self.absolute-position.x + self.mouse-x;
                        let abs-y =
                            self.absolute-position.y + self.mouse-y;
                        ClipDragState.marquee-x0 =
                            abs-x
                            - TimelineMetrics.timeline-abs-x
                            + TimelineMetrics.scroll-x;
                        ClipDragState.marquee-y0 =
                            abs-y
                            - TimelineMetrics.timeline-abs-y
                            + TimelineMetrics.scroll-y;
                        ClipDragState.marquee-x1 =
                            ClipDragState.marquee-x0;
                        ClipDragState.marquee-y1 =
                            ClipDragState.marquee-y0;
                        return;
                    }

                    root.clicked(
                        root.clip-id
                    );


                    // =====================================
                    // RESIZE
                    //
                    //
                    // 100% local: sem callback no DOWN.
                    // =====================================

                    if root.on-edge {

                        root.resize-side =
                            root.on-left-edge
                                ? -1
                                : 1;

                        root.resize-start-abs-x =
                            self.absolute-position.x
                            + self.mouse-x;

                        root.resize-start-beat =
                            root.beat;

                        root.resize-start-len =
                            root.len;

                        root.live-len =
                            root.len;

                        root.live-beat =
                            root.beat;

                        root.resizing =
                            true;
                    }


                    // =====================================
                    // DRAG
                    //
                    // Popula o global — nenhum callback.
                    //
                    // `active` NÃO é ligado aqui: no DOWN o
                    // gesto está apenas armado. Ele vira
                    // arrasto no primeiro MOVE que passa do
                    // limiar, e é só aí que o overlay nasce e
                    // esta instância vira fantasma. Ligar no
                    // DOWN fazia todo clique simples piscar.
                    // =====================================

                    else {

                        ClipDragState.clip-id =
                            root.clip-id;

                        ClipDragState.name =
                            root.name;

                        ClipDragState.orig-beat =
                            root.beat;

                        ClipDragState.orig-track =
                            root.track-index;

                        ClipDragState.len-beats =
                            root.len;

                        ClipDragState.color-index =
                            root.color-index;

                        ClipDragState.is-midi =
                            root.is-midi;

                        ClipDragState.waveform-peaks =
                            root.waveform-peaks;

                        ClipDragState.px-per-beat =
                            root.px-per-beat;

                        ClipDragState.row-height =
                            root.row-height;

                        ClipDragState.track-count =
                            root.track-count;

                        let cursor-abs-x =
                            self.absolute-position.x
                            + self.mouse-x;

                        let cursor-abs-y =
                            self.absolute-position.y
                            + self.mouse-y;

                        ClipDragState.start-cursor-x =
                            cursor-abs-x;

                        ClipDragState.start-cursor-y =
                            cursor-abs-y;

                        ClipDragState.cursor-x =
                            cursor-abs-x;

                        ClipDragState.cursor-y =
                            cursor-abs-y;

                        root.dragging =
                            true;
                    }
                }


                // =========================================
                                // MOVE
                                // =========================================

                                else if event.kind
                                            == PointerEventKind.move {


                                    // Marquee ativo (Ctrl+arrasto começou sobre este clip):
                                    // atualiza o canto oposto aqui, porque o mouse
                                    // ainda está sobre o clip e o zoom-pan-area
                                    // não recebe estes eventos.
                                    if ClipDragState.marquee-active {
                                        let abs-x =
                                            self.absolute-position.x + self.mouse-x;
                                        let abs-y =
                                            self.absolute-position.y + self.mouse-y;
                                        ClipDragState.marquee-x1 =
                                            abs-x
                                            - TimelineMetrics.timeline-abs-x
                                            + TimelineMetrics.scroll-x;
                                        ClipDragState.marquee-y1 =
                                            abs-y
                                            - TimelineMetrics.timeline-abs-y
                                            + TimelineMetrics.scroll-y;
                                        return;
                                    }

                                    // =====================================
                                    // RESIZE
                                    //
                                    // Matemática local: atualiza live-len /
                                    // live-beat. Nenhum callback, nenhum
                                    // acesso ao modelo.
                                    // =====================================

                    if root.resizing {

                        let cursor-abs-x =
                            self.absolute-position.x
                            + self.mouse-x;

                        let dx-px =
                            (
                                cursor-abs-x
                                - root.resize-start-abs-x
                            ) / 1px;

                        let ppb =
                            root.px-per-beat / 1px;

                        let delta-beats =
                            dx-px / ppb;


                        // Snap local (grade de 1 beat).
                        let snap-d =
                            ClipDragState.snap-enabled
                                ? Math.round(
                                    delta-beats
                                )
                                : delta-beats;


                        // =================================
                        // DIREITA
                        // =================================

                        if root.resize-side > 0 {

                            let new-len =
                                root.resize-start-len
                                + snap-d;

                            root.live-len =
                                new-len
                                    < root.minimum-clip-length
                                    ? root.minimum-clip-length
                                    : new-len;
                        }


                        // =================================
                        // ESQUERDA
                        // =================================

                        else {

                            let max-negative =
                                root.resize-start-len
                                - root.minimum-clip-length;

                            let limited-d =
                                snap-d < -max-negative
                                    ? -max-negative
                                    : snap-d;

                            root.live-beat =
                                Math.max(
                                    0.0,
                                    root.resize-start-beat
                                        + limited-d
                                );

                            root.live-len =
                                Math.max(
                                    root.minimum-clip-length,
                                    root.resize-start-len
                                        - limited-d
                                );
                        }
                    }


                    // =====================================
                    // DRAG
                    //
                    // Só publica o cursor — 2 floats.
                    // A posição do overlay é derivada por
                    // binding a cada frame.
                    // =====================================

                    else if root.dragging {

                        ClipDragState.cursor-x =
                            self.absolute-position.x
                            + self.mouse-x;

                        ClipDragState.cursor-y =
                            self.absolute-position.y
                            + self.mouse-y;


                        // Latch do início do arrasto: uma
                        // escrita só, e nunca desliga no meio
                        // do gesto — voltar para dentro do
                        // limiar não pode fazer o overlay
                        // sumir e reaparecer.

                        if !ClipDragState.active
                            && ClipDragState.moved {

                            ClipDragState.active =
                                true;
                        }
                    }
                }


                // =========================================
                // UP → COMMIT ÚNICO
                // =========================================

                else if event.kind
                            == PointerEventKind.up {


                    if ClipDragState.marquee-active {

                        let did-move =
                            ClipDragState.marquee-x1 != ClipDragState.marquee-x0
                            || ClipDragState.marquee-y1 != ClipDragState.marquee-y0;

                        ClipDragState.marquee-active =
                            false;

                        if did-move {

                            let bx0 = min(
                                ClipDragState.marquee-x0,
                                ClipDragState.marquee-x1,
                            ) / root.px-per-beat;

                            let bx1 = max(
                                ClipDragState.marquee-x0,
                                ClipDragState.marquee-x1,
                            ) / root.px-per-beat;

                            let ty0 = Math.floor(
                                (
                                    min(
                                        ClipDragState.marquee-y0,
                                        ClipDragState.marquee-y1,
                                    )
                                    - root.ruler-height
                                )
                                / root.row-height
                            );

                            let ty1 = Math.floor(
                                (
                                    max(
                                        ClipDragState.marquee-y0,
                                        ClipDragState.marquee-y1,
                                    )
                                    - root.ruler-height
                                )
                                / root.row-height
                            );

                            root.marquee-commit(
                                max(0.0, bx0),
                                bx1,
                                max(0, ty0),
                                ty1,
                            );
                            return;
                        }
                    }

                    if root.resizing {

                        root.resizing =
                            false;

                        let side =
                            root.resize-side;

                        let final-len =
                            root.live-len;

                        let final-beat =
                            root.live-beat;

                        root.resize-side =
                            0;

                        root.clip-resize-committed(
                            root.clip-id,
                            side,
                            final-len,
                            final-beat
                        );
                    }


                    if root.dragging {

                        root.dragging =
                            false;


                        // `active` já implica ter passado do
                        // limiar (é ligado por latch no MOVE),
                        // então um clique simples nunca chega
                        // aqui como commit.

                        if ClipDragState.active {

                            root.clip-move-committed(
                                root.clip-id,
                                ClipDragState.live-track,
                                ClipDragState.live-beat
                            );
                        }

                        ClipDragState.reset();
                    }
                }
            }
        }

    // =====================================================
    // CONTROLES SEPARADOS (acima da TouchArea, capturam o gesto
    // apenas sobre as bolinhas de fade e de gain).
    // =====================================================

    fade_ctrl := ClipFade {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: root.row-height;

        clip-id: root.clip-id;
        fade-in: root.fade-in;
        fade-out: root.fade-out;
        len: root.len;
        px-per-beat: root.px-per-beat;
        row-height: root.row-height;
        header-height: root.header-height;
        bw: root.bw;
        is-midi: root.is-midi;
        interactive: root.interactive;
        active-tool: root.active-tool;
        selected: root.selected;
        multi-selected: root.multi-selected;
        hovered: root.hovered;
        clip-color: root.clip-color;

        fade-committed(clip-id, fi, fo) => {
            root.clip-fade-committed(clip-id, fi, fo);
        }
    }

    gain_ctrl := ClipGain {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: root.row-height;

        clip-id: root.clip-id;
        gain-db: root.gain-db;
        body-w: parent.width - 2 * root.bw;
        body-h: root.row-height - root.header-height - root.bw;
        header-height: root.header-height;
        hovered: root.hovered;
        show: root.show-gain-controls;

        gain-committed(clip-id, g) => {
            root.clip-gain-committed(clip-id, g);
        }
    }
    }
}
