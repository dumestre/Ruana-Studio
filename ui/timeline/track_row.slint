import { Theme } from "../theme.slint";
import { TrackClip } from "track_clip.slint";
import { ClipData } from "clip_data.slint";

export component TrackRow inherits Rectangle {

    // =====================================================
    // DADOS
    // =====================================================

    in property <int> track-index: 0;

    in property <bool> selected-track: false;

    in property <int> selected-clip: -1;

    in property <[ClipData]> clips: [];


    // =====================================================
    // MÉTRICAS
    // =====================================================

    in property <length> px-per-beat: 40px;

    in property <length> px-per-bar: 160px;

    in property <length> row-height: 64px;


    // =====================================================
    // MÉTRICA MUSICAL
    // =====================================================

    in property <int> total-bars: 32;

    in property <int> beats-per-bar: 4;


    // =====================================================
    // FERRAMENTA
    // =====================================================

    in property <int> active-tool: 0;

    in property <int> drag-clip-id: -1;

    in property <int> drag-track-offset: 0;


    // =====================================================
    // CALLBACKS
    // =====================================================

    callback clip-selected(int);

    callback slice-requested(int, float);

    callback clip-move-started(int, float);

    callback clip-move-delta(int, float, int);

    callback clip-move-finished(int);

    callback clip-resize-started(int, int);

    callback clip-resize-delta(int, int, float);

    callback clip-resize-finished(int);

    callback clip-delete-requested(int);

    callback clip-rename-requested(int, string);

    callback clip-color-cycle-requested(int);

    callback clip-copy-requested(int);


    // =====================================================
    // DIMENSÃO
    // =====================================================

    height:
        root.row-height;


    // =====================================================
    // FUNDO
    //
    // IMPORTANTE:
    // transparente para deixar o grid da Timeline
    // continuar aparecendo.
    // =====================================================

    background:
        transparent;


    // =====================================================
    // HIGHLIGHT DA TRACK SELECIONADA
    //
    // 82% transparente = apenas uma tonalidade.
    // O grid continua visível por baixo.
    // =====================================================

    Rectangle {

        x: 0px;

        y: 0px;

        width:
            parent.width;

        height:
            parent.height;

        background:
            root.selected-track
                ? Theme.surface-high.transparentize(
                    0.82
                )
                : transparent;

        z: 1;
    }


    // =====================================================
    // LINHA INFERIOR
    // =====================================================

    Rectangle {

        x: 0px;

        y:
            parent.height - 1px;

        width:
            parent.width;

        height:
            1px;

        background:
            Theme.border;

        z: 10;
    }


    // =====================================================
    // CLIPS
    // =====================================================

    for clip in root.clips: TrackClip {

        visible:
            clip.track-index
            == root.track-index;


        // =============================================
        // IDENTIDADE
        // =============================================

        name:
            clip.name;

        clip-id:
            clip.id;

        track-index:
            root.track-index;


        // =============================================
        // POSIÇÃO
        // =============================================

        beat:
            clip.beat;


        // =============================================
        // DURAÇÃO
        // =============================================

        len:
            clip.len;


        // =============================================
        // TIPO / COR
        // =============================================

        is-midi:
            clip.is-midi;

        color-index:
            clip.color;

        waveform-peaks:
            clip.waveform-points;


        // =============================================
        // ESCALA
        // =============================================

        px-per-beat:
            root.px-per-beat;

        row-height:
            root.row-height;


        // =============================================
        // SELEÇÃO
        // =============================================

        selected:
            root.selected-clip
            == clip.id;


        // =============================================
        // FERRAMENTA
        // =============================================

        active-tool:
            root.active-tool;

        drag-clip-id:
            root.drag-clip-id;

        drag-track-offset:
            root.drag-track-offset;


        // =============================================
        // CLIQUE
        // =============================================

        clicked(id) => {

            root.clip-selected(
                id
            );
        }


        // =============================================
        // SLICE
        // =============================================

        slice-requested(
            id,
            position
        ) => {

            root.slice-requested(
                id,
                position
            );
        }


        // =============================================
        // MOVE
        // =============================================

        clip-move-started(
            id,
            beat
        ) => {

            root.clip-move-started(
                id,
                beat
            );
        }


        clip-move-delta(
            id,
            delta_beats,
            delta_tracks
        ) => {

            root.clip-move-delta(
                id,
                delta_beats,
                delta_tracks
            );
        }


        clip-move-finished(
            id
        ) => {

            root.clip-move-finished(
                id
            );
        }


        // =============================================
        // RESIZE
        // =============================================

        clip-resize-started(
            id,
            side
        ) => {

            root.clip-resize-started(
                id,
                side
            );
        }


        clip-resize-delta(
            id,
            side,
            delta
        ) => {

            root.clip-resize-delta(
                id,
                side,
                delta
            );
        }


        clip-resize-finished(
            id
        ) => {

            root.clip-resize-finished(
                id
            );
        }


        // =============================================
        // DELETE
        // =============================================

        clip-delete-requested(
            id
        ) => {

            root.clip-delete-requested(
                id
            );
        }


        // =============================================
        // RENAME
        // =============================================

        clip-rename-requested(
            id,
            new_name
        ) => {

            root.clip-rename-requested(
                id,
                new_name
            );
        }


        // =============================================
        // COLOR
        // =============================================

        clip-color-cycle-requested(
            id
        ) => {

            root.clip-color-cycle-requested(
                id
            );
        }


        // =============================================
        // COPY
        // =============================================

        clip-copy-requested(
            id
        ) => {

            root.clip-copy-requested(
                id
            );
        }
    }
}