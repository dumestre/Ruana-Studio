import { Theme } from "../theme.slint";
import { TimelineHeader } from "header.slint";


export component TrackPanel inherits Rectangle {

    // =====================================================
    // DADOS
    // =====================================================

    in property <[string]> track-names: [];

    // Índice de cor da paleta por track (0 = padrão por tipo).
    in property <[int]> track-colors: [];

    in-out property <int> selected-track: 0;

    in property <length> ruler-height: 30px;

    in property <float> zoom-y: 1.0;

    // Rolagem vertical sincronizada com a timeline (scroll-y).
    in property <length> scroll-y: 0px;


    // =====================================================
    // LARGURA
    // =====================================================

    min-width:
        200px;


    // =====================================================
    // CALLBACKS
    // =====================================================

    callback track-clicked(int);
    callback add-track-requested(string);

    // Cor escolhida no seletor do cabeçalho
    // (track selecionada, índice da paleta).
    callback recolor-requested(int, int);


    // =====================================================
    // FUNDO
    // =====================================================

    background:
        Theme.surface;


    // =====================================================
    // HEADER DOS TRACKS
    // =====================================================

    TimelineHeader {

        x:
            0;

        y:
            0;

        width:
            parent.width;

        height:
            parent.height;

        track-names:
            root.track-names;

        track-colors:
            root.track-colors;

        selected-track:
            root.selected-track;

        ruler-height:
            root.ruler-height;

        zoom-y:
            root.zoom-y;

        scroll-y:
            root.scroll-y;


        track-clicked(index) => {

            root.track-clicked(
                index
            );
        }


        add-track-requested(type) => {

            root.add-track-requested(
                type
            );
        }


        recolor-requested(track, color) => {

            root.recolor-requested(
                track,
                color
            );
        }
    }
}