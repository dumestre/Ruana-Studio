// =============================================================
// PLAYHEAD DA TIMELINE
//
// Componente isolado: concentra o hot-path de repaint durante o
// playback (a posição muda a cada tick do clock visual ~8ms).
// Deve ser instanciado DENTRO do content rectangle para scrollar
// junto com o conteúdo.
//
// Ordem de declaração = ordem de empilhamento:
// linha das tracks < linha da régua < cabeça (bolinha).
// =============================================================

export component PlayheadOverlay inherits Rectangle {

    // Posição da agulha em pixels (relativa ao content rect).
    in property <length> head-x: 0px;

    // Altura da régua e das tracks, para esticar as linhas.
    in property <length> ruler-h: 30px;
    in property <length> tracks-h: 0px;

    background: transparent;

    // Linha vertical sobre as tracks
    Rectangle {
        x: head-x - 1px;
        y: ruler-h;
        width: 2px;
        height: tracks-h;
        background: Colors.crimson;
    }

    // Linha dentro da régua
    Rectangle {
        x: head-x - 1px;
        y: 7px;
        width: 2px;
        height: ruler-h - 7px;
        background: Colors.crimson;
        opacity: 0.9;
    }

    // Cabeça (bolinha) na régua — ÚNICA cabeça do playhead
    Rectangle {
        x: head-x - 6px;
        y: 1px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Colors.crimson;
    }
}
