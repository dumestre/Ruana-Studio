import { Theme } from "../theme.slint";

export component AudioWaveform inherits Rectangle {
    // =====================================================
    // PROPRIEDADES
    // =====================================================

    // Waveform escura (preta), padrão de DAW sobre clip claro
    in property <color> waveform-color: #0A0A0A;

    in property <bool> hovered: false;

    in property <[float]> peaks: [];

    background: transparent;
    clip: true;

    // =====================================================
    // LINHA CENTRAL
    // =====================================================

    Rectangle {
        x: 0;
        y: (parent.height - 1px) / 2;
        width: parent.width;
        height: 1px;

        background: root.waveform-color;
        opacity: 0.35; // Linha central mais sutil no Ableton
    }

    // =====================================================
    // WAVEFORM
    //
    // ESCALA 1:1 — SEM ACHATAMENTO.
    //
    // Cada barra é desenhada com a amplitude REAL do áudio
    // (o Rust já manda RMS + pico por trecho, sem normalizar
    // por arquivo). Nada de multiplicador fixo nem piso de
    // 1px que transformava arquivo baixo em bloco cheio:
    // sample baixo desenha baixo, sample alto desenha alto.
    // =====================================================

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        clip: true;

        for peak[i] in root.peaks: Rectangle {
            x: i * (parent.width / Math.max(1, root.peaks.length));

            // Amplitude real, centrada na linha do meio.
            y: (parent.height - peak * parent.height) / 2;

            // Largura sem gap para formar desenho contínuo.
            width: max(
                1px,
                parent.width / Math.max(1, root.peaks.length)
            );

            // Sem esticamento artificial: o silêncio fica
            // invisível (altura mínima só evita retângulo de
            // altura zero, que alguns backends ignoram).
            height: max(
                0.5px,
                peak * parent.height
            );

            background: root.waveform-color;

            // border-radius removido! O Ableton usa renderização de áudio afiada e retangular.
        }
    }

    // =====================================================
    // HOVER
    // =====================================================

    if root.hovered: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        // No Ableton, o hover geralmente cria uma camada branca/clara sobre o clip
        background: #FFFFFF;
        opacity: 0.12;
    }
}
