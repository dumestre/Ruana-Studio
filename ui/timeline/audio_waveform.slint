import { Theme } from "../theme.slint";

export component AudioWaveform inherits Rectangle {
    // =====================================================
    // PROPRIEDADES
    // =====================================================

    // Waveform escura (preta), padrão de DAW sobre clip claro
    in property <color> waveform-color: #0A0A0A;

    in property <bool> hovered: false;

    in property <[float]> peaks: [];

    // Janela rasterizada dentro do clip, em px do corpo.
    // 0 = corpo inteiro. Quando > 0, só o trecho [src-x, src-x+src-w]
    // é desenhado (scroll/zoom). O deslocamento mantém a onda
    // exatamente ancorada no clip, sem mover por zoom/scroll.
    in property <float> waveform-src-x: 0.0;

    in property <float> waveform-src-w: 0.0;

    background: transparent;
    clip: true;

    // =====================================================
    // LINHA CENTRAL
    // =====================================================

    Rectangle {
        x: 0;
        y: (parent.height - 1px) / 2;
        width: parent.width;
        height: 1px;

        background: root.waveform-color;
        opacity: 0.35;
    }

    // =====================================================
    // WAVEFORM — LINHA PURA SEM RASTER (1px por pico)
    // =====================================================
    // O deslocamento por `waveform-src-x` garante que a
    // waveform permanece exatamente no clip durante zoom,
    // scroll e arrasto — sem deslocamento visual.
    // =====================================================

    for peak[i] in root.peaks: Rectangle {
        x: i * parent.width / root.peaks.length - root.waveform-src-x * 1px;
        y: parent.height / 2 - peak * parent.height / 2;
        width: parent.width / root.peaks.length + 0.5px;
        height: 1.25px;
        background: root.waveform-color;
    }

    // =====================================================
    // HOVER
    // =====================================================

    if root.hovered: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        background: #FFFFFF;
        opacity: 0.12;
    }
}