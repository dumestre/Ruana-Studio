import { Theme } from "../theme.slint";

export component AudioWaveform inherits Rectangle {
    // =====================================================
    // PROPRIEDADES
    // =====================================================

    // Waveform escura e nítida, idêntica ao padrão do Ableton Live
    in property <color> waveform-color: #111111; // Quase preto para contrastar com clips coloridos

    in property <bool> hovered: false;

    in property <[float]> peaks: [];

    background: transparent;
    clip: true;

    // =====================================================
    // LINHA CENTRAL
    // =====================================================

    Rectangle {
        x: 0;
        y: (parent.height - 1px) / 2;
        width: parent.width;
        height: 1px;

        background: root.waveform-color;
        opacity: 0.35; // Linha central mais sutil no Ableton
    }

    // =====================================================
    // WAVEFORM
    // =====================================================

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        clip: true;

        for peak[i] in root.peaks: Rectangle {
            x: i * (parent.width / Math.max(1, root.peaks.length));

            // Expandido para 90% para preencher melhor o clip
            y: (parent.height - peak * parent.height * 0.90) / 2;

            // Largura ajustada para remover o gap (-1px) e formar um desenho contínuo
            width: max(
                1px,
                parent.width / Math.max(1, root.peaks.length)
            );

            height: max(
                1px,
                peak * parent.height * 0.90
            );

            background: root.waveform-color;

             

            // border-radius removido! O Ableton usa renderização de áudio afiada e retangular.
        }
    }

    // =====================================================
    // HOVER
    // =====================================================

    if root.hovered: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        // No Ableton, o hover geralmente cria uma camada branca/clara sobre o clip
        background: #FFFFFF;
        opacity: 0.12;
    }
}