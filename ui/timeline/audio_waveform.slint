import { Theme } from "../theme.slint";

export component AudioWaveform inherits Rectangle {
    in property <color> waveform-color: #1A1A2E;
    in property <bool> hovered: false;
    in property <[float]> peaks: [];

    background: transparent;
    clip: true;

    // =====================================================
    // LINHA CENTRAL
    // =====================================================

    Rectangle {
        x: 0;
        y: (parent.height - 1px) / 2;
        width: parent.width;
        height: 1px;
        background: root.waveform-color;
        opacity: 0.12;
    }

    // =====================================================
    // WAVEFORM (barras dinâmicas)
    // =====================================================

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        clip: true;

        for peak[i] in root.peaks: Rectangle {
            x: i * (parent.width / Math.max(1, root.peaks.length));
            y: (parent.height - peak * parent.height * 0.88) / 2;
            width: max(2px, parent.width / Math.max(1, root.peaks.length) - 1px);
            height: max(2px, peak * parent.height * 0.88);
            background: root.waveform-color;
            opacity: 0.45 + peak * 0.35;
            border-radius: 1px;
        }
    }

    // =====================================================
    // HOVER
    // =====================================================

    if root.hovered: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: root.waveform-color;
        opacity: 0.06;
    }
}
