import { Theme } from "../theme.slint";

// ================================================================
// ITEM DO MENU DE TIPO DE TRACK
// ================================================================

export component TrackTypeItem inherits Rectangle {
    in property <image> icon: @image-url("");
    in property <string> name: "";
    in property <string> description: "";
    in property <color> item-color: Theme.accent;

    callback clicked();

    height: 38px;

    border-radius: 6px;

    background:
        area.has-hover
            ? Theme.surface-high
            : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;

        spacing: 10px;

        alignment: LayoutAlignment.stretch;
        cross-axis-alignment: CrossAxisAlignment.center;

        Rectangle {
            width: 26px;
            height: 26px;

            background:
                root.item-color.transparentize(0.82);

            border-radius: 6px;

            Image {
                source: root.icon;

                width: 15px;
                height: 15px;

                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                colorize: root.item-color;
            }
        }

        VerticalLayout {
            spacing: 1px;

            Text {
                text: root.name;

                color: Theme.text-primary;
                font-size: 11px;
                font-weight: 600;
            }

            Text {
                text: root.description;

                color: Theme.text-dim;
                font-size: 9px;
            }
        }
    }

    area := TouchArea {
        width: 100%;
        height: 100%;

        mouse-cursor: pointer;

        clicked => {
            root.clicked();
        }
    }
}
