export global DragState {

    // =========================================================
    // ESTADO GLOBAL DO DRAG
    // =========================================================

    // Existe um drag de clip em andamento?
    //
    // DOWN → true
    // UP   → false
    //
    // Este estado NÃO depende de hover, borda ou posição
    // do cursor sobre o clip.
    in-out property <bool> active: false;


    // =========================================================
    // CLIP ATUALMENTE SENDO ARRASTADO
    // =========================================================

    // ID do clip em drag.
    //
    // -1 = nenhum clip.
    in-out property <int> clip-id: -1;


    // =========================================================
    // CURSOR ABSOLUTO
    // =========================================================

    // Coordenadas absolutas do cursor na janela.
    //
    // São atualizadas durante o drag mesmo quando o cursor
    // sai visualmente dos limites do clip.
    in-out property <length> cursor-x: 0px;

    in-out property <length> cursor-y: 0px;


    // =========================================================
    // PONTO INICIAL DO DRAG
    // =========================================================

    // Posição absoluta do cursor no momento do DOWN.
    //
    // Estes valores permanecem fixos durante todo o drag.
    in-out property <length> start-x: 0px;

    in-out property <length> start-y: 0px;
}