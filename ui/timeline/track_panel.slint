import { Theme } from "../theme.slint";
import { TimelineHeader } from "header.slint";


export component TrackPanel inherits Rectangle {

    // =====================================================
    // DADOS
    // =====================================================

    in property <[string]> track-names: [];

    in property <[int]> track-colors: [];

    in property <[float]> track-meter-left-levels: [];
    in property <[float]> track-meter-right-levels: [];
    in property <[float]> track-meter-left-peaks: [];
    in property <[float]> track-meter-right-peaks: [];
    in property <[bool]> track-meter-left-clipped: [];
    in property <[bool]> track-meter-right-clipped: [];

    in-out property <int> selected-track: 0;

    in property <length> ruler-height: 25px;

    in property <float> zoom-y: 1.0;

    in property <length> scroll-y: 0px;


    // =====================================================
    // LARGURA
    // =====================================================

    min-width:
        200px;


    // =====================================================
    // CALLBACKS
    // =====================================================

    callback track-clicked(int);

    callback add-track-requested(string);

    callback recolor-requested(int, int);

    // Zoom vertical (Alt+roda) vindo das rows do header.
    callback zoom-y-scrolled(float);


    // =====================================================
    // FUNDO
    // =====================================================

    background:
        Theme.surface-high;

    border-radius:
        6px;


    // =====================================================
    // HEADER DOS TRACKS
    // =====================================================

    TimelineHeader {

        x:
            0px;

        y:
            0px;

        width:
            parent.width;

        height:
            parent.height;

        border-radius:
            6px;


        track-names:
            root.track-names;

        track-colors:
            root.track-colors;

        track-meter-left-levels:
            root.track-meter-left-levels;
        track-meter-right-levels:
            root.track-meter-right-levels;
        track-meter-left-peaks:
            root.track-meter-left-peaks;
        track-meter-right-peaks:
            root.track-meter-right-peaks;
        track-meter-left-clipped:
            root.track-meter-left-clipped;
        track-meter-right-clipped:
            root.track-meter-right-clipped;

        selected-track:
            root.selected-track;

        ruler-height:
            root.ruler-height;

        zoom-y:
            root.zoom-y;

        scroll-y:
            root.scroll-y;


        track-clicked(index) => {

            root.track-clicked(
                index
            );
        }


        add-track-requested(type) => {

            root.add-track-requested(
                type
            );
        }


        recolor-requested(track, color) => {

            root.recolor-requested(
                track,
                color
            );
        }

        zoom-y-scrolled(new-zoom-y) => {

            root.zoom-y-scrolled(
                new-zoom-y
            );
        }
    }
}