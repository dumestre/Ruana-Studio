import { Theme } from "../theme.slint";
import { TrackHeaderRow } from "track_header.slint";

export component TimelineHeader inherits Rectangle {
    in property <[string]> track-names: [];
    in property <int> selected-track: 0;
    in property <length> ruler-height: 30px;

    callback track-clicked(int);

    background: Theme.surface;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Theme.border;
    }

    Rectangle {
        width: 100%;
        height: root.ruler-height;
        background: Theme.surface;

        Rectangle {
            y: parent.height - 1px;
            width: 100%;
            height: 1px;
            background: Theme.border;
        }

        Text {
            text: "TRACK";
            width: 100%;
            height: 100%;
            color: Theme.text-dim;
            font-size: 10px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    VerticalLayout {
        y: root.ruler-height;
        width: 100%;
        height: parent.height - root.ruler-height;
        spacing: 0;

        for name[i] in root.track-names: TrackHeaderRow {
            name: name;
            track-color: i == 2
                ? Theme.clip-audio
                : Theme.clip-midi;

            selected: root.selected-track == i;
            track-index: i;

            clicked(idx) => {
                root.track-clicked(idx);
            }
        }
    }
}
