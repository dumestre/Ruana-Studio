import { Theme } from "../theme.slint";
import { ClipPalette } from "../clip_palette.slint";
import { TrackHeaderRow } from "track_header.slint";
import { TrackTypeSelector } from "new_track.slint";
import { Button } from "../components/button.slint";
import { ColorPicker } from "../components/color_picker.slint";

export component TimelineHeader inherits Rectangle {

    // =====================================================
    // DADOS
    // =====================================================

    in property <[string]> track-names: [];

    in property <[int]> track-colors: [];

    in property <[float]> track-volumes: [];

    // M/S/R dos mesmos arrays que o mixer usa. Vinculados ao estado do
    // core, não a um `bool` local da row: com estado local, dar mute no
    // mixer atualizava só o mixer e o cabeçalho continuava mostrando a
    // faixa como audível — dois "verdades" para o mesmo canal.
    in-out property <[bool]> track-mutes: [];
    in-out property <[bool]> track-soloes: [];
    in-out property <[bool]> track-arms: [];

    // Medição real (4 floats por canal) e clip (2 bools por canal),
    // compartilhada com o mixer.
    in-out property <[float]> channel-meters: [];
    in-out property <[bool]> channel-clipped: [];

    // Leitura com guarda: o comprimento do modelo é publicado pelo
    // `MeterPump` num tick, e a reordenação de faixas acontece entre
    // ticks. Indexar direto nesse intervalo mostraria o canal vizinho
    // no lugar do errado.
    function meter-at(track: int, slot: int) -> float {
        let idx = track * 4 + slot;
        return idx >= 0 && idx < root.channel-meters.length
            ? root.channel-meters[idx]
            : 0.0;
    }

    function clip-at(track: int, side: int) -> bool {
        let idx = track * 2 + side;
        return idx >= 0 && idx < root.channel-clipped.length
            ? root.channel-clipped[idx]
            : false;
    }

    function volume-at(track: int) -> float {
        return track >= 0 && track < root.track-volumes.length
            ? root.track-volumes[track]
            : 0.8;
    }

    // Mesmas guardas da medição: o número de canais é publicado pelo
    // Rust e muda entre ticks, então indexar direto leria a faixa
    // vizinha.
    function mute-at(track: int) -> bool {
        return track >= 0 && track < root.track-mutes.length
            ? root.track-mutes[track]
            : false;
    }

    function solo-at(track: int) -> bool {
        return track >= 0 && track < root.track-soloes.length
            ? root.track-soloes[track]
            : false;
    }

    function arm-at(track: int) -> bool {
        return track >= 0 && track < root.track-arms.length
            ? root.track-arms[track]
            : false;
    }

    in property <int> selected-track: 0;

    in property <length> ruler-height: 30px;

    in property <float> zoom-y: 1.0;

    in property <length> scroll-y: 0px;


    // =====================================================
    // CALLBACKS
    // =====================================================

    callback track-clicked(int);

    callback add-track-requested(string);

    callback recolor-requested(int, int);

    // Volume (posição 0..1 na curva dB) arrastado no triângulo.
    callback track-volume-changed(int, float);

    // M/S/R — agora com destino real no core.
    callback track-mute-clicked(int, float);
    callback track-solo-clicked(int, float);
    callback track-record-clicked(int, float);

    // Clique na luz de clip.
    callback channel-clip-cleared(int);

    // Zoom vertical (Alt+roda) repassado pelas rows.
    callback zoom-y-scrolled(float);


    // =====================================================
    // HEADER FIXO NO TOPO (altura = ruler-height)
    // =====================================================

    header := HorizontalLayout {

        x: 0;
        y: 0;

        width: parent.width;

        height: 25px;

        spacing: 2px;

        padding-left: 6px;

        padding-right: 8px;

        alignment: LayoutAlignment.stretch;

        cross-axis-alignment: CrossAxisAlignment.center;


        // =============================================
        // TÍTULO TRACKS
        // =============================================

        Rectangle {

            horizontal-stretch: 1;

            height: parent.height;

            background: transparent;


            Text {

                width: parent.width;

                height: parent.height;

                text: "TRACKS";

                color: Theme.text-primary;

                font-size: 9px;

                font-weight: 700;

                horizontal-alignment: TextHorizontalAlignment.center;

                vertical-alignment: TextVerticalAlignment.center;

                overflow: elide;
            }
        }


        // =============================================
        // PALETA
        // =============================================

        Button {

            width: 20px;
            height: 20px;

            
            corner-radius: 2px;

            icon: @image-url("../icons/palette.svg");

            icon-size: 16px;

            icon-color: Theme.text-primary;

            resting-bg: transparent;

            hover-bg: Theme.base;

            borderless: true;

            clicked => {
                color-popup.show();
            }
        }


        // =============================================
        // ADICIONAR TRACK
        // =============================================

        add-button := Button {

            width: 20px;

            height: 20px;

            corner-radius: 2px;

            icon: @image-url("../icons/add.svg");

            icon-size: 16px;

            icon-color: Theme.text-primary;

            resting-bg: transparent;

            hover-bg: Theme.base;

            borderless: true;

            clicked => {
                new-track-popup.show();
            }
        }
    }


    // =====================================================
    // DIVISÓRIA
    // =====================================================

    divider := Rectangle {

        x: 0;

        y: root.ruler-height;

        width: parent.width;

        height: 1px;

        background: Theme.is-paper ? Theme.base : Theme.border;
    }


    // =====================================================
    // VIEWPORT SCROLLÁVEL (apenas as tracks)
    // =====================================================

    viewport := Rectangle {

        clip: true;

        x: 0;

        y: root.ruler-height + 1px;  // abaixo do header + divisória

        width: 100%;

        height: parent.height - root.ruler-height - 1px;


        VerticalLayout {

            x: 0;

            y: -root.scroll-y;

            width: parent.width;

            height: root.track-names.length * 64px * root.zoom-y;

            spacing: 0px;

            alignment: LayoutAlignment.start;

            cross-axis-alignment: CrossAxisAlignment.stretch;


            // =============================================
            // TRACK HEADER ROW
            // =============================================

            for name[i] in root.track-names:

                TrackHeaderRow {

                    width: parent.width;

                    height: 64px * root.zoom-y;


                    // -------------------------------------
                    // NOME
                    // -------------------------------------

                    name: name;


                    // -------------------------------------
                    // ÍNDICE
                    // -------------------------------------

                    track-index: i;


                    // -------------------------------------
                    // TIPO
                    // -------------------------------------

                    track-type: "MIDI";


                    // -------------------------------------
                    // ZOOM
                    // -------------------------------------

                    zoom-y: root.zoom-y;


                    // -------------------------------------
                    // COR
                    // -------------------------------------

                    track-color:

                        i < root.track-colors.length
                        && root.track-colors[i] != 0

                        ?

                        ClipPalette.colors[
                            Math.mod(
                                root.track-colors[i],
                                ClipPalette.colors.length
                            )
                        ]

                        :

                        (
                            i == 2
                                ? Theme.clip-audio
                                : Theme.clip-midi
                        );


                    // -------------------------------------
                    // METER
                    // -------------------------------------

                    left-level: root.meter-at(i, 0);
                    right-level: root.meter-at(i, 1);
                    left-peak: root.meter-at(i, 2);
                    right-peak: root.meter-at(i, 3);
                    left-clipped: root.clip-at(i, 0);
                    right-clipped: root.clip-at(i, 1);

                    // O fader é o MESMO componente do mixer, então o
                    // volume também vem do mesmo lugar. Aqui ainda
                    // entra pelo array de volumes, e não por uma
                    // propriedade da row, para não haver duas cópias
                    // do valor.
                    volume: root.volume-at(i);

                    // -------------------------------------
                    // M / S / R (estado vindo do core)
                    // -------------------------------------

                    muted: root.mute-at(i);

                    solo: root.solo-at(i);

                    record-armed: root.arm-at(i);

                    // -------------------------------------
                    // SELEÇÃO
                    // -------------------------------------

                    selected: root.selected-track == i;


                    // -------------------------------------
                    // CLICK
                    // -------------------------------------

                    clicked(index) => {

                        root.track-clicked(index);
                    }

                    // Repassa o zoom vertical calculado na row.
                    zoom-y-scrolled(new-zoom-y) => {
                        root.zoom-y-scrolled(new-zoom-y);
                    }

                    volume-changed(index, pos) => {
                        root.track-volume-changed(index, pos);
                    }

                    mute-clicked(index, on) => {
                        root.track-mute-clicked(index, on);
                    }

                    solo-clicked(index, on) => {
                        root.track-solo-clicked(index, on);
                    }

                    record-clicked(index, on) => {
                        root.track-record-clicked(index, on);
                    }

                    clip-cleared(index) => {
                        root.channel-clip-cleared(index);
                    }
                }
        }
    }


    // =====================================================
    // POPUP DE COR
    // =====================================================

    color-popup := PopupWindow {

        x: root.width - 210px;

        y: -root.scroll-y + root.ruler-height + 1px + 4px;

        ColorPicker {

            background: Theme.base;

            current:
                root.selected-track >= 0
                && root.selected-track < root.track-colors.length
                    ? root.track-colors[root.selected-track]
                    : -1;

            picked(idx) => {

                root.recolor-requested(
                    root.selected-track,
                    idx
                );

                color-popup.close();
            }
        }
    }


    // =====================================================
    // POPUP NOVA TRACK
    // =====================================================

    new-track-popup := PopupWindow {

        x: root.width - 220px;

        y: -root.scroll-y + root.ruler-height + 1px + 4px;

        TrackTypeSelector {

            track-type-selected(type) => {

                root.add-track-requested(type);

                new-track-popup.close();
            }
        }
    }
}