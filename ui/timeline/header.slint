import { Theme } from "../theme.slint";
import { ClipPalette } from "../clip_palette.slint";
import { TrackHeaderRow } from "track_header.slint";
import { TrackTypeSelector } from "new_track.slint";
import { Button } from "../components/button.slint";
import { ColorPicker } from "../components/color_picker.slint";

export component TimelineHeader inherits Rectangle {

    // =====================================================
    // DADOS
    // =====================================================

    in property <[string]> track-names: [];

    in property <[int]> track-colors: [];

    in property <int> selected-track: 0;

    in property <length> ruler-height: 30px;

    in property <float> zoom-y: 1.0;

    in property <length> scroll-y: 0px;


    // =====================================================
    // CALLBACKS
    // =====================================================

    callback track-clicked(int);

    callback add-track-requested(string);

    callback recolor-requested(int, int);

    // Zoom vertical (Alt+roda) repassado pelas rows.
    callback zoom-y-scrolled(float);


    // =====================================================
    // FUNDO
    // =====================================================

    background:
        transparent;


    // =====================================================
    // VIEWPORT
    //
    // Contêiner clippado fixo no tamanho do componente. O
    // conteúdo interno desliza com `scroll-y` — sincronizado
    // com a timeline — e o excesso acima/abaixo é cortado.
    // =====================================================

    viewport := Rectangle {

        clip: true;

        x: 0;

        y: 0;

        width: 100%;

        height: 100%;


        // =================================================
        // CONTEÚDO DESLIZANTE
        // =================================================

        VerticalLayout {

            x: 0;

            y:
                -root.scroll-y;

            width:
                parent.width;

            height:
                max(
                    parent.height,
                    root.ruler-height
                    + 1px
                    + root.track-names.length * 64px * root.zoom-y
                );

            spacing:
                0px;

            alignment:
                LayoutAlignment.start;

            cross-axis-alignment:
                CrossAxisAlignment.stretch;


            // =================================================
            // HEADER
            // =================================================

            HorizontalLayout {

                width:
                    parent.width;

                height:
                    root.ruler-height;

            spacing:
                2px;

            padding-left:
                6px;

            padding-right:
                8px;

            alignment:
                LayoutAlignment.stretch;

            cross-axis-alignment:
                CrossAxisAlignment.center;


            // =============================================
            // TÍTULO TRACKS
            // =============================================

            Rectangle {

                horizontal-stretch:
                    1;

                height:
                    parent.height;

                background:
                    transparent;


                Text {

                    width:
                        parent.width;

                    height:
                        parent.height;

                    text:
                        "TRACKS";

                    color:
                        Theme.text-primary;

                    font-size:
                        9px;

                    font-weight:
                        700;

                    horizontal-alignment:
                        TextHorizontalAlignment.center;

                    vertical-alignment:
                        TextVerticalAlignment.center;

                    overflow:
                        elide;
                }
            }


            // =============================================
            // PALETA
            // =============================================

            Button {

                width:
                    20px;

                height:
                    20px;

                corner-radius:
                    2px;

                icon:
                    @image-url(
                        "../icons/palette.svg"
                    );

                icon-size:
                    16px;

                icon-color:
                    Theme.text-primary;

                resting-bg:
                    transparent;

                hover-bg:
                    Theme.base;

                borderless:
                    true;

                clicked => {
                    color-popup.show();
                }
            }


            // =============================================
            // ADICIONAR TRACK
            // =============================================

            add-button := Button {

                width:
                    20px;

                height:
                    20px;

                corner-radius:
                    2px;

                icon:
                    @image-url(
                        "../icons/add.svg"
                    );

                icon-size:
                    16px;

                icon-color:
                    Theme.text-primary;

                resting-bg:
                    transparent;

                hover-bg:
                    Theme.base;

                borderless:
                    true;

                clicked => {
                    new-track-popup.show();
                }
            }
        }


        // =================================================
        // DIVISÓRIA
        // =================================================

        Rectangle {

            width:
                parent.width;

            height:
                1px;

            background:
                Theme.is-paper
                    ? Theme.base
                    : Theme.border;
        }


        // =================================================
        // TRACKS
        //
        // Não usamos x/y aqui porque este elemento está
        // dentro do VerticalLayout.
        // =================================================

        VerticalLayout {

            width:
                parent.width;

            height:
                root.track-names.length
                * 64px
                * root.zoom-y;

            vertical-stretch:
                1;

            spacing:
                0px;

            alignment:
                LayoutAlignment.start;

            cross-axis-alignment:
                CrossAxisAlignment.stretch;


            // =============================================
            // TRACK HEADER ROW
            // =============================================

            for name[i] in root.track-names:

                TrackHeaderRow {

                    width:
                        parent.width;

                    height:
                        64px * root.zoom-y;


                    // -------------------------------------
                    // NOME
                    // -------------------------------------

                    name:
                        name;


                    // -------------------------------------
                    // ÍNDICE
                    // -------------------------------------

                    track-index:
                        i;


                    // -------------------------------------
                    // TIPO
                    // -------------------------------------

                    track-type:
                        "MIDI";


                    // -------------------------------------
                    // ZOOM
                    // -------------------------------------

                    zoom-y:
                        root.zoom-y;


                    // -------------------------------------
                    // COR
                    // -------------------------------------

                    track-color:

                        i < root.track-colors.length
                        && root.track-colors[i] != 0

                        ?

                        ClipPalette.colors[
                            Math.mod(
                                root.track-colors[i],
                                ClipPalette.colors.length
                            )
                        ]

                        :

                        (
                            i == 2
                                ? Theme.clip-audio
                                : Theme.clip-midi
                        );


                    // -------------------------------------
                    // SELEÇÃO
                    // -------------------------------------

                    selected:
                        root.selected-track == i;


                    // -------------------------------------
                    // CLICK
                    // -------------------------------------

                    clicked(index) => {

                        root.track-clicked(
                            index
                        );
                    }

                    // Repassa o zoom vertical calculado na row.
                    zoom-y-scrolled(new-zoom-y) => {
                        root.zoom-y-scrolled(
                            new-zoom-y
                        );
                    }
                }
        }
    }
    }


    // =====================================================
    // POPUP DE COR
    // =====================================================

    color-popup := PopupWindow {

        x: root.width - 210px;

        y: -root.scroll-y + root.ruler-height + 4px;

        ColorPicker {

            background: Theme.base;

            current:
                root.selected-track >= 0
                && root.selected-track < root.track-colors.length
                    ? root.track-colors[root.selected-track]
                    : -1;

            picked(idx) => {

                root.recolor-requested(
                    root.selected-track,
                    idx
                );

                color-popup.close();
            }
        }
    }


    // =====================================================
    // POPUP NOVA TRACK
    // =====================================================

    new-track-popup := PopupWindow {

        x: root.width - 220px;

        y: -root.scroll-y + root.ruler-height + 4px;

        TrackTypeSelector {

            track-type-selected(type) => {

                root.add-track-requested(type);

                new-track-popup.close();
            }
        }
    }
}