import { Theme } from "../theme.slint";
import { ClipPalette } from "../clip_palette.slint";
import { TrackHeaderRow } from "track_header.slint";
import { TrackTypeItem } from "new_track.slint";
import { ColorPicker } from "../components/color_picker.slint";

export component TimelineHeader inherits Rectangle {

    in property <[string]> track-names: [];
    in property <[int]> track-colors: [];
    in property <int> selected-track: 0;

    in property <length> ruler-height: 30px;
    in property <float> zoom-y: 1.0;
    in property <length> scroll-y: 0px;

    callback track-clicked(int);
    callback add-track-requested(string);
    callback recolor-requested(int, int);

    background: transparent;


    // =====================================================
    // LAYOUT PRINCIPAL
    // =====================================================

    VerticalLayout {

        spacing: 0;

        alignment: LayoutAlignment.start;

        cross-axis-alignment: CrossAxisAlignment.stretch;


    // =================================================
    // HEADER
    // =================================================

    HorizontalLayout {

        height: root.ruler-height;

        spacing: 2px;

        alignment: LayoutAlignment.stretch;

        cross-axis-alignment: CrossAxisAlignment.center;


        Rectangle {

            horizontal-stretch: 1;

            height: parent.height;

            background: transparent;


            Text {

                
                height: parent.height;

                text: "TRACKS";

                color: Theme.text-primary;

                font-size: 9px;
                font-weight: 700;

                horizontal-alignment: TextHorizontalAlignment.center;

                vertical-alignment: TextVerticalAlignment.center;

                overflow: elide;
            }
        }


        // =================================================
        // BOTÃO PALETA
        // =================================================

        Rectangle {

            width: 24px;
            height: 24px;

            border-radius: 5px;

            background:
                color-area.has-hover
                ? Theme.surface-high
                : transparent;


            Image {

                source: @image-url("../icons/palette.svg");

                width: 18px;
                height: 18px;

                x: (parent.width - self.width) / 2;

                y: (parent.height - self.height) / 2;

                colorize: Theme.text-primary;
            }


            color-area := TouchArea {

                
                height: parent.height;

                mouse-cursor: pointer;

                clicked => {
                    // color-popup disabled
                }
            }
        }


        // =================================================
        // BOTÃO ADICIONAR TRACK
        // =================================================

        Rectangle {

            width: 24px;
            height: 24px;

            border-radius: 5px;

            background:
                add-area.has-hover
                ? Theme.surface-high
                : transparent;


            Image {

                source: @image-url("../icons/add.svg");

                width: 18px;
                height: 18px;

                x: (parent.width - self.width) / 2;

                y: (parent.height - self.height) / 2;

                colorize: Theme.text-primary;
            }


            add-area := TouchArea {

                
                height: parent.height;

                mouse-cursor: pointer;

                clicked => {
                    // new-track-popup disabled
                }
            }
        }
    }


    // =================================================
    // LINHA DIVISÓRIA
    // =================================================

    Rectangle {

        height: 1px;

        background: Theme.is-paper ? Theme.base : Theme.border;
    }


    // =================================================
    // VIEWPORT DAS TRACKS
    // =================================================

    Rectangle {

        vertical-stretch: 1;

        background: transparent;

        clip: true;


        VerticalLayout {

            x: 0;

            y: -root.scroll-y;

            width: parent.width;

            height:
                root.track-names.length
                * 64px
                * root.zoom-y;

            spacing: 0;

            alignment: LayoutAlignment.stretch;

            cross-axis-alignment:
                CrossAxisAlignment.stretch;


                for name[i] in root.track-names:

                TrackHeaderRow {

                    name: name;

                    track-index: i;


                    track-color:
                        i < root.track-colors.length
                        && root.track-colors[i] != 0

                        ?

                        ClipPalette.colors[
                            Math.mod(
                                root.track-colors[i],
                                ClipPalette.colors.length
                            )
                        ]

                        :

                        (
                            i == 2
                            ? Theme.clip-audio
                            : Theme.clip-midi
                        );


                    selected:
                        root.selected-track == i;


                    zoom-y:
                        root.zoom-y;


                    clicked(index) => {
                        root.track-clicked(index);
                    }
                }
            }
        }
}


// =====================================================
// POPUP DE COR (desabilitado)
// =====================================================

// color-popup := PopupWindow { ... }


// =====================================================
// POPUP NOVA TRACK (desabilitado)
// =====================================================

// new-track-popup := PopupWindow { ... }
}
