import { Theme } from "../theme.slint";
import { ClipPalette } from "../clip_palette.slint";
import { TrackHeaderRow } from "track_header.slint";
import { TrackTypeItem } from "new_track.slint";
import { ColorPicker } from "../components/color_picker.slint";

export component TimelineHeader inherits Rectangle {

in property <[string]> track-names: [];
in property <[int]> track-colors: [];
in property <int> selected-track: 0;

in property <length> ruler-height: 30px;
in property <float> zoom-y: 1.0;
in property <length> scroll-y: 0px;

callback track-clicked(int);
callback add-track-requested(string);
callback recolor-requested(int, int);

background: transparent;


// =====================================================
// LAYOUT PRINCIPAL
// =====================================================

VerticalLayout {

    width: parent.width;
    height: parent.height;

    spacing: 0;

    alignment: LayoutAlignment.start;

    cross-axis-alignment: CrossAxisAlignment.stretch;


    // =================================================
    // HEADER
    // =================================================

    HorizontalLayout {

        height: root.ruler-height;

        spacing: 2px;

        alignment: LayoutAlignment.center;

        cross-axis-alignment: CrossAxisAlignment.center;


        Rectangle {

            horizontal-stretch: 1;

            height: parent.height;

            background: transparent;


            Text {

                width: parent.width;
                height: parent.height;

                text: "TRACKS";

                color: Theme.text-dim;

                font-size: 9px;
                font-weight: 700;

                horizontal-alignment: TextHorizontalAlignment.center;

                vertical-alignment: TextVerticalAlignment.center;

                overflow: elide;
            }
        }


        // =================================================
        // BOTÃO PALETA
        // =================================================

        Rectangle {

            width: 24px;
            height: 24px;

            border-radius: 5px;

            background:
                color-area.has-hover
                ? Theme.surface-high
                : transparent;


            Image {

                source: @image-url("../icons/palette.svg");

                width: 18px;
                height: 18px;

                x: (parent.width - self.width) / 2;

                y: (parent.height - self.height) / 2;

                colorize: Theme.text-primary;
            }


            color-area := TouchArea {

                width: parent.width;
                height: parent.height;

                mouse-cursor: pointer;

                clicked => {
                    color-popup.show();
                }
            }
        }


        // =================================================
        // BOTÃO ADICIONAR TRACK
        // =================================================

        Rectangle {

            width: 24px;
            height: 24px;

            border-radius: 5px;

            background:
                add-area.has-hover
                ? Theme.surface-high
                : transparent;


            Image {

                source: @image-url("../icons/add.svg");

                width: 18px;
                height: 18px;

                x: (parent.width - self.width) / 2;

                y: (parent.height - self.height) / 2;

                colorize: Theme.text-primary;
            }


            add-area := TouchArea {

                width: parent.width;
                height: parent.height;

                mouse-cursor: pointer;

                clicked => {
                    new-track-popup.show();
                }
            }
        }
    }


    // =================================================
    // LINHA DIVISÓRIA
    // =================================================

    Rectangle {

        width: parent.width;

        height: 1px;

        background: Theme.is-paper ? Theme.base : Theme.border;
    }


    // =================================================
    // VIEWPORT DAS TRACKS
    // =================================================

    Rectangle {

        width: parent.width;

        vertical-stretch: 1;

        background: transparent;

        clip: true;


        Rectangle {

            x: 0;

            y: -root.scroll-y;

            width: parent.width;

            height:
                root.track-names.length
                * 64px
                * root.zoom-y;

            background: transparent;


            VerticalLayout {

                width: parent.width;

                height: parent.height;

                spacing: 0;

                alignment: LayoutAlignment.start;

                cross-axis-alignment:
                    CrossAxisAlignment.stretch;


                for name[i] in root.track-names:

                TrackHeaderRow {

                    name: name;

                    track-index: i;


                    track-color:
                        i < root.track-colors.length
                        && root.track-colors[i] != 0

                        ?

                        ClipPalette.colors[
                            Math.mod(
                                root.track-colors[i],
                                ClipPalette.colors.length
                            )
                        ]

                        :

                        (
                            i == 2
                            ? Theme.clip-audio
                            : Theme.clip-midi
                        );


                    selected:
                        root.selected-track == i;


                    zoom-y:
                        root.zoom-y;


                    clicked(index) => {
                        root.track-clicked(index);
                    }
                }
            }
        }
    }
}


// =====================================================
// POPUP DE COR
// =====================================================

color-popup := PopupWindow {

    x:
        max(
            0px,
            root.width - self.width - 8px
        );

    y: root.ruler-height + 2px;

    width: 197px;
    height: 45px;

    close-policy: close-on-click-outside;


    ColorPicker {

        width: parent.width;
        height: parent.height;


        picked(idx) => {

            root.recolor-requested(
                root.selected-track,
                idx
            );

            color-popup.close();
        }
    }
}


// =====================================================
// POPUP NOVA TRACK
// =====================================================

new-track-popup := PopupWindow {

    x: 0;

    y: root.ruler-height + 2px;

    width: 230px;
    height: 332px;

    close-policy: close-on-click-outside;


    Rectangle {

        width: parent.width;
        height: parent.height;

        background: Theme.surface-high;

        border-radius: 8px;

        border-width: 1px;

        border-color: Theme.border;


        VerticalLayout {

            padding: 6px;

            spacing: 2px;


            Text {

                text: "NOVA TRACK";

                color: Theme.text-dim;

                font-size: 9px;

                font-weight: 700;
            }


            TrackTypeItem {

                icon: @image-url("../icons/audio.svg");

                name: "Audio";

                description: "Onda de áudio gravada";

                item-color: #00C853;

                clicked => {

                    root.add-track-requested("AUDIO");

                    new-track-popup.close();
                }
            }


            TrackTypeItem {

                icon: @image-url("../icons/midi.svg");

                name: "MIDI";

                description: "Notas e dados de controlador";

                item-color: #6FA86B;

                clicked => {

                    root.add-track-requested("MIDI");

                    new-track-popup.close();
                }
            }


            TrackTypeItem {

                icon: @image-url("../icons/instrument.svg");

                name: "Instrument";

                description: "Instrumento virtual (VST)";

                item-color: #6FB3E0;

                clicked => {

                    root.add-track-requested("INSTRUMENT");

                    new-track-popup.close();
                }
            }


            TrackTypeItem {

                icon: @image-url("../icons/drum.svg");

                name: "Drum Machine";

                description: "Bateria por steps";

                item-color: #F2B021;

                clicked => {

                    root.add-track-requested("DRUM");

                    new-track-popup.close();
                }
            }


            TrackTypeItem {

                icon: @image-url("../icons/fx.svg");

                name: "FX";

                description: "Cadeia de efeitos";

                item-color: #B07CD8;

                clicked => {

                    root.add-track-requested("FX");

                    new-track-popup.close();
                }
            }


            TrackTypeItem {

                icon: @image-url("../icons/bus.svg");

                name: "Bus";

                description: "Rota de múltiplos canais";

                item-color: #4EC9C9;

                clicked => {

                    root.add-track-requested("BUS");

                    new-track-popup.close();
                }
            }


            TrackTypeItem {

                icon: @image-url("../icons/master.svg");

                name: "Master";

                description: "Saída principal";

                item-color: #E8E8E8;

                clicked => {

                    root.add-track-requested("MASTER");

                    new-track-popup.close();
                }
            }
        }
    }
}
}