export struct ClipData {
    id: int,
    track-index: int,
    name: string,
    beat: float,
    len: float,
    is-midi: bool,
    color: int,
    // Waveform "Bin Visual": barras min→max por coluna, em LOD
    // multinível (publicadas pelo Rust — nível escolhido pela largura
    // de exibição via waveform-resolution-requested). Arrays paralelas:
    // `waveform-mins[i]` ≤ `waveform-maxes[i]` para todo i.
    waveform-mins: [float],
    waveform-maxes: [float],
    // Seleção múltipla (Ctrl+arrasto / marquee). Independente da
    // seleção simples (`selected-clip`).
    multi-selected: bool,
    // Fades do clip em beats (ajustáveis nos controladores do corpo).
    fade-in: float,
    fade-out: float,
    // Ganho do clip em dB (-24..+12). 0 = unidade. Vem do core e é
    // controlado pela barrinha central do clip ou pelo BarProperties.
    gain-db: float,
}
