export struct ClipData {
    id: int,
    track-index: int,
    name: string,
    beat: float,
    len: float,
    is-midi: bool,
    color: int,
    waveform-points: [float],
    // Waveform pré-renderizada (Rust, uma vez por import).
    // Largura 0 = sem imagem → o clip cai no fallback de retângulos.
    waveform-image: image,
    // Seleção múltipla (Ctrl+arrasto / marquee). Independente da
    // seleção simples (`selected-clip`).
    multi-selected: bool,
}
