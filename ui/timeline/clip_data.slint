export struct ClipData {
    id: int,
    track-index: int,
    name: string,
    beat: float,
    len: float,
    is-midi: bool,
    color: int,
    // Seleção múltipla (Ctrl+arrasto / marquee). Independente da
    // seleção simples (`selected-clip`).
    multi-selected: bool,
    // Fades do clip em beats (ajustáveis nos controladores do corpo).
    fade-in: float,
    fade-out: float,
    // Ganho do clip em dB (-24..+12). 0 = unidade. Vem do core e é
    // controlado pela barrinha central do clip ou pelo BarProperties.
    gain-db: float,
    // Waveform renderizada via wgpu (offscreen + readback) na resolução
    // de exibição exata. O Slint apenas exibe a imagem no corpo do clip.
    waveform: image,
}
