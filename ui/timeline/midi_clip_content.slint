import { Theme } from "../theme.slint";

export component MidiClipContent inherits Rectangle {
    in property <color> note-color: Theme.text-primary;
    in property <bool> hovered: false;

    background: transparent;
    clip: true;

    // =====================================================
    // GRADE HORIZONTAL
    // =====================================================

    Rectangle {
        x: 0;
        y: parent.height / 3;
        width: parent.width;
        height: 1px;

        background: root.note-color;
        opacity: 0.06;
    }

    Rectangle {
        x: 0;
        y: (parent.height * 2) / 3;
        width: parent.width;
        height: 1px;

        background: root.note-color;
        opacity: 0.06;
    }

    // =====================================================
    // NOTAS PRINCIPAIS
    // =====================================================

    Rectangle {
        x: 6px;
        y: 8px;
        width: 18px;
        height: 5px;

        background: root.note-color;
        opacity: 0.78;
        border-radius: 2px;
    }

    Rectangle {
        x: 28px;
        y: 18px;
        width: 25px;
        height: 5px;

        background: root.note-color;
        opacity: 0.88;
        border-radius: 2px;
    }

    Rectangle {
        x: 57px;
        y: 5px;
        width: 15px;
        height: 5px;

        background: root.note-color;
        opacity: 0.70;
        border-radius: 2px;
    }

    Rectangle {
        x: 76px;
        y: 25px;
        width: 30px;
        height: 5px;

        background: root.note-color;
        opacity: 0.84;
        border-radius: 2px;
    }

    Rectangle {
        x: 112px;
        y: 13px;
        width: 21px;
        height: 5px;

        background: root.note-color;
        opacity: 0.76;
        border-radius: 2px;
    }

    Rectangle {
        x: 138px;
        y: 4px;
        width: 27px;
        height: 5px;

        background: root.note-color;
        opacity: 0.90;
        border-radius: 2px;
    }

    Rectangle {
        x: 171px;
        y: 20px;
        width: 19px;
        height: 5px;

        background: root.note-color;
        opacity: 0.72;
        border-radius: 2px;
    }

    Rectangle {
        x: 195px;
        y: 9px;
        width: 27px;
        height: 5px;

        background: root.note-color;
        opacity: 0.86;
        border-radius: 2px;
    }

    Rectangle {
        x: 228px;
        y: 28px;
        width: 18px;
        height: 5px;

        background: root.note-color;
        opacity: 0.68;
        border-radius: 2px;
    }

    // =====================================================
    // NOTAS SECUNDÁRIAS
    // =====================================================

    Rectangle {
        x: 17px;
        y: 31px;
        width: 10px;
        height: 4px;

        background: root.note-color;
        opacity: 0.45;
        border-radius: 2px;
    }

    Rectangle {
        x: 48px;
        y: 3px;
        width: 9px;
        height: 4px;

        background: root.note-color;
        opacity: 0.42;
        border-radius: 2px;
    }

    Rectangle {
        x: 91px;
        y: 9px;
        width: 12px;
        height: 4px;

        background: root.note-color;
        opacity: 0.48;
        border-radius: 2px;
    }

    Rectangle {
        x: 124px;
        y: 32px;
        width: 11px;
        height: 4px;

        background: root.note-color;
        opacity: 0.44;
        border-radius: 2px;
    }

    Rectangle {
        x: 157px;
        y: 18px;
        width: 10px;
        height: 4px;

        background: root.note-color;
        opacity: 0.46;
        border-radius: 2px;
    }

    Rectangle {
        x: 184px;
        y: 3px;
        width: 9px;
        height: 4px;

        background: root.note-color;
        opacity: 0.42;
        border-radius: 2px;
    }

    Rectangle {
        x: 213px;
        y: 18px;
        width: 11px;
        height: 4px;

        background: root.note-color;
        opacity: 0.46;
        border-radius: 2px;
    }

    // =====================================================
    // LINHA VERTICAL DE COMPASSO
    // =====================================================

    Rectangle {
        x: 0;
        y: 0;

        width: 1px;
        height: parent.height;

        background: root.note-color;
        opacity: 0.10;
    }

    // =====================================================
    // HOVER
    // =====================================================

    if root.hovered: Rectangle {
        x: 0;
        y: 0;

        width: parent.width;
        height: parent.height;

        background: transparent;

        border-width: 1px;
        border-color: root.note-color;

        opacity: 0.08;
    }
}