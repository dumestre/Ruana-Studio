import { Theme } from "../theme.slint";
import { TimelineRuler } from "../components/ruler.slint";
import { TrackRow } from "track_row.slint";
import { ClipData } from "clip_data.slint";
import { PlayheadOverlay } from "playhead.slint";

export component Timeline inherits Rectangle {

    // =====================================================
    // SELEÇÃO
    // =====================================================

    in-out property <int> selected-track: 0;
    in-out property <int> selected-clip: -1;


    // =====================================================
    // TRANSPORTE / ZOOM
    //
    // current-time-seconds: TEMPO CONTÍNUO em segundos (fonte
    // da Playhead). bpm/beats-per-bar: só o GRID MUSICAL.
    // =====================================================

    in property <float> current-time-seconds: 0;

    in property <bool> playing: false;

    in-out property <float> zoom: 1.0;

    in-out property <float> zoom-y: 1.0;

    callback zoom-to(float, length);

    // =====================================================
    // SCROLL
    // =====================================================

    in-out property <length> scroll-x: 0px;

    in-out property <length> scroll-y: 0px;

    out property <length> max-scroll-x:
        max(
            0px,
            self.content-width - self.width
        );

    out property <length> max-scroll-y:
        max(
            0px,
            self.ruler-height + self.tracks-height - self.height
        );


    // =====================================================
    // TRACKS
    // =====================================================

    in property <[string]> track-names: [];


    // =====================================================
    // FERRAMENTA
    // =====================================================

    in-out property <int> active-tool: 0;


    // =====================================================
    // CLIPS
    // =====================================================

    in property <[ClipData]> clips: [];

    in property <int> drag-clip-id: -1;
    in property <int> drag-track-offset: 0;


    // =====================================================
    // PREVIEW DE DROP (arrasto do ClipPool)
    //
    // Mostra onde o clip vai cair: slot translúcido com uma
    // linha sólida na borda esquerda (na linha da grid do
    // snap), apenas na track sob o cursor.
    // =====================================================

    in property <bool> drop-visible: false;

    in property <length> drop-x: 0px;

    in property <int> drop-track: 0;

    in property <float> drop-len-beats: 4.0;


    // =====================================================
    // CALLBACKS
    // =====================================================

    callback select-track(int);
    callback seek-to(float);
    callback clip-selected(int);
    callback clip-slice-requested(int, float);
    callback clip-glue-requested(int);
    callback glue-clip-at(float, length, length, length) -> int;
    callback clip-move-started(int, float);
    callback clip-move-delta(int, float, int);
    callback clip-move-finished(int);

    callback clip-resize-started(int, int);
    callback clip-resize-delta(int, int, float);
    callback clip-resize-finished(int);
    callback clip-delete-requested(int);
    callback clip-rename-requested(int, string);
    callback clip-color-cycle-requested(int);


    // =====================================================
    // ESCALA
    // =====================================================

    out property <length> px-per-beat:
        40px * self.zoom;

    property <length> px-per-bar:
        self.px-per-beat * self.beats-per-bar;

    // Métrica musical — projetada do core pelo Rust (fonte única,
    // sem hardcodes). Os loops de grid/régua iteram total-bars.
    in property <int> total-bars: 32;

    in property <int> beats-per-bar: 4;

    in property <int> bpm: 120;


    // =====================================================
    // DIMENSÕES
    // =====================================================

    out property <length> ruler-height: 30px;

    out property <length> row-height:
        64px * self.zoom-y;


    // =====================================================
    // TRACK COUNT
    // =====================================================

    property <int> track-count:
        self.track-names.length;


    // =====================================================
    // LARGURA
    // =====================================================

    property <length> timeline-width:
        self.total-bars * self.px-per-bar;

    property <length> content-width:
        self.timeline-width + 80px;


    // =====================================================
    // ALTURA
    // =====================================================

    property <length> tracks-height:
        self.track-count * self.row-height;


    // =====================================================
    // PLAYHEAD X — TEMPO CONTÍNUO (SEGUNDOS → PIXELS)
    //
    // seconds_per_beat = 60 / bpm
    // pixels_per_second = pixels_per_beat / seconds_per_beat
    // playhead_x = current_time_seconds * pixels_per_second
    //
    // Movimento contínuo: NÃO quantiza em beat, NÃO usa snap,
    // NÃO espera o próximo beat. O BPM só define ONDE ficam as
    // linhas do grid; a agulha desliza por tempo real.
    // =====================================================

    property <float> seconds-per-beat:
        60.0 / root.bpm;

    property <length> pixels-per-second:
        root.px-per-beat / root.seconds-per-beat;

    property <length> playhead-x:
        root.current-time-seconds * root.pixels-per-second;


    // =====================================================
    // BARRAS
    //
    // Os loops de grid/régua iteram `total-bars` direto
    // (for i in root.total-bars) — sem array hardcoded.
    // =====================================================


    // =====================================================
    // FUNDO
    // =====================================================

    background:
        Theme.base;


    // =====================================================
    // ÁREA DA TIMELINE
    // =====================================================

    Rectangle {

        x: 0;
        y: 0;

        width: parent.width;
        height: parent.height;

        clip: true;


        // =================================================
        // ZOOM / PAN (WHEEL)
        //
        // Camada mais baixa: recebe os eventos de wheel
        // que nenhum elemento acima consumir.
        //
        // Ctrl + wheel   ou botão do meio + wheel → zoom H
        // Alt  + wheel                          → zoom V
        // wheel simples                         → pan
        // =================================================

        zoom-pan-area := TouchArea {

            x: 0;
            y: 0;

            width:
                parent.width;

            height:
                parent.height;

            property <bool> middle-pressed: false;
            property <bool> dragging: false;
            property <length> drag-start-x: 0px;
            property <length> drag-start-y: 0px;
            property <length> drag-start-scroll-x: 0px;
            property <length> drag-start-scroll-y: 0px;

            clicked => {
                if root.active-tool == 0 {
                    root.selected-clip = -1;
                }
            }

            pointer-event(event) => {

                if event.kind == PointerEventKind.down
                    && event.button == PointerEventButton.middle {

                    self.middle-pressed = true;
                    self.dragging = true;
                    self.drag-start-x = self.mouse-x;
                    self.drag-start-y = self.mouse-y;
                    self.drag-start-scroll-x = root.scroll-x;
                    self.drag-start-scroll-y = root.scroll-y;
                }

                else if event.kind == PointerEventKind.up
                    && event.button == PointerEventButton.middle {

                    self.middle-pressed = false;
                    self.dragging = false;
                }

                else if event.kind == PointerEventKind.move
                    && self.dragging {

                    root.scroll-x = max(0px, min(root.max-scroll-x,
                        self.drag-start-scroll-x - (self.mouse-x - self.drag-start-x)
                    ));
                    root.scroll-y = max(0px, min(root.max-scroll-y,
                        self.drag-start-scroll-y - (self.mouse-y - self.drag-start-y)
                    ));
                }
            }

            scroll-event(event) => {

                let dz =
                    event.delta-x
                    + event.delta-y;

                if event.modifiers.control
                    || (
                        self.middle-pressed
                        && !event.modifiers.alt
                    ) {

                    let old-zoom = root.zoom;
                    let factor = dz > 0px ? 0.96 : 1.04;
                    let new-zoom = max(0.5, min(4.0, old-zoom * factor));

                    let mouse-x = self.mouse-x;
                    let content-x = (mouse-x + root.scroll-x) / old-zoom;
                    let new-scroll-x = content-x * new-zoom - mouse-x;

                    root.zoom = new-zoom;
                    root.scroll-x = max(0px, min(root.max-scroll-x, new-scroll-x));

                } else if event.modifiers.shift {

                    root.scroll-x =
                        max(
                            0px,
                            min(
                                root.max-scroll-x,
                                root.scroll-x - event.delta-y
                            )
                        );

                } else if event.modifiers.alt {

                    root.zoom-y =
                        max(
                            0.4,
                            min(
                                3.0,
                                root.zoom-y
                                * (
                                    dz > 0px
                                        ? 0.96
                                        : 1.04
                                )
                            )
                        );

                    root.scroll-x =
                        min(
                            root.scroll-x,
                            root.max-scroll-x
                        );

                    root.scroll-y =
                        min(
                            root.scroll-y,
                            root.max-scroll-y
                        );

                } else {

                    root.scroll-x =
                        max(
                            0px,
                            min(
                                root.max-scroll-x,
                                root.scroll-x
                                - event.delta-x
                            )
                        );

                    root.scroll-y =
                        max(
                            0px,
                            min(
                                root.max-scroll-y,
                                root.scroll-y
                                - event.delta-y
                            )
                        );
                }

                accept
            }
        }


        // =================================================
        // CONTEÚDO
        // =================================================

        Rectangle {

            x:
                -root.scroll-x;

            y:
                -root.scroll-y;

            width:
                root.content-width;

            height:
                max(
                    root.ruler-height + root.tracks-height,
                    parent.height
                );

            background:
                Theme.base;


            // =============================================
            // RÉGUA
            // =============================================

            TimelineRuler {

                x: 0;
                y: 0;

                width:
                    root.timeline-width;

                height:
                    root.ruler-height;

                ruler-height:
                    root.ruler-height;

                total-bars: root.total-bars;
                beats-per-bar: root.beats-per-bar;

                px-per-bar:
                    root.px-per-bar;

                scroll-x:
                    root.scroll-x;

                seek-to-beat(beat) => {
                    root.seek-to(beat);
                }

                z: 5;
            }


            // =============================================
            // FUNDO ALTERNADO POR COMPASSO (igual ao beat sequencer)
            // =============================================

            for i in root.total-bars: Rectangle {

                x:
                    i * root.px-per-bar;

                y:
                    root.ruler-height;

                width:
                    root.px-per-bar;

                height:
                    parent.height - root.ruler-height;

                background:
                    Math.mod(i, 2) == 1
                        ? Theme.base
                        : Theme.surface;

                z: -1;
            }


            // =============================================
            // GRID VERTICAL — MESMO GRID DA RÉGUA
            //
            // Origem, matemática e zoom idênticos aos da régua:
            // x = i * px-per-bar + k * px-per-beat (+ fração).
            //
            // COMPASSOS: cor alterna a cada compasso.
            // BATIDAS / 1/8 / 1/16: densidade segue o zoom.
            // O grid é referência VISUAL — a Playhead não o usa.
            // =============================================

            for i in root.total-bars: Rectangle {

                // ---- LINHA DO COMPASSO ----

                x:
                    i * root.px-per-bar;

                y:
                    root.ruler-height;

                width: 1px;

                height:
                    parent.height - root.ruler-height;

                background:
                    Math.mod(i, 2) == 1
                        ? Theme.border
                        : Theme.border.transparentize(0.45);

                z: 0;

                // ---- BATIDAS (k = 0 é a própria linha do compasso) ----

                for k in root.beats-per-bar: Rectangle {

                    visible:
                        k > 0 && root.px-per-bar >= 40px;

                    x:
                        i * root.px-per-bar
                        + k * root.px-per-beat;

                    y:
                        root.ruler-height;

                    width: 1px;

                    height:
                        parent.height - root.ruler-height;

                    background:
                        Theme.border.transparentize(0.6);

                    z: 0;
                }

                // ---- SUBDIVISÃO 1/8 (meio da batida) ----

                for k in root.beats-per-bar: Rectangle {

                    visible:
                        root.px-per-bar >= 120px;

                    x:
                        i * root.px-per-bar
                        + k * root.px-per-beat
                        + root.px-per-beat * 0.5;

                    y:
                        root.ruler-height;

                    width: 1px;

                    height:
                        parent.height - root.ruler-height;

                    background:
                        Theme.border.transparentize(0.7);

                    z: 0;
                }

                // ---- SUBDIVISÃO 1/16 (1/4 da batida) ----

                for k in root.beats-per-bar: Rectangle {

                    visible:
                        root.px-per-bar >= 240px;

                    x:
                        i * root.px-per-bar
                        + k * root.px-per-beat
                        + root.px-per-beat * 0.25;

                    y:
                        root.ruler-height;

                    width: 1px;

                    height:
                        parent.height - root.ruler-height;

                    background:
                        Theme.border.transparentize(0.8);

                    z: 0;
                }

                // ---- SUBDIVISÃO 1/16 (3/4 da batida) ----

                for k in root.beats-per-bar: Rectangle {

                    visible:
                        root.px-per-bar >= 240px;

                    x:
                        i * root.px-per-bar
                        + k * root.px-per-beat
                        + root.px-per-beat * 0.75;

                    y:
                        root.ruler-height;

                    width: 1px;

                    height:
                        parent.height - root.ruler-height;

                    background:
                        Theme.border.transparentize(0.8);

                    z: 0;
                }
            }

            // =============================================
            // TRACKS
            // =============================================

            VerticalLayout {

                x: 0;

                y:
                    root.ruler-height;

                width:
                    root.timeline-width;

                height:
                    root.tracks-height;

                alignment:
                    LayoutAlignment.stretch;

                spacing: 0;


                for name[index] in root.track-names: TrackRow {

                    width:
                        root.timeline-width;

                    height:
                        root.row-height;

                    track-index:
                        index;

                    selected-track:
                        index == root.selected-track;

                    selected-clip:
                        root.selected-clip;

                    clips:
                        root.clips;

                    px-per-beat:
                        root.px-per-beat;

                    px-per-bar:
                        root.px-per-bar;

                    row-height:
                        root.row-height;

                    total-bars: root.total-bars;
                    beats-per-bar: root.beats-per-bar;

                    active-tool:
                        root.active-tool;

                    drag-clip-id:
                        root.drag-clip-id;

                    drag-track-offset:
                        root.drag-track-offset;


                    clip-selected(id) => {

                        if root.active-tool == 0 {

                            root.selected-clip =
                                id;

                            root.clip-selected(
                                id
                            );
                        }
                    }


                    slice-requested(
                        id,
                        position
                    ) => {

                        root.clip-slice-requested(
                            id,
                            position
                        );
                    }

                    clip-move-started(id, beat) => {
                        root.clip-move-started(id, beat);
                    }

                    clip-move-delta(id, delta_beats, delta_tracks) => {
                        root.clip-move-delta(id, delta_beats, delta_tracks);
                    }

                    clip-move-finished(id) => {
                        root.clip-move-finished(id);
                    }

                    clip-resize-started(id, side) => {
                        root.clip-resize-started(id, side);
                    }

                    clip-resize-delta(id, side, delta) => {
                        root.clip-resize-delta(id, side, delta);
                    }

                    clip-resize-finished(id) => {
                        root.clip-resize-finished(id);
                    }

                    clip-delete-requested(id) => {
                        root.clip-delete-requested(id);
                    }

                    clip-rename-requested(id, new_name) => {
                        root.clip-rename-requested(id, new_name);
                    }

                    clip-color-cycle-requested(id) => {
                        root.clip-color-cycle-requested(id);
                    }
                }
            }


            // =============================================
            // PREVIEW DE DROP
            //
            // Desenhado sobre os tracks (z: 8): mostra o slot
            // do clip na track sob o cursor, com a linha da
            // grid onde o snap vai acontecer.
            // =============================================

            Rectangle {

                visible:
                    root.drop-visible;

                x:
                    root.drop-x;

                y:
                    root.ruler-height
                    + root.drop-track * root.row-height;

                width:
                    root.drop-len-beats
                    * root.px-per-beat;

                height:
                    root.row-height;

                background:
                    Theme.accent.transparentize(0.85);

                z: 8;

                // Linha da grid do snap (borda esquerda)
                Rectangle {

                    x: 0;
                    y: 0;

                    width: 2px;

                    height: parent.height;

                    background:
                        Theme.accent;

                    z: 1;
                }
            }


            // =============================================
            // PLAYHEAD
            //
            // DENTRO do content rectangle para scrollar
            // junto com o conteúdo. Os 3 elementos (linha,
            // régua e cabeça) vivem em playhead.slint.
            // =============================================

            PlayheadOverlay {
                head-x: root.playhead-x;
                ruler-h: root.ruler-height;
                tracks-h: root.tracks-height;
                z: 120;
            }
        }
    }



    // =====================================================
    // CURSORES
    // =====================================================

    tool-cursor := TouchArea {

        x: 0;
        y: 0;

        width:
            parent.width;

        height:
            parent.height;

        enabled:
            root.active-tool == 2
            || root.active-tool == 3
            || root.active-tool == 4
            || root.active-tool == 5;

        mouse-cursor:
            root.active-tool == 2
                ? MouseCursor.crosshair
                : root.active-tool == 3
                    ? MouseCursor.ew-resize
                    : root.active-tool == 4
                        ? MouseCursor.crosshair
                        : root.active-tool == 5
                            ? MouseCursor.crosshair
                            : MouseCursor.default;

        z: 200;

        pointer-event(event) => {
            if root.active-tool == 2 && event.kind == PointerEventKind.down {
                let row = (self.mouse-y - (root.ruler-height - root.scroll-y)) / root.row-height;
                let id = root.glue-clip-at(row, self.mouse-x, root.scroll-x, root.px-per-beat);
                if id >= 0 {
                    root.clip-glue-requested(id);
                }
            }
        }
    }


    // =====================================================
    // FOLLOW PLAYHEAD: mantém o playhead visível durante
    // playback. Quando ele sai da área visível, rola a
    // viewport para acompanhar (estilo DAW padrão).
    // =====================================================

    Timer {
        interval: 16ms;
        running: root.playing;

        triggered() => {
            let px = root.playhead-x;
            let visible-left = root.scroll-x;
            let visible-right = root.scroll-x + root.width;
            let margin = root.width * 0.1;

            // Saiu pela direita → centraliza um pouco à direita
            if px > visible-right - margin {
                root.scroll-x = min(
                    root.max-scroll-x,
                    px - root.width * 0.3
                );
            }
            // Saiu pela esquerda → volta a ver
            else if px < visible-left + margin {
                root.scroll-x = max(0px, px - root.width * 0.3);
            }
        }
    }
}