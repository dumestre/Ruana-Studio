
import { Theme } from "../theme.slint";
import { TimelineRuler } from "../components/ruler.slint";
import { TrackRow } from "track_row.slint";
import { ClipDragOverlay } from "clip_drag/clip_drag_overlay.slint";
import { ClipData } from "clip_data.slint";
import { PlayheadOverlay } from "playhead.slint";
import { ClipDragState } from "clip_drag/clip_drag_state.slint";

export component Timeline inherits Rectangle {

    // =====================================================
    // SELEÇÃO
    // =====================================================

    in-out property <int> selected-track: 0;
    in-out property <int> selected-clip: -1;


    // =====================================================
    // MARQUEE
    // =====================================================

    callback marquee-select(float, float, float, float);

    callback keyboard-focus-requested();

    callback multi-delete-requested();


    // =====================================================
    // TRANSPORTE / ZOOM
    // =====================================================

    in property <float> current-time-seconds: 0;

    in property <bool> playing: true;

    in-out property <float> zoom: 1.0;

    in-out property <float> zoom-y: 1.0;

    in-out property <bool> loop-enabled: false;

    in-out property <float> loop-start-beat: 0.0;

    in-out property <float> loop-end-beat: 16.0;

    callback zoom-to(float, length);


    // =====================================================
    // SCROLL / ZOOM
    // =====================================================

    callback scroll-input(
        float,
        float,
        bool,
        bool,
        bool,
        float,
        float
    );


    // =====================================================
    // SCROLL
    // =====================================================

    in-out property <length> scroll-x: 0px;

    in-out property <length> scroll-y: 0px;


    out property <length> max-scroll-x:
        max(
            0px,
            self.content-width - self.width
        );


    out property <length> max-scroll-y:
        max(
            0px,
            self.ruler-height
            + self.tracks-height
            - self.height
        );


    // =====================================================
    // TRACKS
    // =====================================================

    in property <[string]> track-names: [];


    // =====================================================
    // FERRAMENTA
    // =====================================================

    in-out property <int> active-tool: 0;


    // =====================================================
    // CLIPS
    // =====================================================

    in property <[ClipData]> clips: [];


    // =====================================================
    // PREVIEW DE DROP
    // =====================================================

    in property <bool> drop-visible: false;

    in property <length> drop-x: 0px;

    in property <int> drop-track: 0;

    in property <float> drop-len-beats: 4.0;


    // =====================================================
    // CALLBACKS
    // =====================================================

    callback select-track(int);

    callback seek-to(float);

    callback clip-selected(int);

    callback clip-slice-requested(int, float);

    callback clip-glue-requested(int);

    callback glue-clip-at(float, length, length, length) -> int;

    callback clip-move-committed(
        int,
        int,
        float
    );

    callback clip-resize-committed(
        int,
        int,
        float,
        float
    );

    callback clip-delete-requested(int);

    callback clip-rename-requested(int, string);

    callback clip-color-cycle-requested(int);

    callback clip-copy-requested(int);

    callback piano-roll-open-requested(int);

    callback clip-fade-committed(
        int,
        float,
        float
    );

    callback clip-gain-committed(
        int,
        float
    );

    callback paste-requested(float, int);

    callback pencil-created(float, int, float);


    // =====================================================
    // ESCALA
    // =====================================================

    out property <length> px-per-beat:
        40px * self.zoom;


    property <length> px-per-bar:
        self.px-per-beat
        * self.beats-per-bar;


    // =====================================================
    // MÉTRICA MUSICAL
    // =====================================================

    in property <int> total-bars: 32;

    in property <int> beats-per-bar: 4;

    in property <int> bpm: 120;


    // =====================================================
    // FOLLOW PLAYHEAD
    // =====================================================

    in property <bool> follow-playhead: true;


    // =====================================================
    // DIMENSÕES
    // =====================================================

    out property <length> ruler-height: 25px;


    out property <length> row-height:
        64px * self.zoom-y;


    // =====================================================
    // TRACK COUNT
    // =====================================================

    property <int> track-count:
        self.track-names.length;


    // =====================================================
    // PADDING DA ORIGEM
    //
    // Este mesmo padding é utilizado por:
    //
    // - conteúdo
    // - régua
    // - playhead
    //
    // Portanto todos começam exatamente no mesmo X.
    // =====================================================

    in-out property <length> timeline-left-padding: 0px;


    // =====================================================
    // LARGURA
    // =====================================================

    property <length> timeline-width:
        max(
            200 * 1px * self.px-per-bar / 1px,
            self.total-bars * self.px-per-bar
        );


    property <length> content-width:
        self.timeline-left-padding
        + self.timeline-width
        + 80px;


    // =====================================================
    // ALTURA
    // =====================================================

    property <length> tracks-height:
        self.track-count
        * self.row-height;


    // =====================================================
    // PLAYHEAD
    // =====================================================

    property <float> seconds-per-beat:
        60.0 / root.bpm;


    property <length> pixels-per-second:
        root.px-per-beat
        / root.seconds-per-beat;


    // =====================================================
    // POSIÇÃO DO PLAYHEAD
    //
    // Já inclui os 4px do padding.
    // NÃO adicionar padding novamente.
    // =====================================================

    property <length> playhead-x:
        root.timeline-left-padding
        + root.current-time-seconds
        * root.pixels-per-second;


    // =====================================================
    // SCRUB
    // =====================================================

    property <length> scrub-x:
        scrub-source.scrubbing
            ? scrub-source.live-mouse-x
              - root.timeline-left-padding
              + root.scroll-x
            : -1px;


    property <length> last-scrub-x:
        0px;


    changed scrub-x => {

        if root.scrub-x >= 0px {

            root.last-scrub-x =
                root.scrub-x;
        }
    }


    property <bool> use-scrub-pos:
        root.scrub-x < 0px
        && !root.playing
        && (
            root.playhead-x
            - root.last-scrub-x
        ).abs() > 2px;


    property <length> effective-playhead-x:
        root.scrub-x >= 0px
            ? root.scrub-x
            : root.use-scrub-pos
                ? root.last-scrub-x
                : root.playhead-x;


    // =====================================================
    // FUNDO
    // =====================================================

    background: transparent;


    // =====================================================
    // ÁREA PRINCIPAL
    // =====================================================

    Rectangle {

        x: 0;

        y: 0;

        width:
            parent.width;

        height:
            parent.height;

        border-radius: 6px;

        clip: true;


        // =================================================
        // INPUT / PAN / ZOOM
        // =================================================

        zoom-pan-area := TouchArea {

            x: 0;

            y: 0;

            width:
                parent.width;

            height:
                parent.height;


            property <bool> middle-pressed:
                false;


            property <bool> dragging:
                false;


            property <length> drag-start-x:
                0px;


            property <length> drag-start-y:
                0px;


            property <length> drag-start-scroll-x:
                0px;


            property <length> drag-start-scroll-y:
                0px;


            property <bool> left-pressed:
                false;


            property <bool> shift-pressed:
                false;


            property <bool> pencil-drawing:
                false;


            property <float> pencil-start-beat:
                0.0;


            property <int> pencil-track:
                -1;


            // =============================================
            // POINTER
            // =============================================

            pointer-event(event) => {

                // -----------------------------------------
                // CANCEL
                // -----------------------------------------

                if event.kind
                        == PointerEventKind.cancel {

                    ClipDragState.marquee-active =
                        false;

                    self.left-pressed =
                        false;

                    self.middle-pressed =
                        false;

                    self.dragging =
                        false;
                }


                // -----------------------------------------
                // MARQUEE MOVE
                // -----------------------------------------

                if event.kind
                        == PointerEventKind.move
                        && ClipDragState.marquee-active {

                    ClipDragState.marquee-x1 =
                        self.mouse-x
                        + root.scroll-x;

                    ClipDragState.marquee-y1 =
                        self.mouse-y
                        + root.scroll-y;

                    return;
                }


                // -----------------------------------------
                // LEFT CLICK
                // -----------------------------------------

                if event.button
                        == PointerEventButton.left {

                    if event.kind
                            == PointerEventKind.down {

                        self.left-pressed =
                            true;


                        root.keyboard-focus-requested();


                        // CTRL = MARQUEE

                        if event.modifiers.control {

                            ClipDragState.marquee-active =
                                true;


                            ClipDragState.marquee-x0 =
                                self.mouse-x
                                + root.scroll-x;


                            ClipDragState.marquee-y0 =
                                self.mouse-y
                                + root.scroll-y;


                            ClipDragState.marquee-x1 =
                                ClipDragState.marquee-x0;


                            ClipDragState.marquee-y1 =
                                ClipDragState.marquee-y0;

                        } else if root.active-tool == 4 {

                            // LÁPIS: começa a desenhar um clip MIDI.
                            // Não altera a seleção.

                            self.pencil-drawing =
                                true;


                            self.pencil-start-beat =
                                (
                                    self.mouse-x
                                    + root.scroll-x
                                    - root.timeline-left-padding
                                )
                                / root.px-per-beat;


                            self.pencil-track =
                                Math.max(
                                    0,
                                    Math.floor(
                                        (
                                            self.mouse-y
                                            + root.scroll-y
                                            - root.ruler-height
                                        )
                                        / root.row-height
                                    )
                                );

                        } else {

                            root.selected-clip =
                                -1;
                        }
                    }


                    else if event.kind
                                == PointerEventKind.up
                            && self.left-pressed {

                        self.left-pressed =
                            false;


                        self.shift-pressed =
                            event.modifiers.shift;


                        // ---------------------------------
                        // LÁPIS (clip MIDI desenhado)
                        // ---------------------------------

                        if self.pencil-drawing {

                            self.pencil-drawing =
                                false;


                            let end-beat =
                                (
                                    self.mouse-x
                                    + root.scroll-x
                                    - root.timeline-left-padding
                                )
                                / root.px-per-beat;


                            let track =
                                self.pencil-track;


                            let start =
                                min(
                                    self.pencil-start-beat,
                                    end-beat
                                );


                            let len =
                                max(
                                    0.25,
                                    abs(
                                        end-beat
                                        - self.pencil-start-beat
                                    )
                                );


                            root.selected-clip =
                                -1;


                            if track >= 0
                                && start >= 0.0 {

                                self.pencil-track =
                                    -1;


                                root.pencil-created(
                                    start,
                                    track,
                                    len
                                );
                            }


                            return;
                        }


                        // ---------------------------------
                        // MARQUEE
                        // ---------------------------------

                        if ClipDragState.marquee-active {

                            ClipDragState.marquee-active =
                                false;


                            if (
                                ClipDragState.marquee-x1
                                != ClipDragState.marquee-x0
                            )
                            ||
                            (
                                ClipDragState.marquee-y1
                                != ClipDragState.marquee-y0
                            ) {

                                let bx0 =
                                    min(
                                        ClipDragState.marquee-x0,
                                        ClipDragState.marquee-x1
                                    )
                                    / root.px-per-beat;


                                let bx1 =
                                    max(
                                        ClipDragState.marquee-x0,
                                        ClipDragState.marquee-x1
                                    )
                                    / root.px-per-beat;


                                let ty0 =
                                    Math.floor(
                                        (
                                            min(
                                                ClipDragState.marquee-y0,
                                                ClipDragState.marquee-y1
                                            )
                                            - root.ruler-height
                                        )
                                        / root.row-height
                                    );


                                let ty1 =
                                    Math.floor(
                                        (
                                            max(
                                                ClipDragState.marquee-y0,
                                                ClipDragState.marquee-y1
                                            )
                                            - root.ruler-height
                                        )
                                        / root.row-height
                                    );


                                root.marquee-select(
                                    max(0.0, bx0),
                                    bx1,
                                    max(0, ty0),
                                    ty1
                                );

                                return;
                            }
                        }


                        // ---------------------------------
                        // CLIQUE EM ÁREA VAZIA
                        // ---------------------------------

                        if root.active-tool == 0 {

                            let content-y =
                                self.mouse-y
                                + root.scroll-y;


                            let track =
                                Math.floor(
                                    (
                                        content-y
                                        - root.ruler-height
                                    )
                                    / root.row-height
                                );


                            if track >= 0 {

                                let content-x =
                                    self.mouse-x
                                    + root.scroll-x
                                    - root.timeline-left-padding;


                                let beat =
                                    content-x
                                    / root.px-per-beat;


                                if self.shift-pressed {

                                    root.paste-requested(
                                        max(0.0, beat),
                                        track
                                    );
                                }
                            }
                        }
                    }
                }


                // =========================================
                // MIDDLE DOWN
                // =========================================

                if event.kind
                        == PointerEventKind.down
                    && event.button
                        == PointerEventButton.middle {

                    self.middle-pressed =
                        true;


                    self.dragging =
                        true;


                    self.drag-start-x =
                        self.mouse-x;


                    self.drag-start-y =
                        self.mouse-y;


                    self.drag-start-scroll-x =
                        root.scroll-x;


                    self.drag-start-scroll-y =
                        root.scroll-y;
                }


                // =========================================
                // MIDDLE UP
                // =========================================

                else if event.kind
                            == PointerEventKind.up
                        && event.button
                            == PointerEventButton.middle {

                    self.middle-pressed =
                        false;

                    self.dragging =
                        false;
                }


                // =========================================
                // MIDDLE MOVE
                // =========================================

                else if event.kind
                            == PointerEventKind.move
                        && self.dragging {

                    root.scroll-x =
                        max(
                            0px,
                            min(
                                root.max-scroll-x,
                                self.drag-start-scroll-x
                                - (
                                    self.mouse-x
                                    - self.drag-start-x
                                )
                            )
                        );


                    root.scroll-y =
                        max(
                            0px,
                            min(
                                root.max-scroll-y,
                                self.drag-start-scroll-y
                                - (
                                    self.mouse-y
                                    - self.drag-start-y
                                )
                            )
                        );
                }
            }


            // =================================================
            // SCROLL
            // =================================================

            scroll-event(event) => {

                let dx =
                    event.delta-x / 1px;


                let dy =
                    event.delta-y / 1px;


                root.scroll-input(
                    dx,
                    dy,

                    event.modifiers.control
                        || (
                            self.middle-pressed
                            && !event.modifiers.alt
                        ),

                    event.modifiers.shift,

                    event.modifiers.alt,

                    self.mouse-x / 1px,

                    self.mouse-y / 1px
                );


                accept;
            }
        }


        // =================================================
        // CONTEÚDO SCROLLÁVEL
        //
        // A régua NÃO está aqui.
        //
        // Este bloco é o único que recebe scroll-y.
        // =================================================

        Rectangle {

            x:
                root.timeline-left-padding
                - root.scroll-x;


            y:
                -root.scroll-y;


            width:
                root.timeline-width
                + 80px;


            height:
                max(
                    root.ruler-height
                    + root.tracks-height,
                    parent.height
                );


            background:
                transparent;


            // =============================================
            // FUNDO ALTERNADO
            // =============================================

            for i in root.total-bars: Rectangle {

                x:
                    i * root.px-per-bar;


                y:
                    root.ruler-height;


                width:
                    root.px-per-bar;


                height:
                    parent.height
                    - root.ruler-height;


                background:
                    Math.mod(i, 2) == 1
                        ? Theme.surface-high
                        : Theme.surface-step;


                z: -1;
            }


            // =============================================
            // GRID VERTICAL
            // =============================================

            for i in root.total-bars: Rectangle {

                x:
                    i * root.px-per-bar;


                y:
                    root.ruler-height;


                width:
                    root.px-per-bar;


                height:
                    parent.height
                    - root.ruler-height;


                z: 0;


                // -----------------------------------------
                // LINHA DO COMPASSO
                // -----------------------------------------

                Rectangle {

                    x: 0;

                    y: 0;

                    width: 1px;

                    height:
                        parent.height;


                    background:
                        Math.mod(i, 2) == 1
                            ? (
                                Theme.is-paper
                                    ? Theme.base
                                    : Theme.grid-line
                              )
                            : (
                                Theme.is-paper
                                    ? Theme.base
                                    : Theme.grid-line
                              ).transparentize(0.45);
                }


                // -----------------------------------------
                // BATIDAS
                // -----------------------------------------

                for k in root.beats-per-bar: Rectangle {

                    visible:
                        k > 0
                        && root.px-per-bar >= 40px;


                    x:
                        k * root.px-per-beat;


                    y: 0;

                    width: 1px;


                    height:
                        parent.height;


                    background:
                        Theme.is-paper
                            ? Theme.base.transparentize(0.6)
                            : Theme.grid-line.transparentize(0.6);
                }


                // -----------------------------------------
                // 1/8
                // -----------------------------------------

                for k in root.beats-per-bar: Rectangle {

                    visible:
                        root.px-per-bar >= 120px;


                    x:
                        k * root.px-per-beat
                        + root.px-per-beat * 0.5;


                    y: 0;

                    width: 1px;


                    height:
                        parent.height;


                    background:
                        Theme.is-paper
                            ? Theme.base.transparentize(0.7)
                            : Theme.grid-line.transparentize(0.7);
                }


                // -----------------------------------------
                // 1/16 — 1/4
                // -----------------------------------------

                for k in root.beats-per-bar: Rectangle {

                    visible:
                        root.px-per-bar >= 240px;


                    x:
                        k * root.px-per-beat
                        + root.px-per-beat * 0.25;


                    y: 0;

                    width: 1px;


                    height:
                        parent.height;


                    background:
                        Theme.is-paper
                            ? Theme.base.transparentize(0.8)
                            : Theme.grid-line.transparentize(0.8);
                }


                // -----------------------------------------
                // 1/16 — 3/4
                // -----------------------------------------

                for k in root.beats-per-bar: Rectangle {

                    visible:
                        root.px-per-bar >= 240px;


                    x:
                        k * root.px-per-beat
                        + root.px-per-beat * 0.75;


                    y: 0;

                    width: 1px;


                    height:
                        parent.height;


                    background:
                        Theme.is-paper
                            ? Theme.base.transparentize(0.8)
                            : Theme.grid-line.transparentize(0.8);
                }
            }


            // =============================================
            // TRACKS
            // =============================================

            VerticalLayout {

                x: 0;


                y:
                    root.ruler-height;


                width:
                    root.timeline-width;


                height:
                    root.tracks-height;


                alignment:
                    LayoutAlignment.stretch;


                spacing: 0;


                for name[index] in root.track-names: TrackRow {

                    width:
                        root.timeline-width;


                    height:
                        root.row-height;


                    track-index:
                        index;


                    view-scroll-x:
                        root.scroll-x
                        - root.timeline-left-padding;


                    view-width:
                        root.width;


                    selected-track:
                        index == root.selected-track;


                    selected-clip:
                        root.selected-clip;


                    clips:
                        root.clips;


                    px-per-beat:
                        root.px-per-beat;


                    px-per-bar:
                        root.px-per-bar;


                    row-height:
                        root.row-height;


                    ruler-height:
                        root.ruler-height;


                    track-count:
                        root.track-names.length;


                    total-bars:
                        root.total-bars;


                    beats-per-bar:
                        root.beats-per-bar;


                    active-tool:
                        root.active-tool;


                    // -------------------------------------
                    // CLIP SELECTION
                    // -------------------------------------

                    clip-selected(id) => {

                        if root.active-tool == 0 {

                            root.selected-clip =
                                id;


                            root.clip-selected(
                                id
                            );
                        }
                    }


                    // -------------------------------------
                    // SLICE
                    // -------------------------------------

                    slice-requested(
                        id,
                        position
                    ) => {

                        root.clip-slice-requested(
                            id,
                            position
                        );
                    }


                    // -------------------------------------
                    // MOVE
                    // -------------------------------------

                    clip-move-committed(
                        id,
                        track,
                        beat
                    ) => {

                        root.clip-move-committed(
                            id,
                            track,
                            beat
                        );
                    }


                    // -------------------------------------
                    // RESIZE
                    // -------------------------------------

                    clip-resize-committed(
                        id,
                        side,
                        len,
                        beat
                    ) => {

                        root.clip-resize-committed(
                            id,
                            side,
                            len,
                            beat
                        );
                    }


                    // -------------------------------------
                    // DELETE
                    // -------------------------------------

                    clip-delete-requested(id) => {

                        root.clip-delete-requested(
                            id
                        );
                    }


                    // -------------------------------------
                    // RENAME
                    // -------------------------------------

                    clip-rename-requested(
                        id,
                        new_name
                    ) => {

                        root.clip-rename-requested(
                            id,
                            new_name
                        );
                    }


                    // -------------------------------------
                    // COLOR
                    // -------------------------------------

                    clip-color-cycle-requested(id) => {

                        root.clip-color-cycle-requested(
                            id
                        );
                    }


                    // -------------------------------------
                    // COPY
                    // -------------------------------------

                    clip-copy-requested(id) => {

                        root.clip-copy-requested(
                            id
                        );
                    }


                    // -------------------------------------
                    // PIANO ROLL (clipe MIDI)
                    // -------------------------------------

                    piano-roll-open-requested(id) => {

                        root.piano-roll-open-requested(
                            id
                        );
                    }


                    // -------------------------------------
                    // FADE
                    // -------------------------------------

                    clip-fade-committed(
                        id,
                        fi,
                        fo
                    ) => {

                        root.clip-fade-committed(
                            id,
                            fi,
                            fo
                        );
                    }


                    // -------------------------------------
                    // MARQUEE COMMIT
                    // -------------------------------------

                    marquee-commit(
                        b0,
                        b1,
                        t0,
                        t1
                    ) => {

                        root.marquee-select(
                            b0,
                            b1,
                            t0,
                            t1
                        );
                    }
                }
            }


            // =============================================
            // DROP PREVIEW
            // =============================================

            Rectangle {

                visible:
                    root.drop-visible;


                x:
                    root.drop-x;


                y:
                    root.ruler-height
                    + root.drop-track
                    * root.row-height;


                width:
                    root.drop-len-beats
                    * root.px-per-beat;


                height:
                    root.row-height;


                background:
                    Theme.accent.transparentize(0.85);


                z: 8;


                Rectangle {

                    x: 0;

                    y: 0;

                    width: 2px;

                    height:
                        parent.height;


                    background:
                        Theme.accent;


                    z: 1;
                }
            }


            // =============================================
            // CLIP DRAG OVERLAY
            // =============================================

            ClipDragOverlay {

                px-per-beat:
                    root.px-per-beat;


                row-height:
                    root.row-height;


                ruler-height:
                    root.ruler-height;


                z: 60;
            }
        }


        // =================================================
        // RÉGUA FIXA
        //
        // NÃO recebe scroll-y.
        //
        // O X inicial é exatamente o mesmo padding
        // utilizado pelo conteúdo.
        // =================================================

        scrub-source := TimelineRuler {

            x:
                root.timeline-left-padding;


            y: 0;


            width:
                root.width
                - root.timeline-left-padding;


            height:
                root.ruler-height;


            ruler-height:
                25px;


            viewport-width:
                root.width
                - root.timeline-left-padding;


            total-bars:
                root.total-bars;


            beats-per-bar:
                root.beats-per-bar;


            px-per-bar:
                root.px-per-bar;


            scroll-x:
                root.scroll-x;


            loop-enabled:
                root.loop-enabled;


            loop-start-beat:
                root.loop-start-beat;


            loop-end-beat:
                root.loop-end-beat;


            loop-range-changed(a, b) => {

                root.loop-start-beat =
                    a;


                root.loop-end-beat =
                    b;
            }


            seek-to-beat(beat) => {

                root.seek-to(
                    beat
                );
            }


            // Régua acima do conteúdo.
            z: 150;
        }


        // =================================================
        // PLAYHEAD
        //
        // FICA FORA DO CONTEÚDO SCROLLÁVEL.
        //
        // Portanto:
        //
        // - scroll-y NÃO move a bolha;
        // - scroll-y NÃO move a parte superior;
        // - scroll-x é compensado aqui;
        // - o padding já está dentro de effective-playhead-x.
        // =================================================

        PlayheadOverlay {

            head-x:
                root.effective-playhead-x
                - root.scroll-x;


            ruler-h:
                25px;


            tracks-h:
                root.tracks-height;


            // Acima da régua para a bolha nunca ser escondida.
            z: 180;
        }
    }


    // =====================================================
    // MARQUEE
    // =====================================================

    if ClipDragState.marquee-active: Rectangle {

        x:
            min(
                ClipDragState.marquee-x0,
                ClipDragState.marquee-x1
            )
            - root.scroll-x;


        y:
            min(
                ClipDragState.marquee-y0,
                ClipDragState.marquee-y1
            )
            - root.scroll-y;


        width:
            abs(
                ClipDragState.marquee-x1
                - ClipDragState.marquee-x0
            );


        height:
            abs(
                ClipDragState.marquee-y1
                - ClipDragState.marquee-y0
            );


        border-width:
            1px;


        border-color:
            Theme.accent;


        background:
            Theme.accent.transparentize(0.85);


        z: 200;
    }


    // =====================================================
    // CURSOR ESPECIAL
    // =====================================================

    tool-cursor := TouchArea {

        x: 0;

        y: 0;

        width:
            parent.width;

        height:
            parent.height;


        enabled:
            root.active-tool == 2
            || root.active-tool == 3
            || root.active-tool == 4
            || root.active-tool == 5;


        mouse-cursor:
            root.active-tool == 2
                ? MouseCursor.crosshair

            : root.active-tool == 3
                ? MouseCursor.ew-resize

            : root.active-tool == 4
                ? MouseCursor.crosshair

            : root.active-tool == 5
                ? MouseCursor.crosshair

            : MouseCursor.default;


        z: 250;


        pointer-event(event) => {

            if root.active-tool == 2
                && event.kind
                    == PointerEventKind.down {

                let row =
                    (
                        self.mouse-y
                        - (
                            root.ruler-height
                            - root.scroll-y
                        )
                    )
                    / root.row-height;


                let id =
                    root.glue-clip-at(
                        row,
                        self.mouse-x,
                        root.scroll-x,
                        root.px-per-beat
                    );


                if id >= 0 {

                    root.clip-glue-requested(
                        id
                    );
                }
            }
        }
    }


    // =====================================================
    // FOLLOW PLAYHEAD
    // =====================================================

    Timer {

        interval: 8ms;


        running:
            root.playing
            && root.follow-playhead;


        triggered() => {

            let px =
                root.playhead-x;


            let width =
                root.width;


            let margin =
                width * 0.12;


            let visible-right =
                root.scroll-x
                + width;


            // ---------------------------------------------
            // DIREITA
            // ---------------------------------------------

            if px >
                visible-right - margin {

                root.scroll-x =
                    min(
                        max(
                            0px,
                            px
                            - (width - margin)
                        ),
                        root.max-scroll-x
                    );
            }


            // ---------------------------------------------
            // ESQUERDA
            // ---------------------------------------------

            else if px <
                root.scroll-x + margin {

                root.scroll-x =
                    min(
                        max(
                            0px,
                            px
                            - margin
                        ),
                        root.max-scroll-x
                    );
            }
        }
    }
}