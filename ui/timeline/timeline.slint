import { Theme } from "../theme.slint";
import { TimelineRuler } from "../components/ruler.slint";
import { TrackRow } from "track_row.slint";
import { ClipDragOverlay } from "clip_drag/clip_drag_overlay.slint";
import { ClipData } from "clip_data.slint";
import { PlayheadOverlay } from "playhead.slint";

export component Timeline inherits Rectangle {

    // =====================================================
    // SELEÇÃO
    // =====================================================

    in-out property <int> selected-track: 0;
    in-out property <int> selected-clip: -1;


    // =====================================================
    // TRANSPORTE / ZOOM
    // =====================================================

    in property <float> current-time-seconds: 0;

    in property <bool> playing: false;

    in-out property <float> zoom: 1.0;

    in-out property <float> zoom-y: 1.0;

    callback zoom-to(float, length);


    // =====================================================
    // SCROLL
    // =====================================================

    in-out property <length> scroll-x: 0px;

    in-out property <length> scroll-y: 0px;

    out property <length> max-scroll-x:
        max(
            0px,
            self.content-width - self.width
        );

    out property <length> max-scroll-y:
        max(
            0px,
            self.ruler-height + self.tracks-height - self.height
        );


    // =====================================================
    // TRACKS
    // =====================================================

    in property <[string]> track-names: [];


    // =====================================================
    // FERRAMENTA
    // =====================================================

    in-out property <int> active-tool: 0;


    // =====================================================
    // CLIPS
    // =====================================================

    in property <[ClipData]> clips: [];


    // =====================================================
    // PREVIEW DE DROP
    // =====================================================

    in property <bool> drop-visible: false;

    in property <length> drop-x: 0px;

    in property <int> drop-track: 0;

    in property <float> drop-len-beats: 4.0;


    // =====================================================
    // CALLBACKS
    // =====================================================

    callback select-track(int);

    callback seek-to(float);

    callback clip-selected(int);

    callback clip-slice-requested(int, float);

    callback clip-glue-requested(int);

    callback glue-clip-at(float, length, length, length) -> int;

    callback clip-move-committed(
        int,
        int,
        float
    );

    callback clip-resize-committed(
        int,
        int,
        float,
        float
    );

    callback clip-delete-requested(int);

    callback clip-rename-requested(int, string);

    callback clip-color-cycle-requested(int);

    callback clip-copy-requested(int);

    callback paste-requested(float, int);


    // =====================================================
    // ESCALA
    // =====================================================

    out property <length> px-per-beat:
        40px * self.zoom;

    property <length> px-per-bar:
        self.px-per-beat * self.beats-per-bar;


    // =====================================================
    // MÉTRICA MUSICAL
    // =====================================================

    in property <int> total-bars: 32;

    in property <int> beats-per-bar: 4;

    in property <int> bpm: 120;


    // =====================================================
    // FOLLOW PLAYHEAD
    // =====================================================

    in property <bool> follow-playhead: true;


    // =====================================================
    // DIMENSÕES
    // =====================================================

    out property <length> ruler-height: 30px;

    out property <length> row-height:
        64px * self.zoom-y;


    // =====================================================
    // TRACK COUNT
    // =====================================================

    property <int> track-count:
        self.track-names.length;


    // =====================================================
    // PADDING DA ORIGEM
    //
    // Pequeno espaço para o beat 0 não ficar escondido
    // pelo Splitter / Track Panel.
    // =====================================================

    private property <length> timeline-left-padding: 4px;


    // =====================================================
    // LARGURA
    // =====================================================

    property <length> timeline-width:
        self.total-bars * self.px-per-bar;


    property <length> content-width:
        self.timeline-left-padding
        + self.timeline-width
        + 80px;


    // =====================================================
    // ALTURA
    // =====================================================

    property <length> tracks-height:
        self.track-count * self.row-height;


    // =====================================================
    // PLAYHEAD
    //
    // Movimento contínuo baseado em SEGUNDOS.
    // =====================================================

    property <float> seconds-per-beat:
        60.0 / root.bpm;


    property <length> pixels-per-second:
        root.px-per-beat
        / root.seconds-per-beat;


    property <length> playhead-x:
        root.timeline-left-padding
        + root.current-time-seconds
        * root.pixels-per-second;


    // =====================================================
    // FUNDO PRINCIPAL
    // =====================================================

    background:
        Theme.base;


    // =====================================================
    // ÁREA DA TIMELINE
    // =====================================================

    Rectangle {

        x: 0;

        y: 0;

        width:
            parent.width;

        height:
            parent.height;

        clip: true;


        // =================================================
        // ZOOM / PAN
        // =================================================

        zoom-pan-area := TouchArea {

            x: 0;

            y: 0;

            width:
                parent.width;

            height:
                parent.height;


            property <bool> middle-pressed: false;

            property <bool> dragging: false;

            property <length> drag-start-x: 0px;

            property <length> drag-start-y: 0px;

            property <length> drag-start-scroll-x: 0px;

            property <length> drag-start-scroll-y: 0px;

            property <bool> left-pressed: false;


            pointer-event(event) => {

                // =========================================
                // LEFT CLICK EM ÁREA VAZIA
                // =========================================

                if event.button
                        == PointerEventButton.left {

                    if event.kind
                            == PointerEventKind.down {

                        self.left-pressed = true;

                        if root.active-tool == 0 {

                            root.selected-clip = -1;
                        }
                    }

                    else if event.kind
                                == PointerEventKind.up
                            && self.left-pressed {

                        self.left-pressed = false;

                        if root.active-tool == 0 {

                            let content-y =
                                self.mouse-y
                                + root.scroll-y;

                            let track =
                                Math.floor(
                                    (
                                        content-y
                                        - root.ruler-height
                                    )
                                    / root.row-height
                                );

                            if track >= 0 {

                                let content-x =
                                    self.mouse-x
                                    + root.scroll-x
                                    - root.timeline-left-padding;

                                let beat =
                                    content-x
                                    / root.px-per-beat;

                                root.paste-requested(
                                    max(0.0, beat),
                                    track
                                );
                            }
                        }
                    }
                }


                // =========================================
                // MIDDLE MOUSE
                // =========================================

                if event.kind
                        == PointerEventKind.down
                    && event.button
                        == PointerEventButton.middle {

                    self.middle-pressed = true;

                    self.dragging = true;

                    self.drag-start-x =
                        self.mouse-x;

                    self.drag-start-y =
                        self.mouse-y;

                    self.drag-start-scroll-x =
                        root.scroll-x;

                    self.drag-start-scroll-y =
                        root.scroll-y;
                }


                else if event.kind
                            == PointerEventKind.up
                        && event.button
                            == PointerEventButton.middle {

                    self.middle-pressed = false;

                    self.dragging = false;
                }


                else if event.kind
                            == PointerEventKind.move
                        && self.dragging {

                    root.scroll-x =
                        max(
                            0px,
                            min(
                                root.max-scroll-x,
                                self.drag-start-scroll-x
                                - (
                                    self.mouse-x
                                    - self.drag-start-x
                                )
                            )
                        );

                    root.scroll-y =
                        max(
                            0px,
                            min(
                                root.max-scroll-y,
                                self.drag-start-scroll-y
                                - (
                                    self.mouse-y
                                    - self.drag-start-y
                                )
                            )
                        );
                }
            }


            // =================================================
            // SCROLL / ZOOM
            // =================================================

            scroll-event(event) => {

                let dz =
                    event.delta-x
                    + event.delta-y;


                // =============================================
                // HORIZONTAL ZOOM
                // =============================================

                if event.modifiers.control
                    || (
                        self.middle-pressed
                        && !event.modifiers.alt
                    ) {

                    let old-zoom =
                        root.zoom;

                    let factor =
                        dz > 0px
                            ? 0.96
                            : 1.04;

                    let new-zoom =
                        max(
                            0.5,
                            min(
                                4.0,
                                old-zoom * factor
                            )
                        );


                    let mouse-x =
                        self.mouse-x;


                    let content-x =
                        (
                            mouse-x
                            + root.scroll-x
                            - root.timeline-left-padding
                        )
                        / old-zoom;


                    let new-scroll-x =
                        root.timeline-left-padding
                        + content-x * new-zoom
                        - mouse-x;


                    root.zoom =
                        new-zoom;


                    root.scroll-x =
                        max(
                            0px,
                            min(
                                root.max-scroll-x,
                                new-scroll-x
                            )
                        );
                }


                // =============================================
                // SHIFT = HORIZONTAL SCROLL
                // =============================================

                else if event.modifiers.shift {

                    root.scroll-x =
                        max(
                            0px,
                            min(
                                root.max-scroll-x,
                                root.scroll-x
                                - event.delta-y
                            )
                        );
                }


                // =============================================
                // ALT = VERTICAL ZOOM
                // =============================================

                else if event.modifiers.alt {

                    root.zoom-y =
                        max(
                            0.4,
                            min(
                                3.0,
                                root.zoom-y
                                * (
                                    dz > 0px
                                        ? 0.96
                                        : 1.04
                                )
                            )
                        );


                    root.scroll-x =
                        min(
                            root.scroll-x,
                            root.max-scroll-x
                        );


                    root.scroll-y =
                        min(
                            root.scroll-y,
                            root.max-scroll-y
                        );
                }


                // =============================================
                // SCROLL NORMAL
                // =============================================

                else {

                    root.scroll-x =
                        max(
                            0px,
                            min(
                                root.max-scroll-x,
                                root.scroll-x
                                - event.delta-x
                            )
                        );


                    root.scroll-y =
                        max(
                            0px,
                            min(
                                root.max-scroll-y,
                                root.scroll-y
                                - event.delta-y
                            )
                        );
                }


                accept;
            }
        }


        // =================================================
        // CONTEÚDO SCROLLÁVEL
        // =================================================

        Rectangle {

            x:
                root.timeline-left-padding
                - root.scroll-x;

            y:
                -root.scroll-y;

            width:
                root.timeline-width
                + 80px;

            height:
                max(
                    root.ruler-height
                    + root.tracks-height,
                    parent.height
                );

            background:
                Theme.base;


            // =============================================
            // RÉGUA
            // =============================================

            TimelineRuler {

                x: 0;

                y: 0;

                width:
                    root.timeline-width;

                height:
                    root.ruler-height;

                ruler-height:
                    root.ruler-height;

                total-bars:
                    root.total-bars;

                beats-per-bar:
                    root.beats-per-bar;

                px-per-bar:
                    root.px-per-bar;

                scroll-x:
                    root.scroll-x;


                seek-to-beat(beat) => {

                    root.seek-to(
                        beat
                    );
                }


                z: 5;
            }


            // =============================================
            // FUNDO ALTERNADO POR COMPASSO
            //
            // Invertido em relação à régua antiga:
            // compasso ímpar = surface
            // compasso par   = base
            // =============================================

            for i in root.total-bars: Rectangle {

                x:
                    i * root.px-per-bar;

                y:
                    root.ruler-height;

                width:
                    root.px-per-bar;

                height:
                    parent.height
                    - root.ruler-height;

                background:
                    Math.mod(i, 2) == 1
                        ? Theme.surface
                        : Theme.base;

                z: -1;
            }


            // =============================================
            // GRID VERTICAL
            // =============================================

            for i in root.total-bars: Rectangle {

                x:
                    i * root.px-per-bar;

                y:
                    root.ruler-height;

                width:
                    root.px-per-bar;

                height:
                    parent.height
                    - root.ruler-height;

                z: 0;


                // =========================================
                // LINHA DO COMPASSO
                // =========================================

                Rectangle {

                    x: 0;

                    y: 0;

                    width: 1px;

                    height:
                        parent.height;

                    background:
                        Math.mod(i, 2) == 1
                            ? Theme.border
                            : Theme.border.transparentize(0.45);
                }


                // =========================================
                // LINHAS DAS BATIDAS
                // =========================================

                for k in root.beats-per-bar: Rectangle {

                    visible:
                        k > 0
                        && root.px-per-bar >= 40px;

                    x:
                        k * root.px-per-beat;

                    y: 0;

                    width: 1px;

                    height:
                        parent.height;

                    background:
                        Theme.border.transparentize(0.6);
                }


                // =========================================
                // SUBDIVISÃO 1/8
                // =========================================

                for k in root.beats-per-bar: Rectangle {

                    visible:
                        root.px-per-bar >= 120px;

                    x:
                        k * root.px-per-beat
                        + root.px-per-beat * 0.5;

                    y: 0;

                    width: 1px;

                    height:
                        parent.height;

                    background:
                        Theme.border.transparentize(0.7);
                }


                // =========================================
                // SUBDIVISÃO 1/16 — 1/4
                // =========================================

                for k in root.beats-per-bar: Rectangle {

                    visible:
                        root.px-per-bar >= 240px;

                    x:
                        k * root.px-per-beat
                        + root.px-per-beat * 0.25;

                    y: 0;

                    width: 1px;

                    height:
                        parent.height;

                    background:
                        Theme.border.transparentize(0.8);
                }


                // =========================================
                // SUBDIVISÃO 1/16 — 3/4
                // =========================================

                for k in root.beats-per-bar: Rectangle {

                    visible:
                        root.px-per-bar >= 240px;

                    x:
                        k * root.px-per-beat
                        + root.px-per-beat * 0.75;

                    y: 0;

                    width: 1px;

                    height:
                        parent.height;

                    background:
                        Theme.border.transparentize(0.8);
                }
            }


            // =============================================
            // TRACKS
            // =============================================

            VerticalLayout {

                x: 0;

                y:
                    root.ruler-height;

                width:
                    root.timeline-width;

                height:
                    root.tracks-height;

                alignment:
                    LayoutAlignment.stretch;

                spacing: 0;


                for name[index] in root.track-names: TrackRow {

                    width:
                        root.timeline-width;

                    height:
                        root.row-height;

                    track-index:
                        index;

                    selected-track:
                        index == root.selected-track;

                    selected-clip:
                        root.selected-clip;

                    clips:
                        root.clips;

                    px-per-beat:
                        root.px-per-beat;

                    px-per-bar:
                        root.px-per-bar;

                    row-height:
                        root.row-height;

                    track-count:
                        root.track-names.length;

                    total-bars:
                        root.total-bars;

                    beats-per-bar:
                        root.beats-per-bar;

                    active-tool:
                        root.active-tool;


                    // =====================================
                    // CLIP SELECTION
                    // =====================================

                    clip-selected(id) => {

                        if root.active-tool == 0 {

                            root.selected-clip =
                                id;

                            root.clip-selected(
                                id
                            );
                        }
                    }


                    // =====================================
                    // SLICE
                    // =====================================

                    slice-requested(
                        id,
                        position
                    ) => {

                        root.clip-slice-requested(
                            id,
                            position
                        );
                    }


                    // =====================================
                    // MOVE / RESIZE — commit único
                    // =====================================

                    clip-move-committed(
                        id,
                        track,
                        beat
                    ) => {

                        root.clip-move-committed(
                            id,
                            track,
                            beat
                        );
                    }


                    clip-resize-committed(
                        id,
                        side,
                        len,
                        beat
                    ) => {

                        root.clip-resize-committed(
                            id,
                            side,
                            len,
                            beat
                        );
                    }


                    // =====================================
                    // DELETE
                    // =====================================

                    clip-delete-requested(id) => {

                        root.clip-delete-requested(
                            id
                        );
                    }


                    // =====================================
                    // RENAME
                    // =====================================

                    clip-rename-requested(
                        id,
                        new_name
                    ) => {

                        root.clip-rename-requested(
                            id,
                            new_name
                        );
                    }


                    // =====================================
                    // COLOR
                    // =====================================

                    clip-color-cycle-requested(id) => {

                        root.clip-color-cycle-requested(
                            id
                        );
                    }


                    // =====================================
                    // COPY
                    // =====================================

                    clip-copy-requested(id) => {

                        root.clip-copy-requested(
                            id
                        );
                    }
                }
            }


            // =============================================
            // PREVIEW DE DROP
            // =============================================

            Rectangle {

                visible:
                    root.drop-visible;

                x:
                    root.drop-x;

                y:
                    root.ruler-height
                    + root.drop-track
                    * root.row-height;

                width:
                    root.drop-len-beats
                    * root.px-per-beat;

                height:
                    root.row-height;

                background:
                    Theme.accent.transparentize(0.85);

                z: 8;


                Rectangle {

                    x: 0;

                    y: 0;

                    width: 2px;

                    height:
                        parent.height;

                    background:
                        Theme.accent;

                    z: 1;
                }
            }


            // =============================================
            // OVERLAY DO ARRASTO DE CLIP
            //
            // Renderiza o clip sendo arrastado no espaço
            // de conteúdo, seguindo o mouse a cada frame
            // (bindings puros sobre ClipDragState).
            // =============================================

            ClipDragOverlay {

                px-per-beat:
                    root.px-per-beat;

                row-height:
                    root.row-height;

                ruler-height:
                    root.ruler-height;

                z: 60;
            }


            // =============================================
            // PLAYHEAD
            // =============================================

            PlayheadOverlay {

                head-x:
                    root.playhead-x;

                ruler-h:
                    root.ruler-height;

                tracks-h:
                    root.tracks-height;

                z: 120;
            }
        }
    }


    // =====================================================
    // CURSOR ESPECIAL DAS FERRAMENTAS
    // =====================================================

    tool-cursor := TouchArea {

        x: 0;

        y: 0;

        width:
            parent.width;

        height:
            parent.height;

        enabled:
            root.active-tool == 2
            || root.active-tool == 3
            || root.active-tool == 4
            || root.active-tool == 5;


        mouse-cursor:
            root.active-tool == 2
                ? MouseCursor.crosshair

            : root.active-tool == 3
                ? MouseCursor.ew-resize

            : root.active-tool == 4
                ? MouseCursor.crosshair

            : root.active-tool == 5
                ? MouseCursor.crosshair

            : MouseCursor.default;


        z: 200;


        pointer-event(event) => {

            if root.active-tool == 2
                && event.kind
                    == PointerEventKind.down {

                let row =
                    (
                        self.mouse-y
                        - (
                            root.ruler-height
                            - root.scroll-y
                        )
                    )
                    / root.row-height;


                let id =
                    root.glue-clip-at(
                        row,
                        self.mouse-x,
                        root.scroll-x,
                        root.px-per-beat
                    );


                if id >= 0 {

                    root.clip-glue-requested(
                        id
                    );
                }
            }
        }
    }


    // =====================================================
    // FOLLOW PLAYHEAD
    // =====================================================

    Timer {

        interval: 16ms;

        running:
            root.playing
            && root.follow-playhead;


        triggered() => {

            let px =
                root.playhead-x;

            let visible-left =
                root.scroll-x;

            let visible-right =
                root.scroll-x
                + root.width;

            let margin =
                root.width * 0.1;


            // =============================================
            // SAIU PELA DIREITA
            // =============================================

            if px >
                visible-right - margin {

                root.scroll-x =
                    min(
                        root.max-scroll-x,
                        px
                        - root.width * 0.3
                    );
            }


            // =============================================
            // SAIU PELA ESQUERDA
            // =============================================

            else if px <
                visible-left + margin {

                root.scroll-x =
                    max(
                        0px,
                        px
                        - root.width * 0.3
                    );
            }
        }
    }
}