import { Theme } from "../theme.slint";
import { TimelineRuler } from "../components/ruler.slint";
import { TrackRow } from "track_row.slint";
import { ClipDragOverlay } from "clip_drag/clip_drag_overlay.slint";
import { ClipData } from "clip_data.slint";
import { PlayheadOverlay } from "playhead.slint";
import { ClipDragState } from "clip_drag/clip_drag_state.slint";

export component Timeline inherits Rectangle {

    // =====================================================
    // SELEÇÃO
    // =====================================================

    in-out property <int> selected-track: 0;
    in-out property <int> selected-clip: -1;

    // =====================================================
    // MARQUEE (Ctrl + clique esq. arrasto)
    //
    // Retângulo de seleção múltipla: nasce no DOWN com Ctrl,
    // cresce com o mouse e no UP seleciona os clips que
    // intersectam (callback `marquee-select` no Rust).
    // Coordenadas de CONTEÚDO (independem do scroll).
    // =====================================================



    callback marquee-select(float, float, float, float);
        // (beat0, beat1, track0, track1)

    // Clique em qualquer área da timeline → o FocusScope global
    // recupera o foco do teclado (atalhos voltam a funcionar).
    callback keyboard-focus-requested();

    // Delete sem clip de seleção única: apaga todos os clips
    // multi-selecionados (marquee).
    callback multi-delete-requested();


    // =====================================================
    // TRANSPORTE / ZOOM
    // =====================================================

    in property <float> current-time-seconds: 0;

    in property <bool> playing: false;

    in-out property <float> zoom: 1.0;

    in-out property <float> zoom-y: 1.0;

    in-out property <bool> loop-enabled: false;
    in-out property <float> loop-start-beat: 0.0;
    in-out property <float> loop-end-beat: 16.0;

    callback zoom-to(float, length);


    // =====================================================
    // SCROLL
    // =====================================================

    in-out property <length> scroll-x: 0px;

    in-out property <length> scroll-y: 0px;

    out property <length> max-scroll-x:
        max(
            0px,
            self.content-width - self.width
        );

    out property <length> max-scroll-y:
        max(
            0px,
            self.ruler-height + self.tracks-height - self.height
        );


    // =====================================================
    // TRACKS
    // =====================================================

    in property <[string]> track-names: [];


    // =====================================================
    // FERRAMENTA
    // =====================================================

    in-out property <int> active-tool: 0;


    // =====================================================
    // CLIPS
    // =====================================================

    in property <[ClipData]> clips: [];


    // =====================================================
    // PREVIEW DE DROP
    // =====================================================

    in property <bool> drop-visible: false;

    in property <length> drop-x: 0px;

    in property <int> drop-track: 0;

    in property <float> drop-len-beats: 4.0;


    // =====================================================
    // CALLBACKS
    // =====================================================

    callback select-track(int);

    callback seek-to(float);

    callback clip-selected(int);

    callback clip-slice-requested(int, float);

    callback clip-glue-requested(int);

    callback glue-clip-at(float, length, length, length) -> int;

    callback clip-move-committed(
        int,
        int,
        float
    );

    callback clip-resize-committed(
        int,
        int,
        float,
        float
    );

    callback clip-delete-requested(int);

    callback clip-rename-requested(int, string);

    callback clip-color-cycle-requested(int);

    callback clip-copy-requested(int);

    callback paste-requested(float, int);


    // =====================================================
    // ESCALA
    // =====================================================

    out property <length> px-per-beat:
        40px * self.zoom;

    property <length> px-per-bar:
        self.px-per-beat * self.beats-per-bar;


    // =====================================================
    // MÉTRICA MUSICAL
    // =====================================================

    in property <int> total-bars: 32;

    in property <int> beats-per-bar: 4;

    in property <int> bpm: 120;


    // =====================================================
    // FOLLOW PLAYHEAD
    // =====================================================

    in property <bool> follow-playhead: true;


    // =====================================================
    // DIMENSÕES
    // =====================================================

    out property <length> ruler-height: 30px;

    out property <length> row-height:
        64px * self.zoom-y;


    // =====================================================
    // TRACK COUNT
    // =====================================================

    property <int> track-count:
        self.track-names.length;


    // =====================================================
    // PADDING DA ORIGEM
    //
    // Pequeno espaço para o beat 0 não ficar escondido
    // pelo Splitter / Track Panel.
    // =====================================================

    private property <length> timeline-left-padding: 4px;


    // =====================================================
    // LARGURA
    // =====================================================

        // Largura da timeline: SEMPRE pelo menos 200 compassos de
    // "chão" (o espaço vazio rolável que DAWs mostram à direita),
    // crescendo além disso se total-bars pedir mais. O custo é
    // zero: área vazia não gera elementos.
    property <length> timeline-width:
        max(
            200 * 1px * self.px-per-bar / 1px,
            self.total-bars * self.px-per-bar
);


    property <length> content-width:
        self.timeline-left-padding
        + self.timeline-width
        + 80px;


    // =====================================================
    // ALTURA
    // =====================================================

    property <length> tracks-height:
        self.track-count * self.row-height;


    // =====================================================
    // PLAYHEAD
    //
    // Movimento contínuo baseado em SEGUNDOS.
    // =====================================================

    property <float> seconds-per-beat:
        60.0 / root.bpm;


    property <length> pixels-per-second:
        root.px-per-beat
        / root.seconds-per-beat;


    property <length> playhead-x:
        root.timeline-left-padding
        + root.current-time-seconds
        * root.pixels-per-second;

    // =====================================================
    // SCRUB (arrasto na régua)
    //
    // Durante o arrasto, o playhead visual usa uma posição
    // LOCAL atualizada no próprio evento de mouse (0ms de
    // latência). O seek ao motor de áudio é feito pela régua
    // em paralelo; quando o arrasto termina, o visual volta
    // a seguir `current-time-seconds` — que nesse ponto já
    // é igual à posição arrastada.
    // =====================================================

    // X local do mouse durante o scrub (-1 = inativo).
    //
    // Ligado DIRETO à posição do mouse na régua: enquanto
    // `scrubbing`, cada frame reflete o cursor sem roundtrip.
    property <length> scrub-x:
        scrub-source.scrubbing
            ? scrub-source.live-mouse-x
              - root.timeline-left-padding
              + root.scroll-x
            : -1px;

    // Última posição de scrub vista (anti-flash, padrão
    // PlayheadLab): ao soltar o mouse há um frame em que
    // `scrubbing` já caiu mas `current-time-seconds` ainda não
    // propagou o seek final → a agulha piscaria na posição
    // antiga. Seguramos o último x até o transporte alcançar.
    // Atualizado via `changed` do scrub-x (binding próprio é ilegal).
    property <length> last-scrub-x:
        0px;

    changed scrub-x => {
        if root.scrub-x >= 0px {
            root.last-scrub-x = root.scrub-x;
        }
    }

    // O hold só vale durante o PRÓPRIO arrasto + o frame em que
    // ele termina. NUNCA depois: se segurasse além disso, um
    // pause via tecla espaço (playing=false) reativaria o hold e
    // pause via espaço reativaria o hold e a agulha "voltaria" ao
    // onde a música pausou.
    property <bool> use-scrub-pos:
        root.scrub-x < 0px
        && !root.playing
        && (root.playhead-x - root.last-scrub-x).abs() > 2px;

    // Playhead efetivo, prioridade:
    // 1. ARRASTO ATIVO → mouse direto (0ms, sem hold intermediário)
    // 2. PÓS-RELEASE parado → hold anti-flash até transporte alcançar
    // 3. caso contrário → transporte
    property <length> effective-playhead-x:
        root.scrub-x >= 0px
            ? root.scrub-x
            : root.use-scrub-pos
                ? root.last-scrub-x
                : root.playhead-x;


    // =====================================================
    // FUNDO PRINCIPAL
    // =====================================================

    background: transparent;


    // =====================================================
    // ÁREA DA TIMELINE
    // =====================================================

    Rectangle {

        x: 0;

        y: 0;

        width:
            parent.width;

        height:
            parent.height;

        border-radius: 6px;
        clip: true;


        // =================================================
        // ZOOM / PAN
        // =================================================

        zoom-pan-area := TouchArea {

            x: 0;

            y: 0;

            width:
                parent.width;

            height:
                parent.height;


            property <bool> middle-pressed: false;

            property <bool> dragging: false;

            property <length> drag-start-x: 0px;

            property <length> drag-start-y: 0px;

            property <length> drag-start-scroll-x: 0px;

            property <length> drag-start-scroll-y: 0px;

            property <bool> left-pressed: false;

            // Shift pressionado no UP? Shift+clique em área vazia cola.
            property <bool> shift-pressed: false;


            pointer-event(event) => {

                // =========================================
                // CANCEL
                //
                // Gesto interrompido (foco perdido, drag do
                // sistema etc.): nunca deixa o marquee preso.
                // =========================================

                if event.kind
                        == PointerEventKind.cancel {

                    ClipDragState.marquee-active =
                        false;

                    self.left-pressed =
                        false;

                    self.middle-pressed =
                        false;

                    self.dragging =
                        false;
                }

                // =========================================
                // MOVE DO MARQUEE (Ctrl+arrasto começado NA
                // ÁREA VAZIA)
                //
                // O Slint entrega `Moved` com button = Other
                // (nunca Left), então este update precisa viver
                // FORA do bloco `button == left` abaixo — era
                // isso que fazia o lasso não desenhar/atualizar
                // quando se começava fora de um clip: x1/y1
                // nunca mudavam e o UP via x1==x0 (nada).
                // =========================================

                if event.kind == PointerEventKind.move
                        && ClipDragState.marquee-active {

                    ClipDragState.marquee-x1 =
                        self.mouse-x + root.scroll-x;

                    ClipDragState.marquee-y1 =
                        self.mouse-y + root.scroll-y;

                    return;
                }

                // =========================================
                // LEFT CLICK EM ÁREA VAZIA
                // =========================================

                if event.button
                        == PointerEventButton.left {

                    if event.kind
                            == PointerEventKind.down {

                        self.left-pressed = true;

                        // Qualquer clique na timeline devolve o foco
                        // ao FocusScope global — sem isso, depois de
                        // clicar num campo de texto (busca/rename),
                        // Delete, Ctrl+Z etc. morriam.
                        root.keyboard-focus-requested();

                        // CTRL → inicia marquee em vez de deselecionar
                        // (igual ao lasso do piano roll). Shift fica
                        // reservado para o Shift+clique colar.
                        if event.modifiers.control {
                            ClipDragState.marquee-active = true;
                            ClipDragState.marquee-x0 =
                                self.mouse-x + root.scroll-x;
                            ClipDragState.marquee-y0 =
                                self.mouse-y + root.scroll-y;
                            ClipDragState.marquee-x1 =
                                ClipDragState.marquee-x0;
                            ClipDragState.marquee-y1 =
                                ClipDragState.marquee-y0;
                        } else {
                            // Qualquer clique fora dos clips deseleciona
                            // a seleção única, em qualquer ferramenta.
                            root.selected-clip = -1;
                        }
                    }

                    else if event.kind
                                == PointerEventKind.up
                            && self.left-pressed {

                        self.left-pressed = false;

                        // Snapshot do Shift no UP: cola só se estava
                        // pressionado (Shift + clique em área vazia).
                        self.shift-pressed = event.modifiers.shift;

                        // Marquee ativo? Seleciona e consome o UP.
                        // Desliga SEMPRE (Ctrl+clique simples não pode
                        // deixar a caixa pendurada); só seleciona se
                        // houve arrasto de verdade.
                        if ClipDragState.marquee-active {
                            ClipDragState.marquee-active = false;

                            if (ClipDragState.marquee-x1 != ClipDragState.marquee-x0
                                || ClipDragState.marquee-y1 != ClipDragState.marquee-y0) {

                                let bx0 = min(
                                    ClipDragState.marquee-x0,
                                    ClipDragState.marquee-x1,
                                ) / root.px-per-beat;

                                let bx1 = max(
                                    ClipDragState.marquee-x0,
                                    ClipDragState.marquee-x1,
                                ) / root.px-per-beat;

                                let ty0 = Math.floor(
                                    (
                                        min(
                                            ClipDragState.marquee-y0,
                                            ClipDragState.marquee-y1,
                                        )
                                        - root.ruler-height
                                    )
                                    / root.row-height
                                );

                                let ty1 = Math.floor(
                                    (
                                        max(
                                            ClipDragState.marquee-y0,
                                            ClipDragState.marquee-y1,
                                        )
                                        - root.ruler-height
                                    )
                                    / root.row-height
                                );

                                root.marquee-select(
                                    max(0.0, bx0),
                                    bx1,
                                    max(0, ty0),
                                    ty1,
                                );
                                return;
                            }
                        }

                        if root.active-tool == 0 {

                            let content-y =
                                self.mouse-y
                                + root.scroll-y;

                            let track =
                                Math.floor(
                                    (
                                        content-y
                                        - root.ruler-height
                                    )
                                    / root.row-height
                                );

                            if track >= 0 {

                                let content-x =
                                    self.mouse-x
                                    + root.scroll-x
                                    - root.timeline-left-padding;

                                let beat =
                                    content-x
                                    / root.px-per-beat;

                                // Colar SÓ com Shift + clique em área
                                // vazia (pedido do usuário). Clique sem
                                // Shift apenas deseleciona.
                                if self.shift-pressed {
                                    root.paste-requested(
                                        max(0.0, beat),
                                        track
                                    );
                                }
                            }
                        }
                    }
                }


                // =========================================
                // MIDDLE MOUSE
                // =========================================

                if event.kind
                        == PointerEventKind.down
                    && event.button
                        == PointerEventButton.middle {

                    self.middle-pressed = true;

                    self.dragging = true;

                    self.drag-start-x =
                        self.mouse-x;

                    self.drag-start-y =
                        self.mouse-y;

                    self.drag-start-scroll-x =
                        root.scroll-x;

                    self.drag-start-scroll-y =
                        root.scroll-y;
                }


                else if event.kind
                            == PointerEventKind.up
                        && event.button
                            == PointerEventButton.middle {

                    self.middle-pressed = false;

                    self.dragging = false;
                }


                else if event.kind
                            == PointerEventKind.move
                        && self.dragging {

                    root.scroll-x =
                        max(
                            0px,
                            min(
                                root.max-scroll-x,
                                self.drag-start-scroll-x
                                - (
                                    self.mouse-x
                                    - self.drag-start-x
                                )
                            )
                        );

                    root.scroll-y =
                        max(
                            0px,
                            min(
                                root.max-scroll-y,
                                self.drag-start-scroll-y
                                - (
                                    self.mouse-y
                                    - self.drag-start-y
                                )
                            )
                        );
                }
            }


            // =================================================
            // SCROLL / ZOOM
            // =================================================

            scroll-event(event) => {

                let dz =
                    event.delta-x
                    + event.delta-y;


                // =============================================
                // HORIZONTAL ZOOM
                // =============================================

                if event.modifiers.control
                    || (
                        self.middle-pressed
                        && !event.modifiers.alt
                    ) {

                    let old-zoom =
                        root.zoom;

                    // Fator proporcional ao delta do dispositivo:
                    // mouses de roda, trackpads e mouses free-spin
                    // produzem deltas muito diferentes — um fator
                    // fixo fazia o zoom "pular" numas e rastejar
                    // noutras. Multiplicativo + clamp suave = fluido.
                    let strength =
                        min(
                            6.0,
                            abs(dz / 1px) / 60.0
                        );
                    let factor =
                        1.0 - strength * 0.06;

                    let new-zoom =
                        max(
                            0.25,
                            min(
                                64.0,
                                old-zoom
                                * (dz > 0px ? factor : 1.0 / factor)
                            )
                        );


                    let mouse-x =
                        self.mouse-x;


                    let content-x =
                        (
                            mouse-x
                            + root.scroll-x
                            - root.timeline-left-padding
                        )
                        / old-zoom;


                    let new-scroll-x =
                        root.timeline-left-padding
                        + content-x * new-zoom
                        - mouse-x;


                    root.zoom =
                        new-zoom;


                    root.scroll-x =
                        max(
                            0px,
                            min(
                                root.max-scroll-x,
                                new-scroll-x
                            )
                        );
                }


                // =============================================
                // SHIFT = HORIZONTAL SCROLL
                // =============================================

                else if event.modifiers.shift {

                    root.scroll-x =
                        max(
                            0px,
                            min(
                                root.max-scroll-x,
                                root.scroll-x
                                - event.delta-y * 2.5
                            )
                        );
                }


                // =============================================
                // ALT = VERTICAL ZOOM
                // =============================================

                else if event.modifiers.alt {

                    // Zoom vertical: mesmo tratamento do horizontal
                    // (fator proporcional ao delta, range maior).
                    let strength =
                        min(
                            6.0,
                            abs(dz / 1px) / 60.0
                        );
                    let factor =
                        1.0 - strength * 0.06;

                    root.zoom-y =
                        max(
                            0.25,
                            min(
                                6.0,
                                root.zoom-y
                                * (dz > 0px ? factor : 1.0 / factor)
                            )
                        );


                    root.scroll-x =
                        min(
                            root.scroll-x,
                            root.max-scroll-x
                        );


                    root.scroll-y =
                        min(
                            root.scroll-y,
                            root.max-scroll-y
                        );
                }


                // =============================================
                // SCROLL NORMAL
                //
                // Multiplicador no delta: o valor cru do winit é
                // curto demais (linhas de roda ~3 "notches" por
                // gesto), o que dava a sensação de scroll pesado
                // com micro-saltos. 2.5x + clamp = deslize contínuo.
                // =============================================

                else {

                    root.scroll-x =
                        max(
                            0px,
                            min(
                                root.max-scroll-x,
                                root.scroll-x
                                - event.delta-x * 2.5
                            )
                        );


                    root.scroll-y =
                        max(
                            0px,
                            min(
                                root.max-scroll-y,
                                root.scroll-y
                                - event.delta-y * 2.5
                            )
                        );
                }


                accept;
            }
        }


        // =================================================
        // CONTEÚDO SCROLLÁVEL
        // =================================================

        Rectangle {

            x:
                root.timeline-left-padding
                - root.scroll-x;

            y:
                -root.scroll-y;

            width:
                root.timeline-width
                + 80px;

            height:
                max(
                    root.ruler-height
                    + root.tracks-height,
                    parent.height
                );

            background: transparent;


            // =============================================
            // RÉGUA
            // =============================================

            scrub-source := TimelineRuler {

                // A régua agora é um "visor" fixo na tela: anda
                // JUNTO com o scroll (x = scroll-x compensa o
                // deslocamento do container rolado) e só desenha
                // os compassos visíveis.
                x:
                    root.scroll-x;

                y: 0;

                width:
                    root.width;

                height:
                    root.ruler-height;

                ruler-height:
                    root.ruler-height;

                viewport-width:
                    parent.width;

                total-bars:
                    root.total-bars;

                beats-per-bar:
                    root.beats-per-bar;

                px-per-bar:
                    root.px-per-bar;

                scroll-x:
                    root.scroll-x;

                loop-enabled: root.loop-enabled;
                loop-start-beat: root.loop-start-beat;
                loop-end-beat: root.loop-end-beat;
                loop-range-changed(a, b) => { root.loop-start-beat = a; root.loop-end-beat = b; }


                seek-to-beat(beat) => {

                    root.seek-to(
                        beat
                    );
                }


                z: 5;
            }


            // =============================================
            // FUNDO ALTERNADO POR COMPASSO
            //
            // Invertido em relação à régua antiga:
            // compasso ímpar = surface
            // compasso par   = base
            // =============================================

            for i in root.total-bars: Rectangle {

                x:
                    i * root.px-per-bar;

                y:
                    root.ruler-height;

                width:
                    root.px-per-bar;

                height:
                    parent.height
                    - root.ruler-height;

                background:
                    Math.mod(i, 2) == 1
                        ? Theme.surface-high
                        : Theme.surface-step;

                z: -1;
            }


            // =============================================
            // GRID VERTICAL
            // =============================================

            for i in root.total-bars: Rectangle {

                x:
                    i * root.px-per-bar;

                y:
                    root.ruler-height;

                width:
                    root.px-per-bar;

                height:
                    parent.height
                    - root.ruler-height;

                z: 0;


                // =========================================
                // LINHA DO COMPASSO
                // =========================================

                Rectangle {

                    x: 0;

                    y: 0;

                    width: 1px;

                    height:
                        parent.height;

                    background:
                        Math.mod(i, 2) == 1
                            ? (Theme.is-paper ? Theme.base : Theme.border)
                            : (Theme.is-paper ? Theme.base : Theme.border).transparentize(0.45);
                }


                // =========================================
                // LINHAS DAS BATIDAS
                // =========================================

                for k in root.beats-per-bar: Rectangle {

                    visible:
                        k > 0
                        && root.px-per-bar >= 40px;

                    x:
                        k * root.px-per-beat;

                    y: 0;

                    width: 1px;

                    height:
                        parent.height;

                    background:
                        Theme.is-paper ? Theme.base.transparentize(0.6) : Theme.border.transparentize(0.6);
                }


                // =========================================
                // SUBDIVISÃO 1/8
                // =========================================

                for k in root.beats-per-bar: Rectangle {

                    visible:
                        root.px-per-bar >= 120px;

                    x:
                        k * root.px-per-beat
                        + root.px-per-beat * 0.5;

                    y: 0;

                    width: 1px;

                    height:
                        parent.height;

                    background:
                        Theme.is-paper ? Theme.base.transparentize(0.7) : Theme.border.transparentize(0.7);
                }


                // =========================================
                // SUBDIVISÃO 1/16 — 1/4
                // =========================================

                for k in root.beats-per-bar: Rectangle {

                    visible:
                        root.px-per-bar >= 240px;

                    x:
                        k * root.px-per-beat
                        + root.px-per-beat * 0.25;

                    y: 0;

                    width: 1px;

                    height:
                        parent.height;

                    background:
                        Theme.is-paper ? Theme.base.transparentize(0.8) : Theme.border.transparentize(0.8);
                }


                // =========================================
                // SUBDIVISÃO 1/16 — 3/4
                // =========================================

                for k in root.beats-per-bar: Rectangle {

                    visible:
                        root.px-per-bar >= 240px;

                    x:
                        k * root.px-per-beat
                        + root.px-per-beat * 0.75;

                    y: 0;

                    width: 1px;

                    height:
                        parent.height;

                    background:
                        Theme.is-paper ? Theme.base.transparentize(0.8) : Theme.border.transparentize(0.8);
                }
            }


            // =============================================
            // TRACKS
            // =============================================

            VerticalLayout {

                x: 0;

                y:
                    root.ruler-height;

                width:
                    root.timeline-width;

                height:
                    root.tracks-height;

                alignment:
                    LayoutAlignment.stretch;

                spacing: 0;


                for name[index] in root.track-names: TrackRow {

                    width:
                        root.timeline-width;

                    height:
                        root.row-height;

                    track-index:
                        index;

                    // Viewport pro culling de clips (só desenha
                    // os que intersectam a área visível).
                    view-scroll-x:
                        root.scroll-x
                        - root.timeline-left-padding;

                    view-width:
                        root.width;

                    selected-track:
                        index == root.selected-track;

                    selected-clip:
                        root.selected-clip;

                    clips:
                        root.clips;

                    px-per-beat:
                        root.px-per-beat;

                    px-per-bar:
                        root.px-per-bar;

                    row-height:
                        root.row-height;

                    ruler-height:
                        root.ruler-height;

                    track-count:
                        root.track-names.length;

                    total-bars:
                        root.total-bars;

                    beats-per-bar:
                        root.beats-per-bar;

                    active-tool:
                        root.active-tool;


                    // =====================================
                    // CLIP SELECTION
                    // =====================================

                    clip-selected(id) => {

                        if root.active-tool == 0 {

                            root.selected-clip =
                                id;

                            root.clip-selected(
                                id
                            );
                        }
                    }


                    // =====================================
                    // SLICE
                    // =====================================

                    slice-requested(
                        id,
                        position
                    ) => {

                        root.clip-slice-requested(
                            id,
                            position
                        );
                    }


                    // =====================================
                    // MOVE / RESIZE — commit único
                    // =====================================

                    clip-move-committed(
                        id,
                        track,
                        beat
                    ) => {

                        root.clip-move-committed(
                            id,
                            track,
                            beat
                        );
                    }


                    clip-resize-committed(
                        id,
                        side,
                        len,
                        beat
                    ) => {

                        root.clip-resize-committed(
                            id,
                            side,
                            len,
                            beat
                        );
                    }


                    // =====================================
                    // DELETE
                    // =====================================

                    clip-delete-requested(id) => {

                        root.clip-delete-requested(
                            id
                        );
                    }


                    // =====================================
                    // RENAME
                    // =====================================

                    clip-rename-requested(
                        id,
                        new_name
                    ) => {

                        root.clip-rename-requested(
                            id,
                            new_name
                        );
                    }


                    // =====================================
                    // COLOR
                    // =====================================

                    clip-color-cycle-requested(id) => {

                        root.clip-color-cycle-requested(
                            id
                        );
                    }


                    // =====================================
                    // COPY
                    // =====================================

                    clip-copy-requested(id) => {

                        root.clip-copy-requested(
                            id
                        );
                    }


                    // =====================================
                    // MARQUEE COMMIT
                    //
                    // O UP do marquee pode cair sobre um
                    // clip (o Slint entrega ao item sob o
                    // cursor): o TrackClip calcula e comita
                    // por aqui.
                    // =====================================

                    marquee-commit(b0, b1, t0, t1) => {
                        root.marquee-select(b0, b1, t0, t1);
                    }
                }
            }


            // =============================================
            // PREVIEW DE DROP
            // =============================================

            Rectangle {

                visible:
                    root.drop-visible;

                x:
                    root.drop-x;

                y:
                    root.ruler-height
                    + root.drop-track
                    * root.row-height;

                width:
                    root.drop-len-beats
                    * root.px-per-beat;

                height:
                    root.row-height;

                background:
                    Theme.accent.transparentize(0.85);

                z: 8;


                Rectangle {

                    x: 0;

                    y: 0;

                    width: 2px;

                    height:
                        parent.height;

                    background:
                        Theme.accent;

                    z: 1;
                }
            }


            // =============================================
            // OVERLAY DO ARRASTO DE CLIP
            //
            // Renderiza o clip sendo arrastado no espaço
            // de conteúdo, seguindo o mouse a cada frame
            // (bindings puros sobre ClipDragState).
            // =============================================

            ClipDragOverlay {

                px-per-beat:
                    root.px-per-beat;

                row-height:
                    root.row-height;

                ruler-height:
                    root.ruler-height;

                z: 60;
                            }


                            PlayheadOverlay {

                                head-x:
                                    root.effective-playhead-x;

                                ruler-h:
                                    root.ruler-height;

                                tracks-h:
                                    root.tracks-height;

                                z: 120;
                            }
                        }
                    }


                    // ======================================================
                    // RETÂNGULO DO MARQUEE (SELEÇÃO MÚLTIPLA)
                    //
                    // Desenhado no nível RAIZ do Timeline (irmão do
                    // zoom-pan-area e da VerticalLayout das tracks),
                    // DEPOIS das tracks para ficar POR CIMA de tudo.
                    // Mesmo estilo do lasso do Piano Roll: Theme.accent.
                    // ======================================================

                    if ClipDragState.marquee-active: Rectangle {

                        x:
                            min(ClipDragState.marquee-x0, ClipDragState.marquee-x1)
                            - root.scroll-x;

                        y:
                            min(ClipDragState.marquee-y0, ClipDragState.marquee-y1)
                            - root.scroll-y;

                        width:
                            abs(ClipDragState.marquee-x1 - ClipDragState.marquee-x0);

                        height:
                            abs(ClipDragState.marquee-y1 - ClipDragState.marquee-y0);

                        border-width:
                            1px;

                        border-color:
                            Theme.accent;

                        background:
                            Theme.accent.transparentize(0.85);

                        z: 200;
                    }


                    // =====================================================
                    // CURSOR ESPECIAL DAS FERRAMENTAS
    // =====================================================

    tool-cursor := TouchArea {

        x: 0;

        y: 0;

        width:
            parent.width;

        height:
            parent.height;

        enabled:
            root.active-tool == 2
            || root.active-tool == 3
            || root.active-tool == 4
            || root.active-tool == 5;


        mouse-cursor:
            root.active-tool == 2
                ? MouseCursor.crosshair

            : root.active-tool == 3
                ? MouseCursor.ew-resize

            : root.active-tool == 4
                ? MouseCursor.crosshair

            : root.active-tool == 5
                ? MouseCursor.crosshair

            : MouseCursor.default;


        z: 200;


        pointer-event(event) => {

            if root.active-tool == 2
                && event.kind
                    == PointerEventKind.down {

                let row =
                    (
                        self.mouse-y
                        - (
                            root.ruler-height
                            - root.scroll-y
                        )
                    )
                    / root.row-height;


                let id =
                    root.glue-clip-at(
                        row,
                        self.mouse-x,
                        root.scroll-x,
                        root.px-per-beat
                    );


                if id >= 0 {

                    root.clip-glue-requested(
                        id
                    );
                }
            }
        }
    }


    // =====================================================
    // FOLLOW PLAYHEAD
    // =====================================================

    Timer {

        interval: 8ms;

        running:
            root.playing
            && root.follow-playhead;


        triggered() => {

            let px =
                root.playhead-x;

            let width =
                root.width;

            let margin =
                width * 0.12;

            let visible-right =
                root.scroll-x
                + width;


            // =============================================
            // FOLLOW CONTÍNUO (sem pulo de relocação)
            //
            // Antes: ao cruzar a margem o scroll relocava o
            // conteúdo por ~60% da largura de uma vez → a
            // agulha "pulava". Agora o scroll acompanha a
            // agulha exatamente na MESMA velocidade (delta
            // por tick = delta da agulha), então o conteúdo
            // desliza liso e o playhead fica ancorado no
            // limiar.
            // =============================================

            if px >
                visible-right - margin {

                // Ancora o playhead no limiar direito.
                root.scroll-x =
                    min(
                        max(
                            0px,
                            px
                            - (width - margin)
                        ),
                        root.max-scroll-x
                    );

            }
            else if px <
                root.scroll-x + margin {

                // Ancora o playhead no limiar esquerdo.
                root.scroll-x =
                    min(
                        max(
                            0px,
                            px
                            - margin
                        ),
                        root.max-scroll-x
                    );
            }
        }
    }
}
