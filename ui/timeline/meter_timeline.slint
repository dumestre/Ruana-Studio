import { Theme } from "../theme.slint";
import { TimelineHeader } from "header.slint";
import { StereoMeter } from "../components/meter_reuse.slint";


export component MeterTimeline inherits Rectangle {

    // =====================================================
    // DADOS
    // =====================================================
    

    in property <length> ruler-height: 30px;

    in property <float> zoom-y: 1.0;

    in property <length> scroll-y: 0px;

    // Zoom vertical (Alt+roda) vindo das rows do header.
    callback zoom-y-scrolled(float);


    // =====================================================
    // FUNDO
    // =====================================================

    background:
        Theme.surface-high;

    border-radius:
        6px;

        StereoMeter { }
    
}