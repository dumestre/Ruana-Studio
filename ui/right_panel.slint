import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

component BrowserItem inherits Rectangle {
    in property <string> name: "";
    in property <string> kind: "";
    in property <color> item-color: Theme.accent;

    
    height: 26px;
    background: transparent;

    HorizontalLayout {
        spacing: 6px;
        cross-axis-alignment: center;

        Rectangle {
            width: 6px;
            height: 16px;
            background: root.item-color;
            border-radius: 2px;
        }

        Text {
            text: root.name;
            color: Theme.text-primary;
            font-size: 11px;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;
        }

        Text {
            text: root.kind;
            color: Theme.text-dim;
            font-size: 9px;
            vertical-alignment: center;
        }
    }
}

component TabButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> selected: false;
    callback clicked;

    width: 100%;
    height: 26px;
    background: self.selected ? Theme.surface-high : Theme.surface;
    border-radius: 4px;
    border-width: 1px;
    border-color: self.selected ? Theme.accent : Theme.border;

    Text {
        text: root.text;
        color: root.selected ? Theme.text-primary : Theme.text-dim;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component RightPanel inherits Rectangle {
    in-out property <int> current-tab: 0;

    preferred-width: 250px;
    preferred-height: 100%;
    background: Theme.surface;

    Rectangle {
        width: 1px;
        height: 100%;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        Text {
            text: "BROWSER";
            color: Theme.accent;
            font-size: 12px;
        }

        HorizontalLayout {
            spacing: 4px;
            TabButton {
                text: "Samples";
                selected: root.current-tab == 0;
                clicked => { root.current-tab = 0; }
            }
            TabButton {
                text: "Presets";
                selected: root.current-tab == 1;
                clicked => { root.current-tab = 1; }
            }
            TabButton {
                text: "Files";
                selected: root.current-tab == 2;
                clicked => { root.current-tab = 2; }
            }
        }

        ScrollView {
            width: 100%;
            height: 100%;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;

                if root.current-tab == 0: VerticalLayout {
                    spacing: 2px;
                    BrowserItem { name: "Kick 909"; kind: "WAV"; item-color: Theme.accent; }
                    BrowserItem { name: "Snare Tight"; kind: "WAV"; item-color: Theme.accent; }
                    BrowserItem { name: "Hat Open"; kind: "WAV"; item-color: Theme.accent; }
                    BrowserItem { name: "Clap 80s"; kind: "WAV"; item-color: Theme.accent; }
                    BrowserItem { name: "Bass 808"; kind: "WAV"; item-color: Theme.accent; }
                    BrowserItem { name: "Pad Warm"; kind: "WAV"; item-color: Theme.accent; }
                    BrowserItem { name: "Lead Pluck"; kind: "WAV"; item-color: Theme.accent; }
                    BrowserItem { name: "Piano Grand"; kind: "WAV"; item-color: Theme.accent; }
                    BrowserItem { name: "Vocal Ah"; kind: "WAV"; item-color: Theme.accent; }
                    BrowserItem { name: "Vocal Oh"; kind: "WAV"; item-color: Theme.accent; }
                }
                if root.current-tab == 1: VerticalLayout {
                    spacing: 2px;
                    BrowserItem { name: "Ferrum Lead"; kind: "Synth"; item-color: Theme.clip-midi; }
                    BrowserItem { name: "Neo Keys"; kind: "Synth"; item-color: Theme.clip-midi; }
                    BrowserItem { name: "Tape Bass"; kind: "Synth"; item-color: Theme.clip-midi; }
                    BrowserItem { name: "Analog Drums"; kind: "Kit"; item-color: Theme.clip-midi; }
                    BrowserItem { name: "Cinema Pad"; kind: "Synth"; item-color: Theme.clip-midi; }
                    BrowserItem { name: "Pluck House"; kind: "Synth"; item-color: Theme.clip-midi; }
                }
                if root.current-tab == 2: VerticalLayout {
                    spacing: 2px;
                    BrowserItem { name: "MySong"; kind: "Folder"; item-color: Theme.warn; }
                    BrowserItem { name: "Session 01"; kind: "Folder"; item-color: Theme.warn; }
                    BrowserItem { name: "Kick Samples"; kind: "Folder"; item-color: Theme.warn; }
                    BrowserItem { name: "FerrumStudio.app"; kind: "EXE"; item-color: Theme.danger; }
                }
            }
        }
    }
}
