import { Button } from "components/button.slint";
import { Knob, PanKnob } from "components/knob.slint";
import { Fader } from "components/fader.slint";
import { Meter } from "components/meter.slint";
import { Theme } from "theme.slint";

component MixerHeader inherits Rectangle {
    in-out property <bool> expanded: false;
    callback expand-toggle();

    height: 26px;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: LayoutAlignment.space-between;
        cross-axis-alignment: CrossAxisAlignment.center;
        height: 100%;

        Text {
            text: "Mixer";
            color: Theme.text-primary;
            font-size: 10px;
            font-weight: 600;
        }

        Button {
            width: 22px;
            height: 20px;
            icon: @image-url("icons/arrow_up.svg");
            icon-size: 12px;
            borderless: true;
            icon-color: Theme.text-dim;
            transform-rotation: root.expanded ? 180deg : 0deg;
            toggled: root.expanded;
            toggled-icon-color: Theme.accent;
            clicked => { root.expand-toggle(); }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }
}

component MixerChannel inherits Rectangle {
    in property <string> name: "";
    in property <color> channel-color: Theme.accent;
    in property <bool> is-master: false;
    in property <int> channel-index: 0;
    in property <length> available-height: 200px;

    // Estado vem de arrays do core via o componente pai (Mixer)
    in property <bool> muted: false;
    in property <bool> soloed: false;
    in property <bool> arm: false;
    in property <float> volume: 0.8;
    in property <float> pan: 0.5;
    in property <float> level: 0.0;

    // Callbacks para o core (emitidos pelo Mixer)
    callback param-changed(int, string, float);

    property <string> pan-display:
        root.pan < 0.45
            ? "L" + ((0.5 - root.pan) * 100).to-fixed(0)
            : root.pan > 0.55
                ? "R" + ((root.pan - 0.5) * 100).to-fixed(0)
                : "C";
    property <string> vol-display:
        (root.volume * 60 - 60).to-fixed(1) + " dB";

    property <length> fader-height:
        max(60px, root.available-height - 160px);
    property <length> meter-height:
        max(50px, root.available-height - 170px);

    width: 105px;
    background: Theme.surface;

    // Linha divisória lateral direita
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 6px;
        spacing: 5px;
        alignment: LayoutAlignment.start;
        cross-axis-alignment: CrossAxisAlignment.stretch;

        // Cabeçalho do Canal / Nome
        VerticalLayout {alignment: LayoutAlignment.stretch;
            cross-axis-alignment: CrossAxisAlignment.stretch;
            spacing: 2px;

            Text {
                text: root.name;
                color: Theme.text-primary;
                font-size: 10px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Rectangle {
                width: 100%;
                height: 3px;
                background: root.channel-color;
                border-radius: 1.5px;
            }
        }

        // Botões de Ação (M, S, R)
        HorizontalLayout {
            spacing: 2px;
            alignment: center;

            Button {
                text: "M";
                width: 26px;
                height: 18px;
                toggled: root.muted;
                toggled-bg: Colors.gold;
                clicked => {
                    root.param-changed(
                        root.channel-index,
                        "muted",
                        root.muted ? 0.0 : 1.0
                    );
                }
            }

            if (!root.is-master): Button {
                text: "S";
                width: 26px;
                height: 18px;
                toggled: root.soloed;
                clicked => {
                    root.param-changed(
                        root.channel-index,
                        "soloed",
                        root.soloed ? 0.0 : 1.0
                    );
                }
            }
            if (root.is-master): Rectangle {
                width: 26px;
                height: 18px;
                background: transparent;
            }

            if (!root.is-master): Button {
                text: "R";
                width: 26px;
                height: 18px;
                toggled: root.arm;
                clicked => {
                    root.param-changed(
                        root.channel-index,
                        "arm",
                        root.arm ? 0.0 : 1.0
                    );
                }
            }
            if (root.is-master): Rectangle {
                width: 26px;
                height: 18px;
                background: transparent;
            }
        }

        // Slot de Efeitos (FX)
        Rectangle {
            width: 100%;
            height: 16px;
            background: Theme.base;
            border-radius: 3px;
            border-width: 1px;
            border-color: Theme.border;

            Text {
                text: root.is-master ? "MASTER OUT" : "FX SLOT";
                width: 100%;
                height: 100%;
                color: Theme.text-dim;
                font-size: 7px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Pan
        VerticalLayout {
            spacing: 2px;
            alignment: LayoutAlignment.center;
            cross-axis-alignment: CrossAxisAlignment.center;
            padding-top: 2px;
            padding-bottom: 2px;

            HorizontalLayout {
                spacing: 4px;
                alignment: LayoutAlignment.center;
                cross-axis-alignment: CrossAxisAlignment.center;

                PanKnob {
                    width: 34px;
                    height: 50px;
                    caption: "";
                    value: root.pan;
                    display-value: root.pan-display;
                    changed(v) => {
                        root.param-changed(
                            root.channel-index,
                            "pan",
                            v
                        );
                    }
                }

                VerticalLayout {
                    spacing: 0;
                    alignment: center;
                    cross-axis-alignment: CrossAxisAlignment.center;

                    Rectangle { /* @lsp:ignore-node */ }
                }
            }
        }

        // Fader + Meter
        HorizontalLayout {
            spacing: 4px;
            alignment: LayoutAlignment.space-evenly;
            cross-axis-alignment: CrossAxisAlignment.center;
            horizontal-stretch: 1;

            // Fader à esquerda do Meter
            VerticalLayout {
                spacing: 2px;
                alignment: LayoutAlignment.center;
                cross-axis-alignment: CrossAxisAlignment.center;
                horizontal-stretch: 1;

                Fader {
                    value: root.volume;
                    caption: "";
                    fader-height: root.fader-height;
                    changed(v) => {
                        root.param-changed(
                            root.channel-index,
                            "volume",
                            v
                        );
                    }
                }

                // Display de dB
                Rectangle {
                    width: 56px;
                    height: 16px;
                    background: Theme.base;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: Theme.border;

                    Text {
                        text: root.vol-display;
                        width: 100%;
                        height: 100%;
                        color: Theme.text-primary;
                        font-size: 8px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Meter
            Meter {
                level: root.level;
                width: 10px;
                meter-height: root.meter-height;
                active: root.level > 0.05;
            }
        }
    }
}

export component Mixer inherits Rectangle {
    in-out property <[float]> meters: [0, 0, 0, 0, 0];
    in property <[string]> names: ["Drums", "Bass", "Vocal", "Synth", "Master"];

    // Estado do mixer vindo do core (arrays indexados por canal)
    in-out property <[bool]> mutes: [false, false, false, false, false];
    in-out property <[bool]> soloes: [false, false, false, false, false];
    in-out property <[bool]> arms: [false, false, false, false, false];
    in-out property <[float]> volumes: [0.8, 0.8, 0.8, 0.8, 0.8];
    in-out property <[float]> pans: [0.5, 0.5, 0.5, 0.5, 0.5];

    in-out property <bool> expanded: false;
    callback expand-toggle();

    // Callback para o core
    callback channel-param-changed(int, string, float);

    background: Theme.surface;
    border-radius: 8px;

    VerticalLayout {
        spacing: 0;
        alignment: LayoutAlignment.stretch;
        cross-axis-alignment: CrossAxisAlignment.stretch;

        MixerHeader {
            expanded <=> root.expanded;
            expand-toggle => { root.expand-toggle(); }
        }

        flickable := Flickable {
            width: 100%;
            height: 100%;
            vertical-stretch: 1;
            viewport-width: 525px;
            interactive: true;

            HorizontalLayout {
                spacing: 0;
                alignment: start;

                for level[i] in root.meters: MixerChannel {
                    name: root.names[i];
                    channel-color: i == 4 ? Theme.text-primary : Theme.accent;
                    is-master: i == 4;
                    level: level;
                    channel-index: i;
                    available-height: flickable.height;

                    muted: root.mutes[i];
                    soloed: root.soloes[i];
                    arm: root.arms[i];
                    volume: root.volumes[i];
                    pan: root.pans[i];

                    param-changed(idx, param, val) => {
                        root.channel-param-changed(idx, param, val);
                    }
                }
            }
        }
    }
}