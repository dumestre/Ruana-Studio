import { Theme } from "../theme.slint";
import { Button } from "../components/button.slint";
import { KnobWithoutText } from "../components/knob.slint";

export component BeatHeader inherits Rectangle {
    in-out property <string> beat-name: "BEAT SEQUENCER";
    in-out property <float> humanize: 0.0;
    in-out property <float> swing: 0.0;
    in-out property <int> grid-resolution: 16;

    in-out property <bool> grid-dropdown-open: false;
    in-out property <bool> beat-menu-open: false;

    in-out property <int> current-pattern: 0;
    in-out property <[[bool]]> patterns: [[]];
    in-out property <[int]> pattern-indexes: [0];

    in property <[int]> resolution-options: [8, 16, 32, 64];

    callback close-requested;
    callback add-track-requested;
    callback grid-resolution-changed(int);
    callback duplicate-beat;
    callback copy-beat;
    callback clear-beat;
    callback delete-beat;
    callback pattern-changed(int);

    height: 34px;
    background: transparent;
    z: 10;

    HorizontalLayout {
        spacing: 8px;
        cross-axis-alignment: CrossAxisAlignment.center;

        Rectangle {
            width: 4px;
            height: 24px;

            background: Theme.accent;
            border-radius: 2px;
        }

        Text {
            text: root.beat-name;

            color: Theme.text-primary;
            font-family: "";
            font-size: 14px;
            font-weight: 700;

            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Text {
            text: "HUM";

            color: Theme.text-dim;
            font-size: 9px;
            font-weight: 700;

            vertical-alignment: center;
        }

        KnobWithoutText {
            width: 26px;
            height: 26px;

            value <=> root.humanize;
        }

        Text {
            text: "SWG";

            color: Theme.text-dim;
            font-size: 9px;
            font-weight: 700;

            vertical-alignment: center;
        }

        KnobWithoutText {
            width: 26px;
            height: 26px;

            value <=> root.swing;
        }

        Text {
            text: "STEPS";

            color: Theme.text-dim;
            font-size: 9px;
            font-weight: 700;

            vertical-alignment: center;
        }

        steps-button := Rectangle {
            width: 32px;
            height: 26px;

            background: root.grid-dropdown-open
                ? Theme.surface-high
                : Theme.base;

            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;

            Text {
                text: "" + root.grid-resolution;

                width: 100%;
                height: 100%;

                color: Theme.text-dim;
                font-size: 10px;
                font-weight: 700;

                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => {
                    root.grid-dropdown-open =
                        !root.grid-dropdown-open;
                }
            }
        }

        Rectangle {
            width: 74px;
            height: 26px;

            background: touch.has-hover
                ? Theme.surface-high
                : Theme.base;

            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;

            Text {
                text: "+ TRACK";

                width: 100%;
                height: 100%;

                color: Theme.text-dim;
                font-size: 10px;
                font-weight: 700;

                horizontal-alignment: center;
                vertical-alignment: center;
            }

            touch := TouchArea {
                mouse-cursor: pointer;

                clicked => {
                    root.add-track-requested();
                }
            }
        }

        menu-button := Button {
            width: 24px;
            height: 24px;

            border-radius: 12px;

            icon: @image-url("../icons/menu_dots.svg");
            icon-size: 14px;
            icon-color: Theme.text-dim;

            clicked => {
                root.beat-menu-open = !root.beat-menu-open;
            }
        }

        Button {
            width: 24px;
            height: 24px;

            border-radius: 12px;

            icon: @image-url("../icons/close.svg");
            icon-size: 14px;
            icon-color: Theme.text-primary;

            clicked => {
                root.close-requested();
            }
        }
    }

    // Anchors for the dropdown menus, which are rendered at the parent
    // (BeatContent) root level so they paint above the track grid.
    out property <length> steps-anchor-x: steps-button.x;
    out property <length> beat-anchor-x: menu-button.x + menu-button.width;
}