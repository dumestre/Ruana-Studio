import { Theme } from "../theme.slint";
import { Button } from "../components/button.slint";
import { KnobWithoutText } from "../components/knob.slint";

export component BeatHeader inherits Rectangle {

    // ============================================================
    // ESTADO
    // ============================================================

    in-out property <string> beat-name:
        "BEAT SEQUENCER";

    in-out property <float> humanize: 0.0;
    in-out property <float> swing: 0.0;

    in-out property <int> grid-resolution: 16;

    in-out property <bool> grid-dropdown-open: false;
    in-out property <bool> beat-menu-open: false;

    in-out property <bool> playing: false;

    in-out property <int> current-pattern: 0;
    in-out property <[[bool]]> patterns: [[]];
    in-out property <[int]> pattern-indexes: [0];

    in property <[int]> resolution-options:
        [8, 16, 32, 64];


    // ============================================================
    // CALLBACKS
    // ============================================================

    callback close-requested;
    callback add-track-requested;
    callback grid-resolution-changed(int);
    callback drag-moved(length, length);

    callback humanize-changed(float);
    callback swing-changed(float);

    callback duplicate-beat;
    callback copy-beat;
    callback clear-beat;
    callback delete-beat;

    callback pattern-changed(int);

    callback play-state-changed(bool);


    // ============================================================
    // DIMENSÕES
    // ============================================================

    height: 34px;

    background: transparent;

    z: 10;


    // ============================================================
    // ÁREA DE DRAG
    // ============================================================

    drag-zone := TouchArea {

        x: 0px;
        y: 0px;

        width: 100%;
        height: 100%;

        mouse-cursor: grab;

        property <bool> grabbing: false;
        property <length> prev-x: 0px;
        property <length> prev-y: 0px;


        pointer-event(ev) => {

            if (ev.kind == PointerEventKind.down) {

                self.grabbing = true;

                self.prev-x =
                    self.mouse-x;

                self.prev-y =
                    self.mouse-y;

            } else if (ev.kind == PointerEventKind.up) {

                self.grabbing = false;
            }
        }


        moved => {

            if (self.grabbing) {

                root.drag-moved(
                    self.mouse-x - self.prev-x,
                    self.mouse-y - self.prev-y
                );

                self.prev-x =
                    self.mouse-x;

                self.prev-y =
                    self.mouse-y;
            }
        }
    }


    // ============================================================
    // HEADER
    // ============================================================

    HorizontalLayout {

        spacing: 8px;   

        alignment: LayoutAlignment.stretch;
        cross-axis-alignment:
            CrossAxisAlignment.center;


        // ========================================================
        // ESPAÇO
        // ========================================================

        Text {
            font-size: 11px;
            text: "Beat Sequencer";
        }
        Rectangle {

            horizontal-stretch: 1;

            background:
                transparent;
        }


        // ========================================================
        // PLAY / PAUSE
        // ========================================================

        play-button := Rectangle {

            width: 18px;
            height: 18px;

            background:
                transparent;

            border-radius: 15px;


            Image {

                source:
                    root.playing
                    ? @image-url("../icons/pause.svg")
                    : @image-url("../icons/play.svg");

                colorize:
                    root.playing
                    ? Theme.accent
                    : Theme.text-primary;

                width: 18px;
                height: 18px;

                x:
                    (parent.width - self.width) / 2;

                y:
                    (parent.height - self.height) / 2;

                image-fit:
                    ImageFit.contain;
            }


            TouchArea {

                width: 18px;
                height: 18px;

                mouse-cursor:
                    pointer;

                clicked => {

                    root.playing =
                        !root.playing;

                    root.play-state-changed(
                        root.playing
                    );
                }
            }
        }


        // ========================================================
        // HUMANIZE LABEL
        // ========================================================

        Text {

            text:
                "HUM";

            color:
                Theme.text-dim;

            font-size: 9px;

            font-weight: 700;

            vertical-alignment:
                TextVerticalAlignment.center;
        }


        // ========================================================
        // HUMANIZE KNOB
        // ========================================================

        KnobWithoutText {

            width: 26px;
            height: 26px;

            value <=> root.humanize;

            changed(v) => {

                root.humanize-changed(v);
            }
        }


        // ========================================================
        // SWING LABEL
        // ========================================================

        Text {

            text:
                "SWG";

            color:
                Theme.text-dim;

            font-size: 9px;

            font-weight: 700;

            vertical-alignment:
                TextVerticalAlignment.center;
        }


        // ========================================================
        // SWING KNOB
        // ========================================================

        KnobWithoutText {

            width: 26px;
            height: 26px;

            value <=> root.swing;

            changed(v) => {

                root.swing-changed(v);
            }
        }


        // ========================================================
        // STEPS LABEL
        // ========================================================

        Text {

            text:
                "STEPS";

            color:
                Theme.text-dim;

            font-size: 9px;

            font-weight: 700;

            vertical-alignment:
                TextVerticalAlignment.center;
        }


        // ========================================================
        // STEPS BUTTON
        // ========================================================

        steps-button := Rectangle {

            width: 25px;
            height: 18px;

            background:
                root.grid-dropdown-open
                ? Theme.surface-high
                : Theme.base;

            border-radius: 4px;

            border-width: 1px;

            border-color:
                Theme.border;


            Text {

                text:
                    "" + root.grid-resolution;

                width: 100%;
                height: 100%;

                color:
                    Theme.text-dim;

                font-size: 10px;

                font-weight: 700;

                horizontal-alignment:
                    center;

                vertical-alignment:
                    center;
            }


            TouchArea {

                mouse-cursor:
                    pointer;

                clicked => {

                    root.grid-dropdown-open =
                        !root.grid-dropdown-open;
                }
            }
        }


        // ========================================================
        // ADD TRACK
        // ========================================================

        add-track-button := Rectangle {

            width: 74px;
            height: 18px;

            background:
                touch.has-hover
                ? Theme.surface-high
                : Theme.base;

            border-radius: 4px;

            border-width: 1px;

            border-color:
                Theme.border;


            Text {

                text:
                    "+ TRACK";

                width: 100%;
                height: 100%;

                color:
                    Theme.text-dim;

                font-size: 10px;

                font-weight: 700;

                horizontal-alignment:
                    TextHorizontalAlignment.center;

                vertical-alignment:
                    TextVerticalAlignment.center;
            }


            touch := TouchArea {

                mouse-cursor:
                    pointer;

                clicked => {

                    root.add-track-requested();
                }
            }
        }


        // ========================================================
        // MENU
        // ========================================================

        menu-button := Button {

            width: 18px;
            height: 18px;

            background:
                Theme.base;

            border-radius: 12px;

            icon:
                @image-url(
                    "../icons/menu_dots.svg"
                );

            icon-size:
                14px;

            preferred-width:
                18px;

            icon-color:
                Theme.text-dim;


            clicked => {

                root.beat-menu-open =
                    !root.beat-menu-open;
            }
        }


        // ========================================================
        // CLOSE
        // ========================================================

        Button {

            width: 18px;
            height: 18px;

            border-radius: 12px;

            icon:
                @image-url(
                    "../icons/close.svg"
                );

            icon-size:
                14px;

            preferred-width:
                0px;

            icon-color:
                Theme.text-primary;


            clicked => {

                root.close-requested();
            }
        }
    }


    // ============================================================
    // ANCHORS DOS MENUS
    // ============================================================

    out property <length> steps-anchor-x:
        steps-button.x;

    out property <length> beat-anchor-x:
        menu-button.x
        + menu-button.width;
}