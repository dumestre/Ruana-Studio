import { Theme } from "../theme.slint";
import { KnobWithoutText, PanKnobWithoutText } from "../components/knob.slint";

export component BeatTrack inherits Rectangle {

    in-out property <int> track-index: 0;
    in property <string> track-name: "Kick";

    in property <color> track-color: Theme.accent;

    in-out property <bool> active: true;
    in-out property <bool> solo: false;

    in-out property <float> pan: 0.0;
    in-out property <float> volume: 1.0;
    in-out property <int> mixer-channel: 0;

    in property <bool> selected: false;

    in-out property <int> track-menu-open-index: -1;

    // ============================================================
    // COLUNAS
    // ============================================================

    property <length> pan-width: 28px;
    property <length> volume-width: 28px;
    property <length> channel-width: 30px;
    property <length> mute-width: 22px;
    property <length> solo-width: 22px;
    property <length> column-spacing: 2px;

    // ============================================================
    // CALLBACKS
    // ============================================================

    callback selected-changed;
    callback active-changed(bool);
    callback solo-changed(bool);
    callback pan-changed(float);
    callback volume-changed(float);
    callback mixer-channel-changed(int);

    height: 30px;

    background: root.selected
        ? Theme.surface-high
        : transparent;

    border-radius: 4px;

    border-width: root.selected ? 1px : 0px;
    border-color: root.selected
        ? Theme.accent
        : transparent;


    // ============================================================
    // LAYOUT
    //
    // PAN | VOL | CH | M | S | TRACK
    // ============================================================

    HorizontalLayout {
        padding-left: 1px;
        padding-right: 1px;

        spacing: root.column-spacing;

        alignment: LayoutAlignment.stretch;
        cross-axis-alignment: CrossAxisAlignment.center;


        // ========================================================
        // PAN
        // ========================================================

        Rectangle {
            width: root.pan-width;
            height: 28px;

            PanKnobWithoutText {
                width: 100%;
                height: 100%;

                value: (root.pan + 1.0) / 2.0;

                changed(v) => {
                    root.pan = v * 2.0 - 1.0;
                    root.pan-changed(root.pan);
                }
            }
        }


        // ========================================================
        // VOLUME
        // ========================================================

        Rectangle {
            width: root.volume-width;
            height: 28px;

            KnobWithoutText {
                width: 100%;
                height: 100%;

                value: root.volume;

                changed(v) => {
                    root.volume = v;
                    root.volume-changed(root.volume);
                }
            }
        }


        // ========================================================
        // CHANNEL
        // ========================================================

        Rectangle {
            width: root.channel-width;
            height: 24px;

            background: #2f2e2e;

            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;

            Text {
                text: "" + (root.mixer-channel + 1);

                width: 100%;
                height: 100%;

                color: Theme.text-dim;

                font-family: "";
                font-size: 14px;
                font-weight: 0;

                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => {
                    root.mixer-channel =
                        Math.mod(root.mixer-channel + 1, 16);

                    root.mixer-channel-changed(
                        root.mixer-channel
                    );
                }
            }
        }


        // ========================================================
        // MUTE
        // ========================================================

        Rectangle {
            width: root.mute-width;
            height: 24px;

            background: !root.active
                ? Theme.accent
                : Theme.base;

            border-radius: 4px;

            border-width: 1px;

            border-color: !root.active
                ? Theme.accent
                : Theme.border;

            Text {
                text: "M";

                width: 100%;
                height: 100%;

                color: !root.active
                    ? Theme.text-primary
                    : Theme.text-dim;

                font-size: 9px;
                font-weight: 700;

                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => {
                    root.active = !root.active;
                    root.active-changed(root.active);
                }
            }
        }


        // ========================================================
        // SOLO
        // ========================================================

        Rectangle {
            width: root.solo-width;
            height: 24px;

            background: root.solo
                ? Theme.accent
                : Theme.base;

            border-radius: 4px;

            border-width: 1px;

            border-color: root.solo
                ? Theme.accent
                : Theme.border;

            Text {
                text: "S";

                width: 100%;
                height: 100%;

                color: root.solo
                    ? Theme.text-primary
                    : Theme.text-dim;

                font-size: 9px;
                font-weight: 700;

                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => {
                    root.solo = !root.solo;
                    root.solo-changed(root.solo);
                }
            }
        }


        // ========================================================
        // TRACK
        //
        // Esta é a única coluna que cresce.
        // O TouchArea fica DENTRO dela.
        // Não existe mais x: 139px.
        // ========================================================

        Rectangle {
            horizontal-stretch: 1;
            height: 24px;

            background: root.track-color;

            border-radius: 4px;

            border-width: 1px;

            border-color: root.selected
                ? Theme.text-primary
                : Theme.border;

            opacity: root.active ? 1.0 : 0.35;


            // ====================================================
            // NOME
            // ====================================================

            Text {
                text: root.track-name;

                x: 0px;
                y: 0px;

                width: parent.width;
                height: parent.height;

                color: #1a1a1a;

                font-size: 10px;
                font-weight: 700;

                horizontal-alignment: center;
                vertical-alignment: center;

                overflow: elide;
            }


            // ====================================================
            // INTERAÇÃO DA TRACK
            //
            // Agora acompanha automaticamente a largura da
            // coluna TRACK.
            // ====================================================

            TouchArea {
                width: parent.width;
                height: parent.height;

                mouse-cursor: pointer;

                pointer-event(event) => {

                    if event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.left {

                        root.selected-changed();

                    } else if event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.right {

                        if root.track-menu-open-index
                            == root.track-index {

                            root.track-menu-open-index = -1;

                        } else {

                            root.track-menu-open-index =
                                root.track-index;
                        }
                    }
                }
            }
        }
    }
}