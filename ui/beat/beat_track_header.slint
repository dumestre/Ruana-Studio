import { Theme } from "../theme.slint";

export component BeatTrackHeader inherits Rectangle {

    height: 33px;

    HorizontalLayout {
        x: 8px;
        y: 0px;

        width: parent.width - 16px;
        height: 33px;

        spacing: 2px;

        alignment: LayoutAlignment.stretch;
        cross-axis-alignment: CrossAxisAlignment.center;


        // PAN
        Rectangle {
            width: 28px;
            height: 33px;

            Text {
                text: "PAN";

                width: 100%;
                height: 100%;

                color: Theme.text-dim;
                font-size: 9px;
                font-weight: 700;

                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }


        // VOL
        Rectangle {
            width: 28px;
            height: 33px;

            Text {
                text: "VOL";

                width: 100%;
                height: 100%;

                color: Theme.text-dim;
                font-size: 9px;
                font-weight: 700;

                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }


        // CH
        Rectangle {
            width: 30px;
            height: 33px;

            Text {
                text: "CH";

                width: 100%;
                height: 100%;

                color: Theme.text-dim;
                font-size: 9px;
                font-weight: 700;

                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }


        // M
        Rectangle {
            width: 22px;
            height: 33px;

            Text {
                text: "M";

                width: 100%;
                height: 100%;

                color: Theme.text-dim;
                font-size: 9px;
                font-weight: 700;

                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }


        // S
        Rectangle {
            width: 22px;
            height: 33px;

            Text {
                text: "S";

                width: 100%;
                height: 100%;

                color: Theme.text-dim;
                font-size: 9px;
                font-weight: 700;

                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }


        // TRACK
        Rectangle {
            horizontal-stretch: 1;
            height: 33px;

            Text {
                text: "TRACK";

                width: 100%;
                height: 100%;

                color: Theme.text-dim;
                font-size: 10px;
                font-weight: 700;

                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}