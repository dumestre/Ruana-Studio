import { Theme } from "theme.slint";
import { Transport } from "transport.slint";
import { Toolbar } from "toolbar.slint";
import { EditToolbar } from "edit_toolbar.slint";
import { LeftPanel } from "left_panel.slint";
import { Timeline } from "timeline/timeline.slint";
import { ClipData } from "timeline/clip_data.slint";
import { Explorer } from "explorer/explorer.slint";
import { Mixer } from "mixer.slint";
import { BeatPopup } from "beat/beat.slint";
import { SplitterV, SplitterH } from "components/splitter.slint";

export component MainWindow inherits Window {
    title: "Ferrum Studio";
    preferred-width: 1380px;
    preferred-height: 880px;
    background: Theme.base;
    no-frame: true;
    full-screen: true;
    forward-focus: keyboard-focus;

    in-out property <int> transport-position: 0;
    in-out property <bool> playing: false;
    in-out property <int> selected-track: 0;
    in-out property <float> zoom-level: 1.0;
    in-out property <int> active-tool: 0;

    in-out property <bool> beat-open: false;
    in-out property <bool> explorer-visible: true;
    in-out property <bool> mixer-visible: true;

    in-out property <length> explorer-width: 300px;
    in-out property <length> mixer-height: 215px;
    in-out property <length> left-panel-width: 230px;
    in-out property <length> tracks-header-width: 150px;

    min-height: 720px;
    min-width: 1280px;

    in-out property <[float]> mixer-meters: [0, 0, 0, 0, 0];

    in-out property <[ClipData]> clips: [];

    callback play-state-changed(bool);
    callback close;
    callback minimize;
    callback add-track-requested(string);

    in-out property <[string]> track-names: [
        "Drums",
        "Bass",
        "Vocal",
        "Synth"
    ];

    VerticalLayout {
        alignment: LayoutAlignment.stretch;
        cross-axis-alignment: CrossAxisAlignment.stretch;
        spacing: 0;

        Toolbar {
            full-screen <=> root.full-screen;

            zoom-in => {
                root.zoom-level = min(root.zoom-level + 0.25, 4.0);
            }

            zoom-out => {
                root.zoom-level = max(root.zoom-level - 0.25, 0.5);
            }

            close => {
                root.close();
            }

            minimize => {
                root.minimize();
            }
        }

        Transport {
            playing <=> root.playing;
            position <=> root.transport-position;

            play-state-changed(p) => {
                root.play-state-changed(p);
            }
        }

        EditToolbar {
            active-tool <=> root.active-tool;
            beat-open <=> root.beat-open;
            explorer-visible <=> root.explorer-visible;
            mixer-visible <=> root.mixer-visible;
        }

        Rectangle {
            width: 100%;
            vertical-stretch: 1;
            height: 100%;

            HorizontalLayout {
                cross-axis-alignment: CrossAxisAlignment.stretch;
                spacing: 0;

                LeftPanel {
                    selected-track <=> root.selected-track;
                    track-names: root.track-names;
                    width: root.left-panel-width;
                }

                Timeline {
                    selected-track <=> root.selected-track;
                    position: root.transport-position;
                    zoom: root.zoom-level;
                    track-names: root.track-names;
                    active-tool: root.active-tool;
                    clips: root.clips;
                    header-width: root.tracks-header-width;
                    horizontal-stretch: 1;

                    select-track(i) => {
                        root.selected-track = i;
                    }

                    clip-selected(i) => {
                        root.selected-track = i;
                    }

                    add-track-requested(t) => {
                        root.add-track-requested(t);
                    }
                    keyboard-focus := FocusScope {
                        width: 100%;
                        height: 100%;
                    
                        key-pressed(event) => {
                            if (event.text == Key.Space && beat_popup.is-open && beat_popup.mouse-over) {
                                beat_popup.playing = !beat_popup.playing;
                                accept
                            } else {
                                reject
                            }
                        }
                    }
                }
            }

            // =============================================
            // MIXER (OVERLAY INFERIOR)
            //
            // Fica contido entre a coluna de tracks e o
            // explorer (formato "H"), sem empurrar a
            // timeline.
            // =============================================

            SplitterH {
                x: root.left-panel-width + root.tracks-header-width;
                y: parent.height - root.mixer-height - 5px;

                width: parent.width
                    - root.left-panel-width
                    - root.tracks-header-width
                    - (root.explorer-visible ? root.explorer-width + 5px : 0px);

                visible: root.mixer-visible;

                value <=> root.mixer-height;

                z: 30;
            }

            Mixer {
                x: root.left-panel-width + root.tracks-header-width;
                y: parent.height - root.mixer-height;

                width: parent.width
                    - root.left-panel-width
                    - root.tracks-header-width
                    - (root.explorer-visible ? root.explorer-width + 5px : 0px);
                height: root.mixer-height;

                visible: root.mixer-visible;

                meters <=> root.mixer-meters;

                z: 30;
            }

            // =============================================
            // EXPLORER (OVERLAY DIREITO)
            //
            // Cobre a parte direita da timeline, sem
            // empurrá-la.
            // =============================================

            SplitterV {
                x: parent.width - root.explorer-width - 5px;
                y: 0;

                height: 100%;

                visible: root.explorer-visible;

                value <=> root.explorer-width;

                z: 40;
            }

            Explorer {
                x: parent.width - root.explorer-width;
                y: 0;

                width: root.explorer-width;
                height: 100%;

                visible: root.explorer-visible;

                z: 40;
            }
        }

        Rectangle {
            width: 100%;
            height: 1px;
            background: Theme.border;
        }

        Rectangle {
            width: 100%;
            height: 22px;
            background: Theme.surface;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 16px;

                Text {
                    text: "Ferrum Studio 0.1.0";
                    color: Theme.text-dim;
                    font-size: 10px;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                Text {
                    text: "120 BPM";
                    color: Theme.text-dim;
                    font-size: 10px;
                    vertical-alignment: center;
                }

                Text {
                    text: "44.1 kHz";
                    color: Theme.text-dim;
                    font-size: 10px;
                    vertical-alignment: center;
                }

                Text {
                    text: "24-bit";
                    color: Theme.text-dim;
                    font-size: 10px;
                    vertical-alignment: center;
                }

                Text {
                    text: "FASE 1 - UI";
                    color: Theme.accent;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }
        }
    }

    beat_popup := BeatPopup {
        open <=> root.beat-open;
    }

}