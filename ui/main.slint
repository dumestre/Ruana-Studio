import { Theme } from "theme.slint";
import { Transport } from "transport.slint";
import { Toolbar } from "toolbar.slint";
import { EditToolbar } from "edit_toolbar.slint";
import { LeftPanel } from "left_panel.slint";
import { Timeline } from "timeline/timeline.slint";
import { ClipData } from "timeline/clip_data.slint";
import { Explorer } from "explorer/explorer.slint";
import { Mixer } from "mixer.slint";
import { BeatPopup } from "beat/beat.slint";
import {
    SplitterVerticalGrowLeft,
    SplitterVerticalGrowRight,
    SplitterHorizontal
} from "components/splitter.slint";
import { ZoomBarHorizontal, ZoomBarVertical } from "components/zoom_bar.slint";
import { ScrollBarHorizontal, ScrollBarVertical } from "components/scrollbar.slint";
import { TrackPanel } from "timeline/TrackPanel.slint";


export component MainWindow inherits Window {

    // =====================================================
    // JANELA
    // =====================================================

    title:
        "Ferrum Studio";

    preferred-width:
        1380px;

    preferred-height:
        880px;

    min-width:
        1280px;

    min-height:
        720px;

    background:
        Theme.base;

    no-frame:
        true;

    full-screen:
        true;

    forward-focus:
        keyboard-focus;


    // =====================================================
    // ESTADO
    // =====================================================

    in-out property <int> transport-position:
        0;

    in-out property <bool> playing:
        false;

    in-out property <int> selected-track:
        0;

    in-out property <float> zoom-level:
        1.0;

    in-out property <float> zoom-y-level:
        1.0;

    in-out property <int> active-tool:
        0;


    // =====================================================
    // PAINÉIS
    // =====================================================

    in-out property <bool> beat-open:
        false;

    in-out property <bool> explorer-visible:
        true;

    in-out property <bool> mixer-visible:
        true;


    // =====================================================
    // DIMENSÕES
    // =====================================================

    in-out property <length> explorer-width:
        300px;

    in-out property <length> mixer-height:
        215px;

    in-out property <length> left-panel-width:
        230px;

    in-out property <length> tracks-header-width:
        200px;


    // =====================================================
    // DADOS
    // =====================================================

    in-out property <[float]> mixer-meters:
        [0, 0, 0, 0, 0];

    in-out property <[ClipData]> clips:
        [];

    in-out property <[string]> track-names:
        [
            "Drums",
            "Bass",
            "Vocal",
            "Synth"
        ];


    // =====================================================
    // CALLBACKS
    // =====================================================

    callback play-state-changed(bool);

    callback close;

    callback minimize;

    callback add-track-requested(string);


    // =====================================================
    // LAYOUT PRINCIPAL
    // =====================================================

    VerticalLayout {

        alignment:
            LayoutAlignment.stretch;

        cross-axis-alignment:
            CrossAxisAlignment.stretch;

        spacing:
            0;


        // =================================================
        // TOOLBAR
        // =================================================

        Toolbar {

            full-screen <=>
                root.full-screen;


            zoom-in => {

                root.zoom-level =
                    min(
                        root.zoom-level + 0.25,
                        4.0
                    );
            }


            zoom-out => {

                root.zoom-level =
                    max(
                        root.zoom-level - 0.25,
                        0.5
                    );
            }


            close => {

                root.close();
            }


            minimize => {

                root.minimize();
            }
        }


        // =================================================
        // TRANSPORT
        // =================================================

        Transport {

            playing <=>
                root.playing;

            position <=>
                root.transport-position;


            play-state-changed(state) => {

                root.play-state-changed(
                    state
                );
            }
        }


        // =================================================
        // EDIT TOOLBAR
        // =================================================

        EditToolbar {

            active-tool <=>
                root.active-tool;

            beat-open <=>
                root.beat-open;

            explorer-visible <=>
                root.explorer-visible;

            mixer-visible <=>
                root.mixer-visible;
        }


        // =================================================
        // ÁREA DE TRABALHO
        // =================================================

        Rectangle {

            width:
                100%;

            height:
                100%;

            vertical-stretch:
                1;


            // =================================================
            // ÁREA VISÍVEL DA TIMELINE
            //
            // Mesma matemática do Mixer/Explorer.
            // =================================================

            property <length> timeline-area-x:
                root.left-panel-width
                + root.tracks-header-width;

            property <length> timeline-area-w:
                self.width
                - root.left-panel-width
                - root.tracks-header-width
                - (
                    root.explorer-visible
                        ? root.explorer-width + 5px
                        : 0px
                )
                - 5px;

            property <length> timeline-area-h:
                self.height
                - (
                    root.mixer-visible
                        ? root.mixer-height + 5px
                        : 0px
                );


            // =================================================
            // ÁREA PRINCIPAL
            //
            // LeftPanel
            // TrackPanel
            // Splitter
            // Timeline
            //
            // O Timeline recebe automaticamente todo o espaço
            // restante.
            // =================================================

            HorizontalLayout {

                spacing:
                    0;

                cross-axis-alignment:
                    CrossAxisAlignment.stretch;


                // =============================================
                // LEFT PANEL
                // =============================================

                LeftPanel {

                    width:
                        root.left-panel-width;

                    selected-track <=>
                        root.selected-track;

                    track-names:
                        root.track-names;
                }


                // =============================================
                // TRACK PANEL
                // =============================================

                TrackPanel {

                    width:
                        root.tracks-header-width;

                    selected-track <=>
                        root.selected-track;

                    track-names:
                        root.track-names;

                    zoom-y:
                        root.zoom-y-level;


                    track-clicked(index) => {

                        root.selected-track =
                            index;
                    }


                    add-track-requested(type) => {

                        root.add-track-requested(
                            type
                        );
                    }
                }


                // =============================================
                // TIMELINE
                //
                // Ocupa automaticamente todo o espaço
                // restante do HorizontalLayout.
                //
                // Quando TrackPanel aumenta:
                //     Timeline diminui.
                //
                // Quando TrackPanel diminui:
                //     Timeline aumenta.
                // =============================================

                timeline := Timeline {

                    horizontal-stretch:
                        1;

                    selected-track <=>
                        root.selected-track;

                    position:
                        root.transport-position;

                    zoom <=>
                        root.zoom-level;

                    zoom-y <=>
                        root.zoom-y-level;

                    track-names:
                        root.track-names;

                    active-tool:
                        root.active-tool;

                    clips:
                        root.clips;


                    select-track(index) => {

                        root.selected-track =
                            index;
                    }


                    clip-selected(index) => {

                        root.selected-track =
                            index;
                    }


                    clip-slice-requested(
                        id,
                        position
                    ) => {
                    }


 Rectangle { min-width: 16px; min-height: 16px; /* @lsp:ignore-node */ }                }
            }

            // =============================================
            // SPLITTER DO TRACK PANEL
            //
            // TrackPanel está à esquerda.
            //
            // ← aumenta TrackPanel
            // → diminui TrackPanel
            //
            // O valor do splitter é a única fonte
            // de verdade da largura do TrackPanel.
            //
            // Posicionado fora do layout para descer
            // até a borda inferior (como o do Explorer).
            // =============================================

            SplitterVerticalGrowLeft {

                x:
                    root.left-panel-width
                    + root.tracks-header-width;

                y: 0;

                width: 5px;

                height: 100%;

                value <=>
                    root.tracks-header-width;

                min-value:
                    120px;

                max-value:
                    420px;

                z:
                    50;
            }


            // =================================================
            // BARRAS DA TIMELINE
            //
            // Rodapé: scroll horizontal + zoom horizontal.
            // Lateral direita: scroll vertical + zoom vertical.
            // =================================================

            ScrollBarHorizontal {

                x:
                    parent.timeline-area-x;

                y:
                    parent.timeline-area-h
                    - 14px;

                width:
                    parent.timeline-area-w
                    - 32px;

                height: 14px;

                value <=>
                    timeline.scroll-x;

                max-value:
                    timeline.max-scroll-x;

                thumb-size:
                    parent.timeline-area-w
                    * parent.timeline-area-w
                    / (
                        parent.timeline-area-w
                        + timeline.max-scroll-x
                    );

                z: 60;
            }


            ZoomBarHorizontal {

                x:
                    parent.timeline-area-x;

                y:
                    parent.timeline-area-h
                    - 14px
                    - 16px;

                width:
                    parent.timeline-area-w
                    - 32px;

                height: 16px;

                value:
                    root.zoom-level;

                min-value: 0.5;
                max-value: 4.0;

                zoom-requested(new-zoom) => {
                    let old-zoom = timeline.zoom;
                    root.zoom-level = new-zoom;
                    timeline.zoom = new-zoom;
                    timeline.scroll-x = max(0px, min(timeline.max-scroll-x,
                        ((timeline.width / 2 + timeline.scroll-x) / old-zoom) * new-zoom - timeline.width / 2
                    ));
                }

                z: 60;
            }


            ScrollBarVertical {

                x:
                    parent.timeline-area-x
                    + parent.timeline-area-w
                    - 14px;

                y: 0;

                width: 14px;

                height:
                    parent.timeline-area-h
                    - 30px;

                value <=>
                    timeline.scroll-y;

                max-value:
                    timeline.max-scroll-y;

                thumb-size:
                    parent.timeline-area-h
                    * parent.timeline-area-h
                    / (
                        parent.timeline-area-h
                        + timeline.max-scroll-y
                    );

                z: 60;
            }


            ZoomBarVertical {

                x:
                    parent.timeline-area-x
                    + parent.timeline-area-w
                    - 30px;

                y: 0;

                width: 16px;

                height:
                    parent.timeline-area-h
                    - 30px;

                value <=>
                    root.zoom-y-level;

                min-value: 0.4;
                max-value: 3.0;

                z: 60;
                keyboard-focus := FocusScope {
                
                    width:
                        100%;
                
                    height:
                        100%;
                
                
                    key-pressed(event) => {
                
                        if (
                            event.text == Key.Space
                            && beat_popup.is-open
                            && beat_popup.mouse-over
                        ) {
                
                            beat_popup.playing =
                                !beat_popup.playing;
                
                            accept;
                
                        } else {
                
                            reject;
                        }
                    }
                }
            }


            // =================================================
            // MIXER SPLITTER
            // =================================================

            SplitterHorizontal {

                x:
                    root.left-panel-width
                    + root.tracks-header-width;

                y:
                    parent.height
                    - root.mixer-height
                    - 5px;

                width:
                    parent.width
                    - root.left-panel-width
                    - root.tracks-header-width
                    - (
                        root.explorer-visible
                            ? root.explorer-width + 5px
                            : 0px
                    );

                visible:
                    root.mixer-visible;

                value <=>
                    root.mixer-height;

                min-value:
                    120px;

                max-value:
                    600px;

                z:
                    30;
            }


            // =================================================
            // MIXER
            // =================================================

            Mixer {

                x:
                    root.left-panel-width
                    + root.tracks-header-width;

                y:
                    parent.height
                    - root.mixer-height;

                width:
                    parent.width
                    - root.left-panel-width
                    - root.tracks-header-width
                    - (
                        root.explorer-visible
                            ? root.explorer-width + 5px
                            : 0px
                    );

                height:
                    root.mixer-height;

                visible:
                    root.mixer-visible;

                meters <=>
                    root.mixer-meters;

                z:
                    30;
            }


            // =================================================
            // EXPLORER SPLITTER
            //
            // Explorer está à direita.
            //
            // ← diminui Explorer
            // → aumenta Explorer
            // =================================================

            SplitterVerticalGrowRight {

                x:
                    parent.width
                    - root.explorer-width
                    - 5px;

                y:
                    0;

                height:
                    100%;

                visible:
                    root.explorer-visible;

                value <=>
                    root.explorer-width;

                min-value:
                    220px;

                max-value:
                    500px;

                z:
                    40;
            }


            // =================================================
            // EXPLORER
            // =================================================

            Explorer {

                x:
                    parent.width
                    - root.explorer-width;

                y:
                    0;

                width:
                    root.explorer-width;

                height:
                    100%;

                visible:
                    root.explorer-visible;

                z:
                    40;
            }
        }


        // =====================================================
        // STATUS DIVIDER
        // =====================================================

        Rectangle {

            width:
                100%;

            height:
                1px;

            background:
                Theme.border;
        }


        // =====================================================
        // STATUS BAR
        // =====================================================

        Rectangle {

            width:
                100%;

            height:
                22px;

            background:
                Theme.surface;


            HorizontalLayout {

                padding-left:
                    8px;

                padding-right:
                    8px;

                spacing:
                    16px;


                Text {

                    text:
                        "Ferrum Studio 0.1.0";

                    color:
                        Theme.text-dim;

                    font-size:
                        10px;

                    vertical-alignment:
                        center;
                }


                Rectangle {

                    horizontal-stretch:
                        1;

                    background:
                        transparent;
                }


                Text {

                    text:
                        "120 BPM";

                    color:
                        Theme.text-dim;

                    font-size:
                        10px;

                    vertical-alignment:
                        center;
                }


                Text {

                    text:
                        "44.1 kHz";

                    color:
                        Theme.text-dim;

                    font-size:
                        10px;

                    vertical-alignment:
                        center;
                }


                Text {

                    text:
                        "24-bit";

                    color:
                        Theme.text-dim;

                    font-size:
                        10px;

                    vertical-alignment:
                        center;
                }


                Text {

                    text:
                        "FASE 1 - UI";

                    color:
                        Theme.accent;

                    font-size:
                        10px;

                    vertical-alignment:
                        center;
                }
            }
        }
    }


    // =====================================================
    // BEAT POPUP
    // =====================================================

    beat_popup := BeatPopup {

        open <=>
            root.beat-open;
    }
}