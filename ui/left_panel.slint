import { Theme } from "theme.slint";

component ClipItem inherits Rectangle {
    in property <string> name: "";
    in property <string> position: "";
    in property <string> duration: "";
    in property <color> clip-color: Theme.clip-midi;

    height: 38px;
    background: Theme.surface-high;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 8px;

        Rectangle {
            width: 8px;
            height: 100%;
            background: root.clip-color;
            border-radius: 2px;
        }

        VerticalLayout {
            spacing: 2px;
            Text {
                text: root.name;
                color: Theme.text-primary;
                font-size: 11px;
                vertical-alignment: center;
            }
            Text {
                text: "Pos " + root.position + "  ·  Len " + root.duration;
                color: Theme.text-dim;
                font-size: 9px;
                vertical-alignment: center;
            }
        }
    }
}

export component LeftPanel inherits Rectangle {
    in-out property <int> selected-track: 0;
    in property <[string]> track-names: ["Drums", "Bass", "Vocal", "Synth"];
    callback track-selected(int);

    preferred-width: 230px;
    height: 100%;
    background: Theme.surface;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        Rectangle {
            width: 100%;
            height: 28px;
            background: Theme.surface-high;
            border-radius: 4px;

            Text {
                text: "CLIPS — " + root.track-names[root.selected-track];
                color: Theme.accent;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            spacing: 4px;

            if root.selected-track == 0: VerticalLayout {
                spacing: 4px;
                ClipItem { name: "Drums A"; position: "1.1"; duration: "2 bars"; clip-color: Theme.clip-midi; }
                ClipItem { name: "Drums B"; position: "3.1"; duration: "1 bar"; clip-color: Theme.clip-midi; }
                ClipItem { name: "Drums Fill"; position: "4.3"; duration: "2 beats"; clip-color: Theme.clip-midi; }
            }
            if root.selected-track == 1: VerticalLayout {
                spacing: 4px;
                ClipItem { name: "Bass A"; position: "1.1"; duration: "4 bars"; clip-color: Theme.clip-midi; }
                ClipItem { name: "Bass B"; position: "5.2"; duration: "2 bars"; clip-color: Theme.clip-midi; }
            }
            if root.selected-track == 2: VerticalLayout {
                spacing: 4px;
                ClipItem { name: "Vocal Verse"; position: "1.1"; duration: "4 bars"; clip-color: Theme.clip-audio; }
                ClipItem { name: "Vocal Chorus"; position: "5.1"; duration: "2 bars"; clip-color: Theme.clip-audio; }
            }
            if root.selected-track == 3: VerticalLayout {
                spacing: 4px;
                ClipItem { name: "Synth Pad"; position: "1.1"; duration: "8 bars"; clip-color: Theme.clip-midi; }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;
        }

        Text {
            text: "Selection: " + (root.selected-track + 1);
            color: Theme.text-dim;
            font-size: 10px;
            horizontal-alignment: left;
        }
    }
}
