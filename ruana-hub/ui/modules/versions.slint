import { HubTheme } from "../theme.slint";
import { ActionButton } from "../components/action_button.slint";

export struct HubVersion {
    name: string,
    path: string,
}

component VersionRow inherits Rectangle {
    in property <string> name: "";
    in property <string> path: "";
    in property <bool> busy: false;
    callback launch-requested(string);
    callback update-requested(string);

    height: 72px;
    background: HubTheme.surface;
    border-width: 1px;
    border-color: HubTheme.border;
    border-radius: 6px;

    VerticalLayout {
        x: 14px;
        y: 9px;
        width: parent.width - 250px;
        spacing: 4px;
        Text {
            text: root.name;
            color: HubTheme.text-primary;
            font-size: 13px;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            text: root.path;
            color: HubTheme.text-dim;
            font-size: 10px;
            overflow: elide;
        }
    }

    ActionButton {
        x: parent.width - self.width - 12px;
        y: (parent.height - self.height) / 2;
        width: 100px;
        label: "Iniciar";
        primary: true;
        enabled: !root.busy;
        clicked => { root.launch-requested(root.path); }
    }

    ActionButton {
        x: parent.width - self.width - 120px;
        y: (parent.height - self.height) / 2;
        width: 100px;
        label: "Atualizar";
        enabled: !root.busy;
        clicked => { root.update-requested(root.path); }
    }
}

export component VersionsPage inherits Rectangle {
    in property <[HubVersion]> versions: [];
    in-out property <bool> busy: false;
    callback install-version();
    callback update-version(string);
    callback launch-version(string);

    background: transparent;

    VerticalLayout {
        padding: 30px;
        spacing: 18px;

        Text {
            text: "Builds instaladas";
            color: HubTheme.text-primary;
            font-size: 24px;
            font-weight: 700;
        }

        Text {
            text: "Gerencie builds de teste a partir de pastas já extraídas.";
            color: HubTheme.text-dim;
            font-size: 12px;
        }

        HorizontalLayout {
            ActionButton {
                label: root.busy ? "Baixando build..." : "Instalar última versão";
                primary: true;
                enabled: !root.busy;
                clicked => { root.install-version(); }
            }
        }

        if root.versions.length == 0 : Text {
            text: "Nenhuma versão instalada. Instale uma build de teste para começar.";
            color: HubTheme.text-dim;
            font-size: 12px;
            wrap: word-wrap;
        }

        for version in root.versions : VersionRow {
            name: version.name;
            path: version.path;
            busy: root.busy;
            launch-requested(path) => { root.launch-version(path); }
            update-requested(path) => { root.update-version(path); }
        }
    }
}
