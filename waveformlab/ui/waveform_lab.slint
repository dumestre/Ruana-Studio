// WaveformLab — laboratório de renderização de waveform.
//
// UI mínima de propósito: tudo que importa aqui é a waveform.
// Um "clip" largo, zoom por slider/roda, arrastro horizontal e
// troca entre os sinais sintéticos de teste.

import { Slider, ComboBox } from "std-widgets.slint";

export struct LabImage {
    mono: image,
    stereo: image,
}

export component MainWindow inherits Window {
    title: "WaveformLab";
    preferred-width: 1200px;
    preferred-height: 500px;
    background: #14161a;

    // =====================================================
    // ESTADO (setado pelo Rust)
    // =====================================================

    // Imagens pré-renderizadas na resolução atual do viewport.
    in property <image> wave-mono;
    in property <image> wave-stereo;

    // Sinal ativo (índice no combo) + rótulos (sintéticos + WAVs).
    in-out property <int> signal-index: 0;
    in property <[string]> signal-labels;

    // Zoom: pixels por segundo de áudio.
    in-out property <float> px-per-second: 100.0;

    // Viewport: início visível em segundos (arrasto horizontal).
    in-out property <float> view-start: 0.0;

    // Duração total do sinal em segundos (vem do Rust).
    in property <float> duration: 4.0;

    callback signal-changed(int);
    callback zoom-changed(float);
    callback view-changed(float);

    // Arrasto do viewport dentro da área da waveform.
    callback drag-start(length);
    callback drag-move(length);
    callback drag-end();

    // =====================================================
    // LAYOUT
    // =====================================================

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            height: 32px;

            Text {
                text: "Sinal:";
                color: #cccccc;
                vertical-alignment: center;
            }

            ComboBox {
                width: 260px;
                model: root.signal-labels;
                current-index <=> root.signal-index;
                changed current-index => { root.signal-changed(self.current-index); }
            }

            Rectangle {}

            Text {
                text: "Zoom:";
                color: #cccccc;
                vertical-alignment: center;
            }

            Slider {
                width: 260px;
                minimum: 10.0;
                maximum: 200000.0;
                value <=> root.px-per-second;
                changed value => { root.zoom-changed(self.value); }
            }

            Text {
                text: root.px-per-second + " px/s";
                color: #888888;
                vertical-alignment: center;
                width: 90px;
            }
        }

        // Área da waveform.
        Rectangle {
            clip: true;
            border-radius: 6px;
            background: #1c1f24;
            border-width: 1px;
            border-color: #2c3038;

            touch := TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down
                        && event.button == PointerEventButton.left {
                        root.drag-start(touch.mouse-x);
                    }
                    if event.kind == PointerEventKind.up {
                        root.drag-end();
                    }
                }
                moved => {
                    if touch.pressed {
                        root.drag-move(touch.mouse-x);
                    }
                }
            }

            // Canal MONO (envelope único centralizado) — metade de cima.
            Image {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height / 2;
                source: root.wave-mono;
                image-fit: fill;
            }

            // Canal STÉREO (L/R em lanes separados) — metade de baixo.
            Image {
                x: 0;
                y: parent.height / 2;
                width: parent.width;
                height: parent.height / 2;
                source: root.wave-stereo;
                image-fit: fill;
            }

            // Divisória dos modos.
            Rectangle {
                y: parent.height / 2 - 1px;
                height: 1px;
                background: #333842;
            }

            // Rótulos.
            Text {
                x: 8px; y: 6px;
                text: "mono (downmix)";
                color: #555b66;
                font-size: 10px;
            }
            Text {
                x: 8px;
                y: parent.height / 2 + 6px;
                text: "estéreo L|R";
                color: #555b66;
                font-size: 10px;
            }
        }

        HorizontalLayout {
            spacing: 8px;
            height: 20px;
            Text {
                text: "viewport @ " + root.view-start + "s";
                color: #666c77;
                font-size: 11px;
                vertical-alignment: center;
            }
            Rectangle {}
            Text {
                text: "(arraste a waveform para navegar · slider/roda = zoom)";
                color: #444a54;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
    }
}
